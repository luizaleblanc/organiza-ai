# Copie este arquivo para .env e preencha com valores reais.
# .env nunca deve ser commitado (ja esta no .gitignore).

# MySQL -- se omitido, usa o fallback local do compose.yml (localhost:3307, user/senha "app")
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/transaction?useUnicode=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=app
SPRING_DATASOURCE_PASSWORD=app

# Obrigatorio -- chave Gemini Developer API, criada em https://aistudio.google.com/apikey
# Use um projeto no Free Tier. Cotas gratuitas nao sao ilimitadas.
GEMINI_API_KEY=sua-chave-do-google-ai-studio
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_AUDIO_MODEL=gemini-2.5-flash-lite
GEMINI_SPEECH_MODEL=gemini-2.5-flash-preview-tts
GEMINI_SPEECH_VOICE=Kore

# Obrigatorio -- chave de assinatura dos tokens JWT. Gere uma nova e forte, nunca reutilize este exemplo.
# ex: openssl rand -hex 32
API_SECURITY_TOKEN_SECRET=troque-por-uma-chave-forte-gerada-por-voce

# Opcional -- desativa o auto-start do MySQL via Docker Compose quando true
SPRING_DOCKER_COMPOSE_ENABLED=false
