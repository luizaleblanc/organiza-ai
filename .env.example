# Copie este arquivo para .env e preencha com valores reais.
# .env nunca deve ser commitado (ja esta no .gitignore).

# =========================================================
# Backend Kof (backend/*.kf) — monolito KofLith
# =========================================================

# Obrigatorio -- chave de assinatura dos tokens JWT (HS256), com no minimo 32 caracteres.
# Sem ela o servidor NAO sobe ("missing required key 'jwt.secret' ... env KOF_JWT_SECRET").
# E a mesma variavel que o runtime do Kof usa no pipeline auth.* do kof.web.
# Gere uma nova e forte, nunca reutilize este exemplo. ex: openssl rand -hex 32
KOF_JWT_SECRET=troque-por-uma-chave-forte-de-64-caracteres-hex

# Opcional -- emissor (iss) e audiencia (aud) gravados e exigidos nos tokens.
# Padroes: organiza-ai / organiza-ai-api. Trocar invalida os tokens ja emitidos.
KOF_JWT_ISSUER=organiza-ai
KOF_JWT_AUDIENCE=organiza-ai-api

# Banco (backend/store.kf). URL SEM usuario/senha; sem ela, fora de producao, usa H2 em ./data.
# Em producao (KOF_ENV=production) KOF_DB_URL e obrigatoria.
# KOF_DB_URL=jdbc:postgresql://localhost:5432/organiza
# KOF_DB_USER=
# KOF_DB_PASSWORD=
# KOF_ENV=production

# =========================================================
# Legado — backend Spring arquivado em archive/ (NAO usado pelo backend Kof)
# =========================================================

# MySQL -- se omitido, usa o fallback local do compose.yml (localhost:3307, user/senha "app")
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/transaction?useUnicode=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=app
SPRING_DATASOURCE_PASSWORD=app

# Chave da API da OpenAI (Whisper, GPT-4o-mini, TTS) -- usada so pelo Spring arquivado
OPENAI_API_KEY=sk-...

# Opcional -- desativa o auto-start do MySQL via Docker Compose quando true
SPRING_DOCKER_COMPOSE_ENABLED=false
