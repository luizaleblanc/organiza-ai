// backend/models.kf
// Transpilado de src/main/java/com/organiza/**/model/*.java para KOF
// Sintaxe validada apenas contra training/ do repositorio KofLang/Kof4j.
// Anotacoes JPA (@Entity, @Id, @Column, @Enumerated, @PrePersist, @Lob,
// @CreationTimestamp) foram ignoradas -- persistencia sera gerenciada por kof.db.
// BigDecimal -> Float | LocalDateTime/Instant -> String? | UUID -> String

// =========================================================
// Enums
// =========================================================

// mod_user/model/Role.java
enum Role { USER, ADMIN }

// mod_user/model/Tier.java
enum Tier { FREE, PREMIUM }

// mod_user/model/IncomeType.java
enum IncomeType { FIXED, VARIABLE }

// mod_transaction/model/Category.java
enum Category {
    GROCERIES, LEISURE, FOOD, PHARMA, HEALTH, AUTO, TRANSPORT,
    HOUSING, EDUCATION, SHOPPING, SUBSCRIPTIONS, OTHER
}

// mod_transaction/model/Bucket.java (referenciado por TransactionEntity.bucket)
enum Bucket { NEEDS, WANTS, SAVINGS, DEBT_PAYMENT, CULTURAL, LEISURE, EXTRAS }

// mod_transaction/model/Source.java (referenciado por TransactionEntity.source)
enum Source { MANUAL, VOICE, BANK_NOTIFICATION, INVOICE }

// mod_budget/model/BudgetModelType.java
enum BudgetModelType {
    STANDARD_503020, SURVIVAL_702010, ANTI_DEBT_701020,
    SIMPLE_8020, KAKEIBO, FREELANCER_BASE_ZERO
}

// mod_budget/model/EnvelopeLimitType.java
enum EnvelopeLimitType { FIXED, MOVING_AVERAGE }

// mod_ai_coach/model/ChatRole.java
enum ChatRole { USER, ASSISTANT }

// mod_variable_income/model/VariableIncomeDestination.java (referenciado por VariableIncomeEntity.destination)
enum VariableIncomeDestination { EMERGENCY_FUND, BUDGET_5030020 }

// =========================================================
// Entidades (classes mutaveis -- campos + constructor)
// =========================================================

// mod_user/model/UserEntity.java
// Espelho mutavel de UserRow (backend/store.kf): id = numero gerado pelo banco em texto ("1"),
// dinheiro em centavos e valores opcionais como par valor + flag (sem T? primitivo: issue #41).
// name: nome do cadastro (Batch 2); contas anteriores a coluna ficam com "".
// firstName, lastName, age (A2): contas anteriores ficam com "", "" e 0 (0 = idade nao informada).
class UserEntity {
    String id
    String email
    String passwordHash
    Role role
    Long salaryCents
    Bool hasSalary
    Tier tier
    Bool hasVariableIncome
    Long emergencyGoalCents
    Bool hasEmergencyGoal
    BudgetModelType budgetModel
    IncomeType incomeType
    Bool hasDebt
    Long debtCents
    String name
    String firstName
    String lastName
    Int age

    public constructor(String id, String email, String passwordHash, Role role,
            Long salaryCents, Bool hasSalary, Tier tier, Bool hasVariableIncome,
            Long emergencyGoalCents, Bool hasEmergencyGoal, BudgetModelType budgetModel,
            IncomeType incomeType, Bool hasDebt, Long debtCents, String name,
            String firstName, String lastName, Int age) {
        this.id = id
        this.email = email
        this.passwordHash = passwordHash
        this.role = role
        this.salaryCents = salaryCents
        this.hasSalary = hasSalary
        this.tier = tier
        this.hasVariableIncome = hasVariableIncome
        this.emergencyGoalCents = emergencyGoalCents
        this.hasEmergencyGoal = hasEmergencyGoal
        this.budgetModel = budgetModel
        this.incomeType = incomeType
        this.hasDebt = hasDebt
        this.debtCents = debtCents
        this.name = name
        this.firstName = firstName
        this.lastName = lastName
        this.age = age
    }
}

// Borda reais <-> centavos. O duplo roundTo evita 1234.565 * 100 = 123456.49999 (medido no 0.6.3).
Long toCents(Double reais) {
    return math.roundTo(math.roundTo(reais * 100.0, 6), 0) as Long
}

Double centsToReais(Long cents) {
    return cents / 100.0
}

// Salario em reais para os calculos; sem salario informado = 0.0.
Double userSalary(UserEntity user) {
    if (user.hasSalary) {
        return centsToReais(user.salaryCents)
    }
    return 0.0
}

// mod_transaction/model/TransactionEntity.java
// Valor em centavos (Long, PERS-17), espelho de TransactionRow; a API devolve reais (centsToReais).
class TransactionEntity {
    String id
    String description
    Long amountCents
    Category? category
    String currency
    String userId
    Bucket? bucket
    Source source
    String? createdAt
    String? envelopeId

    public constructor(String id, String description, Long amountCents, Category? category,
            String currency, String userId, Bucket? bucket, Source source, String? createdAt,
            String? envelopeId) {
        this.id = id
        this.description = description
        this.amountCents = amountCents
        this.category = category
        this.currency = currency
        this.userId = userId
        this.bucket = bucket
        this.source = source
        this.createdAt = createdAt
        this.envelopeId = envelopeId
    }
}

// mod_budget/model/EnvelopeEntity.java
class EnvelopeEntity {
    String id
    String userId
    String categoryName
    Double limitAmount
    Double currentSpent
    EnvelopeLimitType limitType
    Int movingAverageMonths
    String? createdAt
    // Bucket do modelo do usuario (nome de buildBudgetBuckets, ex.: "Necessidades"); null = derivado da categoria.
    String? bucket

    public constructor(String id, String userId, String categoryName, Double limitAmount,
            Double currentSpent, EnvelopeLimitType limitType, Int movingAverageMonths, String? createdAt,
            String? bucket) {
        this.id = id
        this.userId = userId
        this.categoryName = categoryName
        this.limitAmount = limitAmount
        this.currentSpent = currentSpent
        this.limitType = limitType
        this.movingAverageMonths = movingAverageMonths
        this.createdAt = createdAt
        this.bucket = bucket
    }
}

