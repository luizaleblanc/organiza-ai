// =========================================================
// DTOs de Entrada e API Web (KofLith)
// =========================================================

record LoginRequest(String email, String password)
// Cadastro (A2): firstName, lastName e age (Int) vao para as colunas de mesmo nome, e
// name = firstName + " " + lastName. name sozinho e o corpo legado (isLegacyRegister).
// age em texto ("18") lanca String no json.decode -> 400 "Dados inválidos.".
record RegisterRequest(String? firstName, String? lastName, Int? age, String? name, String email, String password)
// debtAmount em reais (Batch 2). Opcional para manter os clientes antigos: ausente ou null = 0.0
// (Double? no json.decode medido no 0.6.5: ausente/null = null, "abc" lanca String -> 400).
record OnboardingRequest(Double salary, String incomeType, Bool hasDebt, Double? debtAmount)
record VariableIncomeInput(Double amount, String source)
// Sem userId: o dono do envelope vem SEMPRE do token (currentUserId). Um userId enviado no
// corpo por clientes antigos e ignorado pelo json.decode (chaves extras nao quebram).
// bucket opcional (B4): se vier, tem de ser um dos buckets do modelo atual do usuario.
record CreateEnvelopeInput(String categoryName, Double limitAmount, String? bucket)
record ChatMessageRequest(String message)
// Batch 3 (L3/L4): resposta do chat em JSON e historico paginado. role = USER | ASSISTANT;
// messagesLimit = -1 no Premium (igual ao TierStatus). page e 1-based; a pagina 1 traz as mensagens
// mais recentes e cada pagina vem em ordem cronologica (antiga -> nova); hasNext = ha mensagens mais antigas.
record ChatReply(String reply, Int messagesUsed, Int messagesLimit)
record ChatHistoryItem(String role, String content, String createdAt)
record ChatHistoryPage(List<ChatHistoryItem> items, Int page, Int limit, Int offset, Bool hasNext)
// Fase 3: PUT de caixinha (limitType/movingAverageMonths opcionais como no legado), salario, meta de
// reserva e troca de modelo. limitType/model chegam como String (WORKAROUND do enum no json.decode).
record UpdateEnvelopeInput(String categoryName, Double limitAmount, String? limitType, Int? movingAverageMonths)
record SalaryInput(Double salary)
record EmergencyGoalInput(Double goal)
record BudgetModelInput(String model)
record SalaryUpdateResponse(Double salary, String previousModel, String budgetModel, Bool migrated, String description, List<BucketSummaryDTO> buckets)
record EmergencyGoalResponse(Double goal, Bool hasGoal, Double accumulated)

// Corpo de erro das rotas: serializado com json.encode (nunca JSON concatenado a mao)
record ApiError(String error)

// GET /api/users/me (Batch 2). onboardingCompleted = hasSalary && salaryCents > 0: contas antigas
// ficaram com hasSalary = true e salario 0 (o cadastro gravava true ate o F1) e continuam false.
// A2: firstName, lastName e age; age 0 (conta antiga) sai como null.
record MeResponse(String name, String email, Bool onboardingCompleted, String tier, String firstName, String lastName, Int? age)

// Resposta do POST /api/users/onboarding (Batch 2; antes era o texto "MODELO|descricao|nome:pct:valor,").
// suggestedModel e o nome do enum (ASCII); buckets vazio no FREELANCER_BASE_ZERO.
record OnboardingResponse(String suggestedModel, String description, List<BucketSummaryDTO> buckets)

Bool onboardingCompleted(UserEntity user) {
    return user.hasSalary && user.salaryCents > 0
}

// Conta antiga (firstName vazio): os nomes saem do name so na leitura; nada e gravado.
MeResponse meOf(UserEntity user) {
    var first = user.firstName
    var last = user.lastName
    if (first == "") {
        first = firstNameOf(user.name)
        last = lastNameOf(user.name)
    }
    return MeResponse(user.name, user.email, onboardingCompleted(user), user.tier.name(), first, last, publicAge(user.age))
}

// 0 = idade nao informada (conta antiga ou cadastro legado) -> null no JSON.
Int? publicAge(Int age) {
    if (age > 0) {
        return age
    }
    return null
}

// Nome inteiro -> primeiro nome (ate o primeiro espaco) e sobrenome (o resto). Sem espaco = sobrenome "".
String firstNameOf(String fullName) {
    var clean = fullName.trim()
    var space = clean.indexOf(" ")
    if (space < 0) {
        return clean
    }
    return clean.substring(0, space)
}

String lastNameOf(String fullName) {
    var clean = fullName.trim()
    var space = clean.indexOf(" ")
    if (space < 0) {
        return ""
    }
    return clean.substring(space + 1).trim()
}

// =========================================================
// Leitura do corpo (400 em vez de 500). Medido no kof 0.6.3: JSON malformado, corpo vazio, `null`,
// array, texto sobrando no fim, numero em texto ("abc") e campo primitivo ausente (JSN004) lancam
// String, que `catch (String e)` pega; campo String ausente chega como null (o null check funciona).
// null = corpo invalido; a rota responde 400 com invalidBody().
// =========================================================

String invalidBody() {
    return json.encode(ApiError("Dados inválidos."))
}

LoginRequest? decodeLoginRequest(String raw) {
    try {
        var req = json.decode<LoginRequest>(raw)
        if (req.email() == null || req.password() == null) {
            return null
        }
        return req
    } catch (String e) {
        return null
    }
}

// name ausente chega como null; quem barra nome vazio e registerError (400 "Preencha nome, e-mail e senha.").
RegisterRequest? decodeRegisterRequest(String raw) {
    try {
        var req = json.decode<RegisterRequest>(raw)
        if (req.email() == null || req.password() == null) {
            return null
        }
        // Medido no 0.6.6: json.decode<Int?> aceita "18" (texto) e converte. O contrato quer 400, entao
        // o texto e barrado olhando o JSON bruto.
        if (raw.matches("(?s).*\"age\"\s*:\s*\".*")) {
            return null
        }
        return req
    } catch (String e) {
        return null
    }
}

OnboardingRequest? decodeOnboardingRequest(String raw) {
    try {
        var req = json.decode<OnboardingRequest>(raw)
        if (req.incomeType() == null) {
            return null
        }
        return req
    } catch (String e) {
        return null
    }
}

VariableIncomeInput? decodeVariableIncomeInput(String raw) {
    try {
        var req = json.decode<VariableIncomeInput>(raw)
        if (req.source() == null) {
            return null
        }
        return req
    } catch (String e) {
        return null
    }
}

CreateEnvelopeInput? decodeCreateEnvelopeInput(String raw) {
    try {
        var req = json.decode<CreateEnvelopeInput>(raw)
        if (req.categoryName() == null) {
            return null
        }
        return req
    } catch (String e) {
        return null
    }
}

ChatMessageRequest? decodeChatMessageRequest(String raw) {
    try {
        var req = json.decode<ChatMessageRequest>(raw)
        if (req.message() == null) {
            return null
        }
        return req
    } catch (String e) {
        return null
    }
}

// =========================================================
// Regras de negocio da entrada (Batch 2, design §4.3). Rodam depois do decode: null = valido;
// senao, a mensagem do 400 (a rota responde json.encode(ApiError(msg))). Nunca gravam nada.
// =========================================================

// Limite das colunas VARCHAR(255) do ORM: texto maior faria o banco recusar a gravacao (500).
Int maxTextLength() {
    return 255
}

Bool isBlank(String? text) {
    if (text != null) {
        return text.trim() == ""
    }
    return true
}

// Formato minimo: um unico @, com texto antes e depois, sem espacos. A confirmacao real do
// e-mail fica para o "esqueci a senha" (provedor de e-mail, secao 6 do MVP1_HOMOLOGACAO.md).
Bool isEmailLike(String email) {
    var at = email.indexOf("@")
    if (at <= 0 || at != email.lastIndexOf("@")) {
        return false
    }
    return at < email.length() - 1 && !email.contains(" ")
}

// Idade minima do cadastro (decisao da usuaria).
Int MIN_AGE() {
    return 18
}

Int maxAge() {
    return 120
}

Int maxNameLength() {
    return 60
}

Int minPasswordLength() {
    return 8
}

Int maxPasswordLength() {
    return 128
}

// Texto opcional -> "" quando ausente, sem espacos nas pontas.
String trimmedOrEmpty(String? text) {
    if (text != null) {
        return text.trim()
    }
    return ""
}

// Corpo legado {name, email, password}: nenhum dos campos novos veio. Remocao futura: quando nenhum
// cliente mandar mais o corpo antigo (o frontend passa a mandar firstName/lastName/age), apague este
// ramo, o campo name de RegisterRequest e registerLegacyError; a falta dos campos novos passa a dar
// "Preencha nome, sobrenome, idade, e-mail e senha.".
Bool isLegacyRegister(RegisterRequest req) {
    return req.firstName() == null && req.lastName() == null && req.age() == null
}

// Primeiro nome do cadastro (P8 da senha e coluna firstName). Legado: o name ate o primeiro espaco.
String registerFirstName(RegisterRequest req) {
    if (isLegacyRegister(req)) {
        return firstNameOf(trimmedOrEmpty(req.name()))
    }
    return trimmedOrEmpty(req.firstName())
}

String registerLastName(RegisterRequest req) {
    if (isLegacyRegister(req)) {
        return lastNameOf(trimmedOrEmpty(req.name()))
    }
    return trimmedOrEmpty(req.lastName())
}

// Legado = 0 (idade nao informada).
Int registerAge(RegisterRequest req) {
    var age = req.age()
    if (age != null) {
        return age
    }
    return 0
}

// name gravado: legado = o name do corpo; novo = firstName + " " + lastName.
String registerFullName(RegisterRequest req) {
    if (isLegacyRegister(req)) {
        return trimmedOrEmpty(req.name())
    }
    return registerFirstName(req) + " " + registerLastName(req)
}

// Letras (com acento), espaco, hifen e apostrofo (' ou ’).
Bool isValidPersonName(String value) {
    return value.matches("[\\p{L}\\p{M} '’-]+")
}

String? personNameError(String value, String label) {
    if (value.length() < 1 || value.length() > maxNameLength()) {
        return "O " + label + " precisa ter de 1 a 60 caracteres."
    }
    if (!isValidPersonName(value)) {
        return "O " + label + " só pode ter letras, espaço, hífen e apóstrofo."
    }
    return null
}

// P1 a P6 (so a senha). null = cumpre.
String? passwordShapeError(String password) {
    if (password.length() < minPasswordLength()) {
        return "A senha precisa ter pelo menos 8 caracteres."
    }
    if (password.length() > maxPasswordLength()) {
        return "A senha pode ter no máximo 128 caracteres."
    }
    if (!password.matches("(?s).*\\p{Lu}.*")) {
        return "A senha precisa ter pelo menos uma letra maiúscula."
    }
    if (!password.matches("(?s).*\\p{Ll}.*")) {
        return "A senha precisa ter pelo menos uma letra minúscula."
    }
    if (!password.matches("(?s).*\\p{Nd}.*")) {
        return "A senha precisa ter pelo menos um número."
    }
    if (!password.matches("(?s).*[^\\p{L}\\p{Nd}].*")) {
        return "A senha precisa ter pelo menos um caractere especial."
    }
    return null
}

// P7 e P8, sem diferenciar maiusculas: nem o e-mail inteiro, nem a parte antes do @ (com 3 ou mais
// caracteres), nem o primeiro nome (com 3 ou mais caracteres).
String? passwordIdentityError(String password, String email, String firstName) {
    // Regra removida a pedido da usuária (12/11/2026): a senha pode conter nome e e-mail.
    return null
}

String? passwordPolicyError(String password, String email, String firstName) {
    var shape = passwordShapeError(password)
    if (shape != null) {
        return shape
    }
    return passwordIdentityError(password, email, firstName)
}

String? emailError(String email) {
    if (email.length() > maxTextLength() || !isEmailLike(email)) {
        return "Digite um e-mail válido."
    }
    return null
}

// Corpo legado: nome, e-mail e a politica de senha (sem idade e sem a regra de caracteres do nome).
String? registerLegacyError(RegisterRequest req) {
    if (isBlank(req.name()) || isBlank(req.email()) || isBlank(req.password())) {
        return "Preencha nome, sobrenome, idade, e-mail e senha."
    }
    if (trimmedOrEmpty(req.name()).length() > maxTextLength()) {
        return "Dados inválidos."
    }
    var mail = emailError(req.email().trim())
    if (mail != null) {
        return mail
    }
    return passwordPolicyError(req.password(), req.email(), registerFirstName(req))
}

// Ordem: campo vazio, nome, sobrenome, idade, e-mail, senha (P1 a P8). A primeira regra violada vence.
String? registerError(RegisterRequest req) {
    if (isLegacyRegister(req)) {
        return registerLegacyError(req)
    }
    if (isBlank(req.firstName()) || isBlank(req.lastName()) || req.age() == null || isBlank(req.email()) || isBlank(req.password())) {
        return "Preencha nome, sobrenome, idade, e-mail e senha."
    }
    var first = personNameError(registerFirstName(req), "nome")
    if (first != null) {
        return first
    }
    var last = personNameError(registerLastName(req), "sobrenome")
    if (last != null) {
        return last
    }
    var age = registerAge(req)
    if (age < MIN_AGE()) {
        return "Você precisa ter pelo menos 18 anos para criar uma conta."
    }
    if (age > maxAge()) {
        return "Digite uma idade válida."
    }
    var mail = emailError(req.email().trim())
    if (mail != null) {
        return mail
    }
    return passwordPolicyError(req.password(), req.email(), registerFirstName(req))
}

String? loginError(LoginRequest req) {
    if (isBlank(req.email()) || isBlank(req.password())) {
        return "Preencha e-mail e senha."
    }
    return null
}

// Valor da divida em reais; ausente = 0.0 (so conta quando hasDebt = true).
Double debtAmountOf(OnboardingRequest req) {
    var amount = req.debtAmount()
    if (amount == null) {
        return 0.0
    }
    return amount
}

String? onboardingError(OnboardingRequest req) {
    if (req.salary() <= 0.0) {
        return "O salário deve ser maior que zero."
    }
    var debt = debtAmountOf(req)
    if (debt < 0.0 || (req.hasDebt() && debt <= 0.0)) {
        return "O valor da dívida deve ser maior que zero."
    }
    if (req.incomeType() != "FIXED" && req.incomeType() != "VARIABLE") {
        return "Tipo de renda inválido."
    }
    return null
}

// =========================================================
// Fase 3: corpo das rotas novas (null = 400) e regras (null = valido).
// =========================================================

UpdateEnvelopeInput? decodeUpdateEnvelopeInput(String raw) {
    try {
        var req = json.decode<UpdateEnvelopeInput>(raw)
        if (req.categoryName() == null) {
            return null
        }
        return req
    } catch (String e) {
        return null
    }
}

String? envelopeError(String categoryName, Double limitAmount, String? limitType) {
    if (isBlank(categoryName) || categoryName.length() > maxTextLength()) {
        return "Nome da caixinha inválido."
    }
    if (limitAmount < 0.0) {
        return "O limite da caixinha não pode ser negativo."
    }
    if (limitType != null && EnvelopeLimitType.valueOf(limitType) == null) {
        return "Tipo de limite inválido: " + limitType
    }
    return null
}

SalaryInput? decodeSalaryInput(String raw) {
    try {
        return json.decode<SalaryInput>(raw)
    } catch (String e) {
        return null
    }
}

EmergencyGoalInput? decodeEmergencyGoalInput(String raw) {
    try {
        return json.decode<EmergencyGoalInput>(raw)
    } catch (String e) {
        return null
    }
}

BudgetModelInput? decodeBudgetModelInput(String raw) {
    try {
        var req = json.decode<BudgetModelInput>(raw)
        if (req.model() == null) {
            return null
        }
        return req
    } catch (String e) {
        return null
    }
}
