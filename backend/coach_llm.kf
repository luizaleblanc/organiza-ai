// backend/coach_llm.kf
// Coach com OpenAI (gpt-4o-mini, decisao de 16/10), porte do VoiceCommandController do legado:
// prompt de sistema com data (archive/.../prompts/system-message.st), memoria das ultimas 20 mensagens do
// banco e tool calling MANUAL (o Spring AI fazia o laco; aqui: tool_calls -> funcoes Kof -> nova chamada).
// HTTP por backend/outbound.kf (certificado validado). Sem OPENAI_API_KEY, o chat continua com a resposta
// fixa do pulso (decisao de 19/10).
//   OPENAI_API_KEY      chave (segredo; so vai para o cabecalho Authorization, nunca para log)
//   OPENAI_BASE_URL     opcional; padrao https://api.openai.com/v1 (o teste aponta para o mock local)
//   OPENAI_MODEL        opcional; padrao gpt-4o-mini
//   OPENAI_TIMEOUT_MS   opcional; padrao 30000 (por chamada)

// =========================================================
// Configuracao
// =========================================================

String openAiBaseUrl() {
    var url = configText("OPENAI_BASE_URL")
    if (url != null) {
        return url
    }
    return "https://api.openai.com/v1"
}

String openAiModel() {
    var model = configText("OPENAI_MODEL")
    if (model != null) {
        return model
    }
    return "gpt-4o-mini"
}

Int openAiTimeoutMs() {
    var raw = configText("OPENAI_TIMEOUT_MS")
    if (raw != null && strings.isNumeric(raw)) {
        return raw.toInt()
    }
    return 30000
}

Bool llmConfigured() {
    if (configText("OPENAI_API_KEY") != null) {
        return outboundUrlAllowed(openAiBaseUrl() + "/chat/completions")
    }
    return false
}

String llmStatus() {
    if (llmConfigured()) {
        return "coach com OpenAI ligado (modelo " + openAiModel() + ")"
    }
    if (configText("OPENAI_API_KEY") != null) {
        return "coach com OpenAI desligado: OPENAI_BASE_URL precisa ser https:// (http local so com KOF_OUTBOUND_ALLOW_LOCAL_HTTP=true)"
    }
    return "coach com OpenAI desligado: sem OPENAI_API_KEY (resposta fixa com o pulso)"
}

// =========================================================
// Formato da API (Chat Completions)
// =========================================================

record ChatTextMessage(String role, String content)
record ChatToolResultMessage(String role, String tool_call_id, String content)
record ChatToolFunction(String name, String arguments)
record ChatToolCall(String id, String type, ChatToolFunction function)
record ChatAssistantMessage(String role, String? content, List<ChatToolCall>? tool_calls)
record ChatChoice(Int index, ChatAssistantMessage message, String? finish_reason)
record ChatCompletion(List<ChatChoice> choices)

record ToolProperty(String type, String description)
record ToolParameters(String type, Map<String, ToolProperty> properties, List<String> required)
record ToolFunctionDef(String name, String description, ToolParameters parameters)
record ToolDef(String type, ToolFunctionDef function)

ToolDef toolDef(String name, String description, Map<String, ToolProperty> props, List<String> required) {
    return ToolDef("function", ToolFunctionDef(name, description, ToolParameters("object", props, required)))
}

String categoryHelp() {
    return "Uma de: GROCERIES, LEISURE, FOOD, PHARMA, HEALTH, AUTO, TRANSPORT, HOUSING, EDUCATION, SHOPPING, SUBSCRIPTIONS, OTHER"
}

// As 8 tools do legado (VoiceCommandController.defaultToolNames), com as descricoes dos @Description.
// answerKakeiboReflection recebe as 4 respostas num texto separado por " | " (o legado usava List<String>;
// o schema aqui e montado com records e um so tipo de propriedade).
List<ToolDef> coachTools() {
    var none: Map<String, ToolProperty> = mapOf()
    var noRequired: List<String> = listOf()

    var expense: Map<String, ToolProperty> = mapOf()
    expense.put("amount", ToolProperty("number", "Valor em reais, maior que zero"))
    expense.put("category", ToolProperty("string", categoryHelp()))
    expense.put("description", ToolProperty("string", "Descricao curta do gasto"))
    expense.put("caixinha", ToolProperty("string", "Opcional: nome da caixinha do usuario, quando ele citar uma (ex: Viagem). Passe o nome como ele disse."))

    var byCategory: Map<String, ToolProperty> = mapOf()
    byCategory.put("category", ToolProperty("string", categoryHelp()))

    var income: Map<String, ToolProperty> = mapOf()
    income.put("amount", ToolProperty("number", "Valor em reais, maior que zero"))
    income.put("source", ToolProperty("string", "Origem da renda (freela, show, mentoria, salario...)"))

    var envName: Map<String, ToolProperty> = mapOf()
    envName.put("name", ToolProperty("string", "Nome da caixinha como o usuário disse (em português)"))

    var envCreate: Map<String, ToolProperty> = mapOf()
    envCreate.put("name", ToolProperty("string", "Nome da nova caixinha, em português"))
    envCreate.put("limit", ToolProperty("number", "Limite mensal em reais dito pelo usuário. Se ele não disse, não chame a tool: pergunte."))

    var envRename: Map<String, ToolProperty> = mapOf()
    envRename.put("name", ToolProperty("string", "Nome atual da caixinha"))
    envRename.put("newName", ToolProperty("string", "Novo nome, em português"))

    var envLimit: Map<String, ToolProperty> = mapOf()
    envLimit.put("name", ToolProperty("string", "Nome da caixinha"))
    envLimit.put("limit", ToolProperty("number", "Novo limite mensal em reais dito pelo usuário"))

    var envDelete: Map<String, ToolProperty> = mapOf()
    envDelete.put("name", ToolProperty("string", "Nome da caixinha"))
    envDelete.put("confirmed", ToolProperty("string", "sim SOMENTE depois que o usuário confirmou explicitamente que quer apagar; senão nao"))

    var kakeibo: Map<String, ToolProperty> = mapOf()
    kakeibo.put("answers", ToolProperty("string", "As 4 respostas da reflexao, na ordem, separadas por ' | '"))

    return listOf(
        toolDef("persistTransaction", "Cria e salva uma nova transação financeira (gasto) do usuário", expense, listOf("amount", "category", "description")),
        toolDef("listTransactionsByCategory", "Busca e lista as transações do usuário filtradas por uma categoria", byCategory, listOf("category")),
        toolDef("getTotalByCategory", "Calcula e retorna o valor total gasto em uma categoria", byCategory, listOf("category")),
        toolDef("registerIncome", "Registra uma renda do usuário, fixa ou variável, e direciona o valor para a reserva de emergência ou para o orçamento", income, listOf("amount", "source")),
        toolDef("getDailyPulse", "Calcula quanto o usuário ainda pode gastar por dia até o fim do mês", none, noRequired),
        toolDef("getBalance", "Retorna o resumo dos buckets do modelo de orçamento: planejado, gasto e restante", none, noRequired),
        toolDef("suggestModelChange", "Verifica se o modelo de orçamento atual ainda faz sentido", none, noRequired),
        toolDef("createEnvelope", "Cria uma caixinha do usuário com o limite mensal informado", envCreate, listOf("name", "limit")),
        toolDef("renameEnvelope", "Renomeia uma caixinha do usuário (caixinhas automáticas não podem ser renomeadas)", envRename, listOf("name", "newName")),
        toolDef("setEnvelopeLimit", "Altera o limite mensal de uma caixinha do usuário", envLimit, listOf("name", "limit")),
        toolDef("deleteEnvelope", "Apaga uma caixinha do usuário; sem confirmed=sim só devolve a pergunta de confirmação", envDelete, listOf("name", "confirmed")),
        toolDef("getEnvelopeStatus", "Consulta quanto foi gasto, o limite, quanto sobra e o status de uma caixinha neste mês", envName, listOf("name")),
        toolDef("answerKakeiboReflection", "Registra as 4 respostas da reflexão semanal do Kakeibo", kakeibo, listOf("answers"))
    )
}

// =========================================================
// Prompt de sistema (system-message.st do legado, com os nomes das tools daqui)
// =========================================================

String weekdayName(Int dow) {
    var names = listOf("segunda-feira", "terça-feira", "quarta-feira", "quinta-feira", "sexta-feira", "sábado", "domingo")
    if (dow >= 1 && dow <= 7) {
        return names.get(dow - 1)
    }
    return ""
}

// As 4 perguntas do Kakeibo (KakeiboReflectionService.QUESTIONS do legado).
List<String> kakeiboQuestions() {
    return listOf(
        "1) Quais gastos essenciais você conseguiu manter dentro do planejado esta semana?",
        "2) O que você gastou em cultura e lazer sem culpa ou sem planejar?",
        "3) Houve algum gasto extra que você percebeu que não era necessário?",
        "4) Qual ajuste simples você vai fazer na próxima semana para melhorar seu controle?"
    )
}

String envelopeNamesText(String userId) {
    var names = findEnvelopesByUserId(userId).map((e: EnvelopeEntity) -> e.categoryName)
    if (names.isEmpty()) {
        return "o usuário ainda não tem caixinhas."
    }
    var text = ""
    for (var n in names) {
        if (text != "") {
            text = text + ", "
        }
        text = text + n
    }
    return text
}

// Comportamento da IA por modelo (secao 2 de docs/AI_FINANCIAL_COACH_GUIDELINE.md).
String modelBehaviorForPrompt(BudgetModelType model) {
    return switch (model) {
        case ANTI_DEBT_701020 -> "Priorize a quitação da dívida acima de qualquer outra sugestão, sugira renegociar e oriente a não usar o rotativo do cartão nem o cheque especial."
        case SURVIVAL_702010 -> "Parabenize o usuário por guardar mesmo valores pequenos e incentive o foco no essencial; se ele tiver dívida, oriente a renegociar."
        case SIMPLE_8020 -> "Mantenha tudo simples: um teto único de 80% para viver e 20% guardados automaticamente, sem rastrear subcategorias."
        case KAKEIBO -> "Agrupe os gastos em Essencial, Lazer, Cultura e Extras e conduza a reflexão semanal com as 4 perguntas."
        case STANDARD_503020 -> "Mostre como os compromissos fixos cabem nos 50% de necessidades, mantendo o lazer consciente nos 30% e 20% para o futuro."
    }
}

String categoryNamesForPrompt() {
    var text = ""
    for (var c in Category.values()) {
        if (text != "") {
            text = text + ", "
        }
        text = text + c.name() + " = " + categoryLabel(c)
    }
    return text
}

// =========================================================
// Saida ao usuario: nunca expor codigos internos (secao 1.2 / regra 10 do prompt)
// =========================================================

Bool isWordChar(String ch) {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_".contains(ch)
}

// Troca `word` por `repl` so quando aparece como palavra inteira (case-sensitive).
String replaceWord(String text, String word, String repl) {
    var out = ""
    var rest = text
    var idx = rest.indexOf(word)
    while (idx >= 0) {
        var end = idx + word.length()
        var beforeOk = idx == 0 || !isWordChar(rest.substring(idx - 1, idx))
        var afterOk = end >= rest.length() || !isWordChar(rest.substring(end, end + 1))
        if (beforeOk && afterOk) {
            out = out + rest.substring(0, idx) + repl
        } else {
            out = out + rest.substring(0, end)
        }
        rest = rest.substring(end)
        idx = rest.indexOf(word)
    }
    return out + rest
}

String sanitizeCoachReply(String text) {
    var out = text
    for (var m in BudgetModelType.values()) {
        out = replaceWord(out, m.name(), coachModelLabel(m))
    }
    for (var c in Category.values()) {
        out = replaceWord(out, c.name(), categoryLabel(c))
    }
    out = replaceWord(out, "NEEDS", "Necessidades")
    out = replaceWord(out, "WANTS", "Desejos")
    out = replaceWord(out, "SAVINGS", "Poupança")
    out = replaceWord(out, "DEBT_PAYMENT", "Quitação de Dívida")
    out = replaceWord(out, "CULTURAL", "Cultura")
    out = replaceWord(out, "EXTRAS", "Extras")
    out = replaceWord(out, "EMERGENCY_FUND", "reserva de emergência")
    return out
}

String coachSystemPrompt(UserEntity user, Bool kakeiboPending) {
    var today = localTodayIso()
    var dow = time.dayOfWeek(today.substring(0, 4).toInt(), today.substring(5, 7).toInt(), today.substring(8, 10).toInt())
    var p = "Data atual: " + today + ". Dia da semana: " + weekdayName(dow) + ".\n\n" +
        "Você é o coach financeiro do Organiza. Regras obrigatórias:\n\n" +
        "REGRAS DE COMPORTAMENTO:\n" +
        "1. Responda SEMPRE em português brasileiro.\n" +
        "2. NUNCA invente valores. Se não souber um saldo ou gasto, use a tool getDailyPulse para consultar.\n" +
        "3. NUNCA sugira investimentos específicos (ações, fundos, criptomoedas). Diga \"guardar\" ou \"reservar\".\n" +
        "4. NUNCA julgue o usuário. Oriente com base nos dados reais.\n" +
        "5. Se o usuário perguntar algo que você não tem dados para responder, diga \"não tenho essa informação ainda\" e sugira registrar o gasto.\n" +
        "6. NUNCA use emojis e NUNCA use jargões técnicos; fale sempre de forma sucinta, clara e natural.\n" +
        "7. Em extratos e faturas, NUNCA classifique pagamentos de fatura como moradia ou contas fixas sem conhecer os itens da fatura.\n" +
        "8. NUNCA presuma que transferências Pix para pessoas físicas são despesas sem perguntar antes ao usuário, e SEMPRE peça confirmação dos valores antes de distribuir nas regras 70/20/10 ou 50/30/20.\n\n" +
        "REGRAS DE REGISTRO:\n" +
        "6. Quando o usuário informar um gasto com valor e categoria ou caixinha (por texto ou voz, ex: 'gastei 45 no uber'), chame a tool persistTransaction IMEDIATAMENTE para categorizar e atualizar as caixinhas antes de responder; depois confirme valor, categoria e caixinha. Nunca peça confirmação prévia se o valor e o gasto já foram informados.\n" +
        "7. Ao registrar renda variável, pergunte a origem. Ex: \"De onde veio essa renda? Freela, show, mentoria?\"\n" +
        "8. Valores monetários SEMPRE no formato R$ X.XXX,XX. Use os campos pulseText e economicPulseText da tool getDailyPulse exatamente como vierem; nunca calcule, arredonde nem estime valores por conta própria.\n" +
        "9. Pulso Diário é o quanto dá para gastar por dia até o fim do mês; Pulso Econômico é a sugestão para economizar (75% do diário, já calculado pela tool). Depois de registrar gastos, responda no formato: \"Beleza! Seus gastos (alimentação, mercado) foram registrados. Seu pulso atual para terminar o mês no azul é de R$ X/dia. Se quiser dar uma economizada, seu pulso é de R$ Y/dia.\"\n" +
        "10. NUNCA mostre ao usuário códigos internos (nomes de categoria em inglês, nomes de modelo, nomes de tools ou campos). Os códigos servem só para os argumentos das tools; para o usuário, diga o nome em português: " + categoryNamesForPrompt() + ".\n" +
        "11. Ao registrar um gasto, confirme com o valor e a categoria em português que a tool persistTransaction devolver (campos valor e categoria). Se ela devolver caixinhaCriada, diga ao usuário em linguagem simples que a caixinha foi criada.\n" +
        "12a. Pedidos de caixinha (criar, renomear, mudar limite, apagar, consultar saldo) usam as tools createEnvelope, renameEnvelope, setEnvelopeLimit, deleteEnvelope e getEnvelopeStatus. Se faltar o nome da caixinha ou o valor, pergunte antes de chamar a tool. Para apagar, chame deleteEnvelope com confirmed=nao, mostre a pergunta de confirmação e só chame com confirmed=sim depois de um sim explícito. Responda de forma curta repetindo o campo resposta da tool.\n" +
        "12. Status de caixinha: abaixo de 80% do limite é Em dia; de 80% a 100% é Alerta; acima de 100% é Estourada.\n\n" +
        "REGRAS DE MODELO:\n" +
        "13. O modelo de orçamento do usuário é o " + coachModelLabel(user.budgetModel) + " (" + describeBudgetModel(user.budgetModel) + "). Respeite os percentuais dele. " + modelBehaviorForPrompt(user.budgetModel) + "\n" +
        "14. Se o modelo for Kakeibo e ainda não houver reflexão semanal desta semana, faça as 4 perguntas em sequência e, após o usuário responder, chame a tool answerKakeiboReflection com as 4 respostas na ordem correta.\n" +
        "15. Se detectar que os gastos essenciais passaram do percentual do modelo por 3 meses seguidos, sugira trocar de modelo (tool suggestModelChange).\n\n" +
        "REGRAS DE CATEGORIZAÇÃO:\n" +
        "Para cada transação, use OBRIGATORIAMENTE um destes valores exatos: GROCERIES (mercado, feira, padaria), LEISURE (cinema, show, viagem, passeio, ingresso), " +
        "FOOD (restaurante, lanche, delivery, café, almoço, jantar fora), PHARMA (farmácia, remédio), HEALTH (consulta, exame, dentista, plano de saúde, psicólogo), " +
        "AUTO (combustível, estacionamento, pedágio, mecânico, seguro do carro), TRANSPORT (uber, táxi, ônibus, metrô, passagem), HOUSING (aluguel, condomínio, luz, água, gás, internet de casa, IPTU), " +
        "EDUCATION (curso, faculdade, escola, material escolar), SHOPPING (roupa, calçado, eletrônico, presente), SUBSCRIPTIONS (netflix, spotify, software, assinatura mensal), " +
        "OTHER (só quando nada acima se encaixa). Escolha a categoria mais próxima pelo significado; nunca use GROCERIES como padrão de segurança.\n\n" +
        "CAIXINHAS DO USUÁRIO: " + envelopeNamesText(user.id) + "\n" +
        "Se o usuário citar uma caixinha ao registrar um gasto (ex: \"gastei 40 na caixinha Viagem\"), passe o nome dela no argumento caixinha da tool persistTransaction, junto com a categoria que melhor descreve o gasto. Se a caixinha não existir, a tool devolve um erro com a lista: pergunte ao usuário qual ele quis dizer, sem registrar o gasto.\n"
    if (kakeiboPending) {
        p = p + "\nO usuário está no KAKEIBO e ainda não respondeu a reflexão desta semana. As 4 perguntas:"
        for (var q in kakeiboQuestions()) {
            p = p + " " + q
        }
        p = p + "\n"
    }
    return p
}

// =========================================================
// Execucao das tools (sempre no usuario do token)
// =========================================================

record ExpenseArgs(Double? amount, String? category, String? description, String? caixinha)
record CategoryArgs(String? category)
record IncomeArgs(Double? amount, String? source)
record KakeiboArgs(String? answers)
record EnvelopeArgs(String? name, String? newName, Double? limit, String? confirmed)
record EnvelopeToolReply(String resposta)

String envelopeToolReply(String text) {
    return json.encode(EnvelopeToolReply(text))
}

Long limitArgCents(Double? limit) {
    var none: Long = -1
    if (limit == null) {
        return none
    }
    if (limit < 0.0) {
        return none
    }
    return toCents(limit)
}
record ToolError(String error)
// Resultado do registro para o modelo: categoria ja em portugues e aviso de caixinha criada.
record ToolExpenseResult(String id, String description, String categoria, String valor, String? caixinhaCriada)

String expenseToolResult(TransactionOutput saved, Category category, Bool boxExisted) {
    if (boxExisted) {
        return json.encode(ToolExpenseResult(saved.id(), saved.description(), categoryLabel(category), formatBrl(toCents(saved.value())), null))
    }
    return json.encode(ToolExpenseResult(saved.id(), saved.description(), categoryLabel(category), formatBrl(toCents(saved.value())), "Criei a caixinha " + categoryLabel(category) + " para esse gasto."))
}

String toolError(String message) {
    return json.encode(ToolError(message))
}

Category? parseCategory(String? raw) {
    if (raw == null) {
        return null
    }
    return Category.valueOf(raw.trim().toUpperCase())
}

String runCoachToolWithSource(String userId, String name, String arguments, Source chatSource) {
    try {
        if (name == "getDailyPulse") {
            return json.encode(calculateDailyPulse(userId, daysRemainingInMonth(), monthStartIso()))
        }
        if (name == "getBalance") {
            return json.encode(calculateBalance(userId, monthStartIso()))
        }
        if (name == "suggestModelChange") {
            return json.encode(suggestModelChange(userId))
        }
        if (name == "persistTransaction") {
            var a = json.decode<ExpenseArgs>(arguments)
            var amount = a.amount()
            var category = parseCategory(a.category())
            var boxName = a.caixinha()
            if (boxName != null && boxName.trim() != "") {
                var box = findEnvelopeForChat(userId, boxName)
                if (box == null) {
                    return toolError("Não achei a caixinha " + boxName.trim() + ". Suas caixinhas: " + envelopeNamesText(userId) + ".")
                }
                if (amount == null) {
                    return toolError("amount é obrigatório")
                }
                var boxCategory = Category.OTHER
                if (category != null) {
                    boxCategory = category
                } else {
                    var inferredCat = resolveCategoryForEnvelopeName(box.categoryName)
                    if (inferredCat != null) {
                        boxCategory = inferredCat
                    }
                }
                var boxDescription = box.categoryName
                var boxGiven = a.description()
                if (boxGiven != null && boxGiven.trim() != "") {
                    boxDescription = boxGiven.trim()
                }
                var boxSaved = persistTransactionWithSource(boxDescription, amount, boxCategory, "BRL", box.id, userId, chatSource)
                notifyEnvelopeCrossing(userId, box.id, toCents(amount))
                return expenseToolResult(boxSaved.transaction, boxCategory, !boxSaved.envelopeCreated)
            }
            if (amount != null) {
                if (category != null) {
                    var description = category.name()
                    var given = a.description()
                    if (given != null && given.trim() != "") {
                        description = given.trim()
                    }
                    var res = persistTransactionWithSource(description, amount, category, "BRL", null, userId, chatSource)
                    return expenseToolResult(res.transaction, category, !res.envelopeCreated)
                }
            }
            return toolError("amount e category (" + categoryHelp() + ") sao obrigatorios")
        }
        if (name == "listTransactionsByCategory" || name == "getTotalByCategory") {
            var c = parseCategory(json.decode<CategoryArgs>(arguments).category())
            if (c == null) {
                return toolError("category invalida: " + categoryHelp())
            }
            if (name == "getTotalByCategory") {
                return json.encode(GetTotalByCategoryOutput(getTotalByCategory(c, userId)))
            }
            return json.encode(listTransactionsByCategory(c, userId).take(30))
        }
        if (name == "registerIncome") {
            var i = json.decode<IncomeArgs>(arguments)
            var amount = i.amount()
            var source = i.source()
            if (amount != null) {
                if (source != null && amount > 0.0) {
                    return json.encode(registerUserIncome(userId, amount, source))
                }
            }
            return toolError("amount (> 0) e source sao obrigatorios")
        }
        if (name == "createEnvelope" || name == "renameEnvelope" || name == "setEnvelopeLimit" || name == "deleteEnvelope" || name == "getEnvelopeStatus") {
            var ea = json.decode<EnvelopeArgs>(arguments)
            var boxArg = ""
            var rawBox = ea.name()
            if (rawBox != null) {
                boxArg = rawBox.trim()
            }
            if (boxArg == "") {
                return toolError("name é obrigatório: pergunte ao usuário qual caixinha")
            }
            if (name == "createEnvelope") {
                return envelopeToolReply(chatCreateEnvelope(userId, boxArg, limitArgCents(ea.limit())))
            }
            if (name == "renameEnvelope") {
                var nn = ""
                var rawNew = ea.newName()
                if (rawNew != null) {
                    nn = rawNew.trim()
                }
                if (nn == "") {
                    return toolError("newName é obrigatório: pergunte ao usuário o novo nome")
                }
                return envelopeToolReply(chatRenameEnvelope(userId, boxArg, nn))
            }
            if (name == "setEnvelopeLimit") {
                return envelopeToolReply(chatSetEnvelopeLimit(userId, boxArg, limitArgCents(ea.limit())))
            }
            if (name == "deleteEnvelope") {
                var ok = false
                var conf = ea.confirmed()
                if (conf != null) {
                    ok = conf.trim().toLowerCase() == "sim"
                }
                return envelopeToolReply(chatDeleteEnvelope(userId, boxArg, ok))
            }
            return envelopeToolReply(chatEnvelopeStatus(userId, boxArg))
        }
        if (name == "answerKakeiboReflection") {
            var raw = json.decode<KakeiboArgs>(arguments).answers()
            if (raw == null) {
                return toolError("answers e obrigatorio")
            }
            var answers: List<String> = listOf()
            for (var part in raw.split("\\|")) {
                answers.add(part.trim())
            }
            var weekStart = time.startOf(localTodayIso(), "week")
            var saved = recordKakeiboReflection(userId, weekStart, answers)
            return "{\"saved\":true,\"weekStart\":\"" + saved.weekStart + "\"}"
        }
        return toolError("tool desconhecida: " + name)
    } catch (String e) {
        return toolError(e)
    } catch (Exception e) {
        return toolError("dados invalidos para " + name)
    }
}

String runCoachTool(String userId, String name, String arguments) {
    return runCoachToolWithSource(userId, name, arguments, Source.MANUAL)
}

// =========================================================
// Laco de conversa
// =========================================================

// Ultimas 20 mensagens do usuario (legado: findTop20ByUserIdOrderByCreatedAtDesc), em ordem cronologica.
List<String> chatHistoryJson(String userId) {
    var out: List<String> = listOf()
    for (var m in findRecentChatMessages(userId, 20)) {
        var role = "user"
        if (m.role == ChatRole.ASSISTANT) {
            role = "assistant"
        }
        out.add(json.encode(ChatTextMessage(role, m.content)))
    }
    return out
}

// Primeira mensagem da resposta; formato inesperado (sem choices) = throw "coach indisponivel".
ChatAssistantMessage firstChoiceMessage(String body) {
    try {
        var completion = json.decode<ChatCompletion>(body)
        var choices = completion.choices()
        if (choices != null && !choices.isEmpty()) {
            return choices.get(0).message()
        }
    } catch (String e) {
        log.warn("coach: resposta da OpenAI fora do formato esperado")
    } catch (Exception e) {
        log.warn("coach: resposta da OpenAI fora do formato esperado")
    }
    throw "coach indisponivel"
}

String jsonArray(List<String> items) {
    var text = ""
    for (var item in items) {
        if (text != "") {
            text = text + ","
        }
        text = text + item
    }
    return "[" + text + "]"
}

// Teto do texto gravado no historico (a coluna aguenta mais; a resposta do provedor nao tem limite fixo).
String clipForHistory(String text) {
    if (text.length() > 8000) {
        return text.substring(0, 8000)
    }
    return text
}

// Resposta final do coach, ou throw "coach indisponivel" (rede, timeout, 4xx/5xx, resposta invalida).
// Nunca registra a chave nem o corpo da resposta no log; so o status.
String askCoachWithSource(UserEntity user, String userText, Source chatSource) {
    var weekStart = time.startOf(localTodayIso(), "week")
    var messages: List<String> = listOf()
    messages.add(json.encode(ChatTextMessage("system", coachSystemPrompt(user, shouldAskKakeiboReflection(user.id, weekStart)))))
    for (var h in chatHistoryJson(user.id)) {
        messages.add(h)
    }
    var promptUserText = userText
    if (chatSource == Source.VOICE) {
        promptUserText = "[Mensagem enviada por VOZ: se houver gasto com valor claro, chame persistTransaction IMEDIATAMENTE categorizando na(s) caixinha(s) certa(s) sem pedir confirmação prévia.]\n" + userText
    }
    messages.add(json.encode(ChatTextMessage("user", promptUserText)))
    var tools = json.encode(coachTools())
    var headers = jsonBearerHeaders(secrets.secret("OPENAI_API_KEY").reveal())
    var url = openAiBaseUrl() + "/chat/completions"

    var round = 0
    while (round < 5) {
        round = round + 1
        var body = "{\"model\":" + json.encode(openAiModel()) + ",\"messages\":" + jsonArray(messages) + ",\"tools\":" + tools + ",\"temperature\":0.3}"
        var resp = outboundPost(url, body, headers, openAiTimeoutMs())
        if (resp.status != 200) {
            if (resp.status == 0) {
                log.warn("coach: OpenAI sem resposta (" + resp.failure + ")")
            } else {
                log.warn("coach: OpenAI respondeu status " + resp.status)
            }
            throw "coach indisponivel"
        }
        var message = firstChoiceMessage(resp.body)
        var calls = message.tool_calls()
        if (calls != null && !calls.isEmpty()) {
            messages.add(json.encode(message))
            for (var call in calls) {
                messages.add(json.encode(ChatToolResultMessage("tool", call.id(), runCoachToolWithSource(user.id, call.function().name(), call.function().arguments(), chatSource))))
            }
        } else {
            var content = message.content()
            if (content != null && content.trim() != "") {
                return sanitizeCoachReply(content)
            }
            throw "coach indisponivel"
        }
    }
    log.warn("coach: mais de 5 rodadas de tools; conversa interrompida")
    throw "coach indisponivel"
}

String askCoach(UserEntity user, String userText) {
    return askCoachWithSource(user, userText, Source.MANUAL)
}
