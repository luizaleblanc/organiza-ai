// backend/email.kf
// E-mail transacional pelo Resend (decisoes de 16/10 e 19/10: "esqueci a senha" e resumo diario as 20h
// entram no MVP 1). Envio por backend/outbound.kf (HTTPS com certificado validado). Sem a chave, o recurso
// fica DESLIGADO: as rotas respondem 503 com texto honesto e o boot nunca cai por isso.
//   KOF_EMAIL_API_KEY  chave do Resend (segredo; so vai para o cabecalho Authorization, nunca para log)
//   KOF_EMAIL_FROM     remetente verificado no Resend, ex.: "Organiza AI <nao-responda@dominio>"
//   KOF_EMAIL_API_URL  opcional; padrao https://api.resend.com/emails (o teste aponta para o mock local)
//   KOF_APP_BASE_URL   endereco do app, para o link de redefinicao (padrao http://localhost:3000)
//   KOF_DIGEST_AT      horario local do resumo diario, "HH:MM" (padrao 20:00), no fuso da variavel TZ

import java.util.Base64
import javax.net.ssl.SSLSocketFactory
import java.io.BufferedReader
import java.io.InputStreamReader
import java.io.OutputStream
import java.io.InputStream
import java.io.Reader
import java.net.Socket
import java.security.SecureRandom
import java.nio.file.Files
import java.nio.file.Paths

// =========================================================
// Cliente de e-mail (Resend: POST {from, to, subject, text} com Bearer; aceite = 2xx com "id")
// =========================================================

record EmailMessage(String from, String to, String subject, String text)

// ---------------------------------------------------------
// SMTP (ex.: Gmail): SMTPS na porta 465 (TLS desde o início), AUTH LOGIN e mensagem MIME em UTF-8.
//   KOF_SMTP_HOST      padrão smtp.gmail.com
//   KOF_SMTP_PORT      padrão 465 (só TLS implícito; 587/STARTTLS não é suportado)
//   KOF_SMTP_USER      conta, ex.: sua-conta@gmail.com
//   KOF_SMTP_PASSWORD  senha de app do Google (segredo; nunca vai para log)
//   KOF_EMAIL_FROM     opcional; padrão "\"Luiza Leblanc, CEO do Organiza\" <KOF_SMTP_USER>"
// Com SMTP configurado ele tem prioridade sobre o Resend.
// ---------------------------------------------------------

Bool smtpConfigured() {
    return configText("KOF_SMTP_USER") != null && configText("KOF_SMTP_PASSWORD") != null
}

String smtpHost() {
    var h = configText("KOF_SMTP_HOST")
    if (h != null) {
        return h
    }
    return "smtp.gmail.com"
}

Int smtpPort() {
    var raw = configText("KOF_SMTP_PORT")
    if (raw != null) {
        try {
            return raw.trim().toInt()
        } catch (String e) {
            return 465
        }
    }
    return 465
}

String smtpFrom() {
    var f = configText("KOF_EMAIL_FROM")
    if (f != null) {
        return f
    }
    return "\"Luiza Leblanc, CEO do Organiza\" <" + nullToText(configText("KOF_SMTP_USER")) + ">"
}

String smtpB64(String text) {
    return Base64.getEncoder().encodeToString(text.getBytes())
}

// Endereço puro de "Nome <a@b>" (para MAIL FROM).
String smtpAddress(String from) {
    var lt = from.indexOf("<")
    var gt = from.indexOf(">")
    if (lt >= 0 && gt > lt) {
        return from.substring(lt + 1, gt).trim()
    }
    return from.trim()
}

// Lê uma resposta SMTP (pode ter várias linhas "250-...") e confere o código.
smtpExpect(BufferedReader reader, String code) {
    var line = reader.readLine()
    while (line != null && line.length() >= 4 && line.substring(3, 4) == "-") {
        line = reader.readLine()
    }
    if (line == null || !line.startsWith(code)) {
        var got = "sem resposta"
        if (line != null && line.length() >= 3) {
            got = line.substring(0, 3)
        }
        throw "SMTP esperava " + code + " e recebeu " + got
    }
}

smtpSend(OutputStream out, BufferedReader reader, String command, String code) {
    out.write((command + "\r\n").getBytes())
    out.flush()
    smtpExpect(reader, code)
}

// Corpo em base64 quebrado em linhas de 76 (RFC 2045).
String smtpBody(String text) {
    var b = smtpB64(text)
    var lines = ""
    var i = 0
    while (i < b.length()) {
        var end = i + 76
        if (end > b.length()) {
            end = b.length()
        }
        lines = lines + b.substring(i, end) + "\r\n"
        i = end
    }
    return lines
}

// Arquivo de texto da saída do frontend (KOF_WEB_OUT); "" se faltar.
String readWebFile(String webOut, String name) {
    try {
        return Files.readString(Paths.get(webOut, name, ""))
    } catch (Exception e) {
        return ""
    }
}

// Template HTML do e-mail (frontend/assets/email/*.html, copiado para KOF_WEB_OUT/assets/email).
// Sem o arquivo, o e-mail sai só em texto.
String? emailTemplate(String file) {
    var webOut = config.env("KOF_WEB_OUT")
    if (webOut == null) {
        return null
    }
    try {
        return Files.readString(Paths.get(webOut, "assets", "email", file))
    } catch (Exception e) {
        return null
    }
}

String htmlEscape(String v) {
    return v.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
}

// Base64 de bytes quebrado em linhas de 76 (RFC 2045).
String smtpBytesBody(String b) {
    var lines = ""
    var i = 0
    while (i < b.length()) {
        var end = i + 76
        if (end > b.length()) {
            end = b.length()
        }
        lines = lines + b.substring(i, end) + "\r\n"
        i = end
    }
    return lines
}

// Banner da marca (frontend/assets/email/banner.jpg) em base64; "" se não houver.
String emailBannerB64() {
    var webOut = config.env("KOF_WEB_OUT")
    if (webOut == null) {
        return ""
    }
    try {
        return Base64.getEncoder().encodeToString(Files.readAllBytes(Paths.get(webOut, "assets", "email", "banner.jpg")))
    } catch (Exception e) {
        return ""
    }
}

// Corpo MIME: só texto; ou multipart/alternative (texto + HTML); e, com o banner, tudo dentro de
// multipart/related com a imagem inline (Content-ID <banner>, usada como cid:banner no HTML).
String smtpMimeBody(String text, String html) {
    if (html == "") {
        return "Content-Type: text/plain; charset=UTF-8\r\nContent-Transfer-Encoding: base64\r\n\r\n" + smtpBody(text)
    }
    var alt = "organiza-alt-" + crypto.randomHex(8)
    var altPart = "Content-Type: multipart/alternative; boundary=\"" + alt + "\"\r\n\r\n" +
        "--" + alt + "\r\nContent-Type: text/plain; charset=UTF-8\r\nContent-Transfer-Encoding: base64\r\n\r\n" + smtpBody(text) +
        "--" + alt + "\r\nContent-Type: text/html; charset=UTF-8\r\nContent-Transfer-Encoding: base64\r\n\r\n" + smtpBody(html) +
        "--" + alt + "--\r\n"
    var banner = emailBannerB64()
    if (banner == "" || !html.contains("cid:banner")) {
        return altPart
    }
    var rel = "organiza-rel-" + crypto.randomHex(8)
    return "Content-Type: multipart/related; boundary=\"" + rel + "\"\r\n\r\n" +
        "--" + rel + "\r\n" + altPart +
        "--" + rel + "\r\nContent-Type: image/jpeg; name=\"organiza.jpg\"\r\nContent-Transfer-Encoding: base64\r\nContent-ID: <banner>\r\nContent-Disposition: inline; filename=\"organiza.jpg\"\r\n\r\n" + smtpBytesBody(banner) +
        "--" + rel + "--\r\n"
}

Bool sendEmailSmtp(String to, String subject, String text) {
    return sendEmailSmtpHtml(to, subject, text, "")
}

Bool sendEmailSmtpHtml(String to, String subject, String text, String html) {
    var user = nullToText(configText("KOF_SMTP_USER"))
    var pass = secrets.secret("KOF_SMTP_PASSWORD")
    var from = smtpFrom()
    try {
        var socket: Socket = SSLSocketFactory.getDefault().createSocket(smtpHost(), smtpPort())
        socket.setSoTimeout(15000)
        var ins: InputStream = socket.getInputStream()
        var isr: Reader = new InputStreamReader(ins, "UTF-8")
        var reader = new BufferedReader(isr)
        var out: OutputStream = socket.getOutputStream()
        try {
            smtpExpect(reader, "220")
            smtpSend(out, reader, "EHLO organiza.ai", "250")
            smtpSend(out, reader, "AUTH LOGIN", "334")
            smtpSend(out, reader, smtpB64(user), "334")
            smtpSend(out, reader, smtpB64(pass.reveal()), "235")
            smtpSend(out, reader, "MAIL FROM:<" + smtpAddress(from) + ">", "250")
            smtpSend(out, reader, "RCPT TO:<" + to + ">", "250")
            smtpSend(out, reader, "DATA", "354")
            var msg = "From: " + from + "\r\n" +
                "To: <" + to + ">\r\n" +
                "Subject: =?UTF-8?B?" + smtpB64(subject) + "?=\r\n" +
                "MIME-Version: 1.0\r\n" +
                smtpMimeBody(text, html) + ".\r\n"
            out.write(msg.getBytes())
            out.flush()
            smtpExpect(reader, "250")
            smtpSend(out, reader, "QUIT", "221")
        } finally {
            socket.close()
        }
        return true
    } catch (String e) {
        log.warn("e-mail nao enviado por SMTP: " + e)
        return false
    } catch (Exception e) {
        log.warn("e-mail nao enviado por SMTP: falha de conexao ou TLS")
        return false
    }
}

String emailApiUrl() {
    var url = configText("KOF_EMAIL_API_URL")
    if (url != null) {
        return url
    }
    return "https://api.resend.com/emails"
}

Bool emailConfigured() {
    if (smtpConfigured()) {
        return true
    }
    if (configText("KOF_EMAIL_API_KEY") != null && configText("KOF_EMAIL_FROM") != null) {
        return outboundUrlAllowed(emailApiUrl())
    }
    return false
}

// Motivo de o e-mail estar ligado ou desligado (log do boot; nunca cita a chave).
String emailStatus() {
    if (smtpConfigured()) {
        return "e-mail ligado (SMTP " + smtpHost() + ":" + smtpPort() + ")"
    }
    if (emailConfigured()) {
        return "e-mail ligado (Resend)"
    }
    if (configText("KOF_EMAIL_API_KEY") != null && configText("KOF_EMAIL_FROM") != null) {
        return "e-mail desligado: KOF_EMAIL_API_URL precisa ser https:// (http local so com KOF_OUTBOUND_ALLOW_LOCAL_HTTP=true)"
    }
    return "e-mail desligado: defina KOF_SMTP_USER e KOF_SMTP_PASSWORD (Gmail) ou KOF_EMAIL_API_KEY e KOF_EMAIL_FROM (Resend)"
}

// true = o provedor aceitou (2xx). 4xx/5xx/rede = false com o status no log (nunca a chave nem o corpo).
Bool sendEmail(String to, String subject, String text) {
    return sendEmailHtml(to, subject, text, "")
}

// Com SMTP, `html` (não vazio) vira a parte HTML do e-mail; o Resend recebe só o texto.
Bool sendEmailHtml(String to, String subject, String text, String html) {
    if (!emailConfigured()) {
        return false
    }
    if (smtpConfigured()) {
        return sendEmailSmtpHtml(to, subject, text, html)
    }
    var key = secrets.secret("KOF_EMAIL_API_KEY")
    var payload = json.encode(EmailMessage(nullToText(configText("KOF_EMAIL_FROM")), to, subject, text))
    var resp = outboundPost(emailApiUrl(), payload, jsonBearerHeaders(key.reveal()), 10000)
    if (resp.status >= 200 && resp.status < 300) {
        return true
    }
    if (resp.status == 0) {
        log.warn("e-mail nao enviado: " + resp.failure)
    } else {
        log.warn("e-mail recusado pelo provedor: status " + resp.status)
    }
    return false
}

// =========================================================
// Esqueci a senha: token de uso unico, guardado so como hash, valido por 30 minutos
// =========================================================

record ForgotPasswordRequest(String email)
record ResetPasswordRequest(String email, String token, String password)
record MessageResponse(String message)

ForgotPasswordRequest? decodeForgotPasswordRequest(String raw) {
    try {
        var req = json.decode<ForgotPasswordRequest>(raw)
        if (req.email() == null) {
            return null
        }
        return req
    } catch (String e) {
        return null
    }
}

ResetPasswordRequest? decodeResetPasswordRequest(String raw) {
    try {
        var req = json.decode<ResetPasswordRequest>(raw)
        if (req.email() == null || req.token() == null || req.password() == null) {
            return null
        }
        return req
    } catch (String e) {
        return null
    }
}

Long resetTokenTtlMillis() {
    var minutes: Long = 30
    return minutes * 60000
}

String forgotPasswordAnswer() {
    return "Se o e-mail estiver cadastrado, enviamos um código de 6 números para redefinir a senha. Ele vale por 30 minutos."
}

String appBaseUrl() {
    var base = configText("KOF_APP_BASE_URL")
    if (base != null) {
        return base
    }
    return "http://localhost:3000"
}

// IP do cliente para o limite de pedidos: o ULTIMO item do X-Forwarded-For (o que o proxy do Render
// acrescenta; os anteriores vem do cliente e podem ser forjados). Sem proxy (local) = "local".
String clientIpKey(String? forwardedFor) {
    if (forwardedFor != null) {
        var parts = forwardedFor.split(",")
        var last = parts[parts.length - 1].trim()
        if (last != "") {
            return last
        }
    }
    return "local"
}

// Código de 6 números (SecureRandom), com zeros à esquerda.
String sixDigitCode() {
    var n = new SecureRandom().nextInt(1000000)
    var code = "" + n
    while (code.length() < 6) {
        code = "0" + code
    }
    return code
}

// Hash do código amarrado ao usuário: o mesmo código de outra conta não serve (o reset pede e-mail + código).
String resetCodeHash(String userId, String code) {
    return crypto.sha256(userId + ":" + code.trim())
}

// Gera o código de 6 números, grava só o hash (ligado ao usuário) e manda por e-mail.
// Usuario inexistente nao recebe nada e a resposta da rota e a mesma (sem enumeracao de conta).
void startPasswordReset(UserEntity user) {
    var token = sixDigitCode()
    var expiresAt = time.formatInstantIso(time.now() + resetTokenTtlMillis())
    savePasswordResetToken(user.id, resetCodeHash(user.id, token), expiresAt)
    var link = appBaseUrl() + "/#/redefinir-senha?token=" + token
    var text = "Olá, " + user.name + "!\n\nRecebemos um pedido para redefinir a senha da sua conta no Organiza AI.\n\n" +
        "Seu código de redefinição (vale por 30 minutos): " + token + "\n\n" +
        "No Organiza, toque em \"Esqueci a senha\", depois em \"Já tenho o código\", digite seu e-mail e o código e crie a nova senha.\n\n" +
        "Link do app: " + link + "\n\nSe não foi você, ignore este e-mail: sua senha continua a mesma.\n\nUm abraço,\nLuiza Leblanc\nCEO do Organiza"
    var sent = false
    var tpl = emailTemplate("reset-password.html")
    if (tpl != null) {
        var html = tpl.replace("{{name}}", htmlEscape(user.name)).replace("{{code}}", token).replace("{{link}}", htmlEscape(link))
        sent = sendEmailHtml(user.email, "Organiza AI: redefinir sua senha", text, html)
    } else {
        sent = sendEmail(user.email, "Organiza AI: redefinir sua senha", text)
    }
    if (!sent) {
        log.warn("link de redefinicao nao enviado")
    }
}

// =========================================================
// Resumo diario as 20h (Tela 13): scheduler.at e stub (CRON001), entao o contorno do training
// (idioms/concurrency.md): calcular os ms ate o proximo horario e dormir num spawn, rearmando depois de
// cada envio. O registro em EmailLogRow garante um envio por usuario e dia, inclusive apos reinicio.
// =========================================================

Int digestMinuteOfDay() {
    var at = configText("KOF_DIGEST_AT")
    if (at != null && at.length() == 5 && at.substring(2, 3) == ":") {
        var h = at.substring(0, 2)
        var m = at.substring(3, 5)
        if (strings.isNumeric(h) && strings.isNumeric(m) && h.toInt() < 24 && m.toInt() < 60) {
            return h.toInt() * 60 + m.toInt()
        }
    }
    return 20 * 60
}

// Milissegundos do dia local (fuso TZ) agora.
Long localMillisOfDay() {
    var dayMs: Long = 86400000
    return (time.now() + tzOffsetMillis()) % dayMs
}

// Milissegundos ate o proximo HH:MM local (sempre > 0).
Long millisUntilDigest() {
    var dayMs: Long = 86400000
    var target: Long = digestMinuteOfDay()
    var wait = target * 60000 - localMillisOfDay()
    if (wait <= 0) {
        wait = wait + dayMs
    }
    return wait
}

// O horario de hoje ja passou? (no boot: recupera o envio de hoje se o processo estava fora as 20h)
Bool digestTimePassedToday() {
    var target: Long = digestMinuteOfDay()
    return localMillisOfDay() >= target * 60000
}

Bool digestDueToday(PreferencesInput prefs) {
    if (!prefs.emailEnabled() || prefs.frequency() == "NEVER") {
        return false
    }
    if (prefs.frequency() == "WEEKLY") {
        var today = localTodayIso()
        return time.dayOfWeek(today.substring(0, 4).toInt(), today.substring(5, 7).toInt(), today.substring(8, 10).toInt()) == 1
    }
    return true
}

String digestText(UserEntity user) {
    var monthStart = monthStartIso()
    var pulse = calculateDailyPulse(user.id, daysRemainingInMonth(), monthStart)
    var spent = sumAmountCents(findTransactionsByUserIdAndCreatedAtAfter(user.id, monthStart))
    var alerts = envelopesOverview(user).filter((e: EnvelopeOverview) -> e.status != "EM_DIA")
    var text = "Olá, " + user.name + "!\n\nSeu resumo de hoje no Organiza AI:\n" +
        "- Pode gastar por dia até o fim do mês: " + formatBrl(toCents(pulse.pulse)) + " (" + pulse.daysRemaining + " dias restantes)\n" +
        "- Gastos do mês: " + formatBrl(spent) + " de " + formatBrl(user.salaryCents) + "\n"
    for (var e in alerts) {
        text = text + "- Caixinha " + e.categoryName + ": " + e.percent + "% do limite (" + e.status + ")\n"
    }
    return text + "\nDiga ao Organiza o que você gastou hoje e mantenha o pulso em dia."
}

// Um envio por usuario e dia (EmailLogRow): o registro e conferido antes de cada envio.
Int runDailyDigest() {
    var sent = 0
    var today = localTodayIso()
    for (var user in findAllUsers()) {
        if (onboardingCompleted(user) && digestDueToday(findPreferences(user.id)) && !emailAlreadySent(user.id, "DIGEST", today)) {
            if (sendEmail(user.email, "Organiza AI: seu pulso de hoje", digestText(user))) {
                recordEmailSent(user.id, "DIGEST", today)
                sent = sent + 1
            }
        }
    }
    return sent
}

void runDailyDigestSafely() {
    try {
        log.info("resumo diario: " + runDailyDigest() + " e-mail(s) enviados")
    } catch (String e) {
        log.warn("resumo diario falhou; nova tentativa no proximo horario")
    } catch (Exception e) {
        log.warn("resumo diario falhou; nova tentativa no proximo horario")
    }
}

void startDailyDigest() {
    if (!emailConfigured()) {
        log.info("resumo diario por e-mail desligado (" + emailStatus() + ")")
        return
    }
    log.info("resumo diario por e-mail agendado para " + digestMinuteOfDay() / 60 + "h" + digestMinuteOfDay() % 60 + " (fuso TZ)")
    spawn {
        if (digestTimePassedToday()) {
            runDailyDigestSafely()
        }
        while (true) {
            time.sleep(millisUntilDigest() as Int)
            runDailyDigestSafely()
            time.sleep(61000)
        }
    }
}
