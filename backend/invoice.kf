    var recent = findRecentChatMessages(userId, 4)
    for (var m in recent) {
        if (m.role == ChatRole.ASSISTANT) {
            var lower = m.content.toLowerCase()
            if (lower.contains("de qual mês e ano são esses gastos") || lower.contains("de qual mes e ano sao esses gastos") || lower.contains("de qual mês e ano são essas movimentações") || lower.contains("de qual mes e ano sao essas movimentacoes")) {
                return true
            }
        }
    }
    return false
}

Category? detectCategoryReclassificationFromChat(String message) {
    var lower = message.trim().toLowerCase()
    var hasMarker = lower.contains("esse pix foi") || lower.contains("o pix foi") || lower.contains("pix foi") || lower.contains("foi ") || lower.contains("era ") || lower.contains("classifica como") || lower.contains("classificar como") || lower.contains("categoria ")
    if (!hasMarker) {
        return null
    }
    return classifyChatExpenseCategory(lower)
}

InvoiceChatTurnResult? reclassifyPendingDocumentItemTurnFromChat(String userId, String message) {
    var lower = message.trim().toLowerCase()
    var looksLikeReclass = lower.contains("esse pix foi") || lower.contains("o pix foi") || lower.contains("pix foi") || lower.startsWith("foi ") || lower.contains("classifica como") || lower.contains("classificar como")
    if (!looksLikeReclass) {
        return null
    }
    var targetCat = detectCategoryReclassificationFromChat(message)
    if (targetCat == null) {
        return InvoiceChatTurnResult("Me diga qual categoria você quer aplicar a esse item pendente (por exemplo: \"esse Pix foi alimentação\", \"foi mercado\", \"foi transporte\" ou \"foi saúde\").", null)
    }
    if (targetCat == Category.OTHER) {
        return InvoiceChatTurnResult("Me diga qual categoria você quer aplicar a esse item pendente (por exemplo: \"esse Pix foi alimentação\", \"foi mercado\", \"foi transporte\" ou \"foi saúde\").", null)
    }
    var latest = findLatestFinancialDocumentRowByUser(userId)
    if (latest == null) {
        return null
    }
    if (latest.status == "FALHA_EXTRACAO") {
        return null
    }
    var rows = findExtractedTransactionRowsByDoc(userId, latest.docKey)
    var updatedDesc = ""
    var updatedMinor: Long = 0
    var updatedPage = 1
    var updatedRow = 1
    var foundPending = false
    for (var r in rows) {
        if (!foundPending && r.direction != "CREDIT" && r.kind != "INCOME" && r.kind != "PAYMENT" && r.kind != "CARD_EXIT" && r.kind != "REFUND" && r.reviewStatus != "CONFIRMED") {
            saveExtractedTransactionRow(ExtractedTransactionRow(
                r.id, r.documentId, r.userId, r.itemKey, r.txDate, r.descriptionRaw, r.descriptionNormalized,
                r.amountMinor, r.currency, r.direction, r.kind, r.installment,
                targetCat.name(), "USER_CONFIRMED_CHAT", 1.0, r.pageNum, r.rowNum, r.snippet, "CONFIRMED"
            ))
            updatedDesc = r.descriptionRaw
            updatedMinor = r.amountMinor
            updatedPage = r.pageNum
            updatedRow = r.rowNum
            foundPending = true
        }
    }
    if (!foundPending) {
        return null
    }
    var lookup = lookupDocumentReview(latest.docKey, userId)
    var rev = lookup.review()
    if (rev != null) {
        var s = summarizeImportReview(rev)
        var msg = catalogConfirmacaoCategoria(updatedDesc, updatedMinor, latest.filename, updatedPage, updatedRow, categoryLabel(targetCat), s.confirmableExpenseMinor())
        return InvoiceChatTurnResult(msg, buildInvoiceRegisterPayload(rev, s, latest.filename))
    }
    var fallbackMsg = catalogConfirmacaoCategoria(updatedDesc, updatedMinor, latest.filename, updatedPage, updatedRow, categoryLabel(targetCat), updatedMinor)
    return InvoiceChatTurnResult(fallbackMsg, null)
}

String? reclassifyPendingDocumentItemFromChat(String userId, String message) {
    var turn = reclassifyPendingDocumentItemTurnFromChat(userId, message)
    if (turn != null) {
        return turn.reply()
    }
    return null
}

InvoiceChatTurnResult? buildCategoryPreviewTurnBeforeSave(String userId, String? documentId) {
    var targetDocId = ""
    if (documentId != null && documentId.trim() != "") {
        targetDocId = documentId.trim()
    } else {
        var latest = findLatestFinancialDocumentRowByUser(userId)
        if (latest == null) {
            return null
        }
        targetDocId = latest.docKey
    }
    var lookup = lookupDocumentReview(targetDocId, userId)
    var rev = lookup.review()
    if (rev == null) {
        return null
    }
    if (rev.status() == "FALHA_EXTRACAO") {
        return null
    }
    var s = summarizeImportReview(rev)
    var byCat: Map<String, Long> = mapOf()
    var zero: Long = 0
    for (var ctx in rev.transactions()) {
        var fc = flowClassOf(ctx)
        var m = ctx.amountMinor()
        if ((fc == "DESPESA" || fc == "OPERACAO_CREDITO") && m != null && m > 0) {
            var catCode = sanitizeCategoryForConfirm(ctx.category())
            var ptName = categoryLabel(categoryOrNull(catCode))
            byCat.put(ptName, byCat.getOrDefault(ptName, zero) + m)
        }
    }
    var catLines = ""
    for (var ptKey in byCat.keys()) {
        catLines = catLines + "- Caixinha " + ptKey + ": " + formatBrl(byCat.getOrDefault(ptKey, zero)) + "\n"
    }
    if (catLines == "") {
        catLines = "- Nenhuma despesa confirmada pronta para salvar ainda.\n"
    }
    var fname = humanFilenameForDocId(rev.documentId())
    var msg = catalogConfirmacaoCaixinhas(fname, catLines, s.expenseMinor(), s.creditOperationMinor(), s.billPaymentMinor(), s.pendingCount(), s.pendingMinor())
    return InvoiceChatTurnResult(msg, buildInvoiceRegisterPayload(rev, s, fname))
}

String? buildCategoryPreviewBeforeSave(String userId, String? documentId) {
    var turn = buildCategoryPreviewTurnBeforeSave(userId, documentId)
    if (turn != null) {
        return turn.reply()
    }
    return null
}

Bool isExplicitStatementAnalysisRequest(String message) {
    var lower = message.trim().toLowerCase()
    if (detectEducationalFinanceTopic(lower) != "") {
        return false
    }
    return lower.contains("minha fatura") || lower.contains("meu extrato") || lower.contains("analise o documento") || lower.contains("analise a fatura") || lower.contains("fatura enviada") || (lower.contains("fatura ") && lower.contains("enviada:")) || lower.contains("resumo da fatura") || lower.contains("o que tem na fatura")
}

Bool isSoftInvoiceRegisterReply(String lowerMsg) {
    return lowerMsg == "sim" || lowerMsg == "sim!" || lowerMsg == "ok" || lowerMsg == "quero" || lowerMsg == "pode ser" || lowerMsg == "vamos lá" || lowerMsg == "vamos la" || lowerMsg == "vamos" || lowerMsg == "continuar"
}

Bool isExplicitSaveCommand(String lowerMsg) {
    return lowerMsg.contains("pode distribuir") || lowerMsg.contains("pode salvar") || lowerMsg.contains("salva nas caixinhas") || lowerMsg.contains("salvar nas caixinhas") || lowerMsg.contains("salvar os gastos") || lowerMsg.contains("distribua nas caixinhas") || lowerMsg.contains("distribuir nas caixinhas") || lowerMsg.contains("pode confirmar") || lowerMsg == "confirmo" || lowerMsg == "confirmar"
}

Bool recentAssistantAskedExplicitSave(String userId) {
    var recent = findRecentChatMessages(userId, 4)
    for (var m in recent) {
        if (m.role == ChatRole.ASSISTANT) {
            var lower = m.content.toLowerCase()
            if (lower.contains("posso guardar esses valores nas suas caixinhas") || lower.contains("sim, pode distribuir")) {
                return true
            }
        }
    }
    return false
}

// Resposta deterministica do chat sobre documento (ANALISAR_FATURA e confirmacao Passo 2).
// null = mensagem nao e sobre documento. Roda ANTES do ramo LLM.
InvoiceChatTurnResult? invoiceChatTurnFor(String userId, String message, String rawBody) {
    var lowerMsg = message.trim().toLowerCase()

    // 1. Perguntas educativas NUNCA disparam reprocessamento de arquivo (mesmo citando "fatura" ou após falha de upload).
    var eduTurn = answerEducationalFinanceTurn(userId, message)
    if (eduTurn != null) {
        return eduTurn
    }

    // 1b. Fallback determinístico quando o arquivo enviado não consta como fatura / 0 lançamentos identificados.
    if (lowerMsg.contains("0 lançamentos") || lowerMsg.contains("0 lancamentos") || lowerMsg.contains("falha na extração") || lowerMsg.contains("falha na extracao") || (lowerMsg.startsWith("arquivo ") && lowerMsg.contains("enviado:") && lowerMsg.contains("0 "))) {
        return InvoiceChatTurnResult(catalogDocumentoNaoFatura(), null)
    }

    // 2. Reclassificação conversacional de item pendente (ex.: "esse Pix foi alimentação" -> CONFIRMACAO_CATEGORIA + template INVOICE_REGISTER).
    var reclassTurn = reclassifyPendingDocumentItemTurnFromChat(userId, message)
    if (reclassTurn != null) {
        return reclassTurn
    }

    var docId = ""
    var hint = decodeChatDocumentHint(rawBody)
    if (hint != null) {
        var hintDocId = hint.documentId()
        if (hintDocId != null) {
            docId = hintDocId.trim()
        }
    }

    // 3. Templates interativos após a resposta do usuário sobre a fatura:
    if (lowerMsg == "organizar caixinhas" || lowerMsg == "organizar meus gastos nas caixinhas" || lowerMsg == "organizar nas caixinhas" || lowerMsg == "mostrar categorias antes de salvar" || lowerMsg == "registrar fatura" || lowerMsg == "registrar minha fatura" || lowerMsg == "quero registrar" || lowerMsg == "quero registrar a fatura" || lowerMsg == "registrar os gastos" || lowerMsg == "organizar fatura" || lowerMsg == "pode organizar" || lowerMsg == "selecionar gastos" || lowerMsg == "escolher gastos") {
        var previewTurn = buildCategoryPreviewTurnBeforeSave(userId, docId)
        if (previewTurn != null) {
            return previewTurn
        }
    }
    if (lowerMsg == "revisar movimentações" || lowerMsg == "revisar movimentacoes" || lowerMsg == "corrigir uma informação" || lowerMsg == "corrigir uma informacao" || lowerMsg == "corrigir informação" || lowerMsg == "corrigir informacao" || lowerMsg == "ver pendentes") {
        var targetEditDocId = docId
        if (targetEditDocId == "") {
            var latestEdit = findLatestFinancialDocumentRowByUser(userId)
            if (latestEdit != null && latestEdit.status != "FALHA_EXTRACAO" && latestEdit.status != "EXTRACAO_FALHOU") {
                targetEditDocId = latestEdit.docKey
            }
        }
        if (targetEditDocId != "") {
            var lookupEdit = lookupDocumentReview(targetEditDocId, userId)
            var revEdit = lookupEdit.review()
            if (revEdit != null && revEdit.status() != "FALHA_EXTRACAO") {
                var sEdit = summarizeImportReview(revEdit)
                var editFilename = cleanInteractionFilename("", targetEditDocId)
                var pendList = ""
                for (var ln in sEdit.lines()) {
                    if (ln.flowClass() == "PENDENTE_REVISAO") {
                        var dTxt = ln.descriptionRaw()
                        if (dTxt == null || dTxt == "") { dTxt = "Item pendente" }
                        var vMin: Long = 0
                        var am = ln.amountMinor()
                        if (am != null) { vMin = am }
                        var pN = 1
                        var lp = ln.page()
                        if (lp != null) { pN = lp }
                        var rN = 0
                        var lr = ln.row()
                        if (lr != null) { rN = lr }
                        pendList = pendList + dTxt + " · " + formatBrl(vMin) + " (página " + pN + ", linha " + rN + ")\n"
                    }
                }
                if (pendList != "") {
                    return InvoiceChatTurnResult(
                        catalogTransacaoPendente(editFilename, sEdit.pendingCount(), pendList),
                        buildReviewChecklistPayload(revEdit, sEdit, editFilename)
                    )
                }
                if (sEdit.confirmableExpenseCount() > 0) {
                    return InvoiceChatTurnResult(
                        "Todas as movimentações deste arquivo já estão classificadas! Selecione abaixo os lançamentos que deseja registrar nas suas caixinhas.",
                        buildInvoiceRegisterPayload(revEdit, sEdit, editFilename)
                    )
                }
            }
        }
        return InvoiceChatTurnResult("Para corrigir um item pendente da fatura, basta me dizer a categoria dele (por exemplo: \"esse Pix foi alimentação\" ou \"foi transporte\"). Se quiser ajustar uma caixinha, diga por exemplo: \"muda o limite da caixinha Alimentação para R$ 500\".", null)
    }
    if (lowerMsg == "ver meus gastos" || lowerMsg == "ver gastos da fatura" || lowerMsg == "ver por categoria") {
        var targetViewDocId = docId
        if (targetViewDocId == "") {
            var latestView = findLatestFinancialDocumentRowByUser(userId)
            if (latestView != null && (latestView.status == "EM_REVISAO" || latestView.status == "IMPORTADO")) {
                targetViewDocId = latestView.docKey
            }
        }
        if (targetViewDocId != "") {
            var lookupView = lookupDocumentReview(targetViewDocId, userId)
            var revView = lookupView.review()
            if (revView != null && revView.status() != "FALHA_EXTRACAO") {
                var sView = summarizeImportReview(revView)
                var fnameView = cleanInteractionFilename("", targetViewDocId)
                var viewReply = "No extrato " + fnameView + ", você tem " + formatBrl(sView.confirmableExpenseMinor()) + " em despesas distribuídas por categoria. Selecione as categorias abaixo para visualizar ou avançar para o registro."
                return InvoiceChatTurnResult(viewReply, buildViewCategoriesPayload(revView, sView, fnameView))
            }
        }
    }

    var periodReply = parsePeriodParam(message)
    if (periodReply != "" && recentChatAskedPeriodConfirm(userId)) {
        return confirmDocumentFromChatTurnWithPeriod(userId, textOrNull(docId), periodReply)
    }

    // 3b. Resposta afirmativa inicial após a análise da fatura -> abre template de registro com checkboxes antes de salvar.
    if (isSoftInvoiceRegisterReply(lowerMsg) && !isExplicitSaveCommand(lowerMsg) && !recentAssistantAskedExplicitSave(userId)) {
        var regOpenTurn = buildCategoryPreviewTurnBeforeSave(userId, textOrNull(docId))
        if (regOpenTurn != null) {
            return regOpenTurn
        }
    }

    // 4. Confirmação explícita de distribuição/salvamento nas caixinhas (ex.: "sim, pode distribuir")
    if (isChatInvoiceConfirmIntent(message)) {
        if (docId != "") {
            return confirmDocumentFromChatTurn(userId, docId)
        }
        var latestConfirm = findLatestFinancialDocumentRowByUser(userId)
        if (latestConfirm != null) {
            var askedConfirm = recentChatAskedInvoiceConfirm(userId)
            var explicitSave = isExplicitSaveCommand(lowerMsg)
            if ((latestConfirm.status == "EM_REVISAO" && (askedConfirm || explicitSave)) || (latestConfirm.status == "IMPORTADO" && (askedConfirm || explicitSave))) {
                return confirmDocumentFromChatTurn(userId, latestConfirm.docKey)
            }
        }
        return null
    }
    if (docId == "" && isExplicitStatementAnalysisRequest(message)) {
        var latest = findLatestFinancialDocumentRowByUser(userId)
        if (latest != null && latest.status == "EM_REVISAO") {
            docId = latest.docKey
        }
    }
    if (docId == "") {
        return null
    }
    var res = dispatchFinanceIntent(userId, IntentRequest("ANALISAR_FATURA", null, null, null, listOf(docId)))
    if (res.status() == "EM_REVISAO" || res.status() == "IMPORTADO") {
        var lookup = lookupDocumentReview(docId, userId)
        var rev = lookup.review()
        if (rev != null) {
            var s = summarizeImportReview(rev)
            var fname = humanFilenameForDocId(rev.documentId())
            return InvoiceChatTurnResult(
                buildInvoiceChatReplyWithFilename(s, rev.reconciled(), fname),
                buildInvoiceInteractionPayload(rev, s, fname)
            )
        }
    }
    if (res.status() == "FALHA_EXTRACAO") {
        return InvoiceChatTurnResult(catalogDocumentoIlegivel(humanFilenameForDocId(docId)), null)
    }
    var m = res.message()
    if (m != null) {
        return InvoiceChatTurnResult(m, null)
    }
    return InvoiceChatTurnResult(catalogDocumentoIlegivel(humanFilenameForDocId(docId)), null)
}

String? invoiceChatReplyFor(String userId, String message, String rawBody) {
    var turn = invoiceChatTurnFor(userId, message, rawBody)
    if (turn != null) {
        return turn.reply()
    }
    return null
}
