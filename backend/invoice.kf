}

String buildInvoiceChatReplyWithFilename(ImportFlowSummary s, Bool reconciled, String filename) {
    var statementPeriod = lookupStatementPeriod(s.documentId())
    var periodPt = formatPeriodPt(statementPeriod)
    var headline = ""
    if (periodPt != "") {
        headline = "Consegui organizar seu extrato de " + periodPt.toLowerCase() + "!"
    } else {
        headline = "Li o arquivo enviado, mas antes de salvar preciso confirmar com você de qual mês e ano são essas movimentações."
    }
    var outflowsLine = "Saídas: encontrei " + formatBrl(s.confirmableExpenseMinor()) + " em despesas identificadas prontas para organizar nas suas caixinhas."
    if (s.pendingCount() > 0) {
        outflowsLine = "Saídas: encontrei " + formatBrl(s.confirmableExpenseMinor()) + " em despesas identificadas e " + formatBrl(s.pendingMinor()) + " em movimentações que precisamos conferir antes de salvar."
    }
    return headline + "\n\n" + outflowsLine
}

String buildInvoiceChatReply(ImportFlowSummary s, Bool reconciled) {
    return buildInvoiceChatReplyWithFilename(s, reconciled, humanFilenameForDocId(s.documentId()))
}

Bool mentionsStatement(String message) {
    var lower = message.toLowerCase()
    return lower.contains("fatura") || lower.contains("extrato") || lower.contains("lancamento") || lower.contains("lançamento")
}

Bool isChatInvoiceConfirmIntent(String message) {
    var lower = normalizeOcrText(message).toLowerCase()
    if (lower == "") {
        return false
    }
    if (lower.contains("nao ") || lower.contains("não ") || lower == "nao" || lower == "não" || lower.contains("cancela") || lower.contains("recusa") || lower.contains("depois") || lower.contains("analis") || lower.contains("o que tem") || lower.contains("resumo")) {
        return false
    }
    var exact = listOf("sim", "ok", "confirmo", "confirmar", "salvar", "salva", "pode salvar", "sim, pode salvar", "pode distribuir", "distribuir", "distribua", "pode confirmar", "sim, distribua", "sim, distribuir")
    for (var e in exact) {
        if (lower == e) {
            return true
        }
    }
    var markers = listOf("confirmo", "confirmar", "pode salvar", "pode distribuir", "salva nas caixinhas", "salvar nas caixinhas", "salvar os gastos", "confirmar importacao", "confirmar importação", "distribua nas caixinhas", "distribuir nas caixinhas")
    for (var m in markers) {
        if (lower.contains(m)) {
            return true
        }
    }
    if (lower.startsWith("sim ") || lower.startsWith("sim,") || lower.startsWith("pode sim")) {
        return true
    }
    return false
}

Bool recentChatAskedInvoiceConfirm(String userId) {
    var recent = findRecentChatMessages(userId, 6)
    for (var m in recent) {
        if (m.role == ChatRole.ASSISTANT) {
            var lower = m.content.toLowerCase()
            if (lower.contains("caixinhas") || lower.contains("previa do documento") || lower.contains("confere antes de detalharmos") || lower.contains("extracao_falhou") || lower.contains("falha_extracao")) {
                return true
            }
        }
    }
    return false
}

String sanitizeCategoryForConfirm(String? rawCat) {
    if (rawCat != null) {
        var upper = rawCat.trim().toUpperCase()
        if (upper != "" && Category.valueOf(upper) != null) {
            return upper
        }
    }
    return "OTHER"
}

// Passo 2 no chat: persiste idempotente os gastos extraidos do documento em revisao via Source.INVOICE,
// vinculando as caixinhas e buckets do usuario (sem dupla gravacao se /api/invoices/confirm ja confirmou).
InvoiceChatTurnResult? confirmDocumentFromChatTurnWithPeriod(String userId, String? documentId, String? explicitPeriod) {
    var targetDocId = ""
    if (documentId != null && documentId.trim() != "") {
        targetDocId = documentId.trim()
    } else {
        var latest = findLatestFinancialDocumentRowByUser(userId)
        if (latest == null) {
            return null
        }
        targetDocId = latest.docKey
    }

    var lookup = lookupDocumentReview(targetDocId, userId)
    if (lookup.errorCode() == "NOT_FOUND") {
        return InvoiceChatTurnResult("Documento nao encontrado.", null)
    }
    if (lookup.errorCode() == "UNAUTHORIZED") {
        return InvoiceChatTurnResult("Acesso negado ao documento.", null)
    }
    var rev = lookup.review()
    if (rev == null) {
        return InvoiceChatTurnResult("Documento nao encontrado.", null)
    }
    var docFilename = humanFilenameForDocId(rev.documentId())
    if (rev.status() == "FALHA_EXTRACAO" || (rev.extractedCount() == 0 && rev.transactions().isEmpty())) {
        return InvoiceChatTurnResult(catalogDocumentoIlegivel(docFilename), null)
    }

    var docRow = findFinancialDocumentRowByKeyRaw(targetDocId)
    var effectivePeriod = ""
    if (docRow != null && docRow.statementPeriod.trim().matches("[0-9]{4}-[0-9]{2}")) {
        effectivePeriod = docRow.statementPeriod.trim()
    }
    if (effectivePeriod == "" && explicitPeriod != null) {
        var parsedExp = parsePeriodParam(explicitPeriod)
        if (parsedExp != "") {
            effectivePeriod = parsedExp
            if (docRow != null) {
                persistDocumentStatementPeriod(docRow, effectivePeriod)
            }
        }
    }
    if (effectivePeriod == "") {
        return InvoiceChatTurnResult("Não consegui identificar o mês e o ano com segurança neste documento. De qual mês e ano são esses gastos? (Exemplo: novembro de 2026)", null)
    }

    var traceItems = buildConfirmTraceItemsFromReviewFiltered(rev, listOf(), effectivePeriod)
    if (traceItems.size == 0) {
        return InvoiceChatTurnResult("No arquivo " + docFilename + " ainda não há despesas confirmadas prontas para entrar nas caixinhas (receitas, pagamentos de fatura e itens aguardando sua confirmação não são salvos automaticamente).", null)
    }

    var alreadyByReceipt = loadConfirmedOutputsFromReceipt(userId, "conf_doc_" + userId + "_" + targetDocId) != null
    var wasAlreadyImported = rev.confirmedByUser() || alreadyByReceipt
    var saved = confirmInvoiceTraceItemsWithIdempotency(userId, traceItems, targetDocId)

    var savedTotalCents: Long = 0
    var envIds: List<String> = listOf()
    for (var tx in saved) {
        savedTotalCents = savedTotalCents + toCents(tx.value)
        var eid = tx.envelopeId
        if (eid != null && eid != "" && !envIds.contains(eid)) {
            envIds.add(eid)
        }
    }

    var envLines = ""
    var modelLine = ""
    var user = findUserById(userId)
    if (user != null) {
        var envs = envelopesOverview(user)
        for (var e in envs) {
            if (envIds.contains(e.id)) {
                var bText = "Sem grupo"
                var envBucket = e.bucket
                if (envBucket != null && envBucket != "") {
                    bText = envBucket
                }
                var displayEnv = e.categoryName
                var resolvedCat = categoryOrNull(e.categoryName)
                if (resolvedCat != null) {
                    displayEnv = categoryLabel(resolvedCat)
                }
                envLines = envLines + "- " + displayEnv + " (" + bText + "): gasto " + formatBrl(toCents(e.spentThisMonth)) + " de " + formatBrl(toCents(e.limitAmount)) + " (" + e.percent + "%)\n"
            }
        }
        var buckets = buildBudgetBuckets(user.budgetModel, userSalary(user))
        if (!buckets.isEmpty()) {
            var bLine = ""
            for (var b in buckets) {
                if (bLine != "") {
                    bLine = bLine + " | "
                }
                bLine = bLine + b.name + " (" + b.percentage + "% = " + formatBrl(toCents(b.amount)) + ")"
            }
            modelLine = "Distribuição do seu modelo (" + coachModelLabel(user.budgetModel) + "): " + bLine
        }
    }
    var periodPt = formatPeriodPt(effectivePeriod)
    if (periodPt == "") {
        periodPt = effectivePeriod
    }
    var registeredInteraction = buildInvoiceRegisteredPayload(targetDocId, effectivePeriod, periodPt, saved.size, savedTotalCents, wasAlreadyImported)
    if (wasAlreadyImported) {
        return InvoiceChatTurnResult(catalogDuplicidadeDetectada(docFilename, saved.size, savedTotalCents, envLines, modelLine, effectivePeriod), registeredInteraction)
    }
    return InvoiceChatTurnResult(catalogImportacaoConcluida(docFilename, saved.size, savedTotalCents, envLines, modelLine, effectivePeriod), registeredInteraction)
}

