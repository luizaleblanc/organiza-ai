    if (cleanName == "" || cleanName.startsWith("doc_")) {
        cleanName = humanFilenameForDocId(cleanName)
    }
    return "Perfeito! Classifiquei \"" + itemDesc + "\" (" + formatBrl(amountMinor) + ", arquivo " + cleanName + ", página " + pageNum + ", linha " + rowNum + ") na caixinha " + categoryPt + ". Agora o total pronto para organizar nas suas caixinhas é de " + formatBrl(newConfirmableMinor) + ".\n\n"
}

String catalogConfirmacaoCaixinhas(String filename, String categoryLines, Long expenseMinor, Long creditMinor, Long billPaymentMinor, Int pendingCount, Long pendingMinor) {
    var cleanName = filename.trim()
    if (cleanName == "" || cleanName.startsWith("doc_")) {
        cleanName = humanFilenameForDocId(cleanName)
    }
    var msg = "Vou separar seus gastos por categoria e mostrar os valores antes de salvar. Assim, você pode conferir se está tudo certo no arquivo " + cleanName + ":\n\n"
    msg = msg + categoryLines
    msg = msg + "\nResumo antes de guardar:\n"
    msg = msg + "- Despesas confirmadas em estabelecimentos: " + formatBrl(expenseMinor) + "\n"
    msg = msg + "- Compras e Pix no cartão de crédito: " + formatBrl(creditMinor) + "\n"
    msg = msg + "- Total que será guardado nas caixinhas: " + formatBrl(expenseMinor + creditMinor) + "\n"
    if (billPaymentMinor > 0) {
        msg = msg + "- Pagamentos de fatura deixados de fora (para evitar dupla contagem): " + formatBrl(billPaymentMinor) + "\n"
    }
    if (pendingCount > 0) {
        msg = msg + "- Itens ainda aguardando confirmação (não serão salvos sem você dizer a categoria, ex.: \"esse Pix foi alimentação\"): " + formatBrl(pendingMinor) + " (" + countLabel(pendingCount) + ")\n"
    }
    msg = msg + "\nPosso guardar esses valores nas suas caixinhas agora? Responda \"sim, pode distribuir\" para confirmar ou me diga se quiser corrigir uma informação."
    return msg
}

String catalogImportacaoConcluida(String filename, Int savedCount, Long savedTotalCents, String envLines, String modelLine, String period) {
    var cleanName = filename.trim()
    if (cleanName == "" || cleanName.startsWith("doc_")) {
        cleanName = humanFilenameForDocId(cleanName)
    }
    var periodPt = formatPeriodPt(period)
    var msg = "Confirmado! Guardei " + savedCount + " despesa(s) do arquivo " + cleanName + " no total de " + formatBrl(savedTotalCents) + " nas suas caixinhas sem duplicidade. Seu Dashboard (em Gastos Calculados) e suas Caixinhas foram atualizados automaticamente.\n"
    if (periodPt != "") {
        msg = "Confirmado! Guardei " + savedCount + " despesa(s) de " + periodPt.toLowerCase() + " (" + cleanName + ") no total de " + formatBrl(savedTotalCents) + " nas suas caixinhas sem duplicidade. Seu Dashboard (em Gastos Calculados) e suas Caixinhas foram atualizados automaticamente.\n"
    }
    if (envLines != "") {
        msg = msg + "Caixinhas atualizadas:\n" + envLines
    }
    if (modelLine != "") {
        msg = msg + modelLine
    }
    return msg.trim()
}

String catalogImportacaoConcluida(String filename, Int savedCount, Long savedTotalCents, String envLines, String modelLine) {
