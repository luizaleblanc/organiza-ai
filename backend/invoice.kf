}

String detectEducationalFinanceTopic(String lower) {
    if (lower == "entender melhor meus gastos" || lower == "entender meus gastos" || lower.contains("entender melhor meus gastos")) {
        return "ENTENDER_GASTOS"
    }
    var isQuestion = lower.contains("?") || lower.contains("o que é") || lower.contains("o que e") || lower.contains("o que são") || lower.contains("o que sao") || lower.contains("qual a diferença") || lower.contains("qual a diferenca") || lower.contains("diferença entre") || lower.contains("diferenca entre") || lower.contains("como funciona") || lower.contains("por que") || lower.contains("porque") || lower.contains("me explica") || lower.contains("explica")
    if (!isQuestion) {
        return ""
    }
    if (lower.contains("receita") && lower.contains("despesa")) {
        return "RECEITA_E_DESPESA"
    }
    if (lower.contains("o que é receita") || lower.contains("o que e receita") || lower.contains("o que é despesa") || lower.contains("o que e despesa")) {
        return "RECEITA_E_DESPESA"
    }
    if (lower.contains("fixo") || lower.contains("variáve") || lower.contains("variave")) {
        return "FIXOS_E_VARIAVEIS"
    }
    if (lower.contains("dupla contagem") || (lower.contains("pagamento de fatura") && isQuestion) || (lower.contains("fatura") && (lower.contains("duplic") || lower.contains("duas vezes") || lower.contains("o que é") || lower.contains("o que e") || lower.contains("como funciona") || lower.contains("por que")))) {
        return "PAGAMENTO_FATURA_DUPLA_CONTAGEM"
    }
    if (lower.contains("crédito") || lower.contains("credito") || lower.contains("dinheiro disponível") || lower.contains("dinheiro disponivel") || lower.contains("débito") || lower.contains("debito")) {
        return "CREDITO_E_DISPONIVEL"
    }
    if (lower.contains("reserva de emergência") || lower.contains("reserva de emergencia") || (lower.contains("reserva") && isQuestion)) {
        return "RESERVA_EMERGENCIA"
    }
    if (lower.contains("caixinha") && (lower.contains("o que") || lower.contains("como funciona") || lower.contains("organiza") || lower.contains("serve"))) {
        return "ORGANIZACAO_CAIXINHAS"
    }
    if (lower.contains("planejamento") || lower.contains("planejar") || lower.contains("modelo de economia") || lower.contains("50/30/20") || lower.contains("70/20/10")) {
        return "PLANEJAMENTO_GASTOS"
    }
    return ""
}

String invoiceEducationTipForSummary(ImportFlowSummary s) {
    if (s.billPaymentCount() > 0) {
        return "Pagar uma fatura não é fazer uma nova compra. Por isso, deixei esses pagamentos separados para não contar o mesmo gasto duas vezes."
    }
    if (s.creditOperationCount() > 0) {
        return "Compras no cartão comprometem o valor da próxima fatura, enquanto o dinheiro na conta continua disponível até o vencimento. Mantive tudo separado para facilitar."
    }
    if (s.pendingCount() > 0) {
        return "Deixei as movimentações sem descrição clara fora dos seus gastos até você confirmar o que foram, mantendo seus números sempre fiéis."
    }
    return "Separar seus gastos em caixinhas ajuda a acompanhar seu mês com calma antes de o limite apertar."
}

String cleanInteractionFilename(String filename, String docId) {
    var cleanName = filename.trim()
    if (cleanName == "" || cleanName.startsWith("doc_")) {
        cleanName = humanFilenameForDocId(docId)
    }
    return cleanName
}

Int minorToIntCents(Long minor) {
    if (minor > 2000000000) {
        return 2000000000
    }
    if (minor < -2000000000) {
        return -2000000000
    }
    return minor as Int
}

String canonicalTxDisplayDesc(CanonicalTransaction ctx, String fallbackDesc) {
    var norm = ctx.descriptionNormalized()
    if (norm != null && norm.trim() != "") {
        return norm.trim()
    }
    var raw = ctx.descriptionRaw().trim()
    if (raw != "") {
        return raw
    }
    return fallbackDesc
}

ChatInteractionSummary buildInvoiceInteractionSummary(ImportFlowSummary s, String periodLabel) {
    var entradas: List<ChatFlowLineItem> = listOf()
    if (s.professionalIncomeCount() > 0) {
        entradas.add(ChatFlowLineItem("Renda profissional", formatBrl(s.professionalIncomeMinor()), s.professionalIncomeCount(), null))
    }
    if (s.unverifiedPjIncomeCount() > 0) {
        entradas.add(ChatFlowLineItem("Recebimentos de empresas", formatBrl(s.unverifiedPjIncomeMinor()), s.unverifiedPjIncomeCount(), "Aguardando sua confirmação"))
    }
    if (s.otherIncomeCount() > 0) {
        entradas.add(ChatFlowLineItem("Outras entradas e Pix recebidos", formatBrl(s.otherIncomeMinor()), s.otherIncomeCount(), null))
    }
    if (s.refundCount() > 0) {
        entradas.add(ChatFlowLineItem("Estornos e créditos", formatBrl(s.refundMinor()), s.refundCount(), null))
    }

    var saidas: List<ChatFlowLineItem> = listOf()
    saidas.add(ChatFlowLineItem("Despesas confirmadas", formatBrl(s.expenseMinor()), s.expenseCount(), "Prontas para suas caixinhas"))
    if (s.creditOperationCount() > 0) {
        saidas.add(ChatFlowLineItem("Compras e Pix no cartão de crédito", formatBrl(s.creditOperationMinor()), s.creditOperationCount(), "Separado do saldo à vista"))
    }
    if (s.pendingCount() > 0) {
        saidas.add(ChatFlowLineItem("Aguardando sua revisão", formatBrl(s.pendingMinor()), s.pendingCount(), "Não entra nos gastos sem sua confirmação"))
    }

    return ChatInteractionSummary(
        periodLabel,
        formatBrl(s.incomeMinor()),
        s.incomeCount() + s.refundCount(),
        entradas,
        formatBrl(s.confirmableExpenseMinor()),
        s.confirmableExpenseCount(),
        saidas,
        formatBrl(s.pendingMinor()),
        s.pendingCount()
    )
}

ChatInteractionDetails buildInvoiceInteractionDetails(ImportReview rev, ImportFlowSummary s, String cleanName) {
    var detailItems: List<String> = listOf()
    detailItems.add("Arquivo analisado: " + cleanName)
    detailItems.add("Movimentações lidas no documento: " + s.totalStatementRows() + " (" + countLabel(s.extractedCount()) + " identificados)")
    detailItems.add("Transferências internas deixadas de fora (sem dupla contagem): " + formatBrl(s.internalTransferMinor()) + " (" + countLabel(s.internalTransferCount()) + ")")
    detailItems.add("Pagamentos de fatura deixados de fora (sem dupla contagem): " + formatBrl(s.billPaymentMinor()) + " (" + countLabel(s.billPaymentCount()) + ")")
    if (!rev.reconciled()) {
        detailItems.add("Conferência de soma: os itens lidos diferem do total impresso no documento; confira antes de salvar.")
    }
    for (var ln in s.lines()) {
        if (ln.flowClass() == "PENDENTE_REVISAO") {
            var descText = ln.descriptionRaw()
            if (descText == null || descText == "") {
                descText = ln.snippet()
            }
            if (descText == null || descText == "") {
                descText = "Item pendente"
            }
            var valMinor: Long = 0
            var lm = ln.amountMinor()
            if (lm != null) {
                valMinor = lm
            }
            var pNum = 1
            var lp = ln.page()
            if (lp != null) {
                pNum = lp
            }
            var rNum = 0
            var lr = ln.row()
            if (lr != null) {
                rNum = lr
            }
            detailItems.add("Pendente: " + descText + " · " + formatBrl(valMinor) + " (página " + pNum + ", linha " + rNum + ")")
        }
    }
    return ChatInteractionDetails("Detalhes da análise", detailItems)
}

ChatInteractionPayload buildInvoiceInteractionPayload(ImportReview rev, ImportFlowSummary s, String filename) {
    var cleanName = cleanInteractionFilename(filename, rev.documentId())
    var statementPeriod = lookupStatementPeriod(rev.documentId())
    var periodPt = formatPeriodPt(statementPeriod)
    var summaryPeriodLabel = "Período a confirmar"
    if (periodPt != "") {
        summaryPeriodLabel = periodPt
    }
    var tip = invoiceEducationTipForSummary(s)
    var summary = buildInvoiceInteractionSummary(s, summaryPeriodLabel)
    var details = buildInvoiceInteractionDetails(rev, s, cleanName)

    var options: List<ChatInteractionOption> = listOf(
        ChatInteractionOption("opt_view_expenses", "Ver meus gastos", "VIEW_EXPENSES", "CONSULTAR_GASTOS", "chart", 0),
        ChatInteractionOption("opt_organize_caixinhas", "Organizar caixinhas", "ORGANIZE_CAIXINHAS", "CONFIRMAR_IMPORTACAO", "wallet", 0),
        ChatInteractionOption("opt_review_movements", "Revisar movimentações", "REVIEW_MOVEMENTS", "RECLASSIFICAR_MOVIMENTACOES", "checklist", s.pendingCount()),
        ChatInteractionOption("opt_understand_expenses", "Entender meus gastos", "UNDERSTAND_EXPENSES", "EXPLICAR_GASTOS", "book", 0)
    )

    var headline = "Consegui organizar seu extrato de " + periodPt.toLowerCase() + "!"
    if (periodPt == "") {
        headline = "Li o documento. Vamos confirmar o período antes de salvar."
    }

    return ChatInteractionPayload(
        "SINGLE_ACTION",
        "O que você quer fazer agora?",
        textOrNull(rev.documentId()),
        textOrNull(statementPeriod),
        textOrNull(periodPt),
        headline,
        tip,
        summary,
        details,
        options,
        listOf()
    )
}

ChatInteractionPayload buildInvoiceRegisterPayload(ImportReview rev, ImportFlowSummary s, String filename) {
    var cleanName = cleanInteractionFilename(filename, rev.documentId())
    var statementPeriod = lookupStatementPeriod(rev.documentId())
    var periodPt = formatPeriodPt(statementPeriod)
    var summaryPeriodLabel = "Período a confirmar"
    if (periodPt != "") {
        summaryPeriodLabel = periodPt
    }
    var summary = buildInvoiceInteractionSummary(s, summaryPeriodLabel)
    var details = buildInvoiceInteractionDetails(rev, s, cleanName)

    var selectable: List<ChatSelectableItem> = listOf()
    for (var ctx in rev.transactions()) {
        var fc = flowClassOf(ctx)
        var m = ctx.amountMinor()
        if ((fc == "DESPESA" || fc == "OPERACAO_CREDITO") && m != null && m > 0) {
            var catCode = sanitizeCategoryForConfirm(ctx.category())
            var ptLabel = categoryLabel(categoryOrNull(catCode))
            var desc = canonicalTxDisplayDesc(ctx, "Despesa")
            var sub = "Caixinha " + ptLabel
            var txDate = ctx.date()
            if (txDate != null && txDate.trim() != "") {
                sub = txDate.trim() + " · " + sub
            }
            if (fc == "OPERACAO_CREDITO") {
                sub = sub + " · Cartão de crédito"
            }
            selectable.add(ChatSelectableItem(ctx.id(), desc, ptLabel, catCode, formatBrl(m), minorToIntCents(m), sub, true))
        }
    }

    var options: List<ChatInteractionOption> = listOf()
    if (s.pendingCount() > 0) {
        options.add(ChatInteractionOption("opt_review_movements", "Revisar movimentações", "REVIEW_MOVEMENTS", "RECLASSIFICAR_MOVIMENTACOES", "checklist", s.pendingCount()))
    }

    var headline = "Confira e registre os gastos da sua fatura"
    if (periodPt != "") {
        headline = "Registre sua fatura de " + periodPt.toLowerCase() + " nas caixinhas"
    }

    return ChatInteractionPayload(
        "INVOICE_REGISTER",
        "Marque os lançamentos que deseja registrar nas suas caixinhas",
        textOrNull(rev.documentId()),
        textOrNull(statementPeriod),
        textOrNull(periodPt),
        headline,
        "Escolher cada gasto antes de salvar ajuda você a separar compras reais de pagamentos de fatura e transferências, mantendo suas caixinhas fiéis ao mês.",
        summary,
        details,
        options,
        selectable
    )
}

ChatInteractionPayload buildReviewChecklistPayload(ImportReview rev, ImportFlowSummary s, String filename) {
    var cleanName = cleanInteractionFilename(filename, rev.documentId())
    var statementPeriod = lookupStatementPeriod(rev.documentId())
    var periodPt = formatPeriodPt(statementPeriod)
    var summaryPeriodLabel = "Período a confirmar"
    if (periodPt != "") {
        summaryPeriodLabel = periodPt
    }
    var summary = buildInvoiceInteractionSummary(s, summaryPeriodLabel)
    var details = buildInvoiceInteractionDetails(rev, s, cleanName)

    var selectable: List<ChatSelectableItem> = listOf()
    for (var ctx in rev.transactions()) {
        var fc = flowClassOf(ctx)
        var m = ctx.amountMinor()
        if (fc == "PENDENTE_REVISAO" && m != null && m > 0) {
            var pNum = 1
            var rNum = 0
            var ev = ctx.evidence()
            if (ev != null) {
                var ep = ev.page()
                if (ep != null) { pNum = ep }
                var er = ev.row()
                if (er != null) { rNum = er }
            }
            var sub = "Página " + pNum + ", linha " + rNum
            var txDate = ctx.date()
            if (txDate != null && txDate.trim() != "") {
                sub = txDate.trim() + " · " + sub
            }
            selectable.add(ChatSelectableItem(ctx.id(), canonicalTxDisplayDesc(ctx, "Movimentação pendente"), "Pendente de revisão", "OTHER", formatBrl(m), minorToIntCents(m), sub, false))
        }
    }

    var options: List<ChatInteractionOption> = listOf(
        ChatInteractionOption("opt_organize_caixinhas", "Organizar caixinhas", "ORGANIZE_CAIXINHAS", "CONFIRMAR_IMPORTACAO", "wallet", 0)
    )

    return ChatInteractionPayload(
        "REVIEW_CHECKLIST",
        "Selecione as movimentações pendentes e escolha a caixinha",
        textOrNull(rev.documentId()),
        textOrNull(statementPeriod),
        textOrNull(periodPt),
        "Movimentações aguardando sua confirmação",
        "Itens sem estabelecimento claro (como Pix para pessoas) ficam fora dos seus gastos até você confirmar a categoria, evitando distorções no seu planejamento.",
        summary,
        details,
        options,
        selectable
    )
}

ChatInteractionPayload buildViewCategoriesPayload(ImportReview rev, ImportFlowSummary s, String filename) {
    var cleanName = cleanInteractionFilename(filename, rev.documentId())
    var statementPeriod = lookupStatementPeriod(rev.documentId())
    var periodPt = formatPeriodPt(statementPeriod)
    var summaryPeriodLabel = "Período a confirmar"
    if (periodPt != "") {
        summaryPeriodLabel = periodPt
    }
    var summary = buildInvoiceInteractionSummary(s, summaryPeriodLabel)
    var details = buildInvoiceInteractionDetails(rev, s, cleanName)

    var orderedCodes: List<String> = listOf()
    var totalsByCode: Map<String, Long> = mapOf()
    var countsByCode: Map<String, Int> = mapOf()
    var zero: Long = 0
    for (var ctx in rev.transactions()) {
        var fc = flowClassOf(ctx)
        var m = ctx.amountMinor()
        if ((fc == "DESPESA" || fc == "OPERACAO_CREDITO") && m != null && m > 0) {
            var code = sanitizeCategoryForConfirm(ctx.category())
            if (!orderedCodes.contains(code)) {
                orderedCodes.add(code)
            }
            totalsByCode.put(code, totalsByCode.getOrDefault(code, zero) + m)
            countsByCode.put(code, countsByCode.getOrDefault(code, 0) + 1)
        }
    }

    var selectable: List<ChatSelectableItem> = listOf()
    for (var code in orderedCodes) {
        var ptName = categoryLabel(categoryOrNull(code))
        var catMinor = totalsByCode.getOrDefault(code, zero)
        var cnt = countsByCode.getOrDefault(code, 0)
        var sub = cnt + " lançamentos"
        if (cnt == 1) {
            sub = "1 lançamento"
        }
        selectable.add(ChatSelectableItem(code, ptName, ptName, code, formatBrl(catMinor), minorToIntCents(catMinor), sub, true))
    }

    var options: List<ChatInteractionOption> = listOf(
        ChatInteractionOption("opt_organize_caixinhas", "Organizar caixinhas", "ORGANIZE_CAIXINHAS", "CONFIRMAR_IMPORTACAO", "wallet", 0)
    )

    return ChatInteractionPayload(
        "VIEW_CATEGORIES",
        "Marque as categorias que você quer visualizar",
        textOrNull(rev.documentId()),
        textOrNull(statementPeriod),
        textOrNull(periodPt),
        "Gastos da fatura por categoria",
        "Ver seus gastos separados por categoria ajuda a enxergar onde o dinheiro mais pesa no mês e onde dá para ajustar sem aperto.",
        summary,
        details,
        options,
        selectable
    )
}

ChatInteractionPayload buildInvoiceRegisteredPayload(String docId, String period, String periodLabel, Int savedCount, Long savedTotalCents, Bool wasDuplicate) {
    var pLabel = periodLabel
    if (pLabel == "") {
        pLabel = period
    }
    var headline = "Fatura registrada nas suas caixinhas!"
    var itemNote = "Atualizadas nas suas caixinhas sem duplicidade"
    if (wasDuplicate) {
        headline = "Fatura já estava registrada sem duplicidade"
        itemNote = "Registros preservados sem duplicidade"
    }
    var line = ChatFlowLineItem("Despesas registradas", formatBrl(savedTotalCents), savedCount, itemNote)
    var summary = ChatInteractionSummary(pLabel, "R$ 0,00", 0, listOf(), formatBrl(savedTotalCents), savedCount, listOf(line), "R$ 0,00", 0)
    return ChatInteractionPayload(
        "INVOICE_REGISTERED",
        "O que você quer acompanhar agora?",
        textOrNull(docId),
        textOrNull(period),
        textOrNull(pLabel),
        headline,
        "Com seus gastos confirmados no mês certo, suas caixinhas e o painel Gastos Calculados passam a refletir seu orçamento real.",
        summary,
        null,
        listOf(),
        listOf()
    )
}

InvoiceChatTurnResult? answerEducationalFinanceTurn(String userId, String rawMsg) {
    var lower = rawMsg.trim().toLowerCase()
    var topic = detectEducationalFinanceTopic(lower)
    if (topic == "") {
        return null
    }
    if (topic == "RECEITA_E_DESPESA") {
        return InvoiceChatTurnResult("De um jeito simples: receita é todo dinheiro que entra para você (como salário ou pagamento por um serviço), e despesa é o dinheiro que sai para pagar contas ou compras do dia a dia.\n\nExemplo hipotético: se uma pessoa recebe R$ 2.000,00 no mês (receita) e gasta R$ 150,00 na conta de luz (despesa), restam R$ 1.850,00 disponíveis. No Organiza AI, só consideramos renda profissional as entradas comprovadas, para você planejar seu mês com segurança.", null)
    }
    if (topic == "FIXOS_E_VARIAVEIS") {
        return InvoiceChatTurnResult("Gastos fixos são aqueles compromissos que se repetem todo mês com valor parecido (como aluguel, condomínio ou internet). Já os gastos variáveis mudam conforme sua rotina (como pedidos de comida, passeios ou transporte por aplicativo).\n\nExemplo hipotético: um aluguel de R$ 1.000,00 é um gasto fixo; já gastar R$ 80,00 em lanches na semana é um gasto variável, onde geralmente é mais fácil economizar quando o mês aperta.", null)
    }
    if (topic == "CREDITO_E_DISPONIVEL") {
        return InvoiceChatTurnResult("Dinheiro disponível é o saldo que você já tem na conta para usar no débito ou Pix comum: pagou, o valor sai na hora. Já o crédito (cartão ou Pix no cartão) é um valor emprestado pelo banco que só será cobrado na próxima fatura.\n\nExemplo hipotético: se você tem R$ 300,00 na conta e faz uma compra de R$ 100,00 no cartão de crédito, seus R$ 300,00 continuam na conta hoje, mas você já comprometeu R$ 100,00 da sua renda para quando a fatura vencer.", null)
    }
    if (topic == "PAGAMENTO_FATURA_DUPLA_CONTAGEM") {
        return InvoiceChatTurnResult("Quando você compra algo no cartão, cada compra já é um gasto. Se depois nós somarmos também o boleto de \"Pagamento de fatura\" como se fosse uma nova despesa, o mesmo valor seria contado duas vezes (dupla contagem).\n\nExemplo hipotético: se você fez duas compras de R$ 50,00 no cartão (total de R$ 100,00) e depois pagou a fatura de R$ 100,00, seu gasto real foi R$ 100,00, e não R$ 200,00. Por isso o Organiza AI separa o pagamento da fatura das despesas do mês.", null)
    }
    if (topic == "ORGANIZACAO_CAIXINHAS") {
        return InvoiceChatTurnResult("As caixinhas funcionam como envelopes separados para cada área da sua vida (como Alimentação, Moradia, Transporte ou Lazer), cada uma com um limite mensal editável. Assim você enxerga quanto já usou antes de o dinheiro acabar.\n\nExemplo hipotético: se sua caixinha Alimentação tem limite de R$ 400,00 e você registra R$ 100,00, ela fica \"Em dia\" (25%) e mostra que ainda restam R$ 300,00 para o restante do mês.", null)
    }
    if (topic == "RESERVA_EMERGENCIA") {
        return InvoiceChatTurnResult("A reserva de emergência é um valor guardado aos poucos para proteger você de imprevistos (como um gasto de saúde, conserto urgente ou queda na renda), evitando depender de empréstimos ou juros do cartão.\n\nExemplo hipotético: guardar R$ 100,00 por mês constrói em um ano uma reserva de R$ 1.200,00 pronta para dar tranquilidade nos momentos inesperados.", null)
    }
    if (topic == "PLANEJAMENTO_GASTOS") {
        return InvoiceChatTurnResult("Planejar os gastos significa dividir o que você ganha em três grandes partes antes de gastar: o essencial para viver (Necessidades), um espaço para aproveitar sem culpa (Folga ou Desejos) e uma parte para o seu futuro (Poupança).\n\nExemplo hipotético: com uma renda de R$ 3.000,00 na regra 70/20/10, ficam R$ 2.100,00 para necessidades, R$ 600,00 para folga e R$ 300,00 para poupança.", null)
    }
    if (topic == "ENTENDER_GASTOS") {
        var latest = findLatestFinancialDocumentRowByUser(userId)
        if (latest != null && (latest.status == "EM_REVISAO" || latest.status == "IMPORTADO")) {
            var lookup = lookupDocumentReview(latest.docKey, userId)
            var rev = lookup.review()
            if (rev != null) {
                var s = summarizeImportReview(rev)
                var msg = "No arquivo " + latest.filename + ", encontrei " + formatBrl(s.expenseMinor()) + " em compras identificadas. O pagamento da fatura fica separado para evitar contar as compras duas vezes. Ainda há " + formatBrl(s.pendingMinor()) + " em movimentações que precisam da sua confirmação."
                return InvoiceChatTurnResult(msg, buildInvoiceInteractionPayload(rev, s, latest.filename))
            }
        }
        return InvoiceChatTurnResult("Planejar seus gastos ajuda a enxergar para onde o dinheiro vai sem aperto: separamos as contas essenciais (Necessidades), o lazer do dia a dia (Folga) e o valor guardado (Poupança). Você pode me contar um gasto (ex.: \"30 reais em comida\") ou enviar uma fatura para analisarmos juntos.", null)
    }
    return null
}

