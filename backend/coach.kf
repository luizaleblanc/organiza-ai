// backend/coach.kf
// Módulo de IA Coach e Regras Cognitivas transpilado de Java para KOF.
// Cobre: CategoryBucketMapper, GetDailyPulseFunction, GetBalanceFunction,
// RegisterIncomeFunction, SuggestModelChangeFunction e KakeiboReflectionService.
// Compartilha escopo com backend/models.kf e backend/services.kf.

// =========================================================
// DTOs e Records do Coach
// =========================================================

record BucketBalanceDTO(String name, Int percentage, Double plannedAmount, Double spentAmount, Double remainingAmount)

record GetDailyPulseOutput(Double pulse, Int daysRemaining, Double totalSpent, Double salary, String? message)

record GetBalanceOutput(String model, List<BucketBalanceDTO> buckets, Double totalSpent, Double notAllocated)

record RegisterIncomeOutput(String destination, String message)

record SuggestModelChangeOutput(Bool shouldChange, String suggestedModel, String reason)

// =========================================================
// CategoryBucketMapper (Mapeamento de Categoria para Bucket)
// =========================================================

// Categorias essenciais (CategoryBucketMapper.NEEDS do legado).
Set<Category> needsCategories() {
    return setOf(Category.GROCERIES, Category.PHARMA, Category.HEALTH, Category.TRANSPORT, Category.HOUSING, Category.EDUCATION)
}

Bucket toStandardBucket(Category? category) {
    if (category != null && needsCategories().contains(category)) {
        return Bucket.NEEDS
    }
    return Bucket.WANTS
}

String toKakeiboBucket(Category? category) {
    if (category == null) {
        return "Extras"
    }
    if (needsCategories().contains(category)) {
        return "Essencial"
    }
    if (category == Category.SUBSCRIPTIONS) {
        return "Cultura"
    }
    if (category == Category.LEISURE || category == Category.FOOD) {
        return "Lazer"
    }
    return "Extras"
}

String? findPlanBucketName(List<BucketSummaryDTO> plan, List<String> candidates) {
    for (var cand in candidates) {
        for (var b in plan) {
            if (b.name == cand) {
                return b.name
            }
        }
    }
    return null
}

// Nome do bucket do plano que recebe o gasto da categoria e do Bucket explicitado na transacao.
// Busca pelo nome do bucket em vez de posicoes fixas no array.
String? planBucketForTx(BudgetModelType model, List<BucketSummaryDTO> plan, Category? category, Bucket? txBucket) {
    if (plan.size == 0) {
        return null
    }
    if (txBucket != null && (txBucket == Bucket.SAVINGS || txBucket == Bucket.DEBT_PAYMENT)) {
        var reserveName = findPlanBucketName(plan, listOf("Futuro", "Poupança", "Quitação de Dívida", "Guardar", "Reserva"))
        if (reserveName != null) {
            return reserveName
        }
    }
    if (model == BudgetModelType.KAKEIBO) {
        var kName = toKakeiboBucket(category)
        var matched = findPlanBucketName(plan, listOf(kName, "Extras"))
        if (matched != null) {
            return matched
        }
        return plan.get(0).name
    }
    if (model == BudgetModelType.FREELANCER_BASE_ZERO) {
        var baseName = findPlanBucketName(plan, listOf("Pró-labore"))
        if (baseName != null) {
            return baseName
        }
        return plan.get(0).name
    }
    if (plan.size == 2) {
        var simpleName = findPlanBucketName(plan, listOf("Viver"))
        if (simpleName != null) {
            return simpleName
        }
        return plan.get(0).name
    }
    if (toStandardBucket(category) == Bucket.NEEDS) {
        var needsName = findPlanBucketName(plan, listOf("Necessidades", "Essencial", "Viver", "Pró-labore"))
        if (needsName != null) {
            return needsName
        }
        return plan.get(0).name
    }
    var wantsName = findPlanBucketName(plan, listOf("Desejos", "Folga", "Pessoal", "Lazer", "Viver", "Pró-labore"))
    if (wantsName != null) {
        return wantsName
    }
    if (plan.size > 1) {
        return plan.get(1).name
    }
    return plan.get(0).name
}

String? planBucketFor(BudgetModelType model, List<BucketSummaryDTO> plan, Category? category) {
    return planBucketForTx(model, plan, category, null)
}

Bucket toBucket(BudgetModelType model, Category? category) {
    if (model == BudgetModelType.KAKEIBO) {
        var kBucket = toKakeiboBucket(category)
        if (kBucket == "Cultura") { return Bucket.CULTURAL }
        if (kBucket == "Lazer") { return Bucket.LEISURE }
        if (kBucket == "Extras") { return Bucket.EXTRAS }
        return Bucket.NEEDS
    }
    return toStandardBucket(category)
}

// =========================================================
// Repositório Kakeibo
// =========================================================

// Persistido com kof.orm em backend/store.kf (T6): findKakeiboReflection, saveKakeiboReflection
// (respostas em JSON na coluna answersJson; uma reflexao por usuario e semana).

// =========================================================
// GetDailyPulseFunction -> calculateDailyPulse
// =========================================================

GetDailyPulseOutput calculateDailyPulse(String userId, Int daysRemaining, String fromIso) {
    var user = findUserById(userId)
    if (user != null) {
        var salary = userSalary(user)

        var totalSpent = centsToReais(sumAmountByUserIdAndCreatedAtAfter(userId, fromIso))

        var remaining = salary - totalSpent
        if (remaining <= 0.0) {
            return GetDailyPulseOutput(0.0, daysRemaining, totalSpent, salary, "Você já comprometeu todo o salário deste mês.")
        }

        var pulse = math.roundTo(remaining / (daysRemaining * 1.0), 2)
        return GetDailyPulseOutput(pulse, daysRemaining, totalSpent, salary, null)
    }
    throw "Usuário não encontrado."
}

// =========================================================
// GetBalanceFunction -> calculateBalance
// =========================================================

GetBalanceOutput calculateBalance(String userId, String fromIso) {
    var user = findUserById(userId)
    if (user != null) {
        var salary = userSalary(user)
        var model = user.budgetModel
        var monthTransactions = findTransactionsByUserIdAndCreatedAtAfter(userId, fromIso)

        var plan = buildBudgetBuckets(model, salary)
        var resultBuckets: List<BucketBalanceDTO> = listOf()

        for (var b in plan) {
            var spent = monthTransactions
                .filter((t: TransactionEntity) -> planBucketForTx(model, plan, t.category, t.bucket) == b.name)
                .map((t: TransactionEntity) -> centsToReais(t.amountCents))
                .reduce((x: Double, y: Double) -> x + y, 0.0)
            var rem = b.amount - spent
            resultBuckets.add(BucketBalanceDTO(b.name, b.percentage, b.amount, spent, rem))
        }

        // O legado devolve null nos dois campos fora do Base Zero; aqui vao o gasto do mes e o que sobra do salario.
        var monthSpent = centsToReais(sumAmountCents(monthTransactions))
        return GetBalanceOutput(model.name(), resultBuckets, monthSpent, salary - monthSpent)
    }
    throw "Usuário não encontrado."
}

// =========================================================
// RegisterIncomeFunction -> registerUserIncome
// =========================================================

RegisterIncomeOutput registerUserIncome(String userId, Double amount, String source) {
    var lower = source.toLowerCase()
    if (listOf("salari", "salario", "fixo", "clt", "mensal").any((word: String) -> lower.contains(word))) {
        return RegisterIncomeOutput("SALARY", "Beleza, essa é a sua renda fixa. Ela já está considerada no seu orçamento mensal.")
    }

    // id "" = novo: o banco gera o id (PERS-06/07)
    var incomeItem = VariableIncomeEntity("", userId, amount, source, VariableIncomeDestination.EMERGENCY_FUND, nowIso())
    var saved = saveVariableIncome(incomeItem)

    if (saved.destination == VariableIncomeDestination.EMERGENCY_FUND) {
        return RegisterIncomeOutput(saved.destination.name(), "Boa! Coloquei esse valor direto na sua reserva de emergência até você bater a meta.")
    }

    var user = findUserById(userId)
    var modelName = "STANDARD_503020"
    if (user != null) {
        modelName = user.budgetModel.name()
    }

    return RegisterIncomeOutput(saved.destination.name(), "Sua reserva de emergência já está completa, então distribuí esse valor pelo seu modelo de orçamento (" + modelName + ").")
}

// =========================================================
// SuggestModelChangeFunction -> suggestModelChange
// =========================================================

SuggestModelChangeOutput suggestModelChange(String userId) {
    var user = findUserById(userId)
    if (user != null) {
        var currentModel = user.budgetModel
        if (currentModel == BudgetModelType.ANTI_DEBT_701020 && !user.hasDebt) {
            return SuggestModelChangeOutput(true, BudgetModelType.STANDARD_503020.name(), "Seu modelo atual é o Anti-Dívida, mas você não tem nenhuma dívida registrada. Faz mais sentido migrar para o modelo Padrão 50/30/20.")
        }
        return SuggestModelChangeOutput(false, currentModel.name(), "Seus gastos atuais estão aderentes ao modelo " + currentModel.name() + ".")
    }
    throw "Usuário não encontrado."
}

// =========================================================
// KakeiboReflectionService
// =========================================================

Bool shouldAskKakeiboReflection(String userId, String weekStart) {
    var user = findUserById(userId)
    if (user != null) {
        if (user.budgetModel != BudgetModelType.KAKEIBO) {
            return false
        }
        return findKakeiboReflection(userId, weekStart) == null
    }
    return false
}

KakeiboReflectionEntity recordKakeiboReflection(String userId, String weekStart, List<String> answers) {
    var user = findUserById(userId)
    if (user != null) {
        if (user.budgetModel != BudgetModelType.KAKEIBO) {
            throw "Usuário não está no modelo Kakeibo: " + userId
        }
        if (answers.size != 4) {
            throw "As 4 respostas do Kakeibo são obrigatórias."
        }

        var existing = findKakeiboReflection(userId, weekStart)
        if (existing != null) {
            return existing
        }

        var reflection = KakeiboReflectionEntity("", userId, weekStart, answers, nowIso())
        return saveKakeiboReflection(reflection)
    }
    throw "Usuário não encontrado: " + userId
}

String coachModelLabel(BudgetModelType model) {
    return switch (model) {
        case STANDARD_503020 -> "50/30/20"
        case SURVIVAL_702010 -> "70/20/10"
        case ANTI_DEBT_701020 -> "70/10/20 Anti-Dívida"
        case SIMPLE_8020 -> "80/20"
        case KAKEIBO -> "Kakeibo"
        case FREELANCER_BASE_ZERO -> "Base Zero (Profit First)"
    }
}

String buildBucketDivisionLines(BudgetModelType model, Double salary) {
    var buckets = buildBudgetBuckets(model, salary)
    var out = ""
    for (var b in buckets) {
        out = out + "- " + String.valueOf(b.percentage) + "% para " + b.name + ": " + formatBrl(toCents(b.amount)) + "\n"
    }
    return out
}

String extractFilenameFromChatMsg(String msg) {
    var pStart = msg.indexOf("Fatura ")
    if (pStart >= 0) {
        var pEnd = msg.indexOf(" processada", pStart)
        if (pEnd > pStart + 7) {
            return msg.substring(pStart + 7, pEnd).trim()
        }
    }
    var aStart = msg.indexOf("Arquivo ")
    if (aStart >= 0) {
        var aEnd = msg.indexOf(" enviado", aStart)
        if (aEnd > aStart + 8) {
            return msg.substring(aStart + 8, aEnd).trim()
        }
    }
    for (var rawTok in msg.split(" ")) {
        var tok = rawTok.trim().replace("!", "").replace(",", "").replace(";", "")
        var tl = tok.toLowerCase()
        if (tl.endsWith(".pdf") || tl.endsWith(".docx") || tl.endsWith(".png") || tl.endsWith(".jpg") || tl.endsWith(".jpeg") || tl.endsWith(".txt")) {
            return tok
        }
    }
    return ""
}

// AgentConsultorFinanceiro: resposta ancorada exclusivamente no KofDB (zero valores inventados).
String buildGroundedDocumentReply(String userId, UserEntity? user, FinancialDocumentRow docRow, Int step, Double fallbackSalary) {
    var txRows = findExtractedTransactionRowsByDoc(userId, docRow.docKey)
    if (docRow.status == "EXTRACAO_FALHOU" || txRows.isEmpty()) {
        return "Recebi o arquivo " + docRow.filename + ", mas a extração falhou (0 lançamentos identificados com segurança). Por segurança, bloqueei a análise financeira para não estimar nem inventar nenhum valor. Envie um PDF digital com texto selecionável ou me diga os lançamentos por texto."
    }

    var firstName = ""
    var model = BudgetModelType.SURVIVAL_702010
    var salary = fallbackSalary
    if (user != null) {
        if (user.name.trim() != "") {
            var sp = user.name.trim().indexOf(" ")
            if (sp > 0) {
                firstName = user.name.trim().substring(0, sp)
            } else {
                firstName = user.name.trim()
            }
        }
        model = user.budgetModel
        if (user.salaryCents > 0) {
            salary = centsToReais(user.salaryCents)
        }
    }

    var outflowCount = 0
    var outflowTotalMinor: Long = 0
    var pixOutMinor: Long = 0
    var cardExitMinor: Long = 0
    var paymentMinor: Long = 0
    var pixPfMinor: Long = 0
    var confirmedMerchantMinor: Long = 0
    var pjInflowMinor: Long = 0
    var pfInflowMinor: Long = 0
    var merchantExamples = ""
    var merchantCount = 0
    var sampleLines = ""
    var sampleCount = 0
    var paymentEvidence = ""
    var pixPfEvidence = ""
    var pjInflowDetails = ""

    for (var r in txRows) {
        var rLower = r.descriptionRaw.toLowerCase()
        var evRef = "(doc " + docRow.filename + ", pág. " + String.valueOf(r.pageNum) + ", reg. " + String.valueOf(r.rowNum) + ")"
        if (r.kind == "INCOME" || r.direction == "CREDIT") {
            if (r.categoryRule == "INCOME_PJ_NEEDS_REVIEW") {
                pjInflowMinor = pjInflowMinor + r.amountMinor
                var pjEntry = r.txDate + ": " + formatBrl(r.amountMinor) + " em " + r.descriptionNormalized + " " + evRef
                if (pjInflowDetails == "") {
                    pjInflowDetails = pjEntry
                } else {
                    pjInflowDetails = pjInflowDetails + "; " + pjEntry
                }
            } else if (r.kind == "INCOME") {
                pfInflowMinor = pfInflowMinor + r.amountMinor
            }
        } else {
            outflowCount = outflowCount + 1
            outflowTotalMinor = outflowTotalMinor + r.amountMinor
            if (r.kind == "PAYMENT") {
                paymentMinor = paymentMinor + r.amountMinor
                if (paymentEvidence == "") {
                    paymentEvidence = evRef
                }
            } else if (r.kind == "CARD_EXIT" || rLower.contains("pix crédito") || rLower.contains("pix credito")) {
                cardExitMinor = cardExitMinor + r.amountMinor
            } else if (r.kind == "PIX_OUT" || rLower.contains("pix enviado") || rLower.contains("envio de pix")) {
                pixOutMinor = pixOutMinor + r.amountMinor
            }

            if (r.categoryRule == "PIX_PF_NEEDS_REVIEW") {
                pixPfMinor = pixPfMinor + r.amountMinor
                if (pixPfEvidence == "") {
                    pixPfEvidence = evRef
                }
            } else if (r.reviewStatus == "CONFIRMED") {
                confirmedMerchantMinor = confirmedMerchantMinor + r.amountMinor
                if (merchantCount < 3) {
                    var mItem = formatBrl(r.amountMinor) + " em " + r.descriptionNormalized + " " + evRef
                    if (merchantExamples == "") {
                        merchantExamples = mItem
                    } else {
                        merchantExamples = merchantExamples + " e " + mItem
                    }
                    merchantCount = merchantCount + 1
                }
            }
            if (sampleCount < 4) {
                sampleLines = sampleLines + "- " + r.descriptionNormalized + ": " + formatBrl(r.amountMinor) + " " + evRef + "\n"
                sampleCount = sampleCount + 1
            }
        }
    }

    var greetPrefix = "Oi! "
    if (firstName != "") {
        greetPrefix = "Oi, " + firstName + "! "
    }
    var modelLabel = coachModelLabel(model)

    if (step == 1) {
        var internalNote = ""
        for (var w in docRow.warningsText.split("\n")) {
            if (w.contains("INTERNAL_TRANSFERS_FILTERED")) {
                internalNote = " e retirei movimentações internas para nada ficar contado duas vezes"
            }
        }
        var header = greetPrefix + "Li o arquivo " + docRow.filename + internalNote + ".\n\n"
        var inflowText = ""
        if (pjInflowMinor > 0) {
            inflowText = "Identifiquei " + formatBrl(pjInflowMinor) + " em créditos de origem PJ (" + pjInflowDetails + "), mas o extrato sozinho não comprova se todos são renda profissional recorrente.\n"
        }
        if (pixOutMinor > 0 && cardExitMinor > 0 && paymentMinor > 0) {
            return header + inflowText + "Nas saídas, encontrei " + String.valueOf(outflowCount) + " lançamentos somando " + formatBrl(outflowTotalMinor) + ":\n- " + formatBrl(pixOutMinor) + " em Pix enviados pela conta\n- " + formatBrl(cardExitMinor) + " em compras e Pix no cartão\n- " + formatBrl(paymentMinor) + " em pagamentos de faturas\n\nEsse total de " + formatBrl(outflowTotalMinor) + " confere com o que você esperava para o período?"
        }
        var detailBlock = sampleLines
        if (cardExitMinor > 0 && !detailBlock.contains(formatBrl(cardExitMinor))) {
            detailBlock = detailBlock + "- Compras e Pix no cartão: " + formatBrl(cardExitMinor) + "\n"
        }
        if (paymentMinor > 0 && !detailBlock.contains(formatBrl(paymentMinor))) {
            detailBlock = detailBlock + "- Pagamentos de faturas: " + formatBrl(paymentMinor) + "\n"
        }
        return header + inflowText + "Extraí " + String.valueOf(outflowCount) + " lançamentos de saída somando " + formatBrl(outflowTotalMinor) + ":\n" + detailBlock + "\nEsse total de " + formatBrl(outflowTotalMinor) + " confere com o que você esperava para o período?"
    }

    // Passo 2: Analise assertiva com rastreabilidade documental e pedido de confirmacao
    var analysis = "Conferi cada lançamento extraído de " + docRow.filename + ". O total de saídas fechou em " + formatBrl(outflowTotalMinor) + " (" + String.valueOf(outflowCount) + " lançamentos), mas prefiro não adivinhar categorias sem sua confirmação:\n\n"
    if (confirmedMerchantMinor > 0) {
        analysis = analysis + "- Gastos confirmados em estabelecimentos: " + merchantExamples + " (total confirmado: " + formatBrl(confirmedMerchantMinor) + ").\n"
    }
    if (paymentMinor > 0) {
        analysis = analysis + "- Pagamentos de faturas: " + formatBrl(paymentMinor) + " " + paymentEvidence + " (não dá para classificar como moradia ou contas fixas sem ver os itens dessas faturas, porque podem ser compras de meses anteriores).\n"
    }
    if (pixPfMinor > 0) {
        analysis = analysis + "- Pix para pessoas físicas: " + formatBrl(pixPfMinor) + " dentro de " + formatBrl(pixOutMinor) + " enviados por Pix " + pixPfEvidence + " (precisamos confirmar se foram despesas do mês, empréstimos ou transferências pessoais).\n"
    }
    if (pjInflowMinor > 0) {
        analysis = analysis + "- Entradas de origem PJ para confirmar: " + formatBrl(pjInflowMinor) + " (" + pjInflowDetails + ") — confirme se ambos os valores representam renda profissional antes de usar como base mensal.\n"
    }

    var refSalary = salary
    var userHasSalary = false
    if (user != null) {
        if (user.salaryCents > 0) {
            userHasSalary = true
        }
    }
    if (pjInflowMinor > 0 && !userHasSalary) {
        refSalary = centsToReais(pjInflowMinor)
    }
    analysis = analysis + "\nSobre o modelo " + modelLabel + " com base de " + formatBrl(toCents(refSalary)) + ":\n" + buildBucketDivisionLines(model, refSalary)
    if (pjInflowMinor > 0) {
        var ratioPct = ((outflowTotalMinor * 100.0) / (pjInflowMinor * 1.0))
        analysis = analysis + "\nEmbora " + formatBrl(outflowTotalMinor) + " equivalha a " + String.valueOf(math.roundTo(ratioPct, 1)) + "% de " + formatBrl(pjInflowMinor) + ", parte pode incluir faturas anteriores e transferências pessoais.\n"
    }
    return analysis + "\nAntes de eu salvar nas suas caixinhas e distribuir no modelo " + modelLabel + ", você confirma essas entradas e o que foram os Pix pessoais e pagamentos de faturas?"
}

// Resposta determinística / offline alinhada ao Tópico 10 (ChatWin)
String coachReplyOffline(String userId, String rawMsg, String monthStart) {
    var msg = rawMsg.trim()
    var lower = msg.toLowerCase()
    var user = findUserById(userId)
    var salary = 3000.0
    var model = BudgetModelType.STANDARD_503020
    if (user != null) {
        if (user.salaryCents > 0) {
            salary = centsToReais(user.salaryCents)
        }
        model = user.budgetModel
    }
    var modelLabel = coachModelLabel(model)
    var pulse = calculateDailyPulse(userId, daysRemainingInMonth(), monthStart)

    var history = findChatHistoryPage(userId, 1, 10, 0)
    var lastAssistantMsg = ""
    for (var m in history.items) {
        if (m.role == "ASSISTANT") {
            lastAssistantMsg = m.content
        }
    }

    // Bloqueio imediato quando o upload registrou falha de extracao / 0 lancamentos.
    if (lower.contains("0 lançamentos identificados") || lower.contains("0 lancamentos identificados") || lower.contains("falha na extração") || lower.contains("falha na extracao")) {
        var failName = extractFilenameFromChatMsg(msg)
        if (failName == "") {
            failName = "enviado"
        }
        return "Recebi o arquivo " + failName + ", mas a extração identificou 0 lançamentos com segurança. Por segurança, bloqueei a análise financeira para não estimar nem inventar nenhum valor. Envie um PDF digital com texto selecionável ou me informe os lançamentos por texto."
    }

    // 1. Confirmação final após o Passo 2 (antes de salvar nas caixinhas)
    if (lastAssistantMsg.contains("Antes de eu salvar nas suas caixinhas") || lastAssistantMsg.contains("distribua esses gastos na regra") || lastAssistantMsg.contains("Quer que eu distribua")) {
        var canceled = lower == "não" || lower == "nao" || lower.contains("cancela") || lower.contains("não salva") || lower.contains("nao salva") || lower.contains("não salvar") || lower.contains("nao salvar")
        if (canceled) {
            return "Combinado. Não salvei esses lançamentos nas caixinhas nem apliquei o modelo ainda. Quando quiser revisar algum valor, é só me dizer."
        }
        var confirmed = lower == "sim" || lower == "sim!" || lower.startsWith("sim,") || lower.startsWith("sim ") || lower.contains("confirm") || lower.contains("foram") || lower.contains("despesa") || lower.contains("pode salvar") || lower.contains("organizar") || lower.contains("distribua") || lower.contains("50/30/20") || lower.contains("70/20/10") || lower.contains("quero") || lower.contains("pode") || lower.contains("ok") || lastAssistantMsg.contains("Antes de eu salvar nas suas caixinhas")
        if (confirmed) {
            var salStr = formatBrl(toCents(salary))
            var divisionText = buildBucketDivisionLines(model, salary)
            return "Perfeito! Com a sua confirmação, salvei seus lançamentos confirmados nas caixinhas usando o modelo " + modelLabel + " para a renda base de " + salStr + ":\n\n" + divisionText + "\nOs valores foram organizados sem misturar faturas antigas nem transferências pessoais sem comprovação."
        }
    }

    // 2. Confirmação do total lido no Passo 1 -> entrega análise assertiva do Passo 2 baseada no KofDB
    var awaitingTotalConfirmation = lastAssistantMsg.contains("Esse total") || lastAssistantMsg.contains("confere com o que você esperava") || lastAssistantMsg.contains("Você confirma se esse valor total está certo") || lastAssistantMsg.contains("Confirma pra mim se esse é o valor total")
    var userConfirmedTotal = lower == "sim" || lower == "sim!" || lower.startsWith("sim ") || lower.startsWith("sim,") || lower.contains("confir") || lower.contains("confer") || lower.contains("certo") || lower.contains("ok") || lower.contains("isso") || lower.contains("bate") || lower.contains("exato")
    if ((awaitingTotalConfirmation && userConfirmedTotal) || lower.contains("confirmo") || lower.contains("confirma") || lower.contains("confirmar")) {
        var latestDoc = findLatestFinancialDocumentRowByUser(userId)
        if (latestDoc != null) {
            return buildGroundedDocumentReply(userId, user, latestDoc, 2, salary)
        }
        var userTxs = findTransactionsByUserIdAndCreatedAtAfter(userId, monthStart)
        var invoiceTxs = userTxs.filter((t: TransactionEntity) -> t.source == Source.INVOICE)
        if (invoiceTxs.size > 0) {
            var groups = invoiceTxs.groupBy((t: TransactionEntity) -> categoryText(t.category))
            var catLines = ""
            for (var cname in groups.keys()) {
                var cCents = sumAmountCents(groups.getOrDefault(cname, listOf()))
                catLines = catLines + "- " + cname + ": " + formatBrl(cCents) + "\n"
            }
            var numCats = groups.keys().size
            return "Conferi seus lançamentos confirmados no histórico e encontrei " + String.valueOf(numCats) + " grupos:\n\n" + catLines + "\nAntes de eu salvar nas suas caixinhas e distribuir no modelo " + modelLabel + ", você confirma se essas categorias estão certinhas?"
        }
        return "Ainda não encontrei nenhum documento financeiro processado para confirmar os lançamentos. Envie sua fatura ou extrato primeiro para eu analisar os dados reais."
    }

    // 3. Fatura / extrato recebido (PDF, PNG, JPEG, DOCX) -> Passo 1 (leitura exclusiva do KofDB)
    if (lower.contains("fatura") || lower.contains("extrato") || lower.contains(".pdf") || lower.contains(".docx") || lower.contains(".jpeg") || lower.contains(".jpg") || lower.contains(".png")) {
        var fname = extractFilenameFromChatMsg(msg)
        var docRow = findLatestFinancialDocumentRowByUser(userId)
        if (fname != "") {
            var byName = findLatestFinancialDocumentRowByUserAndFilename(userId, fname)
            if (byName != null) {
                docRow = byName
            }
        }
        if (docRow != null) {
            return buildGroundedDocumentReply(userId, user, docRow, 1, salary)
        }
        return "Ainda não encontrei esse arquivo processado no seu histórico de documentos. Tente enviar o anexo novamente ou informe os valores por texto."
    }

    // 3b. GATE 4: Consulta deterministica de gastos em linguagem natural / voz (CONSULTAR_GASTOS)
    if (lower.contains("quanto gastei") || lower.contains("quanto eu gastei") || lower.contains("quanto ja gastei") || lower.contains("quanto já gastei") || lower.contains("meus gastos") || lower.contains("total de gastos") || lower.contains("consultar gastos")) {
        var catCode = "ALL"
        var catPt = "todas as categorias"
        if (lower.contains("delivery") || lower.contains("ifood") || lower.contains("restaurante") || lower.contains("alimentacao") || lower.contains("alimentação") || lower.contains("comida") || lower.contains("lanche") || lower.contains("almoço") || lower.contains("almoco")) {
            catCode = "FOOD"
            catPt = "alimentação e delivery"
        } else if (lower.contains("mercado") || lower.contains("supermercado") || lower.contains("hortifruti")) {
            catCode = "GROCERIES"
            catPt = "mercado"
        } else if (lower.contains("transporte") || lower.contains("uber") || lower.contains("99")) {
            catCode = "TRANSPORT"
            catPt = "transporte"
        } else if (lower.contains("moradia") || lower.contains("aluguel") || lower.contains("conta") || lower.contains("luz") || lower.contains("internet")) {
            catCode = "HOUSING"
            catPt = "moradia e contas"
        } else if (lower.contains("lazer") || lower.contains("bebida") || lower.contains("cinema")) {
            catCode = "LEISURE"
            catPt = "lazer"
        } else if (lower.contains("farmacia") || lower.contains("farmácia") || lower.contains("remedio") || lower.contains("remédio")) {
            catCode = "PHARMA"
            catPt = "farmácia"
        } else if (lower.contains("saude") || lower.contains("saúde") || lower.contains("medico") || lower.contains("médico")) {
            catCode = "HEALTH"
            catPt = "saúde"
        } else if (lower.contains("assinatura") || lower.contains("streaming") || lower.contains("netflix")) {
            catCode = "SUBSCRIPTIONS"
            catPt = "assinaturas"
        }
        var periodKey = "month"
        var periodLabel = "neste mês"
        if (lower.contains("semana")) {
            periodKey = "week"
            periodLabel = "nesta semana"
        } else if (lower.contains("ano")) {
            periodKey = "year"
            periodLabel = "neste ano"
        } else if (lower.contains("novembro")) {
            periodKey = "2026-11"
            periodLabel = "em novembro"
        } else if (lower.contains("tudo") || lower.contains("total geral")) {
            periodKey = "all"
            periodLabel = "em todo o histórico"
        }
        var queried = queryConfirmedExpenses(userId, periodKey, catCode)
        if (queried.count() == 0) {
            return "Ainda não há lançamentos confirmados em " + catPt + " " + periodLabel + ". Quando você confirmar uma fatura ou registrar um gasto por aqui, eu atualizo esse total na hora."
        }
        return "Nos lançamentos confirmados " + periodLabel + " em " + catPt + ", você gastou " + formatBrl(queried.totalMinor()) + " distribuídos em " + queried.count() + " registro(s)."
    }

    // 4. Registro de gastos por texto / voz
    if (lower.contains("gastei") || lower.contains("gasto") || lower.contains("comprei") || lower.contains("paguei")) {
        var registeredCats: List<String> = listOf()
        var parts = lower.split(" e ")
        for (var part in parts) {
            var words = part.trim().split(" ")
            var amt = 0.0
            var catName = ""
            var catEnum = Category.OTHER
            for (var w in words) {
                var clean = w.replace("r$", "").replace("$", "").replace(",", ".").trim()
                if (clean.length() > 0 && strings.isNumeric(clean.replace(".", ""))) {
                    try {
                        amt = clean.toDouble()
                    } catch (Exception e) {}
                }
            }
            if (part.contains("almoço") || part.contains("almoco") || part.contains("restaurante") || part.contains("lanche") || part.contains("comida") || part.contains("food")) {
                catName = "alimentação"
                catEnum = Category.FOOD
            } else if (part.contains("mercado") || part.contains("supermercado") || part.contains("feira") || part.contains("hortifruti")) {
                catName = "mercado"
                catEnum = Category.GROCERIES
            } else if (part.contains("farmacia") || part.contains("farmácia") || part.contains("drogaria") || part.contains("remedio")) {
                catName = "farmácia"
                catEnum = Category.PHARMA
            } else if (part.contains("uber") || part.contains("99") || part.contains("transporte") || part.contains("onibus")) {
                catName = "transporte"
                catEnum = Category.TRANSPORT
            } else if (part.contains("gasolina") || part.contains("combustivel") || part.contains("posto")) {
                catName = "combustível"
                catEnum = Category.AUTO
            }
            if (amt > 0.0) {
                insertTransaction(TransactionEntity("", catName, toCents(amt), catEnum, "BRL", userId, Bucket.NEEDS, Source.MANUAL, nowIso(), null))
                if (catName.length() > 0 && !registeredCats.contains(catName)) {
                    registeredCats.add(catName)
                }
            }
        }
        var updatedPulse = calculateDailyPulse(userId, daysRemainingInMonth(), monthStart)
        var pNow = formatBrl(toCents(updatedPulse.pulse))
        var pEco = formatBrl(toCents(updatedPulse.pulse * 0.75))
        var catsText = "alimentação, mercado"
        if (registeredCats.size > 0) {
            catsText = ""
            var ci = 0
            while (ci < registeredCats.size) {
                if (ci > 0) { catsText = catsText + ", " }
                catsText = catsText + registeredCats.get(ci)
                ci = ci + 1
            }
        }
        return "Beleza! Seus gastos (" + catsText + ") foram registrados. Seu pulso atual para terminar o mês no azul é de " + pNow + "/dia. Se quiser dar uma economizada, seu pulso é de " + pEco + "/dia."
    }

    // 5. Fallback com o tom do Organiza AI
    return "Olá! Seu pulso diário disponível hoje é " + formatBrl(toCents(pulse.pulse)) + ". Me fala seus gastos aí. Você pode digitar, falar por voz ou enviar sua fatura por aqui que eu leio e organizo tudo pra você."
}

