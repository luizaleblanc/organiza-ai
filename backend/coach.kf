// backend/coach.kf
// Módulo de IA Coach e Regras Cognitivas transpilado de Java para KOF.
// Cobre: CategoryBucketMapper, GetDailyPulseFunction, GetBalanceFunction,
// RegisterIncomeFunction, SuggestModelChangeFunction e KakeiboReflectionService.
// Compartilha escopo com backend/models.kf e backend/services.kf.

// =========================================================
// DTOs e Records do Coach
// =========================================================

record BucketBalanceDTO(String name, Int percentage, Double plannedAmount, Double spentAmount, Double remainingAmount)

record GetDailyPulseOutput(Double pulse, Int daysRemaining, Double totalSpent, Double salary, String? message)

record GetBalanceOutput(String model, List<BucketBalanceDTO> buckets, Double totalSpent, Double notAllocated)

record RegisterIncomeOutput(String destination, String message)

record SuggestModelChangeOutput(Bool shouldChange, String suggestedModel, String reason)

// =========================================================
// CategoryBucketMapper (Mapeamento de Categoria para Bucket)
// =========================================================

// Categorias essenciais (CategoryBucketMapper.NEEDS do legado).
Set<Category> needsCategories() {
    return setOf(Category.GROCERIES, Category.PHARMA, Category.HEALTH, Category.TRANSPORT, Category.HOUSING, Category.EDUCATION)
}

Bucket toStandardBucket(Category? category) {
    if (category != null && needsCategories().contains(category)) {
        return Bucket.NEEDS
    }
    return Bucket.WANTS
}

String toKakeiboBucket(Category? category) {
    if (category == null) {
        return "Extras"
    }
    if (needsCategories().contains(category)) {
        return "Essencial"
    }
    if (category == Category.SUBSCRIPTIONS) {
        return "Cultura"
    }
    if (category == Category.LEISURE || category == Category.FOOD) {
        return "Lazer"
    }
    return "Extras"
}

// Nome do bucket do plano que recebe o gasto da categoria (mesma regra do GetBalance do legado):
// Kakeibo pelo nome; plano de 2 buckets (80/20) tudo no primeiro; com 3 ou mais, essencial no primeiro
// e o resto no segundo. Base Zero (sem buckets) = null.
String? planBucketFor(BudgetModelType model, List<BucketSummaryDTO> plan, Category? category) {
    if (model == BudgetModelType.KAKEIBO) {
        return toKakeiboBucket(category)
    }
    if (plan.size == 2) {
        return plan.get(0).name
    }
    if (plan.size > 2) {
        if (toStandardBucket(category) == Bucket.NEEDS) {
            return plan.get(0).name
        }
        return plan.get(1).name
    }
    return null
}

Bucket toBucket(BudgetModelType model, Category? category) {
    if (model == BudgetModelType.KAKEIBO) {
        var kBucket = toKakeiboBucket(category)
        if (kBucket == "Cultura") { return Bucket.CULTURAL }
        if (kBucket == "Lazer") { return Bucket.LEISURE }
        if (kBucket == "Extras") { return Bucket.EXTRAS }
        return Bucket.NEEDS
    }
    return toStandardBucket(category)
}

// =========================================================
// Repositório Kakeibo
// =========================================================

// Persistido com kof.orm em backend/store.kf (T6): findKakeiboReflection, saveKakeiboReflection
// (respostas em JSON na coluna answersJson; uma reflexao por usuario e semana).

// =========================================================
// GetDailyPulseFunction -> calculateDailyPulse
// =========================================================

GetDailyPulseOutput calculateDailyPulse(String userId, Int daysRemaining, String fromIso) {
    var user = findUserById(userId)
    if (user != null) {
        var salary = userSalary(user)

        var totalSpent = centsToReais(sumAmountByUserIdAndCreatedAtAfter(userId, fromIso))

        var remaining = salary - totalSpent
        if (remaining <= 0.0) {
            return GetDailyPulseOutput(0.0, daysRemaining, totalSpent, salary, "Você já comprometeu todo o salário deste mês.")
        }

        var pulse = math.roundTo(remaining / (daysRemaining * 1.0), 2)
        return GetDailyPulseOutput(pulse, daysRemaining, totalSpent, salary, null)
    }
    throw "Usuário não encontrado."
}

// =========================================================
// GetBalanceFunction -> calculateBalance
// =========================================================

GetBalanceOutput calculateBalance(String userId, String fromIso) {
    var user = findUserById(userId)
    if (user != null) {
        var salary = userSalary(user)
        var model = user.budgetModel
        var monthTransactions = findTransactionsByUserIdAndCreatedAtAfter(userId, fromIso)

        if (model == BudgetModelType.FREELANCER_BASE_ZERO) {
            var totalSpent = monthTransactions.map((t: TransactionEntity) -> centsToReais(t.amountCents)).reduce((a: Double, b: Double) -> a + b, 0.0)
            var notAllocated = salary - totalSpent
            var emptyList: List<BucketBalanceDTO> = listOf()
            return GetBalanceOutput(model.name(), emptyList, totalSpent, notAllocated)
        }

        var plan = buildBudgetBuckets(model, salary)
        var resultBuckets: List<BucketBalanceDTO> = listOf()

        if (model == BudgetModelType.KAKEIBO) {
            for (var b in plan) {
                var spent = monthTransactions
                    .filter((t: TransactionEntity) -> toKakeiboBucket(t.category) == b.name)
                    .map((t: TransactionEntity) -> centsToReais(t.amountCents))
                    .reduce((x: Double, y: Double) -> x + y, 0.0)
                var rem = b.amount - spent
                resultBuckets.add(BucketBalanceDTO(b.name, b.percentage, b.amount, spent, rem))
            }
        } else {
            var needsSpent = 0.0
            var wantsSpent = 0.0
            for (var t in monthTransactions) {
                var bucket = toStandardBucket(t.category)
                if (bucket == Bucket.NEEDS) {
                    needsSpent = needsSpent + centsToReais(t.amountCents)
                } else {
                    wantsSpent = wantsSpent + centsToReais(t.amountCents)
                }
            }

            if (plan.size == 2) {
                var first = plan.get(0)
                var totalSpent = needsSpent + wantsSpent
                resultBuckets.add(BucketBalanceDTO(first.name, first.percentage, first.amount, totalSpent, first.amount - totalSpent))
                if (plan.size > 1) {
                    var second = plan.get(1)
                    resultBuckets.add(BucketBalanceDTO(second.name, second.percentage, second.amount, 0.0, second.amount))
                }
            } else if (plan.size >= 2) {
                var first = plan.get(0)
                resultBuckets.add(BucketBalanceDTO(first.name, first.percentage, first.amount, needsSpent, first.amount - needsSpent))
                var second = plan.get(1)
                resultBuckets.add(BucketBalanceDTO(second.name, second.percentage, second.amount, wantsSpent, second.amount - wantsSpent))
                var i = 2
                while (i < plan.size) {
                    var other = plan.get(i)
                    resultBuckets.add(BucketBalanceDTO(other.name, other.percentage, other.amount, 0.0, other.amount))
                    i = i + 1
                }
            }
        }

        // O legado devolve null nos dois campos fora do Base Zero; aqui vao o gasto do mes e o que sobra do salario.
        var monthSpent = centsToReais(sumAmountCents(monthTransactions))
        return GetBalanceOutput(model.name(), resultBuckets, monthSpent, salary - monthSpent)
    }
    throw "Usuário não encontrado."
}

// =========================================================
// RegisterIncomeFunction -> registerUserIncome
// =========================================================

RegisterIncomeOutput registerUserIncome(String userId, Double amount, String source) {
    var lower = source.toLowerCase()
    if (listOf("salari", "salario", "fixo", "clt", "mensal").any((word: String) -> lower.contains(word))) {
        return RegisterIncomeOutput("SALARY", "Beleza, essa é a sua renda fixa. Ela já está considerada no seu orçamento mensal.")
    }

    // id "" = novo: o banco gera o id (PERS-06/07)
    var incomeItem = VariableIncomeEntity("", userId, amount, source, VariableIncomeDestination.EMERGENCY_FUND, nowIso())
    var saved = saveVariableIncome(incomeItem)

    if (saved.destination == VariableIncomeDestination.EMERGENCY_FUND) {
        return RegisterIncomeOutput(saved.destination.name(), "Boa! Coloquei esse valor direto na sua reserva de emergência até você bater a meta.")
    }

    var user = findUserById(userId)
    var modelName = "STANDARD_503020"
    if (user != null) {
        modelName = user.budgetModel.name()
    }

    return RegisterIncomeOutput(saved.destination.name(), "Sua reserva de emergência já está completa, então distribuí esse valor pelo seu modelo de orçamento (" + modelName + ").")
}

// =========================================================
// SuggestModelChangeFunction -> suggestModelChange
// =========================================================

SuggestModelChangeOutput suggestModelChange(String userId) {
    var user = findUserById(userId)
    if (user != null) {
        var currentModel = user.budgetModel
        if (currentModel == BudgetModelType.ANTI_DEBT_701020 && !user.hasDebt) {
            return SuggestModelChangeOutput(true, BudgetModelType.STANDARD_503020.name(), "Seu modelo atual é o Anti-Dívida, mas você não tem nenhuma dívida registrada. Faz mais sentido migrar para o modelo Padrão 50/30/20.")
        }
        return SuggestModelChangeOutput(false, currentModel.name(), "Seus gastos atuais estão aderentes ao modelo " + currentModel.name() + ".")
    }
    throw "Usuário não encontrado."
}

// =========================================================
// KakeiboReflectionService
// =========================================================

Bool shouldAskKakeiboReflection(String userId, String weekStart) {
    var user = findUserById(userId)
    if (user != null) {
        if (user.budgetModel != BudgetModelType.KAKEIBO) {
            return false
        }
        return findKakeiboReflection(userId, weekStart) == null
    }
    return false
}

KakeiboReflectionEntity recordKakeiboReflection(String userId, String weekStart, List<String> answers) {
    var user = findUserById(userId)
    if (user != null) {
        if (user.budgetModel != BudgetModelType.KAKEIBO) {
            throw "Usuário não está no modelo Kakeibo: " + userId
        }
        if (answers.size != 4) {
            throw "As 4 respostas do Kakeibo são obrigatórias."
        }

        var existing = findKakeiboReflection(userId, weekStart)
        if (existing != null) {
            return existing
        }

        var reflection = KakeiboReflectionEntity("", userId, weekStart, answers, nowIso())
        return saveKakeiboReflection(reflection)
    }
    throw "Usuário não encontrado: " + userId
}

