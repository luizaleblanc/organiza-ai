// =========================================================
// shared/service/TierEnforcementService.java
// O corte do mes (monthStartIso) vem do chamador; as rotas passam monthStartIso() (issue #44).
// =========================================================

// Limite do plano Gratuito (legado: FREE_MESSAGE_LIMIT).
Int freeMessageLimit() {
    return 30
}

TierStatus getTierStatus(String userId, String monthStartIso) {
    var user = findUserById(userId)
    if (user != null) {
        var messagesUsed = countChatMessagesByUserIdAndRoleAndCreatedAtGreaterThanEqual(userId, ChatRole.USER, monthStartIso)

        if (user.tier == Tier.PREMIUM) {
            return TierStatus(Tier.PREMIUM.name(), messagesUsed, -1, true, true)
        }

        return TierStatus(Tier.FREE.name(), messagesUsed, freeMessageLimit(), false, messagesUsed < freeMessageLimit())
    }
    throw "User not found."
}

void enforceCanSendMessage(String userId, String monthStartIso) {
    var status = getTierStatus(userId, monthStartIso)
    if (!status.canSendMessage()) {
        throw "Você atingiu o limite de 30 mensagens gratuitas este mês."
    }
}

void enforceVoiceAllowed(String userId, String monthStartIso) {
    var status = getTierStatus(userId, monthStartIso)
    if (!status.voiceEnabled()) {
        throw "Entrada por voz disponível apenas no plano Premium."
    }
}

// =========================================================
// B4: bucket da caixinha validado contra os buckets do modelo atual do usuario
// =========================================================

// null = valido. Bucket ausente e valido (fica derivado da categoria); "" ou nome fora do modelo = erro.
String? envelopeBucketError(UserEntity user, String? bucket) {
    if (bucket == null) {
        return null
    }
    var names = buildBudgetBuckets(user.budgetModel, userSalary(user)).map((b: BucketSummaryDTO) -> b.name())
    if (!names.contains(bucket)) {
        return "Bucket inválido para o seu modelo: " + bucket
    }
    return null
}

// =========================================================
// B3: confirmar e gravar em lote os itens extraidos da fatura (L6)
// =========================================================

record InvoiceConfirmItem(String description, Double amount, String category)
record InvoiceConfirmRequest(List<InvoiceConfirmItem> items, String? documentId)
record InvoiceConfirmResponse(Int saved, List<TransactionOutput> transactions)

Int invoiceConfirmMaxItems() {
    return 100
}

InvoiceConfirmRequest? decodeInvoiceConfirmRequest(String raw) {
    try {
        var req = json.decode<InvoiceConfirmRequest>(raw)
        if (req.items() == null) {
            return null
        }
        return req
    } catch (String e) {
        return null
    }
}

// null = item valido; senao a mensagem (com o indice, base 0) para o 400. Nada e gravado se um falhar.
String? validateInvoiceItemFields(String? description, Double amount, String? category, Int index) {
    var prefix = "Item " + index + ": "
    if (description == null) {
        return prefix + "campos obrigatórios: description, amount, category."
    }
    if (category == null) {
        return prefix + "campos obrigatórios: description, amount, category."
    }
    if (isBlank(description) || description.length() > maxTextLength()) {
        return prefix + "descrição inválida."
    }
    if (amount <= 0.0 || amount > 1000000000.0) {
        return prefix + "o valor deve ser maior que zero."
    }
    if (Category.valueOf(category) == null) {
        return prefix + "categoria inválida: " + category
    }
    return null
}

String? invoiceItemError(InvoiceConfirmItem item, Int index) {
    if (item == null || item.amount() == null) {
        return "Item " + index + ": campos obrigatórios: description, amount, category."
    }
    return validateInvoiceItemFields(item.description(), item.amount(), item.category(), index)
}

String? invoiceItemsError(List<InvoiceConfirmItem> items) {
    if (items.size == 0) {
        return "Nenhum item para gravar."
    }
    if (items.size > invoiceConfirmMaxItems()) {
        return "Itens demais (máximo de " + invoiceConfirmMaxItems() + " por chamada)."
    }
    var i = 0
    while (i < items.size) {
        var err = invoiceItemError(items.get(i), i)
        if (err != null) {
            return err
        }
        i = i + 1
    }
    return null
}

void notifyBatchEnvelopeCrossings(String userId, List<TransactionEntity> newlySaved) {
    var envIds: List<String> = listOf()
    for (var t in newlySaved) {
        var id = nullToText(t.envelopeId)
        if (id != "" && !envIds.contains(id)) {
            envIds.add(id)
        }
    }
    for (var envId in envIds) {
        notifyEnvelopeCrossing(userId, envId, sumAmountCents(newlySaved.filter((t: TransactionEntity) -> t.envelopeId == envId)))
    }
}

// O transaction {} fica numa funcao propria, fora de qualquer try (COMP002). Grava as linhas, os
// descontos das caixinhas e o controle do onboarding na conexao da transacao; qualquer erro desfaz o lote inteiro.
List<TransactionEntity> insertInvoiceBatch(String tx, List<TransactionEntity> rows, String userId) {
    var user = findUserById(userId)
    var saved: List<TransactionEntity> = listOf()
    transaction {
        for (var t in rows) {
            var row = insertTransactionOn(tx, t)
            saved.add(row)
            var envId = t.envelopeId
            if (envId != null) {
                addEnvelopeSpentCentsOn(tx, userId, envId, t.amountCents)
            }
            if (user != null) {
                syncOnboardingControlSpentOn(tx, row, user)
            }
        }
    }
    return saved
}

// Itens ja validados (invoiceItemsError). Caixinha resolvida pela categoria, so entre as do usuario.
List<TransactionOutput> confirmInvoiceItems(String userId, List<InvoiceConfirmItem> items) {
    var rows = items.map((it: InvoiceConfirmItem) -> invoiceItemToEntity(userId, it))
    var saved: List<TransactionEntity> = listOf()
    var token = DbConn.lock.receive()
    try {
        var tx = txConnection()
        try {
            saved = insertInvoiceBatch(tx, rows, userId)
        } catch (String e) {
            dropTxConnection()
            log.warn("lote da fatura desfeito (rollback)")
            throw "Não foi possível gravar os itens da fatura."
        }
    } finally {
        DbConn.lock.send(token)
    }
    notifyBatchEnvelopeCrossings(userId, saved)
    return saved.map((t: TransactionEntity) -> transactionEntityToOutput(t))
}

TransactionEntity invoiceItemToEntity(String userId, InvoiceConfirmItem item) {
    var category = Category.valueOf(item.category())
    var envId = resolveEnvelopeId(userId, null, category)
    return TransactionEntity("", item.description().trim(), toCents(item.amount()), category, "BRL", userId, null, Source.INVOICE, nowIso(), envId)
}

// =========================================================
// Confirmacao rastreavel da fatura (proveniencia + deduplicacao por externalRef no banco)
// =========================================================

record InvoiceConfirmTraceItem(String description, Double amount, String category, String documentId, Int sourcePage, Int sourceLine, String externalRef, String? txDate)
record InvoiceTraceRowInput(TransactionEntity txEntity, String? documentId, Int? sourcePage, Int? sourceLine, String? externalRef)
record InvoiceTraceBatchEntry(TransactionWithProvenance item, Bool inserted)

String? invoiceTraceItemError(InvoiceConfirmTraceItem item, Int index) {
    if (item == null || item.amount() == null) {
        return "Item " + index + ": campos obrigatórios: description, amount, category."
    }
    return validateInvoiceItemFields(item.description(), item.amount(), item.category(), index)
}

String? invoiceTraceItemsError(List<InvoiceConfirmTraceItem> items) {
    if (items.size == 0) {
        return "Nenhum item para gravar."
    }
    if (items.size > invoiceConfirmMaxItems()) {
        return "Itens demais (máximo de " + invoiceConfirmMaxItems() + " por chamada)."
    }
    var i = 0
    while (i < items.size) {
        var err = invoiceTraceItemError(items.get(i), i)
        if (err != null) {
            return err
        }
        i = i + 1
    }
    return null
}

InvoiceTraceRowInput invoiceTraceItemToInput(String userId, InvoiceConfirmTraceItem item) {
    var category = Category.valueOf(item.category())
    var envId = resolveEnvelopeId(userId, null, category)
    var createdAtIso = nowIso()
    var rawTxDate = item.txDate()
    if (rawTxDate != null && rawTxDate.trim().length() >= 10) {
        createdAtIso = rawTxDate.trim()
    }
    var txObj = TransactionEntity("", item.description().trim(), toCents(item.amount()), category, "BRL", userId, null, Source.INVOICE, createdAtIso, envId)
    return InvoiceTraceRowInput(txObj, cleanOptionalText(item.documentId()), intOrNull(item.sourcePage()), intOrNull(item.sourceLine()), cleanOptionalText(item.externalRef()))
}

List<InvoiceTraceBatchEntry> insertInvoiceTraceBatch(String tx, List<InvoiceTraceRowInput> rows, String userId) {
    var user = findUserById(userId)
    var result: List<InvoiceTraceBatchEntry> = listOf()
    transaction {
        for (var item in rows) {
            var extRef = nullToText(item.externalRef)
            var existing = findTransactionWithProvenanceByUserAndExternalRefOn(tx, userId, extRef)
            if (existing != null) {
                result.add(InvoiceTraceBatchEntry(existing, false))
            } else {
                var savedEntity = insertTransactionWithProvenanceOn(tx, item.txEntity, item.documentId, item.sourcePage, item.sourceLine, item.externalRef)
                var savedProv = TransactionWithProvenance(savedEntity, item.documentId, item.sourcePage, item.sourceLine, item.externalRef)
                result.add(InvoiceTraceBatchEntry(savedProv, true))
                var envId = item.txEntity.envelopeId
                if (envId != null) {
                    addEnvelopeSpentCentsOn(tx, userId, envId, item.txEntity.amountCents)
                }
                if (user != null) {
                    syncOnboardingControlSpentOn(tx, savedEntity, user)
                }
            }
        }
    }
    return result
}

List<TransactionOutput> confirmInvoiceItemsWithTraceability(String userId, List<InvoiceConfirmTraceItem> items) {
    var err = invoiceTraceItemsError(items)
    if (err != null) {
        throw "Validação da fatura: " + err
    }
    var rows = items.map((it: InvoiceConfirmTraceItem) -> invoiceTraceItemToInput(userId, it))
    var entries: List<InvoiceTraceBatchEntry> = listOf()
    var token = DbConn.lock.receive()
    try {
        var tx = txConnection()
        try {
            entries = insertInvoiceTraceBatch(tx, rows, userId)
        } catch (String e) {
            dropTxConnection()
            log.warn("lote rastreavel da fatura desfeito (rollback)")
            throw "Não foi possível gravar os itens da fatura."
        }
    } finally {
        DbConn.lock.send(token)
    }
    var newlyInserted = entries.filter((e: InvoiceTraceBatchEntry) -> e.inserted).map((e: InvoiceTraceBatchEntry) -> e.item.transaction)
    if (!newlyInserted.isEmpty()) {
        notifyBatchEnvelopeCrossings(userId, newlyInserted)
    }
    return entries.map((e: InvoiceTraceBatchEntry) -> transactionWithProvenanceToOutput(e.item))
}

// =========================================================
// Reset seguro por usuario e registro inicial de "Reserva acumulada"
// =========================================================

void runResetUserFinancialDataTx(String tx, String userId) {
    transaction {
        deleteUserFinancialDataOn(tx, userId)
    }
}

void resetUserFinancialData(String userId) {
    var user = findUserById(userId)
    if (user == null) {
        throw "User not found."
    }
    var token = DbConn.lock.receive()
    try {
        var tx = txConnection()
        try {
            runResetUserFinancialDataTx(tx, userId)
        } catch (String e) {
            dropTxConnection()
            log.warn("limpeza de dados do usuario desfeita (rollback)")
            throw "Não foi possível limpar os dados financeiros."
        }
    } finally {
        DbConn.lock.send(token)
    }
}

record InitialSavingsResult(VariableIncomeOutput income, EnvelopeOutput envelope)

InitialSavingsResult insertInitialSavingsTx(String tx, UserEntity user, Double amount) {
    var amountCents = toCents(amount)
    var normalizedAmount = centsToReais(amountCents)
    var reserveBucket = planReserveBucket(user.budgetModel)
    var now = nowIso()
    var savedIncomes: List<VariableIncomeEntity> = listOf()
    var savedEnvelopes: List<EnvelopeEntity> = listOf()
    transaction {
        var inc = saveVariableIncomeEntityOn(tx, VariableIncomeEntity("", user.id, normalizedAmount, "Reserva acumulada inicial", VariableIncomeDestination.EMERGENCY_FUND, now))
        savedIncomes.add(inc)
        var existing = findEnvelopeByNameOn(tx, user.id, "Reserva acumulada")
        if (existing != null) {
            var newLimit = centsToReais(toCents(existing.limitAmount) + amountCents)
            var bucket = existing.bucket
            if (bucket == null || bucket == "") {
                bucket = textOrNull(reserveBucket)
            }
            var updated = saveEnvelopeOn(tx, EnvelopeEntity(existing.id, existing.userId, existing.categoryName, newLimit, existing.currentSpent, existing.limitType, existing.movingAverageMonths, existing.createdAt, bucket))
            savedEnvelopes.add(updated)
        } else {
            var created = saveEnvelopeOn(tx, EnvelopeEntity("", user.id, "Reserva acumulada", normalizedAmount, 0.0, EnvelopeLimitType.FIXED, 0, now, textOrNull(reserveBucket)))
            savedEnvelopes.add(created)
        }
    }
    return InitialSavingsResult(variableIncomeEntityToOutput(savedIncomes.get(0)), envelopeEntityToOutput(savedEnvelopes.get(0)))
}

InitialSavingsResult recordInitialSavings(String userId, Double amount) {
    if (amount <= 0.0 || amount > 1000000000.0) {
        throw "O valor da reserva deve ser maior que zero."
    }
    var user = findUserById(userId)
    if (user == null) {
        throw "User not found."
    }
    var token = DbConn.lock.receive()
    try {
        var tx = txConnection()
        try {
            return insertInitialSavingsTx(tx, user, amount)
        } catch (String e) {
            dropTxConnection()
            log.warn("registro de reserva inicial desfeito (rollback)")
            throw "Não foi possível registrar a reserva acumulada."
        }
    } finally {
        DbConn.lock.send(token)
    }
}

// Registra somente a diferenca de um saldo de reserva informado e confirmado
// no chat. O valor alimenta o Dashboard sem criar ou alterar uma Caixinha.
VariableIncomeEntity recordReserveDashboardDelta(String userId, Long amountCents) {
    if (amountCents <= 0 || amountCents > 100000000000) {
        throw "O valor da reserva deve ser maior que zero."
    }
    var user = findUserById(userId)
    if (user == null) {
        throw "User not found."
    }
    var token = DbConn.lock.receive()
    try {
        var item = VariableIncomeEntity("", user.id, centsToReais(amountCents), "Saldo inicial da reserva informado no chat", VariableIncomeDestination.EMERGENCY_FUND, nowIso())
        return saveVariableIncomeEntity(item)
    } finally {
        DbConn.lock.send(token)
    }
}
