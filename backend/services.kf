// =========================================================
// mod_budget/service/BudgetModelSuggestionService.java
// =========================================================

Double salarioMinimo() {
    return 1621.0
}

Double survivalThreshold() {
    return 2.0 * salarioMinimo()
}

Double antiDebtThreshold() {
    return salarioMinimo()
}

Double kakeiboThreshold() {
    return 3.0 * salarioMinimo()
}

Double simple8020Threshold() {
    return 5.0 * salarioMinimo()
}

// Ordem de selecao (educacao financeira, SM = salarioMinimo()):
// 1. Anti-Divida 70/10/20: tem divida e renda >= 1 SM. Abaixo disso, 20% nao cobre
//    nem a parcela minima: fica no Sobrevivencia e o coach orienta renegociar.
// 2. Sobrevivencia 70/20/10: renda < 2 SM (modelo de entrada).
// 3. 80/20: sem divida, ja guarda todo mes e renda >= 5 SM.
// 4. Kakeibo: so por escolha do usuario, sem divida e renda >= 3 SM (ver budgetModelEligibilityError).
// 5. 50/30/20: sem divida e renda >= 2 SM.
// Renda variavel nao muda a selecao: so os 5 modelos oficiais da tabela de docs/DATA_MODEL.md.
BudgetModelType suggestBudgetModel(Double salary, IncomeType incomeType, Bool hasDebt, Bool savesMonthly) {
    if (hasDebt && salary >= antiDebtThreshold()) {
        return BudgetModelType.ANTI_DEBT_701020
    }
    if (salary < survivalThreshold() || hasDebt) {
        return BudgetModelType.SURVIVAL_702010
    }
    if (savesMonthly && salary >= simple8020Threshold()) {
        return BudgetModelType.SIMPLE_8020
    }
    return BudgetModelType.STANDARD_503020
}

// Valida a troca manual de modelo contra os pisos de renda da tabela. null = permitido.
String? budgetModelEligibilityError(BudgetModelType model, Double salary, Bool hasDebt) {
    if (model == BudgetModelType.ANTI_DEBT_701020 && (!hasDebt || salary < antiDebtThreshold())) {
        return "O modelo Anti-Dívida é para quem tem dívida e renda a partir de 1 salário mínimo."
    }
    if (model == BudgetModelType.SIMPLE_8020 && (hasDebt || salary < simple8020Threshold())) {
        return "O modelo 80/20 é para quem está sem dívidas e tem renda a partir de 5 salários mínimos."
    }
    if (model == BudgetModelType.KAKEIBO && (hasDebt || salary < kakeiboThreshold())) {
        return "O modelo Kakeibo é para quem está sem dívidas e tem renda a partir de 3 salários mínimos."
    }
    if (model == BudgetModelType.STANDARD_503020 && (hasDebt || salary < survivalThreshold())) {
        return "O modelo 50/30/20 é para quem está sem dívidas e tem renda a partir de 2 salários mínimos."
    }
    return null
}

BudgetModelType suggestBudgetModel(Double salary, IncomeType incomeType, Bool hasDebt) {
    return suggestBudgetModel(salary, incomeType, hasDebt, false)
}

// =========================================================
// mod_budget/service/BudgetModelPlanService.java
// =========================================================

String describeBudgetModel(BudgetModelType model) {
    return switch (model) {
        case STANDARD_503020 -> "Modelo Padrão 50/30/20: metade da sua renda cobre o essencial, 30% é pra viver bem hoje, e 20% guarda pro futuro."
        case SURVIVAL_702010 -> "Modelo Sobrevivência 70/20/10: a maior parte cobre o essencial, uma folga pra respirar e um pouco guardado, mesmo que pouco."
        case ANTI_DEBT_701020 -> "Modelo Anti-Dívida: 70% para necessidades, 10% para o mínimo pessoal, 20% para quitar suas dívidas. Quando você sair do vermelho, o sistema migra automaticamente para outro modelo."
        case SIMPLE_8020 -> "Modelo Simplificado 80/20: 80% pra viver sem culpa, 20% pra guardar sem esforço. Simples assim."
        case KAKEIBO -> "Modelo Kakeibo: você acompanha seus gastos por reflexão em Essencial (50%), Lazer (15%), Cultura (10%) e Extras (5%), separando 20% em Poupança no início do mês."
    }
}

BucketSummaryDTO bucketOf(String name, Int percentage, Double salary) {
    var amount = math.roundTo(salary * percentage / 100.0, 2)
    return BucketSummaryDTO(name, percentage, amount)
}

List<BucketSummaryDTO> buildBudgetBuckets(BudgetModelType model, Double salary) {
    return switch (model) {
        case STANDARD_503020 -> listOf(
            bucketOf("Necessidades", 50, salary),
            bucketOf("Desejos", 30, salary),
            bucketOf("Futuro", 20, salary))
        case SURVIVAL_702010 -> listOf(
            bucketOf("Necessidades", 70, salary),
            bucketOf("Folga", 20, salary),
            bucketOf("Poupança", 10, salary))
        case ANTI_DEBT_701020 -> listOf(
            bucketOf("Necessidades", 70, salary),
            bucketOf("Pessoal", 10, salary),
            bucketOf("Quitação de Dívida", 20, salary))
        case SIMPLE_8020 -> listOf(
            bucketOf("Viver", 80, salary),
            bucketOf("Guardar", 20, salary))
        case KAKEIBO -> listOf(
            bucketOf("Essencial", 50, salary),
            bucketOf("Lazer", 15, salary),
            bucketOf("Cultura", 10, salary),
            bucketOf("Extras", 5, salary),
            bucketOf("Poupança", 20, salary))
    }
}

// =========================================================
// mod_budget/service/EnvelopeService.java
// =========================================================

EnvelopeEntity createEnvelope(EnvelopeEntity envelope) {
    return saveEnvelope(envelope)
}

// Dono sempre explicito (userId das claims): envelope de outro usuario = inexistente (PERS-11).
EnvelopeEntity updateEnvelope(String userId, String id, EnvelopeEntity updated) {
    var envelope = findEnvelopeById(userId, id)
    if (envelope != null) {
        envelope.categoryName = updated.categoryName
        envelope.limitAmount = updated.limitAmount
        envelope.limitType = updated.limitType
        envelope.movingAverageMonths = updated.movingAverageMonths
        return saveEnvelope(envelope)
    }
    throw "Envelope not found."
}

void deleteEnvelope(String userId, String id) {
    deleteEnvelopeById(userId, id)
}

EnvelopeEntity updateEnvelopeSpent(String userId, String envelopeId, Double amount) {
    return addEnvelopeSpentCents(userId, envelopeId, toCents(amount))
}

// TODO (preservado do Java original): TransactionEntity ainda nao tem
// envelope_id (ver PROJECT_STATUS.md). Implementar consulta real dos
// gastos dos ultimos N meses quando esse campo existir.
Double calculateMovingAverage(String userId, String envelopeId, Int months) {
    var envelope = findEnvelopeById(userId, envelopeId)
    if (envelope != null) {
        return 0.0
    }
    throw "Envelope not found."
}

// =========================================================
// mod_budget/service/BudgetModelMigrationService.java
// =========================================================

BudgetModelType migrateBudgetModelIfNeeded(UserEntity? user) {
    if (user != null) {
        var current = user.budgetModel
        var incomeType = user.incomeType
        var hasDebt = user.hasDebt
        var salary = userSalary(user)

        // Kakeibo e escolha do usuario: mantem enquanto continuar elegivel.
        if (current == BudgetModelType.KAKEIBO && budgetModelEligibilityError(current, salary, hasDebt) == null) {
            return current
        }
        var suggested = suggestBudgetModel(salary, incomeType, hasDebt, user.savesMonthly)
        if (suggested == current) {
            return current
        }
        return suggested
    }
    throw "User cannot be null."
}

// =========================================================
// mod_variable_income/service/VariableIncomeService.java
// =========================================================

VariableIncomeDestination decideVariableIncomeDestination(String userId, Double amount) {
    var user = findUserById(userId)
    if (user != null) {
        if (user.hasEmergencyGoal) {
            var goal = centsToReais(user.emergencyGoalCents)
            var currentReserve = findVariableIncomesByUserId(userId)
                .filter((inc: VariableIncomeEntity) -> inc.destination == VariableIncomeDestination.EMERGENCY_FUND)
                .map((inc: VariableIncomeEntity) -> inc.amount)
                .reduce((a: Double, b: Double) -> a + b, 0.0)
            if (currentReserve < goal) {
                return VariableIncomeDestination.EMERGENCY_FUND
            }
            return VariableIncomeDestination.BUDGET_5030020
        }
        return VariableIncomeDestination.BUDGET_5030020
    }
    throw "User not found."
}

VariableIncomeEntity saveVariableIncome(VariableIncomeEntity income) {
    income.destination = decideVariableIncomeDestination(income.userId, income.amount)
    return saveVariableIncomeEntity(income)
}

// =========================================================
// mod_transaction/service/PersistTransactionUseCase.java
// GAP (ver relatorio #5): CurrentUserService (Spring Security) nao tem
// equivalente confirmado no training/ -- userId passa a ser parametro
// explicito da funcao em vez de injetado via contexto de autenticacao.
// Id gerado pelo banco (PERS-06/07); valor gravado em centavos (PERS-17/18).
// =========================================================

// Envelope da transacao: o informado no corpo so vale se for do proprio usuario (PERS-11);
// senao, o envelope do usuario com o nome da categoria; nenhum = auto-cria caixinha da categoria.
String? resolveEnvelopeId(String userId, String? given, Category category) {
    if (given != null && given.trim() != "") {
        var owned = findEnvelopeById(userId, given)
        if (owned != null) {
            if (categoryOrNull(owned.categoryName) != null) {
                var ptOwned = categoryLabel(categoryOrNull(owned.categoryName))
                updateEnvelope(userId, owned.id, EnvelopeEntity(owned.id, userId, ptOwned, owned.limitAmount, owned.currentSpent, owned.limitType, owned.movingAverageMonths, owned.createdAt, owned.bucket))
            }
            return owned.id
        }
    }
    var ptLabel = categoryLabel(category)
    var labeled = findEnvelopeByName(userId, ptLabel, "")
    if (labeled != null) {
        return labeled.id
    }
    var env = findEnvelopeByUserIdAndCategoryName(userId, category.name())
    if (env != null) {
        updateEnvelope(userId, env.id, EnvelopeEntity(env.id, userId, ptLabel, env.limitAmount, env.currentSpent, env.limitType, env.movingAverageMonths, env.createdAt, env.bucket))
        return env.id
    }
    var created = autoCreateCategoryEnvelope(userId, category)
    if (created != null) {
        return created.id
    }
    return null
}

// A categoria ja tem caixinha (pelo codigo antigo ou pelo nome em portugues)?
Bool categoryHasEnvelope(String userId, Category category) {
    return findEnvelopeByUserIdAndCategoryName(userId, category.name()) != null || findEnvelopeByName(userId, categoryLabel(category), "") != null
}

// =========================================================
// Controle estrito do onboarding (OnboardingExpenseControlRow + OnboardingChipAllocationRow)
// =========================================================

record TransactionResult(TransactionOutput transaction, Bool envelopeCreated, Bool rebalanced, String? bucket, String? controlStatus)

String onboardingControlStatus(Long spentCents, Long plannedCents) {
    if (spentCents <= 0) {
        return "PENDENTE"
    }
    if (plannedCents <= 0 || spentCents > plannedCents) {
        return "ESTOURADO"
    }
    if (spentCents * 100 >= plannedCents * 80) {
        return "ALERTA"
    }
    return "ATIVO"
}

Category? categoryEnumOrNull(String name) {
    for (var c in Category.values()) {
        if (c.name() == name) {
            return c
        }
    }
    return null
}

Category? categoryByPortugueseLabel(String name) {
    var key = envelopeNameKey(name)
    for (var c in Category.values()) {
        if (envelopeNameKey(categoryLabel(c)) == key) {
            return c
        }
    }
    return null
}

Category? resolveCategoryForEnvelopeName(String name) {
    var byCode = categoryEnumOrNull(name)
    if (byCode != null) {
        return byCode
    }
    return categoryByPortugueseLabel(name)
}

String envelopePlanBucket(EnvelopeEntity e, BudgetModelType model, List<BucketSummaryDTO> plan) {
    if (e.bucket != null && e.bucket != "") {
        return nullToText(e.bucket)
    }
    if (isReserveEnvelopeName(e.categoryName)) {
        return planReserveBucket(model)
    }
    var cat = resolveCategoryForEnvelopeName(e.categoryName)
    if (cat != null) {
        return nullToText(planBucketFor(model, plan, cat))
    }
    return ""
}

Long bucketCeilingCents(List<BucketSummaryDTO> plan, String bucketName) {
    var matches = plan.filter((b: BucketSummaryDTO) -> b.name == bucketName)
    if (matches.isEmpty()) {
        return 0
    }
    return toCents(matches.get(0).amount)
}

Bool isAutoCreatedCategoryEnvelope(EnvelopeEntity e, List<OnboardingChipAllocationRow> chips) {
    if (e.bucket == null || e.bucket == "" || e.movingAverageMonths != 0 || e.limitType != EnvelopeLimitType.FIXED) {
        return false
    }
    var byLabel = categoryByPortugueseLabel(e.categoryName)
    if (byLabel == null) {
        return isFreeEnvelopeName(e.categoryName) && !isReserveEnvelopeName(e.categoryName)
    }
    var chipCats = chips.map((c: OnboardingChipAllocationRow) -> c.category())
    return !chipCats.contains(byLabel.name())
}

// Rebalanceia apenas as caixinhas auto-criadas no bucket para respeitar o teto do bucket
// sem tocar em caixinhas manuais nem nas criadas por chips do onboarding.
Bool rebalanceAutoEnvelopesInBucket(UserEntity user, String bucketName, String? skipCategoryLabel) {
    if (!onboardingCompleted(user) || bucketName == "") {
        return false
    }
    var model = user.budgetModel
    var plan = buildBudgetBuckets(model, userSalary(user))
    var ceilingCents = bucketCeilingCents(plan, bucketName)
    var chips = listOnboardingChipsByUser(user.id)
    var inBucket = findEnvelopesByUserId(user.id).filter((e: EnvelopeEntity) -> envelopePlanBucket(e, model, plan) == bucketName)
    var autoEnvs: List<EnvelopeEntity> = listOf()
    var fixedCents: Long = 0
    for (var e in inBucket) {
        if (isAutoCreatedCategoryEnvelope(e, chips)) {
            autoEnvs.add(e)
        } else {
            fixedCents = fixedCents + toCents(e.limitAmount)
        }
    }
    if (autoEnvs.isEmpty()) {
        return false
    }
    var availableCents = ceilingCents - fixedCents
    if (availableCents < 0) {
        availableCents = 0
    }
    var perAutoCents = availableCents / autoEnvs.size
    var perAutoReais = centsToReais(perAutoCents)
    var changed = false
    for (var ae in autoEnvs) {
        if ((skipCategoryLabel == null || ae.categoryName != skipCategoryLabel) && toCents(ae.limitAmount) != perAutoCents) {
            saveEnvelope(EnvelopeEntity(ae.id, ae.userId, ae.categoryName, perAutoReais, ae.currentSpent, ae.limitType, ae.movingAverageMonths, ae.createdAt, ae.bucket))
            changed = true
        }
    }
    return changed
}

// Reconstroi as linhas de controle do onboarding preservando os gastos reais do mes em TransactionRow.
List<OnboardingExpenseControlRow> saveOnboardingControlForUser(UserEntity user) {
    if (!onboardingCompleted(user)) {
        deleteOnboardingControlForUser(user.id)
        return listOf()
    }
    var model = user.budgetModel
    var plan = buildBudgetBuckets(model, userSalary(user))
    for (var b in plan) {
        rebalanceAutoEnvelopesInBucket(user, b.name, null)
    }
    var monthTxs = findTransactionsByUserIdAndCreatedAtAfter(user.id, monthStartIso())
    var envelopes = findEnvelopesByUserId(user.id)
    var chips = listOnboardingChipsByUser(user.id)
    var now = nowIso()
    var zero: Long = 0

    var catOrder: List<String> = listOf()
    var catPlanned: Map<String, Long> = mapOf()
    for (var chip in chips) {
        var cCode = chip.category()
        if (!catOrder.contains(cCode)) {
            catOrder.add(cCode)
        }
        var prev = catPlanned.getOrDefault(cCode, zero)
        catPlanned.put(cCode, prev + chip.plannedCents())
    }
    for (var env in envelopes) {
        var cat = resolveCategoryForEnvelopeName(env.categoryName)
        if (cat != null) {
            var code = cat.name()
            if (!catOrder.contains(code)) {
                catOrder.add(code)
            }
            catPlanned.put(code, toCents(env.limitAmount))
        }
    }
    for (var t in monthTxs) {
        var tc = t.category
        if (tc != null) {
            var tCode = tc.name()
            if (!catOrder.contains(tCode)) {
                catOrder.add(tCode)
                catPlanned.put(tCode, zero)
            }
        }
    }

    deleteOnboardingControlForUser(user.id)
    var bucketsWithCategories: List<String> = listOf()
    var savedRows: List<OnboardingExpenseControlRow> = listOf()
    for (var code in catOrder) {
        var cat = categoryEnumOrNull(code)
        var bucketName = nullToText(planBucketFor(model, plan, cat))
        var planned = catPlanned.getOrDefault(code, zero)
        var spent = sumAmountCents(monthTxs.filter((t: TransactionEntity) -> categoryText(t.category) == code))
        var st = onboardingControlStatus(spent, planned)
        savedRows.add(upsertOnboardingControlRow(OnboardingExpenseControlRow(0, user.id, code, bucketName, planned, spent, st, now)))
        if (bucketName != "" && !bucketsWithCategories.contains(bucketName)) {
            bucketsWithCategories.add(bucketName)
        }
    }
    for (var b in plan) {
        if (!bucketsWithCategories.contains(b.name)) {
            var bPlanned = toCents(b.amount)
            var bSpent = sumAmountCents(monthTxs.filter((t: TransactionEntity) -> planBucketForTx(model, plan, t.category, t.bucket) == b.name))
            var bStatus = onboardingControlStatus(bSpent, bPlanned)
            savedRows.add(upsertOnboardingControlRow(OnboardingExpenseControlRow(0, user.id, b.name, b.name, bPlanned, bSpent, bStatus, now)))
        }
    }
    return savedRows
}

void saveChipListAllocationsForUser(UserEntity user, List<String> chips) {
    var uniqueChips = chips.distinct()
    var model = user.budgetModel
    var plan = buildBudgetBuckets(model, userSalary(user))
    var catMap = chipCategories()
    var categories = uniqueChips.map((c: String) -> catMap.getOrDefault(c, "OTHER")).distinct()
    var byBucket = categories.groupBy((c: String) -> nullToText(planBucketFor(model, plan, categoryOrNull(c))))

    var chipsByCategory: Map<String, Int> = mapOf()
    for (var chip in uniqueChips) {
        var catCode = catMap.getOrDefault(chip, "OTHER")
        chipsByCategory.put(catCode, chipsByCategory.getOrDefault(catCode, 0) + 1)
    }

    var seenPerCat: Map<String, Int> = mapOf()
    var now = nowIso()
    var rows: List<OnboardingChipAllocationRow> = listOf()
    for (var chip in uniqueChips) {
        var catCode = catMap.getOrDefault(chip, "OTHER")
        var bucketName = nullToText(planBucketFor(model, plan, categoryOrNull(catCode)))
        var share = byBucket.getOrDefault(bucketName, listOf()).size
        var totalCatCents = toCents(chipLimit(plan, bucketName, share))
        var chipCountInCat = chipsByCategory.getOrDefault(catCode, 1)
        var idx = seenPerCat.getOrDefault(catCode, 0)
        seenPerCat.put(catCode, idx + 1)
        var base = totalCatCents / chipCountInCat
        var rem = totalCatCents - base * chipCountInCat
        var chipCents = base
        if (idx == 0) {
            chipCents = base + rem
        }
        rows.add(OnboardingChipAllocationRow(0, user.id, chip, catCode, chipCents, now))
    }
    replaceOnboardingChipsForUser(user.id, rows)
    saveOnboardingControlForUser(user)
}

void saveChipAllocationsForUser(UserEntity user, ChipsInput chips) {
    var allChips: List<String> = listOf()
    allChips.addAll(chips.fixed())
    allChips.addAll(chips.variable())
    saveChipListAllocationsForUser(user, allChips)
}

// Sincroniza spentCents e status na mesma conexao da transacao (sem try {}, COMP002).
OnboardingExpenseControlRow? syncOnboardingControlSpentOn(String conn, TransactionEntity savedTx, UserEntity user) {
    if (!onboardingCompleted(user)) {
        return null
    }
    var model = user.budgetModel
    var plan = buildBudgetBuckets(model, userSalary(user))
    var cat = savedTx.category
    var catKey = categoryText(cat)
    var bucketName = nullToText(planBucketForTx(model, plan, cat, savedTx.bucket))
    var targetKey = catKey
    if (targetKey == "") {
        targetKey = bucketName
    }
    if (targetKey == "") {
        return null
    }

    var monthTxs = findTransactionsByUserIdAndCreatedAtAfterOn(conn, user.id, monthStartIso())
    var spentCents: Long = 0
    if (cat != null) {
        spentCents = sumAmountCents(monthTxs.filter((t: TransactionEntity) -> t.category == cat))
    } else {
        spentCents = sumAmountCents(monthTxs.filter((t: TransactionEntity) -> planBucketForTx(model, plan, t.category, t.bucket) == bucketName))
    }

    var controls = listOnboardingControlsByUserOn(conn, user.id)
    if (targetKey != bucketName && bucketName != "") {
        var placeholders = controls.filter((r: OnboardingExpenseControlRow) -> r.category() == bucketName)
        for (var p in placeholders) {
            deleteOnboardingControlRowOn(conn, p.id())
        }
    }

    var existingMatches = controls.filter((r: OnboardingExpenseControlRow) -> r.category() == targetKey)
    var existingId: Long = 0
    var plannedCents: Long = 0
    if (!existingMatches.isEmpty()) {
        existingId = existingMatches.get(0).id()
        plannedCents = existingMatches.get(0).plannedCents()
    }
    var envId = savedTx.envelopeId
    if (envId != null && cat != null) {
        var envRow = findOwnedEnvelopeRowOn(conn, user.id, envId)
        if (envRow != null) {
            if (envRow.categoryName() == cat.name() || envelopeNameKey(envRow.categoryName()) == envelopeNameKey(categoryLabel(cat))) {
                plannedCents = envRow.limitCents()
            }
        }
    }

    var status = onboardingControlStatus(spentCents, plannedCents)
    return upsertOnboardingControlRowOn(conn, OnboardingExpenseControlRow(existingId, user.id, targetKey, bucketName, plannedCents, spentCents, status, nowIso()))
}

OnboardingExpenseControlRow? syncOnboardingControlSpentOn(TransactionRow txRow, UserEntity user) {
    return syncOnboardingControlSpentOn(DbConn.handle, transactionFromRow(txRow), user)
}

// Gasto numa categoria sem caixinha: cria a caixinha automaticamente com o nome em portugues
// (categoryLabel, ex.: "Transporte"), no bucket do modelo do usuario e rebalanceando caixinhas
// auto-criadas para nao ultrapassar o teto do bucket quando o onboarding esta concluido.
EnvelopeEntity? autoCreateCategoryEnvelope(String userId, Category category) {
    var user = findUserById(userId)
    if (user == null) {
        return null
    }
    var model = user.budgetModel
    var plan = buildBudgetBuckets(model, userSalary(user))
    var bucket = nullToText(planBucketFor(model, plan, category))
    if (!onboardingCompleted(user)) {
        var share = 1 + findEnvelopesByUserId(userId).filter((e: EnvelopeEntity) -> nullToText(e.bucket) == bucket).size
        var limit = chipLimit(plan, bucket, share)
        return createEnvelope(EnvelopeEntity("", userId, categoryLabel(category), limit, 0.0, EnvelopeLimitType.FIXED, 0, nowIso(), textOrNull(bucket)))
    }

    var ceilingCents = bucketCeilingCents(plan, bucket)
    var chips = listOnboardingChipsByUser(userId)
    var inBucket = findEnvelopesByUserId(userId).filter((e: EnvelopeEntity) -> envelopePlanBucket(e, model, plan) == bucket)
    var autoEnvs: List<EnvelopeEntity> = listOf()
    var fixedCents: Long = 0
    for (var e in inBucket) {
        if (isAutoCreatedCategoryEnvelope(e, chips)) {
            autoEnvs.add(e)
        } else {
            fixedCents = fixedCents + toCents(e.limitAmount)
        }
    }
    var availableCents = ceilingCents - fixedCents
    if (availableCents < 0) {
        availableCents = 0
    }
    var perAutoCents = availableCents / (autoEnvs.size + 1)
    var perAutoReais = centsToReais(perAutoCents)
    for (var ae in autoEnvs) {
        if (toCents(ae.limitAmount) != perAutoCents) {
            saveEnvelope(EnvelopeEntity(ae.id, ae.userId, ae.categoryName, perAutoReais, ae.currentSpent, ae.limitType, ae.movingAverageMonths, ae.createdAt, ae.bucket))
        }
    }
    var created = createEnvelope(EnvelopeEntity("", userId, categoryLabel(category), perAutoReais, 0.0, EnvelopeLimitType.FIXED, 0, nowIso(), textOrNull(bucket)))
    saveOnboardingControlForUser(user)
    return created
}

// Gasto com assunto/categoria falado diferente das caixinhas do onboarding: cria automaticamente
// uma nova caixinha 100% editável (nome livre em português) no bucket correspondente do modelo.
EnvelopeEntity? autoCreateCustomEditableEnvelope(String userId, String customTopic, Category fallbackCategory) {
    var cleanTopic = customTopic.trim()
    if (cleanTopic == "" || envelopeNameError(cleanTopic) != null) {
        return autoCreateCategoryEnvelope(userId, fallbackCategory)
    }
    var existing = findEnvelopeForChat(userId, cleanTopic)
    if (existing != null) {
        return existing
    }
    var user = findUserById(userId)
    if (user == null) {
        return null
    }
    var model = user.budgetModel
    var plan = buildBudgetBuckets(model, userSalary(user))
    var bucket = nullToText(planBucketFor(model, plan, fallbackCategory))
    if (!onboardingCompleted(user)) {
        var share = 1 + findEnvelopesByUserId(userId).filter((e: EnvelopeEntity) -> nullToText(e.bucket) == bucket).size
        var limit = chipLimit(plan, bucket, share)
        return createEnvelope(EnvelopeEntity("", userId, cleanTopic, limit, 0.0, EnvelopeLimitType.FIXED, 0, nowIso(), textOrNull(bucket)))
    }

    var ceilingCents = bucketCeilingCents(plan, bucket)
    var chips = listOnboardingChipsByUser(userId)
    var inBucket = findEnvelopesByUserId(userId).filter((e: EnvelopeEntity) -> envelopePlanBucket(e, model, plan) == bucket)
    var autoEnvs: List<EnvelopeEntity> = listOf()
    var fixedCents: Long = 0
    for (var e in inBucket) {
        if (isAutoCreatedCategoryEnvelope(e, chips)) {
            autoEnvs.add(e)
        } else {
            fixedCents = fixedCents + toCents(e.limitAmount)
        }
    }
    var availableCents = ceilingCents - fixedCents
    if (availableCents < 0) {
        availableCents = 0
    }
    var perAutoCents = availableCents / (autoEnvs.size + 1)
    var perAutoReais = centsToReais(perAutoCents)
    for (var ae in autoEnvs) {
        if (toCents(ae.limitAmount) != perAutoCents) {
            saveEnvelope(EnvelopeEntity(ae.id, ae.userId, ae.categoryName, perAutoReais, ae.currentSpent, ae.limitType, ae.movingAverageMonths, ae.createdAt, ae.bucket))
        }
    }
    var created = createEnvelope(EnvelopeEntity("", userId, cleanTopic, perAutoReais, 0.0, EnvelopeLimitType.FIXED, 0, nowIso(), textOrNull(bucket)))
    saveOnboardingControlForUser(user)
    return created
}

// O transaction {} fica numa funcao propria: dentro de um try, o kof 0.6.3 para com "Internal compiler
// error: null [COMP002]" (medido nesta mudanca). O bloco nao devolve valor, entao a linha gravada sai
// por uma lista. Desconto do envelope lido e gravado na mesma conexao da transacao (soma em centavos).
TransactionEntity insertTransactionAndSpend(String tx, TransactionEntity transaction, String userId, String? envId, Long amountCents) {
    var user = findUserById(userId)
    var saved: List<TransactionEntity> = listOf()
    transaction {
        var row = insertTransactionOn(tx, transaction)
        saved.add(row)
        if (envId != null) {
            addEnvelopeSpentCentsOn(tx, userId, envId, amountCents)
        }
        if (user != null) {
            syncOnboardingControlSpentOn(tx, row, user)
        }
    }
    return saved.get(0)
}

TransactionOutput persistTransaction(PersistTransactionInput input, Category category, String userId) {
    return persistTransactionAmount(input.description(), input.amount() * 1.0, category, input.currency(), input.envelopeId(), userId)
}

TransactionResult persistTransactionWithSource(String description, Double amount, Category category, String currency, String? envelopeId, String userId, Source source) {
    if (amount <= 0.0) {
        throw "Operação negada: O valor da transação deve ser maior que zero."
    }

    var user = findUserById(userId)
    var hadEnvelope = false
    if (envelopeId != null) {
        if (findEnvelopeById(userId, envelopeId) != null) {
            hadEnvelope = true
        }
    }
    if (!hadEnvelope) {
        hadEnvelope = categoryHasEnvelope(userId, category)
    }

    var bucketName: String? = textOrNull("")
    var autoCountBefore = 0
    if (user != null) {
        var plan = buildBudgetBuckets(user.budgetModel, userSalary(user))
        bucketName = planBucketFor(user.budgetModel, plan, category)
        if (!hadEnvelope && onboardingCompleted(user) && bucketName != null) {
            var chips = listOnboardingChipsByUser(userId)
            autoCountBefore = findEnvelopesByUserId(userId)
                .filter((e: EnvelopeEntity) -> envelopePlanBucket(e, user.budgetModel, plan) == nullToText(bucketName) && isAutoCreatedCategoryEnvelope(e, chips))
                .size
        }
    }

    var envId = resolveEnvelopeId(userId, envelopeId, category)
    var amountCents = toCents(amount)

    // Transacao + desconto do envelope + controle do onboarding numa unica transacao do banco,
    // isolada das outras requisicoes: com a ficha do DbConn.lock e em txConnection().
    var saved: List<TransactionEntity> = listOf()
    var token = DbConn.lock.receive()
    try {
        var tx = txConnection()
        try {
            // createdAt = instante real (issue #44); descricao gravada literal via binds (PERS-15)
            saved.add(insertTransactionAndSpend(tx, TransactionEntity("", description, amountCents, category, currency, userId, null, source, nowIso(), envId), userId, envId, amountCents))
        } catch (String e) {
            // Rollback ja feito pelo runtime; a conexao e descartada (pode ser ela que caiu) e o detalhe
            // do banco nao vai para a resposta.
            dropTxConnection()
            log.warn("transacao desfeita (rollback)")
            throw "Não foi possível gravar a transação."
        }
    } finally {
        DbConn.lock.send(token)
    }

    var txOut = transactionEntityToOutput(saved.get(0))
    var envelopeCreated = !hadEnvelope && envId != null
    var rebalanced = envelopeCreated && autoCountBefore > 0 && user != null && onboardingCompleted(user)
    var controlStatus: String? = textOrNull("")
    if (user != null && onboardingCompleted(user)) {
        var matches = listOnboardingControlsByUser(userId).filter((r: OnboardingExpenseControlRow) -> r.category() == category.name())
        if (!matches.isEmpty()) {
            controlStatus = matches.get(0).status()
        }
    }
    return TransactionResult(txOut, envelopeCreated, rebalanced, bucketName, controlStatus)
}

// Mesmo caminho com valor em reais com centavos (tool persistTransaction do coach: "R$ 35,50").
TransactionOutput persistTransactionAmount(String description, Double amount, Category category, String currency, String? envelopeId, String userId) {
    return persistTransactionWithSource(description, amount, category, currency, envelopeId, userId, Source.MANUAL).transaction
}

