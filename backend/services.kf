// =========================================================
// mod_ai_coach/repository/ChatMessageEntityRepository.java
// =========================================================

// GAP (ver relatorio #4): sem orderBy/sort confirmados no training/ para
// List<T> generico (orderBy so existe dentro da Query DSL de kof.orm sobre
// `entity`, nao para List). Filtra mas NAO ordena.
List<ChatMessageEntity> findChatMessagesByUserIdOrderByCreatedAtAsc(String userId) {
    return BackendDb.chatMessages.filter((m: ChatMessageEntity) -> m.userId == userId)
}

// GAP: idem acima + sem "top N"/limit confirmado para List generico.
// Retorna todas as mensagens do usuario, sem ordenar nem truncar em 20.
List<ChatMessageEntity> findTop20ChatMessagesByUserIdOrderByCreatedAtDesc(String userId) {
    return BackendDb.chatMessages.filter((m: ChatMessageEntity) -> m.userId == userId)
}

// GAP: comparacao de data como String (compareTo), mesma ressalva do gap #3.
Int countChatMessagesByUserIdAndRoleAndCreatedAtGreaterThanEqual(String userId, ChatRole role, String since) {
    var count = 0
    for (var m in BackendDb.chatMessages) {
        var createdAt = m.createdAt
        if (m.userId == userId && m.role == role && createdAt != null) {
            if (createdAt.compareTo(since) >= 0) {
                count = count + 1
            }
        }
    }
    return count
}

ChatMessageEntity saveChatMessage(ChatMessageEntity message) {
    var i = 0
    while (i < BackendDb.chatMessages.size) {
        var existing = BackendDb.chatMessages.get(i)
        if (existing.id == message.id) {
            BackendDb.chatMessages.set(i, message)
            return message
        }
        i = i + 1
    }
    BackendDb.chatMessages.add(message)
    return message
}

