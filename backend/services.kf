// backend/services.kf
// Transpilado de src/main/java/com/organiza/**/service/*.java e
// src/main/java/com/organiza/**/repository/*.java para KOF.
// Sintaxe validada apenas contra training/ do repositorio KofLang/Kof4j.
//
// DESVIO DE INSTRUCAO (reportado): a tarefa pediu "Importar os tipos de
// backend/models.kf no topo". Testei empiricamente com o binario kof
// 0.4.2-beta: `import backend.models` e `import models` retornam
// PKG006 ("import nao encontrado no modulo... sob a raiz") porque este
// projeto nao tem um manifesto de pacote (kofdeps / kof.toml) definindo
// a raiz -- e um `package backend` em models.kf tambem falha com PKG004
// ("package nao corresponde ao diretorio") quando o check roda a partir
// da raiz do projeto. training/ nao documenta o formato desse manifesto,
// entao nao posso inventa-lo. O que FUNCIONA e comprovadamente compila
// (`kof check backend`, verificado nesta sessao): arquivos .kf no MESMO
// DIRETORIO compartilham escopo de tipos automaticamente, sem import.
// Por isso este arquivo NAO tem `import` -- os tipos de models.kf (UserEntity,
// TransactionEntity, EnvelopeEntity, ChatMessageEntity, VariableIncomeEntity,
// Role, Tier, IncomeType, Category, Bucket, Source, BudgetModelType,
// EnvelopeLimitType, ChatRole, VariableIncomeDestination) sao usados
// diretamente porque backend/models.kf esta no mesmo diretorio.
//
// Repository/Service/Controller (Spring) viram funcoes top-level, conforme
// training/idioms/architecture.md ("Unnecessary layers" -- Controller/Service/
// Repository e convencao de framework Java, Kof nao tem essa convencao).
//
// @Autowired/injecao de construtor: sem container de DI confirmado no
// training/ -- convertido para parametros de funcao explicitos (userId,
// datas de corte, etc.) em vez de campos injetados.

// =========================================================
// Mock de persistencia (equivalente a AppDatabase de
// frontend/core/database.kf, mas tipado com as entidades de
// backend/models.kf -- ver gap #1 no relatorio)
// =========================================================

class BackendDb {
    static List<TransactionEntity> transactions = listOf()
    static List<EnvelopeEntity> envelopes = listOf()
    static List<ChatMessageEntity> chatMessages = listOf()
    static List<VariableIncomeEntity> variableIncomes = listOf()
    static List<KakeiboReflectionEntity> kakeiboReflections = listOf()
}

// =========================================================
// DTOs auxiliares (records referenciados pelos services pedidos)
// =========================================================

// mod_user/dto/BucketSummaryDTO.java
record BucketSummaryDTO(String name, Int percentage, Double amount)

// mod_transaction/dto/PersistTransactionInput.java
// WORKAROUND: json.decode<T> com campo enum = argument type mismatch (repro j2; issue upstream
// pendente). `category` chega como String e o handler converte com Category.valueOf.
// Remover quando corrigido (voltar para `Category category`).
record PersistTransactionInput(String description, Long amount, String category, String currency, String? envelopeId)

// mod_transaction/dto/TransactionOutput.java
record TransactionOutput(String id, String description, String category, Double value, String currency, String? envelopeId)

// mod_transaction/dto/GetTotalByCategoryInput.java
record GetTotalByCategoryInput(Category category)

// mod_transaction/dto/GetTotalByCategoryOutput.java
record GetTotalByCategoryOutput(Double total)

// mod_transaction/service/ListTransactionsByCategoryUseCase.java (record interno Input, elevado a top-level)
record ListTransactionsByCategoryInput(Category category)

// shared/service/TierStatus.java
record TierStatus(String tier, Int messagesUsed, Int messagesLimit, Bool voiceEnabled, Bool canSendMessage)

// =========================================================
// mod_transaction/repository/TransactionEntityRepository.java
// (inclui a logica de JpaTransactionRepository/TransactionRepository,
// colapsada aqui -- ver gap #2 no relatorio: sem camada de dominio
// Transaction/TransactionId separada da entidade, por idioms/architecture.md)
// =========================================================

// Persistido com kof.orm em backend/store.kf (T5): findTransactionsByCategoryAndUserId,
// findTransactionsByUserIdAndCreatedAtAfter, deleteTransactionsByUserId, insertTransaction.
// As somas trabalham em centavos (Long, soma exata) e so viram reais na borda.

Long sumAmountCents(List<TransactionEntity> transactions) {
    var sum: Long = 0
    for (var t in transactions) {
        sum = sum + t.amountCents
    }
    return sum
}

Double sumAmountByCategoryAndUserId(Category category, String userId) {
    return centsToReais(sumAmountCents(findTransactionsByCategoryAndUserId(category, userId)))
}

// Total em CENTAVOS (Long); quem exibe converte com centsToReais.
Long sumAmountByUserIdAndCreatedAtAfter(String userId, String from) {
    return sumAmountCents(findTransactionsByUserIdAndCreatedAtAfter(userId, from))
}

TransactionOutput transactionEntityToOutput(TransactionEntity t) {
    var category = t.category
    var categoryName = "OTHER"
    if (category != null) {
        categoryName = category.name()
    }
    return TransactionOutput(t.id, t.description, categoryName, centsToReais(t.amountCents), t.currency, t.envelopeId)
}

