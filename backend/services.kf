void clearTransactions(String userId) {
    deleteTransactionsByUserId(userId)
}

// =========================================================
// shared/service/TierEnforcementService.java
// GAP (ver relatorio #3): "inicio do mes" (LocalDate.now().withDayOfMonth(1)...)
// nao tem API de data/hora confirmada no training/ lido nesta sessao
// (kof.time existe segundo o README principal, mas seu training especifico
// nao foi lido nesta tarefa -- nao vou inventar sua assinatura). O calculo
// da data de corte passa a ser responsabilidade do chamador, via parametro
// monthStartIso.
// =========================================================

TierStatus getTierStatus(String userId, String monthStartIso) {
    var user = findUserById(userId)
    if (user != null) {
        var messagesUsed = countChatMessagesByUserIdAndRoleAndCreatedAtGreaterThanEqual(userId, ChatRole.USER, monthStartIso)

        if (user.tier == Tier.PREMIUM) {
            return TierStatus(Tier.PREMIUM.name(), messagesUsed, -1, true, true)
        }

        var canSendMessage = messagesUsed < 30
        return TierStatus(Tier.FREE.name(), messagesUsed, 30, false, canSendMessage)
    }
    throw "User not found."
}

void enforceCanSendMessage(String userId, String monthStartIso) {
    var status = getTierStatus(userId, monthStartIso)
    if (!status.canSendMessage()) {
        throw "Você atingiu o limite de 30 mensagens gratuitas este mês."
    }
}

void enforceVoiceAllowed(String userId, String monthStartIso) {
    var status = getTierStatus(userId, monthStartIso)
    if (!status.voiceEnabled()) {
        throw "Entrada por voz disponível apenas no plano Premium."
    }
}
