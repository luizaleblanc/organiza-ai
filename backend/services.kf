// =========================================================
// mod_budget/service/BudgetModelSuggestionService.java
// =========================================================

BudgetModelType suggestBudgetModel(Double salary, IncomeType incomeType, Bool hasDebt) {
    if (incomeType == IncomeType.VARIABLE) {
        return BudgetModelType.FREELANCER_BASE_ZERO
    }
    if (hasDebt) {
        return BudgetModelType.ANTI_DEBT_701020
    }
    if (salary <= 3242.0) {
        return BudgetModelType.SURVIVAL_702010
    }
    if (salary <= 5000.0) {
        return BudgetModelType.STANDARD_503020
    }
    return BudgetModelType.STANDARD_503020
}

// =========================================================
// mod_budget/service/BudgetModelPlanService.java
// =========================================================

String describeBudgetModel(BudgetModelType model) {
    return switch (model) {
        case STANDARD_503020 -> "Modelo Padrão 50/30/20: metade da sua renda cobre o essencial, 30% é pra viver bem hoje, e 20% guarda pro futuro."
        case SURVIVAL_702010 -> "Modelo Sobrevivência 70/20/10: a maior parte cobre o essencial, uma folga pra respirar e um pouco guardado, mesmo que pouco."
        case ANTI_DEBT_701020 -> "Modelo Anti-Dívida: 70% para necessidades, 10% para o mínimo pessoal, 20% para quitar suas dívidas. Quando você sair do vermelho, o sistema migra automaticamente para outro modelo."
        case SIMPLE_8020 -> "Modelo Simplificado 80/20: 80% pra viver sem culpa, 20% pra guardar sem esforço. Simples assim."
        case KAKEIBO -> "Modelo Kakeibo: reflexão em 4 categorias -- essencial, cultura, lazer e extras. Toda semana você para pra pensar no que gastou e como pode melhorar."
        case FREELANCER_BASE_ZERO -> "Modelo Base Zero: sua renda varia, então cada entrada é alocada na hora -- parte pra reserva de emergência, parte pro seu orçamento. Nada fixo, tudo sob controle."
    }
}

BucketSummaryDTO bucketOf(String name, Int percentage, Double salary) {
    var amount = math.roundTo(salary * percentage / 100.0, 2)
    return BucketSummaryDTO(name, percentage, amount)
}

List<BucketSummaryDTO> buildBudgetBuckets(BudgetModelType model, Double salary) {
    return switch (model) {
        case STANDARD_503020 -> listOf(
            bucketOf("Necessidades", 50, salary),
            bucketOf("Desejos", 30, salary),
            bucketOf("Futuro", 20, salary))
        case SURVIVAL_702010 -> listOf(
            bucketOf("Necessidades", 70, salary),
            bucketOf("Folga", 20, salary),
            bucketOf("Guarda", 10, salary))
        case ANTI_DEBT_701020 -> listOf(
            bucketOf("Necessidades", 70, salary),
            bucketOf("Pessoal", 10, salary),
            bucketOf("Quitação de Dívida", 20, salary))
        case SIMPLE_8020 -> listOf(
            bucketOf("Viver", 80, salary),
            bucketOf("Guardar", 20, salary))
        case KAKEIBO -> listOf(
            bucketOf("Essencial", 50, salary),
            bucketOf("Cultura", 10, salary),
            bucketOf("Lazer", 30, salary),
            bucketOf("Extras", 10, salary))
        case FREELANCER_BASE_ZERO -> listOf()
    }
}

// =========================================================
// mod_budget/service/EnvelopeService.java
// =========================================================

EnvelopeEntity createEnvelope(EnvelopeEntity envelope) {
    return saveEnvelope(envelope)
}

// Dono sempre explicito (userId das claims): envelope de outro usuario = inexistente (PERS-11).
EnvelopeEntity updateEnvelope(String userId, String id, EnvelopeEntity updated) {
    var envelope = findEnvelopeById(userId, id)
    if (envelope != null) {
        envelope.categoryName = updated.categoryName
        envelope.limitAmount = updated.limitAmount
        envelope.limitType = updated.limitType
        envelope.movingAverageMonths = updated.movingAverageMonths
        return saveEnvelope(envelope)
    }
    throw "Envelope not found."
}

void deleteEnvelope(String userId, String id) {
    deleteEnvelopeById(userId, id)
}

EnvelopeEntity updateEnvelopeSpent(String userId, String envelopeId, Double amount) {
    return addEnvelopeSpentCents(userId, envelopeId, toCents(amount))
}

// TODO (preservado do Java original): TransactionEntity ainda nao tem
// envelope_id (ver PROJECT_STATUS.md). Implementar consulta real dos
// gastos dos ultimos N meses quando esse campo existir.
Double calculateMovingAverage(String userId, String envelopeId, Int months) {
    var envelope = findEnvelopeById(userId, envelopeId)
    if (envelope != null) {
        return 0.0
    }
    throw "Envelope not found."
}

// =========================================================
// mod_budget/service/BudgetModelMigrationService.java
// =========================================================

BudgetModelType migrateBudgetModelIfNeeded(UserEntity? user) {
    if (user != null) {
        var current = user.budgetModel
        var incomeType = user.incomeType
        var hasDebt = user.hasDebt
        var salary = userSalary(user)

        if (current == BudgetModelType.ANTI_DEBT_701020 && !hasDebt) {
            return BudgetModelType.STANDARD_503020
        }
        if (current == BudgetModelType.STANDARD_503020 && incomeType == IncomeType.VARIABLE) {
            return BudgetModelType.FREELANCER_BASE_ZERO
        }
        if (current == BudgetModelType.STANDARD_503020 && hasDebt) {
            return BudgetModelType.ANTI_DEBT_701020
        }
        if (current == BudgetModelType.SURVIVAL_702010 && hasDebt) {
            return BudgetModelType.ANTI_DEBT_701020
        }
        if (current == BudgetModelType.STANDARD_503020 && salary <= 3242.0 && !hasDebt) {
            return BudgetModelType.SURVIVAL_702010
        }
        if (current == BudgetModelType.SURVIVAL_702010 && salary > 5000.0 && !hasDebt) {
            return BudgetModelType.STANDARD_503020
        }

        var suggested = suggestBudgetModel(salary, incomeType, hasDebt)
        if (suggested == current) {
            return current
        }
        return suggested
    }
    throw "User cannot be null."
}

// =========================================================
// mod_variable_income/service/VariableIncomeService.java
// =========================================================

VariableIncomeDestination decideVariableIncomeDestination(String userId, Double amount) {
    var user = findUserById(userId)
    if (user != null) {
        if (user.hasEmergencyGoal) {
            var goal = centsToReais(user.emergencyGoalCents)
            var emergencyIncomes = findVariableIncomesByUserId(userId)
            var currentReserve = 0.0
            for (var inc in emergencyIncomes) {
                if (inc.destination == VariableIncomeDestination.EMERGENCY_FUND) {
                    currentReserve = currentReserve + inc.amount
                }
            }
            if (currentReserve < goal) {
                return VariableIncomeDestination.EMERGENCY_FUND
            }
            return VariableIncomeDestination.BUDGET_5030020
        }
        return VariableIncomeDestination.BUDGET_5030020
    }
    throw "User not found."
}

VariableIncomeEntity saveVariableIncome(VariableIncomeEntity income) {
    income.destination = decideVariableIncomeDestination(income.userId, income.amount)
    return saveVariableIncomeEntity(income)
}

// =========================================================
// mod_transaction/service/PersistTransactionUseCase.java
// GAP (ver relatorio #5): CurrentUserService (Spring Security) nao tem
// equivalente confirmado no training/ -- userId passa a ser parametro
// explicito da funcao em vez de injetado via contexto de autenticacao.
// Id gerado pelo banco (PERS-06/07); valor gravado em centavos (PERS-17/18).
// =========================================================

// Envelope da transacao: o informado no corpo so vale se for do proprio usuario (PERS-11);
// senao, o envelope do usuario com o nome da categoria; nenhum = null.
String? resolveEnvelopeId(String userId, String? given, Category category) {
    if (given != null) {
        var owned = findEnvelopeById(userId, given)
        if (owned != null) {
            return owned.id
        }
    }
    var env = findEnvelopeByUserIdAndCategoryName(userId, category.name())
    if (env != null) {
        return env.id
    }
    return null
}

TransactionOutput persistTransaction(PersistTransactionInput input, Category category, String userId) {
    if (input.amount() <= 0) {
        throw "Operação negada: O valor da transação deve ser maior que zero."
    }

    var envId = resolveEnvelopeId(userId, input.envelopeId(), category)
    var amountCents = toCents(input.amount() * 1.0)

    // createdAt fixo ate a issue #44 (datas reais); descricao gravada literal via binds (PERS-15)
    var transaction = insertTransaction(TransactionEntity("", input.description(), amountCents, category, input.currency(), userId, null, Source.MANUAL, "2026-09-18T12:00:00Z", envId))

    // Desconto do envelope gravado no banco (soma em centavos)
    if (envId != null) {
        addEnvelopeSpentCents(userId, envId, amountCents)
    }

    return transactionEntityToOutput(transaction)
}

// =========================================================
// mod_transaction/service/GetTotalByCategoryUseCase.java
// =========================================================

Double getTotalByCategory(Category category, String userId) {
    return sumAmountByCategoryAndUserId(category, userId)
}

GetTotalByCategoryOutput getTotalByCategoryOutput(GetTotalByCategoryInput input, String userId) {
    return GetTotalByCategoryOutput(getTotalByCategory(input.category(), userId))
}

// =========================================================
// mod_transaction/service/ListTransactionsByCategoryUseCase.java
// =========================================================

List<TransactionOutput> listTransactionsByCategory(Category category, String userId) {
    return findTransactionsByCategoryAndUserId(category, userId).map((t: TransactionEntity) -> transactionEntityToOutput(t))
}

List<TransactionOutput> listTransactionsByCategoryOutput(ListTransactionsByCategoryInput input, String userId) {
    return listTransactionsByCategory(input.category(), userId)
}

// =========================================================
// mod_transaction/service/ClearTransactionsUseCase.java
