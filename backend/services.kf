}

EnvelopeEntity saveEnvelope(EnvelopeEntity envelope) {
    var i = 0
    while (i < BackendDb.envelopes.size) {
        var existing = BackendDb.envelopes.get(i)
        if (existing.id == envelope.id) {
            BackendDb.envelopes.set(i, envelope)
            return envelope
        }
        i = i + 1
    }
