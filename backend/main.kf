// backend/main.kf
// KofLith — Monólito Modular Unificado do Organiza IA (0.4.x)
// Substitui a segregação artificial BFF <-> Spring Boot.
// Todas as rotas chamam diretamente o domínio Kof sem proxy HTTP.

// Porta HTTP: variavel PORT (o Render injeta), padrao 3000. app.listen aceita so Int (SEM025);
// um PORT que nao e numero derruba o boot com a excecao da conversao (nunca sobe na porta errada).
Int listenPort() {
    var raw = config.env("PORT")
    if (raw != null) {
        return raw.trim().toInt()
    }
    return 3000
}

main() {
    // Boot falha cedo se KOF_JWT_SECRET faltar ou for curta (a mensagem nunca traz o valor).
    // O mesmo segredo alimenta o pipeline auth.* do runtime, que recusa tokens mal assinados.
    try {
        auth.secret(jwtSecret())
    } catch (String e) {
        log.error("Boot abortado: " + e)
        throw e
    }
    // Banco (backend/store.kf): conexao + schema antes de aceitar requisicoes; falha derruba o boot.
    try {
        openDb()
    } catch (String e) {
        log.error("Boot abortado: " + e)
        throw e
    }
    var app = web.app()

    // Middleware global de autenticação: fora das rotas públicas, exige token válido
    // (assinatura, exp, iss e aud via currentClaims). As rotas só leem o usuário.
    app.use {
        // Conexao morta (MySQL reiniciado, idle timeout) e reaberta aqui, antes da rota; banco fora = 503
        // sem detalhe. So /api/* usa o banco: o /health faz o proprio ping (abaixo) e os arquivos do
        // frontend sao servidos mesmo com o banco fora.
        if (path().startsWith("/api/") && !ensureDb()) {
            return status(503, json.encode(ApiError("Serviço temporariamente indisponível. Tente de novo em instantes.")))
        }
        if (isPublicPath(path())) {
            return null
        }
        if (currentClaims() == null) {
            return status(401, json.encode(ApiError("Token ausente, inválido ou expirado")))
        }
        return null
    }

    // Health check do Render e do keep-alive: "OK" so com o banco respondendo (SELECT 1, reabrindo a
    // conexao se ela caiu). Banco fora = 503 sem detalhe; o Render reinicia o servico que fica em 503.
    app.get("/health") {
        if (ensureDb()) {
            return "OK"
        }
        return status(503, json.encode(ApiError("Banco de dados indisponível.")))
    }

    // =========================================================
    // Autenticação Direta (Zero dependência externa)
    // =========================================================

    // Corpo invalido (JSON malformado, campo ausente ou de tipo errado) = 400 em todas as rotas com corpo.
    app.post("/api/auth/login") {
        var req = decodeLoginRequest(body())
        if (req != null) {
            // Campo vazio = 400 antes do rate limit (nao gasta tentativa); e-mail sem espacos nas pontas.
            var invalid = loginError(req)
            if (invalid != null) {
                return status(400, json.encode(ApiError(invalid)))
            }
            var email = req.email.trim()
            // Limite de tentativas por e-mail (5 por minuto) contra força bruta
            if (!security.rateLimit("login:" + email, 5, 60)) {
                return status(429, json.encode(ApiError("Muitas tentativas de login. Tente de novo em 1 minuto.")))
            }
            // Mesma resposta (401) para e-mail inexistente e senha errada: sem enumeracao de usuario
            var user = authenticateUser(email, req.password)
            if (user != null) {
                return issueToken(user.id)
            }
            return status(401, json.encode(ApiError("Credenciais inválidas")))
        }
        return status(400, invalidBody())
    }

    app.post("/api/auth/register") {
        var req = decodeRegisterRequest(body())
        if (req != null) {
            // Regras do cadastro (nome, e-mail, senha >= 8): 400 sem gravar nada.
            var invalid = registerError(req)
            if (invalid != null) {
                return status(400, json.encode(ApiError(invalid)))
            }
            var email = req.email.trim()
            var existing = findUserByEmail(email)
            if (existing != null) {
                return status(409, json.encode(ApiError("Usuário já cadastrado")))
            }

            // Senha so como passwords.hash (PERS-12); o id vem do banco, nunca de contagem em memoria (PERS-06).
            // Corrida com o mesmo e-mail: a UNIQUE do banco barra o perdedor, que tambem recebe 409.
            // hasSalary = false ate o onboarding: o cadastro nao informa salario (onboardingCompleted, Batch 2).
            var created = insertUserIfNew(UserEntity("", email, passwords.hash(req.password), Role.USER, 0, false, Tier.FREE, false, 0, true, BudgetModelType.STANDARD_503020, IncomeType.FIXED, false, 0, req.name.trim()))
            if (created != null) {
                return issueToken(created.id)
            }
            return status(409, json.encode(ApiError("Usuário já cadastrado")))
        }
        return status(400, invalidBody())
    }

    // Esqueci a senha (email.kf). Mesma resposta 202 para e-mail cadastrado ou nao (sem enumeracao);
    // o envio roda num spawn, entao o tempo de resposta tambem nao revela a conta. E-mail desligado = 503.
    app.post("/api/auth/forgot-password") {
        var req = decodeForgotPasswordRequest(body())
        if (req == null) {
            return status(400, invalidBody())
        }
        var email = req.email.trim()
        if (!isEmailLike(email) || email.length() > maxTextLength()) {
            return status(400, json.encode(ApiError("Digite um e-mail válido.")))
        }
        if (!emailConfigured()) {
            return status(503, json.encode(ApiError("Recuperação de senha indisponível no momento. Tente de novo mais tarde.")))
        }
        // Limites por e-mail (3/h) e por IP (10/h). O limite por e-mail vale igual para conta existente ou
        // nao, entao o 429 tambem nao revela cadastro.
        if (!security.rateLimit("forgot-ip:" + clientIpKey(header("X-Forwarded-For")), 10, 3600)) {
            return status(429, json.encode(ApiError("Muitos pedidos de redefinição. Tente de novo mais tarde.")))
        }
        if (!security.rateLimit("forgot:" + email.toLowerCase(), 3, 3600)) {
            return status(429, json.encode(ApiError("Muitos pedidos de redefinição para este e-mail. Tente de novo mais tarde.")))
        }
        var user = findUserByEmail(email)
        if (user != null) {
            spawn {
                startPasswordReset(user)
            }
        }
        return status(202, json.encode(MessageResponse(forgotPasswordAnswer())))
    }

    app.post("/api/auth/reset-password") {
        var req = decodeResetPasswordRequest(body())
        if (req == null) {
            return status(400, invalidBody())
        }
        if (req.password.length() < 8 || req.password.length() > maxTextLength()) {
            return status(400, json.encode(ApiError("A senha precisa ter pelo menos 8 caracteres.")))
        }
        if (!emailConfigured()) {
            return status(503, json.encode(ApiError("Recuperação de senha indisponível no momento. Tente de novo mais tarde.")))
        }
        if (!security.rateLimit("reset-ip:" + clientIpKey(header("X-Forwarded-For")), 20, 3600)) {
            return status(429, json.encode(ApiError("Muitas tentativas. Tente de novo mais tarde.")))
        }
        var userId = consumePasswordResetToken(crypto.sha256(req.token), nowIso())
        if (userId == null) {
            return status(400, json.encode(ApiError("Link inválido ou expirado. Peça um novo.")))
        }
        var user = findUserById(userId)
        if (user == null) {
            return status(400, json.encode(ApiError("Link inválido ou expirado. Peça um novo.")))
        }
        user.passwordHash = passwords.hash(req.password)
        updateUser(user)
        return json.encode(MessageResponse("Senha alterada. Entre com a nova senha."))
    }

    // =========================================================
    // Onboarding — Sugestão e Criação de Orçamento
    // =========================================================

    app.post("/api/users/onboarding") {
        var req = decodeOnboardingRequest(body())
        if (req != null) {
            // Salario > 0, divida > 0 quando hasDebt, incomeType FIXED/VARIABLE: 400 sem gravar nada.
            var invalid = onboardingError(req)
            if (invalid != null) {
                return status(400, json.encode(ApiError(invalid)))
            }
            var incomeType = IncomeType.FIXED
            if (req.incomeType == "VARIABLE") {
                incomeType = IncomeType.VARIABLE
            }

            var suggested = suggestBudgetModel(req.salary, incomeType, req.hasDebt)

            // Persiste o perfil no usuario autenticado (id sempre das claims, nunca do body)
            var user = findUserById(currentUserId())
            if (user == null) {
                return status(404, json.encode(ApiError("Usuário não encontrado")))
            }
            user.salaryCents = toCents(req.salary)
            user.hasSalary = true
            user.incomeType = incomeType
            user.hasDebt = req.hasDebt
            // Divida em centavos so com hasDebt; "Nao, estou em dia" grava 0 mesmo se vier um valor.
            user.debtCents = 0
            if (req.hasDebt) {
                user.debtCents = toCents(debtAmountOf(req))
            }
            user.budgetModel = suggested
            updateUser(user)

            var desc = describeBudgetModel(suggested)
            var buckets = buildBudgetBuckets(suggested, req.salary)
            return json.encode(OnboardingResponse(suggested.name(), desc, buckets))
        }
        return status(400, invalidBody())
    }

    // =========================================================
    // Renda Variável (Reserva de Emergência ou Orçamento)
    // =========================================================

    app.post("/api/variable-income") {
        var req = decodeVariableIncomeInput(body())
        if (req != null) {
            var res = registerUserIncome(currentUserId(), req.amount, req.source)
            var user = findUserById(currentUserId())
            if (user != null) {
                notifyReserveGoal(user)
            }
            return json.encode(res)
        }
        return status(400, invalidBody())
    }

    // Meta da reserva de emergencia: com meta > 0, a renda variavel vai para a reserva ate bater a meta.
    // 0 desliga a meta. Avisa (Tela 12) se a reserva ja alcancou a meta nova.
    app.put("/api/users/me/emergency-goal") {
        var req = decodeEmergencyGoalInput(body())
        if (req == null) {
            return status(400, invalidBody())
        }
        if (req.goal < 0.0) {
            return status(400, json.encode(ApiError("A meta da reserva não pode ser negativa.")))
        }
        var user = findUserById(currentUserId())
        if (user == null) {
            return status(404, json.encode(ApiError("Usuário não encontrado")))
        }
        user.emergencyGoalCents = toCents(req.goal)
        user.hasEmergencyGoal = user.emergencyGoalCents > 0
        updateUser(user)
        notifyReserveGoal(user)
        return json.encode(EmergencyGoalResponse(centsToReais(user.emergencyGoalCents), user.hasEmergencyGoal, centsToReais(reserveCents(user.id))))
    }

    app.get("/api/variable-income") {
        var list = findVariableIncomesByUserId(currentUserId())
        return json.encode(list)
    }

    // =========================================================
    // Pulso Diário e Coach Cognitivo
    // =========================================================

    // GetBalance do legado: buckets do modelo com planejado, gasto e saldo do mes.
    app.get("/api/budgets/balance") {
        return json.encode(calculateBalance(currentUserId(), monthStartIso()))
    }

    app.get("/api/budgets/daily-pulse") {
        return json.encode(calculateDailyPulse(currentUserId(), daysRemainingInMonth(), monthStartIso()))
    }

    // Leitura de fatura PDF (backend/invoice.kf): {"fileBase64": "..."} -> texto + transacoes.
    // Exige token (middleware); corpo acima do limite = 413; JSON/base64/PDF invalido = 400.
    app.post("/api/invoices/parse") {
        var raw = body()
        if (raw.length() > invoiceMaxBase64Chars() + 1024) {
            return status(413, json.encode(ApiError("Arquivo grande demais (máximo de 2 MB).")))
        }
        var req = decodeInvoiceUploadRequest(raw)
        if (req == null) {
            return status(400, invalidBody())
        }
        if (req.fileBase64().length() > invoiceMaxBase64Chars()) {
            return status(413, json.encode(ApiError("Arquivo grande demais (máximo de 2 MB).")))
        }
        try {
            return json.encode(parseInvoicePdf(req.fileBase64()))
        } catch (String e) {
            return status(400, json.encode(ApiError("PDF inválido: " + e)))
        }
    }

    // B3 (L6): confirma e grava em lote os itens da fatura. {"items":[{description, amount, category}]}
    // Exige token; ate 100 itens; um item invalido = 400 e nada gravado; tudo num transaction {}.
    app.post("/api/invoices/confirm") {
        var raw = body()
        if (raw.length() > 65536) {
            return status(413, json.encode(ApiError("Corpo grande demais.")))
        }
        var req = decodeInvoiceConfirmRequest(raw)
        if (req == null) {
            return status(400, invalidBody())
        }
        var err = invoiceItemsError(req.items())
        if (err != null) {
            return status(400, json.encode(ApiError(err)))
        }
        try {
            var saved = confirmInvoiceItems(currentUserId(), req.items())
            return status(201, json.encode(InvoiceConfirmResponse(saved.size, saved)))
        } catch (String e) {
            return status(500, json.encode(ApiError(e)))
        }
    }

    app.post("/api/chat/message") {
        var userId = currentUserId()
        var msgReq = decodeChatMessageRequest(body())
        if (msgReq != null) {
            // Limite do plano antes de gravar (legado: enforceCanSendMessage -> 402 {"error": ...});
            // a mensagem recusada nao e gravada e nao conta no mes.
            var monthStart = monthStartIso()
            try {
                enforceCanSendMessage(userId, monthStart)
            } catch (String e) {
                return status(402, json.encode(ApiError(e)))
            }
            // Coach com OpenAI (coach_llm.kf): a memoria e lida ANTES de gravar a mensagem nova. Se o
            // provedor falhar (rede, timeout, 4xx/5xx), 503 honesto e nada e gravado: a mensagem nao conta
            // no limite do plano. Sem OPENAI_API_KEY, a resposta fixa com o pulso (decisao de 19/10).
            if (llmConfigured()) {
                var user = findUserById(userId)
                if (user == null) {
                    return status(404, json.encode(ApiError("Usuário não encontrado.")))
                }
                var answer = ""
                try {
                    answer = askCoach(user, msgReq.message)
                } catch (String e) {
                    return status(503, json.encode(ApiError("O coach está indisponível no momento. Tente de novo em instantes.")))
                }
                saveChatMessage(ChatMessageEntity("", userId, ChatRole.USER, msgReq.message, nowIso()))
                saveChatMessage(ChatMessageEntity("", userId, ChatRole.ASSISTANT, clipForHistory(answer), nowIso()))
                return answer
            }

            // ids gerados pelo banco (PERS-06/07); createdAt = instante real (issue #44)
            saveChatMessage(ChatMessageEntity("", userId, ChatRole.USER, msgReq.message, nowIso()))

            var pulse = calculateDailyPulse(userId, daysRemainingInMonth(), monthStart)
            var reply = "Olá! Seu pulso diário disponível hoje é R$ " + String.valueOf(pulse.pulse) + ". O que deseja registrar hoje?"
            saveChatMessage(ChatMessageEntity("", userId, ChatRole.ASSISTANT, reply, nowIso()))

            return reply
        }
        return status(400, invalidBody())
    }

    // =========================================================
    // Envelopes e Caixinhas
    // =========================================================

    app.get("/api/envelopes") {
        var envelopes = findEnvelopesByUserId(currentUserId())
        return json.encode(envelopes)
    }

    // Tela 11: caixinhas com o bucket do modelo, o gasto do mes e o status (Em dia/Alerta/Estourada).
    app.get("/api/envelopes/overview") {
        var user = findUserById(currentUserId())
        if (user == null) {
            return status(404, json.encode(ApiError("Usuário não encontrado")))
        }
        return json.encode(envelopesOverview(user))
    }

    // Tela 7: chips de gastos fixos/variaveis -> caixinhas (regra fixa). Exige o onboarding feito.
    app.post("/api/envelopes/from-chips") {
        var req = decodeChipsInput(body())
        if (req == null) {
            return status(400, invalidBody())
        }
        var chips: List<String> = listOf()
        chips.addAll(req.fixed())
        chips.addAll(req.variable())
        var invalid = chipsError(chips)
        if (invalid != null) {
            return status(400, json.encode(ApiError(invalid)))
        }
        var user = findUserById(currentUserId())
        if (user == null) {
            return status(404, json.encode(ApiError("Usuário não encontrado")))
        }
        if (!onboardingCompleted(user)) {
            return status(409, json.encode(ApiError("Conclua o onboarding antes de criar as caixinhas.")))
        }
        return json.encode(createEnvelopesFromChips(user, chips))
    }

    // Legado: PUT /api/envelopes/{id}. limitType ausente = FIXED e movingAverageMonths ausente = 3, como no
    // EnvelopeController. Caixinha de outro usuario ou inexistente = 404.
    app.put("/api/envelopes/:id") {
        var req = decodeUpdateEnvelopeInput(body())
        if (req == null) {
            return status(400, invalidBody())
        }
        var invalid = envelopeError(req.categoryName, req.limitAmount, req.limitType)
        if (invalid != null) {
            return status(400, json.encode(ApiError(invalid)))
        }
        var userId = currentUserId()
        var current = findEnvelopeById(userId, param("id"))
        if (current == null) {
            return status(404, json.encode(ApiError("Caixinha não encontrada.")))
        }
        var limitType = EnvelopeLimitType.FIXED
        var typeText = req.limitType
        if (typeText != null) {
            limitType = limitTypeFromText(typeText)
        }
        var months = 3
        var givenMonths = req.movingAverageMonths
        if (givenMonths != null) {
            months = givenMonths
        }
        return json.encode(updateEnvelope(userId, current.id, EnvelopeEntity(current.id, userId, req.categoryName.trim(), req.limitAmount, current.currentSpent, limitType, months, current.createdAt, current.bucket)))
    }

    app.delete("/api/envelopes/:id") {
        var userId = currentUserId()
        var current = findEnvelopeById(userId, param("id"))
        if (current == null) {
            return status(404, json.encode(ApiError("Caixinha não encontrada.")))
        }
        deleteEnvelope(userId, current.id)
        return status(204, "")
    }

    app.post("/api/envelopes") {
        var req = decodeCreateEnvelopeInput(body())
        if (req != null) {
            // B4: bucket opcional, validado contra os buckets do modelo atual do usuario.
            var owner = findUserById(currentUserId())
            if (owner == null) {
                return status(404, json.encode(ApiError("Usuário não encontrado")))
            }
            var bucketErr = envelopeBucketError(owner, req.bucket)
            if (bucketErr != null) {
                return status(400, json.encode(ApiError(bucketErr)))
            }
            // id "" = novo: o banco gera o id (PERS-06); o dono vem das claims (PERS-09)
            var newEnv = EnvelopeEntity("", currentUserId(), req.categoryName, req.limitAmount, 0.0, EnvelopeLimitType.FIXED, 0, nowIso(), req.bucket)
            var saved = createEnvelope(newEnv)
            return json.encode(saved)
        }
        return status(400, invalidBody())
    }

    // =========================================================
    // Transações e Histórico (Issues #3 e #24)
    // =========================================================

    app.get("/api/transactions") {
        var list = findTransactionsByUserIdAndCreatedAtAfter(currentUserId(), "2000-01-01")
        return json.encode(list.map((t: TransactionEntity) -> transactionEntityToOutput(t)))
    }

    app.post("/api/transactions") {
        var req = decodePersistTransactionInput(body())
        if (req != null) {
            if (req.amount() <= 0) {
                return status(400, json.encode(ApiError("O valor da transação deve ser maior que zero.")))
            }
            var category = Category.valueOf(req.category())
            if (category == null) {
                return status(400, json.encode(ApiError("Categoria inválida: " + req.category())))
            }
            var created = persistTransaction(req, category, currentUserId())
            var envId = created.envelopeId
            if (envId != null) {
                notifyEnvelopeCrossing(currentUserId(), envId, toCents(req.amount() * 1.0))
            }
            return json.encode(created)
        }
        return status(400, invalidBody())
    }

    // Legado: GET /transactions/summary (total por categoria, todas as datas, so categorias com gasto).
    app.get("/api/transactions/summary") {
        var groups = findTransactionsByUserIdAndCreatedAtAfter(currentUserId(), "2000-01-01").groupBy((t: TransactionEntity) -> categoryText(t.category))
        // for, nao forEach: no kof 0.6.6, Map<String, Double>.put dentro de lambda chama Double.valueOf(Double),
        // que nao existe (NoSuchMethodError em runtime; repro p23/repro/foreachput).
        var summary: Map<String, Double> = mapOf()
        for (var name in groups.keys()) {
            summary.put(name, centsToReais(sumAmountCents(groups.getOrDefault(name, listOf()))))
        }
        return json.encode(summary)
    }

    // Legado: GET /transactions/{category}.
    app.get("/api/transactions/:category") {
        var category = Category.valueOf(param("category"))
        if (category == null) {
            return status(400, json.encode(ApiError("Categoria inválida: " + param("category"))))
        }
        return json.encode(listTransactionsByCategory(category, currentUserId()))
    }

    // =========================================================
    // Dashboard (Tela 9): JSON real do periodo (?period=week|month|year; padrao month)
    // =========================================================

    app.get("/api/dashboard") {
        var period = query("period")
        var unit = periodUnit(period)
        if (unit == null) {
            return status(400, json.encode(ApiError("Período inválido: use week, month ou year.")))
        }
        var user = findUserById(currentUserId())
        if (user == null) {
            return status(404, json.encode(ApiError("Usuário não encontrado")))
        }
        return json.encode(dashboardOf(user, unit, unit))
    }

    // Tela 12: avisos do usuario (os do dia sao criados na primeira leitura) e "marcar todas como lidas".
    app.get("/api/notifications") {
        var user = findUserById(currentUserId())
        if (user == null) {
            return status(404, json.encode(ApiError("Usuário não encontrado")))
        }
        ensureDailyNotifications(user)
        return json.encode(findNotifications(user.id))
    }

    app.post("/api/notifications/read-all") {
        markNotificationsRead(currentUserId())
        return status(204, "")
    }

    // Tela 13: preferencias de e-mail/push.
    app.get("/api/users/me/preferences") {
        return json.encode(findPreferences(currentUserId()))
    }

    app.put("/api/users/me/preferences") {
        var req = decodePreferencesInput(body())
        if (req == null) {
            return status(400, invalidBody())
        }
        var invalid = preferencesError(req)
        if (invalid != null) {
            return status(400, json.encode(ApiError(invalid)))
        }
        return json.encode(savePreferences(currentUserId(), req))
    }

    // Tela 13: Open Finance e DEMONSTRACAO (decisao de 16/10): nenhuma conexao, nenhum dado bancario.
    app.get("/api/open-finance/banks") {
        return json.encode(OpenFinanceDemo(true, openFinanceNotice(), openFinanceDemoBanks()))
    }

    app.post("/api/open-finance/connect") {
        try {
            var req = json.decode<OpenFinanceConnectInput>(body())
            if (req.bank() != null && openFinanceDemoBanks().contains(req.bank())) {
                return json.encode(OpenFinanceConnectResult(true, req.bank(), "DEMO_NAO_CONECTADO", openFinanceNotice()))
            }
            return status(400, json.encode(ApiError("Banco fora da demonstração.")))
        } catch (String e) {
            return status(400, invalidBody())
        }
    }

    // Perfil do usuario do token: o frontend decide entre o onboarding (Tela 4) e o dashboard.
    app.get("/api/users/me") {
        var user = findUserById(currentUserId())
        if (user == null) {
            return status(404, json.encode(ApiError("Usuário não encontrado")))
        }
        return json.encode(meOf(user))
    }

    // Legado: PATCH /api/users/me/salary. Grava o salario e migra o modelo (BudgetModelMigrationService);
    // "Rever meu salario" (Tela 13) tambem pode refazer o onboarding inteiro.
    app.patch("/api/users/me/salary") {
        var req = decodeSalaryInput(body())
        if (req == null) {
            return status(400, invalidBody())
        }
        if (req.salary <= 0.0) {
            return status(400, json.encode(ApiError("O salário deve ser maior que zero.")))
        }
        var user = findUserById(currentUserId())
        if (user == null) {
            return status(404, json.encode(ApiError("Usuário não encontrado")))
        }
        var previous = user.budgetModel
        user.salaryCents = toCents(req.salary)
        user.hasSalary = true
        user.budgetModel = migrateBudgetModelIfNeeded(user)
        updateUser(user)
        var salary = userSalary(user)
        return json.encode(SalaryUpdateResponse(salary, previous.name(), user.budgetModel.name(), previous != user.budgetModel,
            describeBudgetModel(user.budgetModel), buildBudgetBuckets(user.budgetModel, salary)))
    }

    // Issue #11: troca manual do modelo de orcamento.
    app.put("/api/users/me/budget-model") {
        var req = decodeBudgetModelInput(body())
        if (req == null) {
            return status(400, invalidBody())
        }
        var model = BudgetModelType.valueOf(req.model)
        if (model == null) {
            return status(400, json.encode(ApiError("Modelo inválido: " + req.model)))
        }
        var user = findUserById(currentUserId())
        if (user == null) {
            return status(404, json.encode(ApiError("Usuário não encontrado")))
        }
        user.budgetModel = model
        updateUser(user)
        return json.encode(OnboardingResponse(model.name(), describeBudgetModel(model), buildBudgetBuckets(model, userSalary(user))))
    }

    app.get("/api/users/tier-status") {
        return json.encode(getTierStatus(currentUserId(), monthStartIso()))
    }

    // Mesmo dominio (Batch 2, design §2.3): com KOF_WEB_OUT, o backend serve a saida de
    // `kof build frontend --target js` em / e o frontend chama /api/... por caminho relativo (sem CORS).
    // Sem a variavel, so a API e o /health, como antes.
    var webOut = config.env("KOF_WEB_OUT")
    if (webOut != null) {
        app.serveDir("/", webOut)
        log.info("frontend servido de KOF_WEB_OUT")
    }

    log.info(emailStatus())
    log.info(llmStatus())
    startDailyDigest()
    app.listen(listenPort())
}
