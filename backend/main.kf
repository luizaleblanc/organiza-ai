// backend/main.kf
// KofLith — Monólito Modular Unificado do Organiza IA (0.4.x)
// Substitui a segregação artificial BFF <-> Spring Boot.
// Todas as rotas chamam diretamente o domínio Kof sem proxy HTTP.

import kof.web

// Porta HTTP: variavel PORT (o Render injeta), padrao 3000. app.listen aceita so Int (SEM025);
// um PORT que nao e numero derruba o boot com a excecao da conversao (nunca sobe na porta errada).
// Resposta do chat em JSON (L3): texto + uso do plano ja contando a mensagem recem-gravada.
String chatReplyJson(String userId, String reply, String monthStart) {
    var tier = getTierStatus(userId, monthStart)
    return json.encode(ChatReply(reply, tier.messagesUsed(), tier.messagesLimit()))
}

Int listenPort() {
    var raw = config.env("PORT")
    if (raw != null) {
        return raw.trim().toInt()
    }
    return 3000
}

main() {
    // Boot falha cedo se KOF_JWT_SECRET faltar ou for curta (a mensagem nunca traz o valor).
    // O mesmo segredo alimenta o pipeline auth.* do runtime, que recusa tokens mal assinados.
    try {
        auth.secret(jwtSecret())
    } catch (String e) {
        log.error("Boot abortado: " + e)
        throw e
    }
    // Banco (backend/store.kf): conexao + schema antes de aceitar requisicoes; falha derruba o boot.
    try {
        openDb()
    } catch (String e) {
        log.error("Boot abortado: " + e)
        throw e
    }
    var app = web.app()
    logQaMode()

    // Middleware global de autenticação: fora das rotas públicas, exige token válido
    // (assinatura, exp, iss e aud via currentClaims). As rotas só leem o usuário.
    app.use {
        // Conexao morta (MySQL reiniciado, idle timeout) e reaberta aqui, antes da rota; banco fora = 503
        // sem detalhe. So /api/* usa o banco: o /health faz o proprio ping (abaixo) e os arquivos do
        // frontend sao servidos mesmo com o banco fora.
        if (path().startsWith("/api/") && !ensureDb()) {
            return status(503, json.encode(ApiError("Serviço temporariamente indisponível. Tente de novo em instantes.")))
        }
        if (isPublicPath(path())) {
            return null
        }
        if (currentClaims() == null) {
            return status(401, json.encode(ApiError("Token ausente, inválido ou expirado")))
        }
        return null
    }

    // Health check do Render e do keep-alive: "OK" so com o banco respondendo (SELECT 1, reabrindo a
    // conexao se ela caiu). Banco fora = 503 sem detalhe; o Render reinicia o servico que fica em 503.
    app.get("/health") {
        if (ensureDb()) {
            return "OK"
        }
        return status(503, json.encode(ApiError("Banco de dados indisponível.")))
    }

    app.get("/qa") {
        if (!qaEnabled()) { return qaNotFound() }
        setHeader("Content-Type", "text/plain; charset=utf-8")
        return qaGuide()
    }

    app.post("/api/qa/seed") {
        if (!qaEnabled()) { return qaNotFound() }
        return json.encode(seedQaData())
    }

    app.post("/api/qa/reset") {
        if (!qaEnabled()) { return qaNotFound() }
        return json.encode(resetQaData())
    }

    app.post("/api/qa/clear-transactions") {
        if (!qaEnabled()) { return qaNotFound() }
        var targetUser = findUserByEmail("luizaa.fq@gmail.com")
        if (targetUser == null) { targetUser = findUserByEmail(qaDemoEmail()) }
        if (targetUser != null) {
            deleteTransactionsByUserId(targetUser.id)
            var envs = findEnvelopesByUserId(targetUser.id)
            for (var env in envs) {
                env.currentSpent = 0.0
                updateEnvelope(targetUser.id, env.id, env)
            }
        }
        return json.encode(mapOf("status", "cleared"))
    }

    app.post("/api/qa/clear-chat") {
        if (!qaEnabled()) { return qaNotFound() }
        var targetUser = findUserByEmail("luizaa.fq@gmail.com")
        if (targetUser == null) { targetUser = findUserByEmail(qaDemoEmail()) }
        if (targetUser != null) {
            deleteChatMessagesByUserId(targetUser.id)
        }
        return json.encode(mapOf("status", "chat_cleared"))
    }

    app.delete("/api/chat/messages") {
        var userId = currentUserId()
        deleteChatMessagesByUserId(userId)
        return status(204, "")
    }

    app.post("/api/qa/notifications/simulate") {
        if (!qaEnabled()) { return qaNotFound() }
        var demo = findUserByEmail("luizaa.fq@gmail.com")
        if (demo == null) { demo = findUserByEmail(qaDemoEmail()) }
        if (demo == null) {
            var all = findAllUsers()
            if (all.size > 0) { demo = all.get(0) }
        }
        if (demo == null) { return status(409, json.encode(ApiError("Nenhum usuário encontrado."))) }
        var day = monthStartIso()
        insertNotificationOnce(demo.id, "ENVELOPE_EXCEEDED", "Você estourou a caixinha Assinaturas", "Você já gastou R$ 360 de R$ 300 em assinaturas (120%). Dá uma olhada antes que aperte o resto do mês.", day + "-sim-exceeded")
        insertNotificationOnce(demo.id, "ENVELOPE_WARNING", "Delivery quase no limite", "Você já gastou R$ 270 de R$ 300 em Delivery (90%). Ainda dá pra segurar até o fim do mês.", day + "-sim-warning")
        insertNotificationOnce(demo.id, "DAILY_PULSE", "Seu pulso de hoje", "Você pode gastar R$ 92,00 hoje sem sair do combinado. Faltam 12 dias para o fim do mês.", day + "-sim-pulse")
        insertNotificationOnce(demo.id, "SAVINGS", "Mês fechado dentro do combinado!", "Você terminou o mês gastando R$ 2.840 de R$ 3.000. Mandou bem — bora manter o ritmo?", day + "-sim-savings")
        insertNotificationOnce(demo.id, "REMINDER", "Não esqueceu de registrar hoje?", "Você ainda não lançou nenhum gasto hoje. Manda um \"gastei R$ X\" no chat que eu cuido do resto.", day + "-sim-reminder")
        return json.encode(findNotifications(demo.id))
    }

    app.get("/api/qa/notifications/simulate") {
        if (!qaEnabled()) { return qaNotFound() }
        var demo = findUserByEmail("luizaa.fq@gmail.com")
        if (demo == null) { demo = findUserByEmail(qaDemoEmail()) }
        if (demo == null) {
            var all = findAllUsers()
            if (all.size > 0) { demo = all.get(0) }
        }
        if (demo == null) { return status(409, json.encode(ApiError("Nenhum usuário encontrado."))) }
        var day = monthStartIso()
        insertNotificationOnce(demo.id, "ENVELOPE_EXCEEDED", "Você estourou a caixinha Assinaturas", "Você já gastou R$ 360 de R$ 300 em assinaturas (120%). Dá uma olhada antes que aperte o resto do mês.", day + "-sim-exceeded")
        insertNotificationOnce(demo.id, "ENVELOPE_WARNING", "Delivery quase no limite", "Você já gastou R$ 270 de R$ 300 em Delivery (90%). Ainda dá pra segurar até o fim do mês.", day + "-sim-warning")
        insertNotificationOnce(demo.id, "DAILY_PULSE", "Seu pulso de hoje", "Você pode gastar R$ 92,00 hoje sem sair do combinado. Faltam 12 dias para o fim do mês.", day + "-sim-pulse")
        insertNotificationOnce(demo.id, "SAVINGS", "Mês fechado dentro do combinado!", "Você terminou o mês gastando R$ 2.840 de R$ 3.000. Mandou bem — bora manter o ritmo?", day + "-sim-savings")
        insertNotificationOnce(demo.id, "REMINDER", "Não esqueceu de registrar hoje?", "Você ainda não lançou nenhum gasto hoje. Manda um \"gastei R$ X\" no chat que eu cuido do resto.", day + "-sim-reminder")
        return json.encode(findNotifications(demo.id))
    }

    app.get("/api/qa/session") {
        if (!qaEnabled()) { return qaNotFound() }
        var demo = findUserByEmail(qaDemoEmail())
        if (demo == null) { return status(409, json.encode(ApiError("Execute POST /api/qa/seed primeiro."))) }
        return json.encode(mapOf("token", issueToken(demo.id), "screen", "dashboard"))
    }

    // =========================================================
    // Autenticação Direta (Zero dependência externa)
    // =========================================================

    // Corpo invalido (JSON malformado, campo ausente ou de tipo errado) = 400 em todas as rotas com corpo.
    app.post("/api/auth/login") {
        var req = decodeLoginRequest(body())
        if (req != null) {
            // Campo vazio = 400 antes do rate limit (nao gasta tentativa); e-mail sem espacos nas pontas.
            var invalid = loginError(req)
            if (invalid != null) {
                return status(400, json.encode(ApiError(invalid)))
            }
            var email = req.email.trim().toLowerCase()
            // Limite de tentativas por e-mail (5 por minuto) contra força bruta
            if (!security.rateLimit("login:" + email, 5, 60)) {
                return status(429, json.encode(ApiError("Muitas tentativas de login. Tente de novo em 1 minuto.")))
            }
            // Mesma resposta (401) para e-mail inexistente e senha errada: sem enumeracao de usuario
            var user = authenticateUser(email, req.password)
            if (user != null) {
                return issueToken(user.id)
            }
            return status(401, json.encode(ApiError("Credenciais inválidas")))
        }
        return status(400, invalidBody())
    }

    app.post("/api/auth/register") {
        var req = decodeRegisterRequest(body())
        if (req != null) {
            // Regras do cadastro (nome, sobrenome, idade, e-mail e politica de senha): 400 sem gravar nada.
            var invalid = registerError(req)
            if (invalid != null) {
                return status(400, json.encode(ApiError(invalid)))
            }
            var email = req.email.trim().toLowerCase()
            var existing = findUserByEmail(email)
            if (existing != null) {
                return status(409, json.encode(ApiError("Usuário já cadastrado")))
            }

            // Senha so como passwords.hash (PERS-12); o id vem do banco, nunca de contagem em memoria (PERS-06).
            // Corrida com o mesmo e-mail: a UNIQUE do banco barra o perdedor, que tambem recebe 409.
            // hasSalary = false ate o onboarding: o cadastro nao informa salario (onboardingCompleted, Batch 2).
            var created = insertUserIfNew(UserEntity("", email, passwords.hash(req.password), Role.USER, 0, false, Tier.FREE, false, 0, true, BudgetModelType.STANDARD_503020, IncomeType.FIXED, false, 0, registerFullName(req), registerFirstName(req), registerLastName(req), registerAge(req)))
            if (created != null) {
                return issueToken(created.id)
            }
            return status(409, json.encode(ApiError("Usuário já cadastrado")))
        }
        return status(400, invalidBody())
    }

    // Esqueci a senha (email.kf). Mesma resposta 202 para e-mail cadastrado ou nao (sem enumeracao);
    // o envio roda num spawn, entao o tempo de resposta tambem nao revela a conta. E-mail desligado = 503.
    app.post("/api/auth/forgot-password") {
        var req = decodeForgotPasswordRequest(body())
        if (req == null) {
            return status(400, invalidBody())
        }
        var email = req.email.trim().toLowerCase()
        if (!isEmailLike(email) || email.length() > maxTextLength()) {
            return status(400, json.encode(ApiError("Digite um e-mail válido.")))
        }
        if (!emailConfigured()) {
            return status(503, json.encode(ApiError("Recuperação de senha indisponível no momento. Tente de novo mais tarde.")))
        }
        // Limites por e-mail (3/h) e por IP (10/h). O limite por e-mail vale igual para conta existente ou
        // nao, entao o 429 tambem nao revela cadastro.
        if (!security.rateLimit("forgot-ip:" + clientIpKey(header("X-Forwarded-For")), 10, 3600)) {
            return status(429, json.encode(ApiError("Muitos pedidos de redefinição. Tente de novo mais tarde.")))
        }
        if (!security.rateLimit("forgot:" + email.toLowerCase(), 3, 3600)) {
            return status(429, json.encode(ApiError("Muitos pedidos de redefinição para este e-mail. Tente de novo mais tarde.")))
        }
        var user = findUserByEmail(email)
        if (user != null) {
            spawn {
                startPasswordReset(user)
            }
        }
        return status(202, json.encode(MessageResponse(forgotPasswordAnswer())))
    }

    app.post("/api/auth/reset-password") {
        var req = decodeResetPasswordRequest(body())
        if (req == null) {
            return status(400, invalidBody())
        }
        // P1 a P6 antes de gastar o token; P7 e P8 (e-mail e nome) dependem da conta, entao vem depois.
        var shape = passwordShapeError(req.password)
        if (shape != null) {
            return status(400, json.encode(ApiError(shape)))
        }
        if (!emailConfigured()) {
            return status(503, json.encode(ApiError("Recuperação de senha indisponível no momento. Tente de novo mais tarde.")))
        }
        if (!security.rateLimit("reset-ip:" + clientIpKey(header("X-Forwarded-For")), 20, 3600)) {
            return status(429, json.encode(ApiError("Muitas tentativas. Tente de novo mais tarde.")))
        }
        // E-mail + código de 6 números: no máximo 5 tentativas por e-mail a cada 30 minutos.
        var resetEmail = req.email.trim().toLowerCase()
        if (!security.rateLimit("reset-email:" + resetEmail, 5, 1800)) {
            return status(429, json.encode(ApiError("Muitas tentativas. Peça um novo código e tente de novo mais tarde.")))
        }
        var owner = findUserByEmail(resetEmail)
        if (owner == null) {
            return status(400, json.encode(ApiError("Código inválido ou expirado. Peça um novo.")))
        }
        var userId = consumePasswordResetToken(resetCodeHash(owner.id, req.token), nowIso())
        if (userId == null) {
            return status(400, json.encode(ApiError("Código inválido ou expirado. Peça um novo.")))
        }
        if (userId != owner.id) {
            return status(400, json.encode(ApiError("Código inválido ou expirado. Peça um novo.")))
        }
        var user = findUserById(owner.id)
        if (user == null) {
            return status(400, json.encode(ApiError("Código inválido ou expirado. Peça um novo.")))
        }
        var identity = passwordIdentityError(req.password, user.email, meOf(user).firstName)
        if (identity != null) {
            return status(400, json.encode(ApiError(identity)))
        }
        user.passwordHash = passwords.hash(req.password)
        updateUser(user)
        return json.encode(MessageResponse("Senha alterada. Entre com a nova senha."))
    }

    // =========================================================
    // Onboarding — Sugestão e Criação de Orçamento
    // =========================================================

    app.post("/api/users/onboarding") {
        var req = decodeOnboardingRequest(body())
        if (req != null) {
            // Salario > 0, divida > 0 quando hasDebt, incomeType FIXED/VARIABLE: 400 sem gravar nada.
            var invalid = onboardingError(req)
            if (invalid != null) {
                return status(400, json.encode(ApiError(invalid)))
            }
            var incomeType = IncomeType.FIXED
            if (req.incomeType == "VARIABLE") {
                incomeType = IncomeType.VARIABLE
            }

            var suggested = suggestBudgetModel(req.salary, incomeType, req.hasDebt)

            // Persiste o perfil no usuario autenticado (id sempre das claims, nunca do body)
            var user = findUserById(currentUserId())
            if (user == null) {
                return status(404, json.encode(ApiError("Usuário não encontrado")))
            }
            user.salaryCents = toCents(req.salary)
            user.hasSalary = true
            user.incomeType = incomeType
            user.hasDebt = req.hasDebt
            // Divida em centavos so com hasDebt; "Nao, estou em dia" grava 0 mesmo se vier um valor.
            user.debtCents = 0
            if (req.hasDebt) {
                user.debtCents = toCents(debtAmountOf(req))
            }
            user.budgetModel = suggested
            updateUser(user)

            var desc = describeBudgetModel(suggested)
            var buckets = buildBudgetBuckets(suggested, req.salary)
            return json.encode(OnboardingResponse(suggested.name(), desc, buckets))
        }
        return status(400, invalidBody())
    }

    // =========================================================
    // Renda Variável (Reserva de Emergência ou Orçamento)
    // =========================================================

    app.post("/api/variable-income") {
        var req = decodeVariableIncomeInput(body())
        if (req != null) {
            var res = registerUserIncome(currentUserId(), req.amount, req.source)
            var user = findUserById(currentUserId())
            if (user != null) {
                notifyReserveGoal(user)
            }
            return json.encode(res)
        }
        return status(400, invalidBody())
    }

    // Meta da reserva de emergencia: com meta > 0, a renda variavel vai para a reserva ate bater a meta.
    // 0 desliga a meta. Avisa (Tela 12) se a reserva ja alcancou a meta nova.
    app.put("/api/users/me/emergency-goal") {
        var req = decodeEmergencyGoalInput(body())
        if (req == null) {
            return status(400, invalidBody())
        }
        if (req.goal < 0.0) {
            return status(400, json.encode(ApiError("A meta da reserva não pode ser negativa.")))
        }
        var user = findUserById(currentUserId())
        if (user == null) {
            return status(404, json.encode(ApiError("Usuário não encontrado")))
        }
        user.emergencyGoalCents = toCents(req.goal)
        user.hasEmergencyGoal = user.emergencyGoalCents > 0
        updateUser(user)
        notifyReserveGoal(user)
        return json.encode(EmergencyGoalResponse(centsToReais(user.emergencyGoalCents), user.hasEmergencyGoal, centsToReais(reserveCents(user.id))))
    }

    app.get("/api/variable-income") {
        var list = findVariableIncomesByUserId(currentUserId())
        return json.encode(list.map((v: VariableIncomeEntity) -> variableIncomeEntityToOutput(v)))
    }

    // =========================================================
    // Pulso Diário e Coach Cognitivo
    // =========================================================

    // GetBalance do legado: buckets do modelo com planejado, gasto e saldo do mes.
    app.get("/api/budgets/balance") {
        return json.encode(calculateBalance(currentUserId(), monthStartIso()))
    }

    app.get("/api/budgets/daily-pulse") {
        return json.encode(calculateDailyPulse(currentUserId(), daysRemainingInMonth(), monthStartIso()))
    }

    // Leitura de fatura PDF (backend/invoice.kf): {"fileBase64": "..."} -> texto + transacoes.
    // Exige token (middleware); corpo acima do limite = 413; JSON/base64/PDF invalido = 400.
    app.post("/api/invoices/parse") {
        var raw = body()
        if (raw.length() > invoiceMaxBase64Chars() + 1024) {
            return status(413, json.encode(ApiError("Arquivo grande demais (máximo de 2 MB).")))
        }
        var req = decodeInvoiceUploadRequest(raw)
        if (req == null) {
            return status(400, invalidBody())
        }
        if (req.fileBase64().length() > invoiceMaxBase64Chars()) {
            return status(413, json.encode(ApiError("Arquivo grande demais (máximo de 2 MB).")))
        }
        try {
            return json.encode(parseInvoicePdf(req.fileBase64()))
        } catch (String e) {
            return status(400, json.encode(ApiError("PDF inválido: " + e)))
        }
    }

    // B3 (L6): confirma e grava em lote os itens da fatura. {"items":[{description, amount, category}]}
    // Exige token; ate 100 itens; um item invalido = 400 e nada gravado; tudo num transaction {}.
    app.post("/api/invoices/confirm") {
        var raw = body()
        if (raw.length() > 65536) {
            return status(413, json.encode(ApiError("Corpo grande demais.")))
        }
        var req = decodeInvoiceConfirmRequest(raw)
        if (req == null) {
            return status(400, invalidBody())
        }
        var err = invoiceItemsError(req.items())
        if (err != null) {
            return status(400, json.encode(ApiError(err)))
        }
        try {
            var saved = confirmInvoiceItems(currentUserId(), req.items())
            return status(201, json.encode(InvoiceConfirmResponse(saved.size, saved)))
        } catch (String e) {
            return status(500, json.encode(ApiError(e)))
        }
    }

    app.post("/api/chat/message") {
        var userId = currentUserId()
        var msgReq = decodeChatMessageRequest(body())
        if (msgReq != null) {
            // Limite do plano antes de gravar (legado: enforceCanSendMessage -> 402 {"error": ...});
            // a mensagem recusada nao e gravada e nao conta no mes.
            var monthStart = monthStartIso()
            try {
                enforceCanSendMessage(userId, monthStart)
            } catch (String e) {
                return status(402, json.encode(ApiError(e)))
            }
            // Coach com OpenAI (coach_llm.kf): a memoria e lida ANTES de gravar a mensagem nova. Se o
            // provedor falhar (rede, timeout, 4xx/5xx), 503 honesto e nada e gravado: a mensagem nao conta
            // no limite do plano. Sem OPENAI_API_KEY, a resposta fixa com o pulso (decisao de 19/10).
            if (llmConfigured()) {
                var user = findUserById(userId)
                if (user == null) {
                    return status(404, json.encode(ApiError("Usuário não encontrado.")))
                }
                var answer = ""
                try {
                    answer = askCoach(user, msgReq.message)
                } catch (String e) {
                    return status(503, json.encode(ApiError("O coach está indisponível no momento. Tente de novo em instantes.")))
                }
                saveChatMessage(ChatMessageEntity("", userId, ChatRole.USER, msgReq.message, nowIso()))
                saveChatMessage(ChatMessageEntity("", userId, ChatRole.ASSISTANT, clipForHistory(answer), nowIso()))
                return chatReplyJson(userId, answer, monthStart)
            }

            // ids gerados pelo banco (PERS-06/07); createdAt = instante real (issue #44)
            saveChatMessage(ChatMessageEntity("", userId, ChatRole.USER, msgReq.message, nowIso()))

            var reply = coachReplyOffline(userId, msgReq.message, monthStart)
            saveChatMessage(ChatMessageEntity("", userId, ChatRole.ASSISTANT, reply, nowIso()))

            return chatReplyJson(userId, reply, monthStart)
        }
        return status(400, invalidBody())
    }

    // Historico do chat do usuario do token (L4): ?page=&limit= (ou ?offset=), padrao 50, teto 100.
    // Pagina 1 = mensagens mais recentes, em ordem cronologica. Parametro invalido = 400.
    app.get("/api/chat/messages") {
        try {
            val p = pageRequest(50, 100)
            return json.encode(findChatHistoryPage(currentUserId(), p.page(), p.limit(), p.offset()))
        } catch (String e) {
            return status(400, json.encode(ApiError(e)))
        }
    }

    // =========================================================
    // Envelopes e Caixinhas
    // =========================================================

    app.get("/api/envelopes") {
        var envelopes = findEnvelopesByUserId(currentUserId())
        return json.encode(envelopes.map((e: EnvelopeEntity) -> envelopeEntityToOutput(e)))
    }

    // Tela 11: caixinhas com o bucket do modelo, o gasto do mes e o status (Em dia/Alerta/Estourada).
    app.get("/api/envelopes/overview") {
        var user = findUserById(currentUserId())
        if (user == null) {
            return status(404, json.encode(ApiError("Usuário não encontrado")))
        }
        return json.encode(envelopesOverview(user))
    }

    // Tela 7: chips de gastos fixos/variaveis -> caixinhas (regra fixa). Exige o onboarding feito.
    app.post("/api/envelopes/from-chips") {
        var req = decodeChipsInput(body())
        if (req == null) {
            return status(400, invalidBody())
        }
        var chips: List<String> = listOf()
        chips.addAll(req.fixed())
        chips.addAll(req.variable())
        var invalid = chipsError(chips)
        if (invalid != null) {
            return status(400, json.encode(ApiError(invalid)))
        }
        var user = findUserById(currentUserId())
        if (user == null) {
            return status(404, json.encode(ApiError("Usuário não encontrado")))
        }
        if (!onboardingCompleted(user)) {
            return status(409, json.encode(ApiError("Conclua o onboarding antes de criar as caixinhas.")))
        }
        return json.encode(createEnvelopesFromChips(user, chips).map((e: EnvelopeEntity) -> envelopeEntityToOutput(e)))
    }

    // Legado: PUT /api/envelopes/{id}. limitType ausente = FIXED e movingAverageMonths ausente = 3, como no
    // EnvelopeController. Caixinha de outro usuario ou inexistente = 404.
    app.put("/api/envelopes/:id") {
        var req = decodeUpdateEnvelopeInput(body())
        if (req == null) {
            return status(400, invalidBody())
        }
        var invalid = envelopeError(req.categoryName, req.limitAmount, req.limitType)
        if (invalid != null) {
            return status(400, json.encode(ApiError(invalid)))
        }
        var userId = currentUserId()
        var current = findEnvelopeById(userId, param("id"))
        if (current == null) {
            return status(404, json.encode(ApiError("Caixinha não encontrada.")))
        }
        var newName = req.categoryName.trim()
        if (newName != current.categoryName) {
            if (findEnvelopeByName(userId, newName, current.id) != null) {
                return status(409, json.encode(ApiError("Você já tem uma caixinha com esse nome.")))
            }
        }
        var limitType = EnvelopeLimitType.FIXED
        var typeText = req.limitType
        if (typeText != null) {
            limitType = limitTypeFromText(typeText)
        }
        var months = 3
        var givenMonths = req.movingAverageMonths
        if (givenMonths != null) {
            months = givenMonths
        }
        return json.encode(envelopeEntityToOutput(updateEnvelope(userId, current.id, EnvelopeEntity(current.id, userId, newName, req.limitAmount, current.currentSpent, limitType, months, current.createdAt, current.bucket))))
    }

    app.delete("/api/envelopes/:id") {
        var userId = currentUserId()
        var current = findEnvelopeById(userId, param("id"))
        if (current == null) {
            return status(404, json.encode(ApiError("Caixinha não encontrada.")))
        }
        deleteEnvelope(userId, current.id)
        return status(204, "")
    }

    app.post("/api/envelopes") {
        var req = decodeCreateEnvelopeInput(body())
        if (req != null) {
            var nameErr = envelopeNameError(req.categoryName)
            if (nameErr != null) {
                return status(400, json.encode(ApiError(nameErr)))
            }
            // B4: bucket opcional, validado contra os buckets do modelo atual do usuario.
            var owner = findUserById(currentUserId())
            if (owner == null) {
                return status(404, json.encode(ApiError("Usuário não encontrado")))
            }
            var bucketErr = envelopeBucketError(owner, req.bucket)
            if (bucketErr != null) {
                return status(400, json.encode(ApiError(bucketErr)))
            }
            if (findEnvelopeByName(currentUserId(), req.categoryName, "") != null) {
                return status(409, json.encode(ApiError("Você já tem uma caixinha com esse nome.")))
            }
            // id "" = novo: o banco gera o id (PERS-06); o dono vem das claims (PERS-09)
            var newEnv = EnvelopeEntity("", currentUserId(), req.categoryName.trim(), req.limitAmount, 0.0, EnvelopeLimitType.FIXED, 0, nowIso(), req.bucket)
            var saved = createEnvelope(newEnv)
            return json.encode(envelopeEntityToOutput(saved))
        }
        return status(400, invalidBody())
    }

    // =========================================================
    // Transações e Histórico (Issues #3 e #24)
    // =========================================================

    app.get("/api/transactions") {
        var list = findTransactionsByUserIdAndCreatedAtAfter(currentUserId(), "2000-01-01")
        return json.encode(list.map((t: TransactionEntity) -> transactionEntityToOutput(t)))
    }

    app.post("/api/transactions") {
        var req = decodePersistTransactionInput(body())
        if (req != null) {
            if (req.amount() <= 0) {
                return status(400, json.encode(ApiError("O valor da transação deve ser maior que zero.")))
            }
            var category = Category.valueOf(req.category())
            if (category == null) {
                return status(400, json.encode(ApiError("Categoria inválida: " + req.category())))
            }
            var created = persistTransaction(req, category, currentUserId())
            var envId = created.envelopeId
            if (envId != null) {
                notifyEnvelopeCrossing(currentUserId(), envId, toCents(req.amount() * 1.0))
            }
            return json.encode(created)
        }
        return status(400, invalidBody())
    }

    // Legado: GET /transactions/summary (total por categoria, todas as datas, so categorias com gasto).
    app.get("/api/transactions/summary") {
        var groups = findTransactionsByUserIdAndCreatedAtAfter(currentUserId(), "2000-01-01").groupBy((t: TransactionEntity) -> categoryText(t.category))
        // for, nao forEach: no kof 0.6.6, Map<String, Double>.put dentro de lambda chama Double.valueOf(Double),
        // que nao existe (NoSuchMethodError em runtime; repro p23/repro/foreachput).
        var summary: Map<String, Double> = mapOf()
        for (var name in groups.keys()) {
            summary.put(name, centsToReais(sumAmountCents(groups.getOrDefault(name, listOf()))))
        }
        return json.encode(summary)
    }

    // Legado: GET /transactions/{category}.
    app.get("/api/transactions/:category") {
        var category = Category.valueOf(param("category"))
        if (category == null) {
            return status(400, json.encode(ApiError("Categoria inválida: " + param("category"))))
        }
        return json.encode(listTransactionsByCategory(category, currentUserId()))
    }

    // =========================================================
    // Dashboard (Tela 9): JSON real do periodo (?period=week|month|year; padrao month)
    // =========================================================

    app.get("/api/dashboard") {
        var period = query("period")
        var unit = periodUnit(period)
        if (unit == null) {
            return status(400, json.encode(ApiError("Período inválido: use week, month ou year.")))
        }
        var user = findUserById(currentUserId())
        if (user == null) {
            return status(404, json.encode(ApiError("Usuário não encontrado")))
        }
        return json.encode(dashboardOf(user, unit, unit))
    }

    // Tela 12: avisos do usuario (os do dia sao criados na primeira leitura) e "marcar todas como lidas".
    app.get("/api/notifications") {
        var user = findUserById(currentUserId())
        if (user == null) {
            return status(404, json.encode(ApiError("Usuário não encontrado")))
        }
        ensureDailyNotifications(user)
        return json.encode(findNotifications(user.id))
    }

    app.post("/api/notifications/read-all") {
        markNotificationsRead(currentUserId())
        return status(204, "")
    }

    // Tela 13: preferencias de e-mail/push.
    app.get("/api/users/me/preferences") {
        return json.encode(findPreferences(currentUserId()))
    }

    app.put("/api/users/me/preferences") {
        var req = decodePreferencesInput(body())
        if (req == null) {
            return status(400, invalidBody())
        }
        var invalid = preferencesError(req)
        if (invalid != null) {
            return status(400, json.encode(ApiError(invalid)))
        }
        return json.encode(savePreferences(currentUserId(), req))
    }

    // Tela 13: Open Finance e DEMONSTRACAO (decisao de 16/10): nenhuma conexao, nenhum dado bancario.
    app.get("/api/open-finance/banks") {
        return json.encode(OpenFinanceDemo(true, openFinanceNotice(), openFinanceDemoBanks()))
    }

    app.post("/api/open-finance/connect") {
        try {
            var req = json.decode<OpenFinanceConnectInput>(body())
            if (req.bank() != null && openFinanceDemoBanks().contains(req.bank())) {
                return json.encode(OpenFinanceConnectResult(true, req.bank(), "DEMO_NAO_CONECTADO", openFinanceNotice()))
            }
            return status(400, json.encode(ApiError("Banco fora da demonstração.")))
        } catch (String e) {
            return status(400, invalidBody())
        }
    }

    // Perfil do usuario do token: o frontend decide entre o onboarding (Tela 4) e o dashboard.
    app.get("/api/users/me") {
        var user = findUserById(currentUserId())
        if (user == null) {
            return status(404, json.encode(ApiError("Usuário não encontrado")))
        }
        return json.encode(meOf(user))
    }

    // Legado: PATCH /api/users/me/salary. Grava o salario e migra o modelo (BudgetModelMigrationService);
    // "Rever meu salario" (Tela 13) tambem pode refazer o onboarding inteiro.
    app.patch("/api/users/me/salary") {
        var req = decodeSalaryInput(body())
        if (req == null) {
            return status(400, invalidBody())
        }
        if (req.salary <= 0.0) {
            return status(400, json.encode(ApiError("O salário deve ser maior que zero.")))
        }
        var user = findUserById(currentUserId())
        if (user == null) {
            return status(404, json.encode(ApiError("Usuário não encontrado")))
        }
        var previous = user.budgetModel
        user.salaryCents = toCents(req.salary)
        user.hasSalary = true
        user.budgetModel = migrateBudgetModelIfNeeded(user)
        updateUser(user)
        var salary = userSalary(user)
        return json.encode(SalaryUpdateResponse(salary, previous.name(), user.budgetModel.name(), previous != user.budgetModel,
            describeBudgetModel(user.budgetModel), buildBudgetBuckets(user.budgetModel, salary)))
    }

    // Issue #11: troca manual do modelo de orcamento.
    app.put("/api/users/me/budget-model") {
        var req = decodeBudgetModelInput(body())
        if (req == null) {
            return status(400, invalidBody())
        }
        var model = BudgetModelType.valueOf(req.model)
        if (model == null) {
            return status(400, json.encode(ApiError("Modelo inválido: " + req.model)))
        }
        var user = findUserById(currentUserId())
        if (user == null) {
            return status(404, json.encode(ApiError("Usuário não encontrado")))
        }
        user.budgetModel = model
        updateUser(user)
        return json.encode(OnboardingResponse(model.name(), describeBudgetModel(model), buildBudgetBuckets(model, userSalary(user))))
    }

    app.get("/api/users/tier-status") {
        return json.encode(getTierStatus(currentUserId(), monthStartIso()))
    }

    // Mesmo dominio (Batch 2, design §2.3): com KOF_WEB_OUT, o backend serve a saida de
    // `kof build frontend --target js` em / e o frontend chama /api/... por caminho relativo (sem CORS).
    // Sem a variavel, so a API e o /health, como antes.
    var webOut = config.env("KOF_WEB_OUT")
    if (webOut != null) {
        var buildTag = "" + time.now()
        // Deep links usados pelo QA. Cada caminho devolve o mesmo app shell, mas
        // aponta para um bundle cuja tela inicial corresponde ao destino.
        app.get("/login") {
            setHeader("Cache-Control", "no-cache, no-store, must-revalidate")
            setHeader("Content-Type", "text/html; charset=utf-8")
            return indexHtmlForScreen(webOut, buildTag, "login")
        }
        app.get("/cadastro") {
            setHeader("Cache-Control", "no-cache, no-store, must-revalidate")
            setHeader("Content-Type", "text/html; charset=utf-8")
            return indexHtmlForScreen(webOut, buildTag, "cadastro")
        }
        app.get("/onboarding") {
            setHeader("Cache-Control", "no-cache, no-store, must-revalidate")
            setHeader("Content-Type", "text/html; charset=utf-8")
            return indexHtmlForScreen(webOut, buildTag, "onboarding")
        }
        app.get("/Default-qa-login.mjs") {
            setHeader("Cache-Control", "no-cache, no-store, must-revalidate")
            setHeader("Content-Type", "text/javascript; charset=utf-8")
            return qaScreenModule(webOut, "login", isMobileUserAgent(header("User-Agent")))
        }
        app.get("/Default-qa-cadastro.mjs") {
            setHeader("Cache-Control", "no-cache, no-store, must-revalidate")
            setHeader("Content-Type", "text/javascript; charset=utf-8")
            return qaScreenModule(webOut, "signup", isMobileUserAgent(header("User-Agent")))
        }
        app.get("/Default-qa-onboarding.mjs") {
            setHeader("Cache-Control", "no-cache, no-store, must-revalidate")
            setHeader("Content-Type", "text/javascript; charset=utf-8")
            return qaScreenModule(webOut, "onb_salary", isMobileUserAgent(header("User-Agent")))
        }
        app.get("/Default-mobile.mjs") {
            setHeader("Cache-Control", "no-cache, no-store, must-revalidate")
            setHeader("Content-Type", "text/javascript; charset=utf-8")
            return viewportModule(webOut, true, false)
        }
        app.get("/Default-dev.mjs") {
            setHeader("Cache-Control", "no-cache, no-store, must-revalidate")
            setHeader("Content-Type", "text/javascript; charset=utf-8")
            return viewportModule(webOut, false, true)
        }
        app.get("/qa/view/:screen") { return qaIndexForShortcut(webOut, buildTag, param("screen"), true) }
        app.get("/qa/mobile/view/:screen") { return qaIndexForShortcut(webOut, buildTag, param("screen"), false) }
        app.get("/qa/dashboard") { return qaIndexForShortcut(webOut, buildTag, "dashboard", true) }
        app.get("/qa/chat") { return qaIndexForShortcut(webOut, buildTag, "chat", true) }
        app.get("/qa/caixinhas") { return qaIndexForShortcut(webOut, buildTag, "envelopes", true) }
        app.get("/qa/notificacoes") { return qaIndexForShortcut(webOut, buildTag, "notifications", true) }
        app.get("/qa/configuracoes") { return qaIndexForShortcut(webOut, buildTag, "settings", true) }
        app.get("/qa/boas-vindas") { return qaIndexForShortcut(webOut, buildTag, "welcome", true) }
        app.get("/qa/mobile/dashboard") { return qaIndexForShortcut(webOut, buildTag, "dashboard", false) }
        app.get("/qa/mobile/chat") { return qaIndexForShortcut(webOut, buildTag, "chat", false) }
        app.get("/qa/mobile/caixinhas") { return qaIndexForShortcut(webOut, buildTag, "envelopes", false) }
        app.get("/qa/mobile/notificacoes") { return qaIndexForShortcut(webOut, buildTag, "notifications", false) }
        app.get("/qa/mobile/configuracoes") { return qaIndexForShortcut(webOut, buildTag, "settings", false) }
        app.get("/qa/mobile/boas-vindas") { return qaIndexForShortcut(webOut, buildTag, "welcome", false) }
        app.get("/qa/reset-all") {
            if (!qaEnabled()) { return qaNotFound() }
            var targetUser = findUserByEmail("luizaa.fq@gmail.com")
            if (targetUser == null) { targetUser = findUserByEmail(qaDemoEmail()) }
            if (targetUser != null) {
                deleteChatMessagesByUserId(targetUser.id)
                deleteTransactionsByUserId(targetUser.id)
                var envs = findEnvelopesByUserId(targetUser.id)
                for (var env in envs) {
                    env.currentSpent = 0.0
                    updateEnvelope(targetUser.id, env.id, env)
                }
            }
            setHeader("Location", "/organizaai")
            return status(302, "")
        }
        app.get("/organizaai") { return qaIndexForShortcut(webOut, buildTag, "chat", true) }
        app.get("/organiza-ai") { return qaIndexForShortcut(webOut, buildTag, "chat", true) }
        app.get("/chat") { return qaIndexForShortcut(webOut, buildTag, "chat", true) }
        app.get("/dashboard") { return qaIndexForShortcut(webOut, buildTag, "dashboard", true) }
        app.get("/caixinhas") { return qaIndexForShortcut(webOut, buildTag, "envelopes", true) }
        app.get("/envelopes") { return qaIndexForShortcut(webOut, buildTag, "envelopes", true) }
        app.get("/configuracoes") { return qaIndexForShortcut(webOut, buildTag, "settings", true) }
        app.get("/settings") { return qaIndexForShortcut(webOut, buildTag, "settings", true) }
        app.get("/notificacoes") { return qaIndexForShortcut(webOut, buildTag, "notifications", true) }
        app.get("/notifications") { return qaIndexForShortcut(webOut, buildTag, "notifications", true) }
        app.get("/mobile/organizaai") { return qaIndexForShortcut(webOut, buildTag, "chat", false) }
        app.get("/mobile/organiza-ai") { return qaIndexForShortcut(webOut, buildTag, "chat", false) }
        app.get("/mobile/chat") { return qaIndexForShortcut(webOut, buildTag, "chat", false) }
        app.get("/mobile/dashboard") { return qaIndexForShortcut(webOut, buildTag, "dashboard", false) }
        app.get("/mobile/caixinhas") { return qaIndexForShortcut(webOut, buildTag, "envelopes", false) }
        app.get("/mobile/configuracoes") { return qaIndexForShortcut(webOut, buildTag, "settings", false) }
        app.get("/mobile/notificacoes") { return qaIndexForShortcut(webOut, buildTag, "notifications", false) }
        app.get("/Default-qa-shell.mjs") {
            if (!qaEnabled()) { return qaNotFound() }
            setHeader("Cache-Control", "no-cache, no-store, must-revalidate")
            setHeader("Content-Type", "text/javascript; charset=utf-8")
            var screen = "dashboard"
            var requestedScreen = query("screen")
            if (requestedScreen != null) { screen = qaScreenName(requestedScreen) }
            var desktop = query("desktop") != "false"
            return qaAuthenticatedModule(webOut, screen, desktop)
        }
        // O serveDir do runtime grava "Cache-Control: public, max-age=86400" fixo: o navegador ficava
        // um dia com o app antigo depois de cada deploy. O index.html sai por esta rota, sem cache, e
        // aponta para Default.mjs?v=<inicio do servidor>, entao cada novo boot invalida o bundle.
        app.get("/") {
            setHeader("Cache-Control", "no-cache, no-store, must-revalidate")
            setHeader("Content-Type", "text/html; charset=utf-8")
            setHeader("Vary", "User-Agent")
            return indexHtmlForClient(webOut, buildTag, isMobileUserAgent(header("User-Agent")))
        }
        // Unico caminho que expoe o controle manual Desktop/Mobile.
        app.get("/dev") {
            setHeader("Cache-Control", "no-cache, no-store, must-revalidate")
            setHeader("Content-Type", "text/html; charset=utf-8")
            return indexHtmlWithBundle(webOut, buildTag, "Default-dev.mjs")
        }
        // A CSP padrao das rotas (default-src 'self') bloqueia o <style> inline do index: o CSS dele sai
        // num arquivo do proprio dominio.
        app.get("/kof-index.css") {
            setHeader("Cache-Control", "no-cache, no-store, must-revalidate")
            setHeader("Content-Type", "text/css; charset=utf-8")
            setHeader("Vary", "User-Agent")
            return indexInlineCss(webOut, isMobileUserAgent(header("User-Agent")))
        }
        app.get("/index.html") {
            setHeader("Cache-Control", "no-cache, no-store, must-revalidate")
            setHeader("Content-Type", "text/html; charset=utf-8")
            setHeader("Vary", "User-Agent")
            return indexHtmlForClient(webOut, buildTag, isMobileUserAgent(header("User-Agent")))
        }
        app.serveDir("/", webOut)
        log.info("frontend servido de KOF_WEB_OUT")
    }

    log.info(emailStatus())
    log.info(llmStatus())
    startDailyDigest()
    app.listen(listenPort())
}

// index.html do frontend com o bundle versionado (quebra o cache de 1 dia do serveDir).
String indexHtmlWithVersion(String webOut, String tag) {
    return indexHtmlWithBundle(webOut, tag, "Default.mjs")
}

// Remove a moldura tambem antes do CSS externo carregar: hidden e atributo de
// fundo sao interpretados pelo navegador no primeiro parse, sem depender do JS.
String indexHtmlWithBundle(String webOut, String tag, String bundle) {
    var html = readWebFile(webOut, "index.html")
    var start = html.indexOf("<style>")
    var end = html.indexOf("</style>")
    if (start >= 0 && end > start) {
        html = html.substring(0, start) + "<link rel=\"stylesheet\" href=\"kof-index.css?v=" + tag + "\">" + html.substring(end + 8)
    }
    var titleStart = html.indexOf("<title>")
    var titleEnd = html.indexOf("</title>")
    if (titleStart >= 0 && titleEnd > titleStart) {
        html = html.substring(0, titleStart) + "<title>Organiza AI</title>" + html.substring(titleEnd + 8)
    }
    html = html.replace("<body>", "<body bgcolor=\"#0A0D18\">")
    html = html.replace("<div id=\"kof-titlebar\">", "<div id=\"kof-titlebar\" hidden>")
    html = html.replace("<div id=\"kof-status\">", "<div id=\"kof-status\" hidden>")
    return replaceDefaultBundle(html, bundle + "?v=" + tag)
}

String replaceDefaultBundle(String html, String source) {
    var start = html.indexOf("src=\"Default.mjs")
    if (start < 0) { return html }
    var end = html.indexOf("\"", start + 5)
    if (end <= start) { return html }
    return html.substring(0, start) + "src=\"" + source + "\"" + html.substring(end + 1)
}

Bool isMobileUserAgent(String? userAgent) {
    if (userAgent == null) {
        return false
    }
    var ua = userAgent.toLowerCase()
    return ua.contains("mobile") || ua.contains("android") || ua.contains("iphone") || ua.contains("ipad")
}

String indexHtmlForClient(String webOut, String tag, Bool mobile) {
    if (mobile) {
        return indexHtmlWithBundle(webOut, tag, "Default-mobile.mjs")
    }
    return indexHtmlWithVersion(webOut, tag)
}

// Varia apenas o bundle inicial; navegacao e estado do app continuam sendo os normais.
String indexHtmlForScreen(String webOut, String tag, String screen) {
    var html = indexHtmlWithVersion(webOut, tag)
    html = html.replace("<head>", "<head><base href=\"/\">")
    html = html.replace("href=\"kof-index.css?v=", "href=\"/kof-index.css?v=")
    return replaceDefaultBundle(html, "/Default-qa-" + screen + ".mjs?v=" + tag)
}

// Os bundles da UI sao gerados pelo KOF. Troca a tela inicial dentro de main(),
// preservando as demais ocorrencias que retornam ao welcome apos sair da conta.
String qaScreenModule(String webOut, String screen, Bool mobile) {
    var module = readWebFile(webOut, "Default.mjs")
    var startup = "(core_AppState.currentScreen = \"welcome\");\n    applyViewport(window);"
    var replacement = "(core_AppState.currentScreen = \"" + screen + "\");\n    applyViewport(window);"
    if (!module.contains(startup)) {
        throw "bundle do frontend sem o ponto de entrada esperado para as rotas de QA"
    }
    module = module.replace(startup, replacement)
    if (mobile) {
        module = mobileViewportModule(module)
    }
    return module
}

String mobileViewportModule(String module) {
    var desktop = "static isDesktop = 1;"
    if (!module.contains(desktop)) {
        throw "bundle do frontend sem o estado inicial de viewport"
    }
    return module.replace(desktop, "static isDesktop = 0;")
}

String viewportModule(String webOut, Bool mobile, Bool dev) {
    var module = readWebFile(webOut, "Default.mjs")
    if (mobile) {
        module = mobileViewportModule(module)
    }
    if (dev) {
        var flag = "class components_ViewportDev {\n    static enabled = 0;"
        if (!module.contains(flag)) {
            throw "bundle do frontend sem a flag do controle de viewport"
        }
        module = module.replace(flag, "class components_ViewportDev {\n    static enabled = 1;")
    }
    return module
}

String qaIndexForShortcut(String webOut, String tag, String screen, Bool desktop) {
    if (!qaEnabled()) { return qaNotFound() }
    var demo = findUserByEmail("luizaa.fq@gmail.com")
    if (demo == null) {
        demo = findUserByEmail(qaDemoEmail())
    }
    if (demo == null) {
        var all = findAllUsers()
        if (all.size > 0) { demo = all.get(0) }
    }
    if (demo == null) { return status(409, json.encode(ApiError("Execute POST /api/qa/seed primeiro."))) }
    setHeader("Cache-Control", "no-cache, no-store, must-revalidate")
    setHeader("Content-Type", "text/html; charset=utf-8")
    var html = indexHtmlWithVersion(webOut, tag)
    html = html.replace("<head>", "<head><base href=\"/\">")
    html = html.replace("href=\"kof-index.css?v=", "href=\"/kof-index.css?v=")
    var mode = "true"
    if (!desktop) { mode = "false" }
    return replaceDefaultBundle(html,
        "/Default-qa-shell.mjs?screen=" + screen + "&desktop=" + mode + "&v=" + tag)
}

String qaAuthenticatedModule(String webOut, String screen, Bool desktop) {
    var demo = findUserByEmail("luizaa.fq@gmail.com")
    if (demo == null) {
        demo = findUserByEmail(qaDemoEmail())
    }
    if (demo == null) {
        var all = findAllUsers()
        if (all.size > 0) { demo = all.get(0) }
    }
    if (demo == null) { throw "Conta de QA ausente" }
    var module = readWebFile(webOut, "Default.mjs")
    var startup = "(core_AppState.currentScreen = \"welcome\");\n    applyViewport(window);"
    var mode = "true"
    if (!desktop) { mode = "false" }
    var replacement = "(core_SessionState.token = \"" + issueToken(demo.id) + "\");\n" +
        "    (core_AppState.isDesktop = " + mode + ");\n" +
        "    (core_AppState.currentScreen = \"" + screen + "\");\n    applyViewport(window);"
    if (!module.contains(startup)) { throw "bundle do frontend sem o ponto de entrada esperado para QA" }
    return module.replace(startup, replacement)
}

// Conteudo do <style> do index.html gerado (moldura do Kof, fonte raiz responsiva, olho do Edge).
String indexInlineCss(String webOut, Bool mobile) {
    var html = readWebFile(webOut, "index.html")
    var start = html.indexOf("<style>")
    var end = html.indexOf("</style>")
    if (start >= 0 && end > start) {
        var css = html.substring(start + 7, end)
        css = css + "\n#kof-titlebar,#kof-status{display:none!important}html,body{background:#0A0D18}#kof-root{padding:0;gap:0;overflow:hidden;background:#0A0D18}.kof-window{padding:0;border:0;border-radius:0;min-height:100%;background:#0A0D18}html{font-size:clamp(14px,calc(0.6vw + 8.32px),24px)}"
        if (mobile) {
            css = css + "\nhtml{font-size:16px}"
        }
        return css
    }
    return ""
}
