// backend/auth.kf
// Autenticação e Autorização JWT unificada do Monólito KofLith
// Filosofia KOF: "Menos segregação, mais intenção" -- sem isolamento artificial de pacotes.

record AuthClaims(String sub, String iss, String aud)

// Configuracao do JWT (kof.config: a chave "jwt.secret" le a variavel KOF_JWT_SECRET,
// a mesma que o runtime usa no pipeline auth.* do kof.web — uma unica fonte de verdade).
// Ausente ou curta = falha no boot; a mensagem cita a variavel, nunca o valor.
String jwtSecret() {
    var secret = config.required("jwt.secret")
    if (secret.length() < 32) {
        throw "KOF_JWT_SECRET precisa ter pelo menos 32 caracteres"
    }
    return secret
}

// KOF_JWT_ISSUER / KOF_JWT_AUDIENCE (padroes documentados em .env.example e docs/DEPLOY.md)
String jwtIssuer() {
    return config.str("jwt.issuer", "organiza-ai")
}

String jwtAudience() {
    return config.str("jwt.audience", "organiza-ai-api")
}

// Emite o token do usuario: sub + iss + aud (iat/exp sao adicionados pelo jwt.create; TTL 2 h)
String issueToken(String userId) {
    return jwt.create(json.encode(AuthClaims(userId, jwtIssuer(), jwtAudience())), jwtSecret(), 7200)
}

List<String> publicPaths() {
    return listOf("/health", "/api/auth/login", "/api/auth/register")
}

Bool isPublicPath(String path) {
    return publicPaths().contains(path)
}

// Hash PBKDF2 de uma senha aleatoria descartada (nao e segredo): o login roda o
// verify contra ele quando o e-mail nao existe, para que "e-mail inexistente" e
// "senha errada" custem o mesmo tempo (~200 ms) e nao revelem quem tem conta.
String unknownUserHash() {
    return "pbkdf2$sha256$600000$yuJ5I43zf8jqHSJcH03DKg==$Imcjjj+zeYwtjFV9LS03HQf0nOZ73XUJsxCwMawh9zo="
}

// Devolve o usuario somente se a senha confere; sempre executa um passwords.verify.
UserEntity? authenticateUser(String email, String password) {
    var user = findUserByEmail(email)
    if (user == null) {
        passwords.verify(password, unknownUserHash())
        return null
    }
    if (passwords.verify(password, user.passwordHash)) {
        return user
    }
    return null
}

String? extractBearerToken(String? authHeader) {
    if (authHeader != null) {
        if (authHeader.startsWith("Bearer ")) {
            var token = authHeader.substring(7).trim()
            if (token != "") {
                return token
            }
        }
    }
    return null
}

Bool hasBearerToken() {
    return extractBearerToken(header("Authorization")) != null
}

AuthClaims requireAuth() {
    var token = extractBearerToken(header("Authorization"))
    if (token == null) {
        throw "Token não informado"
    }
    try {
        // assinatura + exp + iss + aud validados pela plataforma (jwt.verify de 4 argumentos)
        var claimsJson = jwt.verify(token, jwtSecret(), jwtIssuer(), jwtAudience())
        return json.decode<AuthClaims>(claimsJson)
    } catch (String e) {
        throw "Token inválido ou expirado"
    }
}

