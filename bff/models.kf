record User(String id, String name, Float monthlySalary)

record Envelope(String id, String userId, String categoryName, Float limitAmount, Float currentSpent)

record Transaction(String id, String envelopeId, String userId, Float amount, String description, String date)

record LoginRequest(String email, String password)

record LoginResponse(String token)

record ChatMessageRequest(String message)

record ChatMessageResponse(String reply, Float dailyPulse)

record VariableIncome(String id, String userId, Float amount, String source, String destination, String date)

record OnboardingRequest(Float salary, String incomeType, Boolean hasDebt)

record OnboardingResponse(String suggestedModel, String modelDescription)

record BucketSummary(String name, Int percentage, Float amount)

record TierStatus(String tier, Int messagesUsed, Boolean voiceEnabled, Boolean canSendMessage)

record TransactionResponse(String id, String category, String description, Float amount, String currency)
record DashboardSummaryResponse(List<BucketSummary> categories, Float totalSpent, String currency)
record CategorySummary(String category, Float total, String currency, Int count, Float percentage)
record TransactionOutput(String id, String description, String category, Float value, String currency)
record DashboardSummaryResponse(Float totalSpent, String currency, List<CategorySummary> categories, List<TransactionOutput> transactions)
