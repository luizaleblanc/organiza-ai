// Sintaxe validada contra training/ do Kof4j e o codigo-fonte do compilador
// (KofWeb.java, KofHttp.java, KofSecurity.java). Ver KOF_WEB_REFERENCE.md e
// docs/kof4j/ na raiz do projeto.
//
// http.get/post/put/delete/patch/options retornam String pura (o corpo da
// resposta) -- nao existe objeto de resposta com .body. Headers sao uma
// String "Nome: valor" passada como ultimo argumento de http.*, o que
// permite repassar o Authorization recebido para o backend Spring Boot.

import middleware.auth

String authHeader(String token) = "Authorization: " + token

main() {
    var app = web.app()

    // app.use roda ANTES do roteamento, para TODAS as rotas -- nao tem
    // escopo por path (docs/kof4j/web.md). Por isso o bypass de rotas
    // publicas e feito aqui dentro, checando path(). So rejeita cedo
    // requisicao SEM Authorization; a validacao completa (assinatura,
    // expiracao, issuer) roda por rota via requireAuth(), antes de
    // qualquer chamada ao backend -- ver bff/middleware/auth.kf.
    app.use {
        if (isPublicPath(path())) {
            return null
        }
        if (!hasBearerToken()) {
            return status(401, "{\"error\":\"Token não informado\"}")
        }
        return null
    }

    app.get("/health") {
        return "OK"
    }

    // Rotas publicas -- sem autenticacao
    app.post("/api/auth/login") {
        var rawJson = http.post("http://localhost:8080/auth/login", body())
        var resp = json.decode<LoginResponse>(rawJson)
        return resp.token
    }

    app.post("/api/auth/register") {
        return http.post("http://localhost:8080/auth/register", body())
    }

    // Rotas protegidas -- requireAuth() valida assinatura/expiracao/issuer
    // e lanca (throw String) em token invalido; capturado abaixo antes de
    // qualquer chamada ao backend.

    app.post("/api/variable-income") {
        var token = header("Authorization")
        try {
            requireAuth()
        } catch (String e) {
            return status(401, "{\"error\":\"" + e + "\"}")
        }
        return http.post("http://localhost:8080/api/variable-income", body(), authHeader(token))
    }

    app.get("/api/variable-income") {
        var token = header("Authorization")
        try {
            requireAuth()
        } catch (String e) {
            return status(401, "{\"error\":\"" + e + "\"}")
        }
        var userId = query("userId")
        return http.get("http://localhost:8080/api/variable-income?userId=" + userId, authHeader(token))
    }

    app.post("/api/users/onboarding") {
        var token = header("Authorization")
        try {
            requireAuth()
        } catch (String e) {
            return status(401, "{\"error\":\"" + e + "\"}")
        }
        var rawJson = http.post("http://localhost:8080/api/users/me/onboarding", body(), authHeader(token))
        try {
            var resp = json.decode<OnboardingResponse>(rawJson)
            var bStr = ""
            for (var i = 0; i < resp.buckets.size(); i = i + 1) {
                var b = resp.buckets.get(i)
                bStr = bStr + b.name + ":" + b.percentage + ":" + b.formattedValue + ","
            }
            return resp.suggestedModel + "|" + resp.modelDescription + "|" + bStr
        } catch (String err) {
            return status(500, "{\"error\":\"Erro ao decodificar JSON do backend: " + err + "\"}")
        }
    }

    // Repassa para o mesmo endpoint de registro de renda do backend (/api/variable-income)
    app.post("/api/income") {
        var token = header("Authorization")
        try {
            requireAuth()
        } catch (String e) {
            return status(401, "{\"error\":\"" + e + "\"}")
        }
        return http.post("http://localhost:8080/api/variable-income", body(), authHeader(token))
    }

    app.post("/api/chat/message") {
        var token = header("Authorization")
        try {
            requireAuth()
        } catch (String e) {
            return status(401, "{\"error\":\"" + e + "\"}")
        }
        var rawJson = http.post("http://localhost:8080/api/coach/chat", body(), authHeader(token))
        try {
            var resp = json.decode<ChatMessageResponse>(rawJson)
            return resp.reply
        } catch (String err) {
            return status(500, "{\"error\":\"Erro ao decodificar JSON do backend: " + err + "\"}")
        }
    }

    app.get("/api/transactions") {
        var token = header("Authorization")
        try {
            requireAuth()
        } catch (String e) {
            return status(401, "{\"error\":\"" + e + "\"}")
        }
        var month = query("month")
        return http.get("http://localhost:8080/transactions?month=" + month, authHeader(token))
    }

    app.post("/api/transactions") {
        var token = header("Authorization")
        try {
            requireAuth()
        } catch (String e) {
            return status(401, "{\"error\":\"" + e + "\"}")
        }
        return http.post("http://localhost:8080/transactions", body(), authHeader(token))
    }

    app.get("/api/budgets/daily-pulse") {
        var token = header("Authorization")
        try {
            requireAuth()
        } catch (String e) {
            return status(401, "{\"error\":\"" + e + "\"}")
        }
        return http.get("http://localhost:8080/budgets/daily-pulse", authHeader(token))
    }

    app.get("/api/envelopes") {
        var token = header("Authorization")
        try {
            requireAuth()
        } catch (String e) {
            return status(401, "{\"error\":\"" + e + "\"}")
        }
        var userId = query("userId")
        return http.get("http://localhost:8080/api/envelopes?userId=" + userId, authHeader(token))
    }

    app.post("/api/envelopes") {
        var token = header("Authorization")
        try {
            requireAuth()
        } catch (String e) {
            return status(401, "{\"error\":\"" + e + "\"}")
        }
        return http.post("http://localhost:8080/api/envelopes", body(), authHeader(token))
    }

    app.put("/api/envelopes/:id") {
        var token = header("Authorization")
        try {
            requireAuth()
        } catch (String e) {
            return status(401, "{\"error\":\"" + e + "\"}")
        }
        return http.put("http://localhost:8080/api/envelopes/" + param("id"), body(), authHeader(token))
    }

    app.delete("/api/envelopes/:id") {
        var token = header("Authorization")
        try {
            requireAuth()
        } catch (String e) {
            return status(401, "{\"error\":\"" + e + "\"}")
        }
        return http.delete("http://localhost:8080/api/envelopes/" + param("id"), authHeader(token))
    }

    app.get("/api/dashboard") {
        var token = header("Authorization")
        try {
            requireAuth()
        } catch (String e) {
            return status(401, "{\"error\":\"" + e + "\"}")
        }
        var rawJson = http.get("http://localhost:8080/transactions/dashboard", authHeader(token))
        
        try {
            var dash = json.decode<DashboardSummaryResponse>(rawJson)
            
            // Montar string customizada para contornar limitacao de parser no kof.ui
            // Formato: totalSpent|currency|Cat1:pct,Cat2:pct...|Tx1:cat:val,Tx2:cat:val...
            var cats = ""
            for (var i = 0; i < dash.categories.size(); i = i + 1) {
                var c = dash.categories.get(i)
                cats = cats + c.category + ":" + c.percentage + ","
            }
            
            var txs = ""
            for (var j = 0; j < dash.transactions.size(); j = j + 1) {
                var t = dash.transactions.get(j)
                txs = txs + t.description + ":" + t.category + ":" + t.value + ","
            }
            
            return dash.totalSpent + "|" + dash.currency + "|" + cats + "|" + txs
        } catch (String err) {
            return status(500, "{\"error\":\"Erro ao decodificar JSON do backend: " + err + "\"}")
        }
    }

    app.get("/api/users/tier-status") {
        var token = header("Authorization")
        try {
            requireAuth()
        } catch (String e) {
            return status(401, "{\"error\":\"" + e + "\"}")
        }
        return http.get("http://localhost:8080/api/users/tier-status", authHeader(token))
    }

    app.listen(3000)
}

