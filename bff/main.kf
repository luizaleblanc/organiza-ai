// KOF_REFERENCE.md nao documenta uma forma de definir o status HTTP da resposta
// a partir de uma rota (nao ha response.status() ou equivalente na referencia).
// Por isso, quando o token esta ausente, a rota protegida retorna a mensagem de
// erro "Token nao informado" como corpo da resposta, em vez de um status 401 literal.
requireAuth() -> String {
    var token = header("Authorization")
    if (token == null || token == "") {
        return ""
    }
    return token
}

main() {
    var app = web.app()

    app.get("/health") {
        return "OK"
    }

    // Rotas publicas -- sem autenticacao
    app.post("/api/auth/login") {
        var response = http.post("http://localhost:8080/auth/login", body())
        return response.body
    }

    app.post("/api/auth/register") {
        var response = http.post("http://localhost:8080/auth/register", body())
        return response.body
    }

    // Rotas protegidas -- exigem Authorization e repassam o header para o backend validar o JWT

    app.post("/api/variable-income") {
        var token = requireAuth()
        if (token == "") {
            return "Token não informado"
        }
        var response = http.post("http://localhost:8080/api/variable-income", body(),
            headers: {"Authorization": token})
        return response.body
    }

    app.get("/api/variable-income") {
        var token = requireAuth()
        if (token == "") {
            return "Token não informado"
        }
        var userId = query("userId")
        var response = http.get("http://localhost:8080/api/variable-income?userId=" + userId,
            headers: {"Authorization": token})
        return response.body
    }

    app.post("/api/users/onboarding") {
        var token = requireAuth()
        if (token == "") {
            return "Token não informado"
        }
        var response = http.post("http://localhost:8080/api/users/onboarding", body(),
            headers: {"Authorization": token})
        return response.body
    }

    // Repassa para o mesmo endpoint de registro de renda do backend (/api/variable-income)
    app.post("/api/income") {
        var token = requireAuth()
        if (token == "") {
            return "Token não informado"
        }
        var response = http.post("http://localhost:8080/api/variable-income", body(),
            headers: {"Authorization": token})
        return response.body
    }

    app.post("/api/chat/message") {
        var token = requireAuth()
        if (token == "") {
            return "Token não informado"
        }
        var response = http.post("http://localhost:8080/chat/message", body(),
            headers: {"Authorization": token})
        return response.body
    }

    app.get("/api/transactions") {
        var token = requireAuth()
        if (token == "") {
            return "Token não informado"
        }
        var month = query("month")
        var response = http.get("http://localhost:8080/transactions?month=" + month,
            headers: {"Authorization": token})
        return response.body
    }

    app.post("/api/transactions") {
        var token = requireAuth()
        if (token == "") {
            return "Token não informado"
        }
        var response = http.post("http://localhost:8080/transactions", body(),
            headers: {"Authorization": token})
        return response.body
    }

    app.get("/api/budgets/daily-pulse") {
        var token = requireAuth()
        if (token == "") {
            return "Token não informado"
        }
        var response = http.get("http://localhost:8080/budgets/daily-pulse",
            headers: {"Authorization": token})
        return response.body
    }

    app.get("/api/envelopes") {
        var token = requireAuth()
        if (token == "") {
            return "Token não informado"
        }
        var userId = query("userId")
        var response = http.get("http://localhost:8080/api/envelopes?userId=" + userId,
            headers: {"Authorization": token})
        return response.body
    }

    app.post("/api/envelopes") {
        var token = requireAuth()
        if (token == "") {
            return "Token não informado"
        }
        var response = http.post("http://localhost:8080/api/envelopes", body(),
            headers: {"Authorization": token})
        return response.body
    }

    app.put("/api/envelopes/:id") {
        var token = requireAuth()
        if (token == "") {
            return "Token não informado"
        }
        var response = http.put("http://localhost:8080/api/envelopes/" + param("id"), body(),
            headers: {"Authorization": token})
        return response.body
    }

    app.delete("/api/envelopes/:id") {
        var token = requireAuth()
        if (token == "") {
            return "Token não informado"
        }
        var response = http.delete("http://localhost:8080/api/envelopes/" + param("id"),
            headers: {"Authorization": token})
        return response.body
    }

    app.listen(3000)
}
