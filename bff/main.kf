main() {
    var app = web.app()

    app.get("/health") {
        return "OK"
    }

    // Rotas publicas -- sem autenticacao
    app.post("/api/auth/login") {
        var response = http.post("http://localhost:8080/auth/login", body())
        return response.body
    }

    app.post("/api/auth/register") {
        var response = http.post("http://localhost:8080/auth/register", body())
        return response.body
    }

    // Rotas protegidas -- repassam o header Authorization para o backend validar o JWT
    app.post("/api/variable-income") {
        var response = http.post("http://localhost:8080/api/variable-income", body(),
            headers: {"Authorization": header("Authorization")})
        return response.body
    }

    app.get("/api/variable-income") {
        var userId = query("userId")
        var response = http.get("http://localhost:8080/api/variable-income?userId=" + userId,
            headers: {"Authorization": header("Authorization")})
        return response.body
    }

    app.post("/api/users/onboarding") {
        var response = http.post("http://localhost:8080/api/users/onboarding", body(),
            headers: {"Authorization": header("Authorization")})
        return response.body
    }

    // Repassa para o mesmo endpoint de registro de renda do backend (/api/variable-income)
    app.post("/api/income") {
        var response = http.post("http://localhost:8080/api/variable-income", body(),
            headers: {"Authorization": header("Authorization")})
        return response.body
    }

    app.listen(3000)
}
