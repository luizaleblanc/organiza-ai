import kof.ui
import core.theme
import core.app_state
import core.navigation

// =============================================================================
// T5 — Entrypoint Organiza AI
// =============================================================================
// O dispatcher `buildActiveScreen(Window w)` e a navegação vivem em
// core/navigation.kf (main.kf não é importável). Re-renderização:
// AppState.currentScreen = "..." + mountScreen(window).
// Nunca chamar window.bind direto aqui: um root montado fora de
// NavState.mounted não é removido pelo próximo mountScreen, e duas telas
// passam a conviver no DOM.
// =============================================================================

main() {
    var window = Window("Organiza AI")
    window.theme = Theme.dark()
    AppState.currentScreen = "welcome"
    applyViewport(window)
    mountScreen(window)
    window.show()
}
