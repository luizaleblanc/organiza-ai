import kof.ui
import core.theme
import core.constants
import core.router_config
import core.service_locator

import screens.welcome.screen
import screens.auth.login_screen
import screens.auth.register_screen
import screens.onboarding.salary_screen
import screens.onboarding.income_type_screen
import screens.onboarding.debt_screen
import screens.onboarding.debt_amount_screen
import screens.onboarding.result_screen
import screens.dashboard.screen
import screens.chat.screen
import screens.envelopes.screen

// =============================================================================
// Organiza IA — Frontend KOF (Monolito Modular)
// =============================================================================
// Entrypoint da aplicação. Responsabilidades:
// 1. Inicializar o ServiceLocator (BFF URL)
// 2. Configurar o tema dark
// 3. Registrar todas as rotas no Router
// 4. Exibir a tela inicial (welcome)
// =============================================================================

main() {
    // 1. Inicializar serviços
    ServiceLocator.init("http://localhost:3000")

    // 2. Criar janela com tema dark
    var window = Window("Organiza IA")
    window.size(Layout.screenWidth, Layout.screenHeight)
    window.theme = Theme.dark()

    // 3. Registrar rotas (cada screen é um Component)
    Router.route(Routes.welcome,     buildWelcomeScreen())
    Router.route(Routes.login,       buildLoginScreen())
    Router.route(Routes.register,    buildRegisterScreen())
    Router.route(Routes.onboarding,  buildSalaryScreen())
    Router.route(Routes.incomeType,  buildIncomeTypeScreen())
    Router.route(Routes.debt,        buildDebtScreen())
    Router.route(Routes.debtAmount,  buildDebtAmountScreen())
    Router.route(Routes.result,      buildResultScreen())
    Router.route(Routes.dashboard,   buildDashboardScreen())
    Router.route(Routes.chat,        buildChatScreen())
    Router.route(Routes.envelopes,   buildEnvelopesScreen())

    // 4. Navegar para a tela inicial
    Router.go(Routes.welcome)

    // 5. Exibir
    window.show()
}

