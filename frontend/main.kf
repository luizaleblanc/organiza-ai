import kof.ui
import core.theme
import core.app_state
import screens.welcome_screen
import screens.onboarding_screen

// =============================================================================
// Organiza IA — shell estável do frontend
// =============================================================================
// Este padrão usa o runtime KOF compatível do projeto e evita as APIs mais
// recentes que não existem no compilador atual.
// =============================================================================

main() {
    var window = Window("Organiza IA")
    window.theme = Theme.dark()
    window.size(360, 640)

    AppState.currentScreen = "welcome"
    var screen = welcomeScreen(window)
    window.bind(screen)
    window.show()
}
