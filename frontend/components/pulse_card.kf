package components

import kof.ui
import core.theme

// =============================================================================
// Pulse Card - card de pulso diario do dashboard
// DESIGN_SYSTEM.md secao 3.3 (Card de pulso diario)
// =============================================================================

Column buildPulseCard(String availableToday, String daysRemaining, String tip) {
    var eyebrow = Label("VOCE PODE GASTAR HOJE")
    eyebrow.fontSize = 14
    eyebrow.color = AppTheme.textSecondary
    eyebrow.bold = false

    var value = Label(availableToday)
    value.fontSize = 24
    value.color = AppTheme.accent
    value.bold = true

    var footer = Label(daysRemaining)
    footer.fontSize = 14
    footer.color = AppTheme.textMuted
    footer.bold = false

    var items = listOf(eyebrow, value, footer)

    if (tip != "") {
        var tipLabel = Label(tip)
        tipLabel.fontSize = 13
        tipLabel.color = AppTheme.accent
        tipLabel.bold = true
        items = listOf(eyebrow, value, footer, tipLabel)
    }

    return Column(items)
}
