package components

import kof.ui
import core.theme
import core.app_state
import core.navigation
import components.brand_mark
import components.icons

// =============================================================================
// Navegação do shell autenticado (Batch 3, T0)
// =============================================================================
// Desktop: sidebar de 190 px (artefato Desktop 64FYjX5UiveVxTtRGYurQP,
// Sidebar): logo Canvas 90, Dashboard / Organiza AI / Caixinhas /
// Notificações, rodapé com Configurações e o bloco do usuário.
// Mobile: barra inferior de 5 abas (artefato Mobile 8b3jFV4BrGj4YkDQAwDvDF,
// BottomTab): Dashboard / Organiza AI / Caixinhas / Alertas / Config.
// Não existe BottomNavigationBar nem onClick em View no kof.ui: cada item é um
// View/Column com o ícone Canvas + um Button transparente. O Button do item
// tem id "nav-<rota>" (Desktop e Mobile).
// =============================================================================

// ---- Ícones (grade 24x24 do artefato, escalada para `s` px) ----------------

Int sc(Int v, Int s) = v * s / 24

strokeRect(Canvas c, Int x, Int y, Int w, Int h, Int s) {
    c.beginPath()
    c.moveTo(sc(x, s), sc(y, s))
    c.lineTo(sc(x + w, s), sc(y, s))
    c.lineTo(sc(x + w, s), sc(y + h, s))
    c.lineTo(sc(x, s), sc(y + h, s))
    c.closePath()
    c.stroke()
}

Canvas navIcon(String route, Int s, Color color) {
    var c = Canvas(s, s)
    c.setStroke(color)
    c.setLineWidth(2)
    if (route == "dashboard") {
        strokeRect(c, 3, 3, 8, 8, s)
        strokeRect(c, 13, 3, 8, 5, s)
        strokeRect(c, 13, 11, 8, 10, s)
        strokeRect(c, 3, 14, 8, 7, s)
    } else if (route == "chat") {
        c.beginPath()
        c.moveTo(sc(4, s), sc(5, s))
        c.lineTo(sc(20, s), sc(5, s))
        c.lineTo(sc(20, s), sc(16, s))
        c.lineTo(sc(9, s), sc(16, s))
        c.lineTo(sc(4, s), sc(20, s))
        c.closePath()
        c.stroke()
    } else if (route == "envelopes") {
        c.beginPath()
        c.moveTo(sc(3, s), sc(8, s))
        c.lineTo(sc(12, s), sc(3, s))
        c.lineTo(sc(21, s), sc(8, s))
        c.lineTo(sc(12, s), sc(13, s))
        c.closePath()
        c.stroke()
        c.beginPath()
        c.moveTo(sc(3, s), sc(8, s))
        c.lineTo(sc(3, s), sc(16, s))
        c.lineTo(sc(12, s), sc(21, s))
        c.lineTo(sc(21, s), sc(16, s))
        c.lineTo(sc(21, s), sc(8, s))
        c.stroke()
    } else if (route == "notifications") {
        c.beginPath()
        c.arc(sc(12, s), sc(9, s), sc(6, s), 3.14159, 6.28318)
        c.lineTo(sc(18, s), sc(15, s))
        c.lineTo(sc(21, s), sc(17, s))
        c.lineTo(sc(3, s), sc(17, s))
        c.lineTo(sc(6, s), sc(15, s))
        c.lineTo(sc(6, s), sc(9, s))
        c.stroke()
        c.beginPath()
        c.moveTo(sc(10, s), sc(20, s))
        c.lineTo(sc(14, s), sc(20, s))
        c.stroke()
    } else {
        // settings: engrenagem simplificada (eixo + aro + 4 dentes).
        c.beginPath()
        c.arc(sc(12, s), sc(12, s), sc(3, s), 0.0, 6.28318)
        c.stroke()
        c.beginPath()
        c.arc(sc(12, s), sc(12, s), sc(7, s), 0.0, 6.28318)
        c.stroke()
        c.beginPath()
        c.moveTo(sc(12, s), sc(2, s))
        c.lineTo(sc(12, s), sc(5, s))
        c.stroke()
        c.beginPath()
        c.moveTo(sc(12, s), sc(19, s))
        c.lineTo(sc(12, s), sc(22, s))
        c.stroke()
        c.beginPath()
        c.moveTo(sc(2, s), sc(12, s))
        c.lineTo(sc(5, s), sc(12, s))
        c.stroke()
        c.beginPath()
        c.moveTo(sc(19, s), sc(12, s))
        c.lineTo(sc(22, s), sc(12, s))
        c.stroke()
    }
    return c
}

// Nome do ícone do design system (components/icons.kf) para cada rota.
String routeIcon(String route) {
    if (route == "dashboard") { return "dash" }
    if (route == "chat") { return "chat" }
    if (route == "envelopes") { return "box" }
    if (route == "notifications") { return "bell" }
    return "gear"
}

View iconHolder(Canvas icon) {
    var holder = View(screenStyle())
    holder.setStyle(navIconCss())
    holder.bind(icon)
    return holder
}

Bool isActiveRoute(String route) = AppState.currentScreen == route

// ---- Desktop ---------------------------------------------------------------

// Ícone e rótulo começam sempre na mesma coluna, inclusive no item ativo.
Style navItemRowCss() = Style("display: flex; flex-direction: row; flex-wrap: nowrap; justify-content: flex-start; align-items: center; gap: 14; width: 100%; padding: 0; background: transparent")

View sidebarItem(Window w, String route, String text) {
    var active = isActiveRoute(route)
    var tone = "secondary"
    if (active) {
        tone = "accent"
    }
    var label = Button(text, () -> navigateTo(w, route))
    label.setId("nav-" + route)
    if (active) {
        label.setStyle(navLabelActiveCss())
    } else {
        label.setStyle(navLabelCss())
    }
    var item = View(screenStyle())
    item.setId("nav-item-" + route)
    if (active) {
        item.setStyle(sidebarItemActiveCss())
    } else {
        item.setStyle(sidebarItemCss())
    }
    // nowrap: com a fonte responsiva maior, o .kof-row (flex-wrap: wrap) jogava o rótulo para baixo do ícone.
    var itemRow = Row(listOf(iconView(routeIcon(route), 20, tone, "nav-icon-" + route), label))
    itemRow.setStyle(navItemRowCss())
    item.bind(itemRow)
    return item
}

String userInitial() {
    var name = SessionState.userName.trim()
    if (name == "") {
        return "?"
    }
    return name.substring(0, 1).toUpperCase()
}

View userBlock() {
    var avatar = Label(userInitial())
    avatar.setId("user-initial")
    avatar.setStyle(avatarCss())
    var name = Label(SessionState.userName)
    name.setId("user-name")
    name.setStyle(userNameCss())
    var email = Label(SessionState.userEmail)
    email.setId("user-email")
    email.setStyle(userEmailCss())
    var text = Column(listOf(name, email))
    text.setStyle(userTextCss())
    var col = Column(listOf(avatar, text))
    col.setStyle(userBlockCss())
    return col
}

// Sidebar vertical (Desktop). A rota interna de notificações não entra na
// navegação: ela sustenta disparos automáticos quando o app acompanha as
// finanças, sem expor uma aba dedicada ao usuário.
// Sidebar presa à altura do shell: só a lista do meio rola; o rodapé
// (Configurações, avatar e nome) fica sempre visível.
Style sidebarFixedCss()       = Style("display: flex; flex-direction: column; align-items: center; flex-wrap: nowrap; align-self: stretch; width: 224; flex-shrink: 0; min-height: 0; gap: 8; padding: 28px 16px; box-sizing: border-box; overflow: hidden; background: #0A0D18; border-right: 1px solid rgba(255,255,255,.1)")
Style sidebarNavScrollCss()   = Style("display: flex; flex-direction: column; align-items: center; gap: 6; flex: 1 1 0; min-height: 0; width: 100%; overflow-y: auto; overflow-x: hidden")
Style sidebarFooterFixedCss() = Style("display: flex; flex-direction: column; align-items: center; gap: 14; width: 100%; flex-shrink: 0; margin-top: auto; padding-top: 16; border-top: 1px solid rgba(255,255,255,.1)")
Style bottomTabFixedCss()     = Style("display: flex; flex-direction: row; flex-wrap: nowrap; justify-content: space-around; align-items: flex-start; width: 100%; height: 74; flex-shrink: 0; padding-top: 10; box-sizing: border-box; background: #12162A; border-top: 1px solid rgba(255,255,255,.1)")

View buildSidebar(Window w) {
    var logo = brandMark(120, "sidebar-logo")
    logo.setStyle(sidebarLogoCss())
    var nav = Column(listOf(
        sidebarItem(w, "dashboard", "Dashboard"),
        sidebarItem(w, "chat", "Organiza AI"),
        sidebarItem(w, "envelopes", "Caixinhas")))
    nav.setStyle(sidebarNavScrollCss())
    var footer = Column(listOf(sidebarItem(w, "settings", "Configurações"), userBlock()))
    footer.setStyle(sidebarFooterFixedCss())
    var col = Column(listOf(logo, nav, footer))
    col.setId("sidebar")
    col.setStyle(sidebarFixedCss())
    return col
}

// ---- Mobile ----------------------------------------------------------------

View bottomTabItem(Window w, String route, String text) {
    var active = isActiveRoute(route)
    var tone = "muted"
    if (active) {
        tone = "primary"
    }
    var label = Button(text, () -> navigateTo(w, route))
    label.setId("nav-" + route)
    if (active) {
        label.setStyle(bottomTabLabelActiveCss())
    } else {
        label.setStyle(bottomTabLabelCss())
    }
    var col = Column(listOf(iconView(routeIcon(route), 20, tone, "nav-icon-" + route), label))
    col.setStyle(bottomTabItemCss())
    return col
}

// Barra inferior Mobile; notificações continuam como rota interna de disparo.
View buildNavBar(Window w) {
    var row = Row(listOf(
        bottomTabItem(w, "dashboard", "Dashboard"),
        bottomTabItem(w, "chat", "Organiza AI"),
        bottomTabItem(w, "envelopes", "Caixinhas"),
        bottomTabItem(w, "settings", "Config")))
    row.setId("bottom-tab")
    row.setStyle(bottomTabFixedCss())
    return row
}
