package components

import kof.ui
import core.theme

// =============================================================================
// brandMark — logomarca de 3 ondas em Canvas, proporção 2:1 (design.md §2.5)
// =============================================================================
// Mesma geometria do OrganizaMark do artefato (viewBox 240x120): cada onda é
// "M8 y Q60 y-22 120 y T232 y", com opacidade 1 / .78 / .58.
// O Canvas do kof.ui não tem quadraticCurveTo nem gradiente de traço: a curva
// é amostrada em 12 segmentos por metade (Bézier quadrática em Int) e o traço
// usa o accent sólido #00D4FF com setGlobalAlpha.
// =============================================================================

Int waveSteps() = 12

// Coordenada de uma Bézier quadrática no passo i de n, já escalada de 240 para `width`.
Int bezierAt(Int p0, Int ctrl, Int p1, Int i, Int n, Int width) {
    var a = n - i
    var acc = a * a * p0 + 2 * a * i * ctrl + i * i * p1
    return acc * width / (240 * n * n)
}

drawBrandWave(Canvas c, Int width, Int yBase, Double alpha) {
    var n = waveSteps()
    c.setGlobalAlpha(alpha)
    c.beginPath()
    c.moveTo(bezierAt(8, 8, 8, 0, n, width), bezierAt(yBase, yBase, yBase, 0, n, width))
    // 1ª metade: controle acima (y - 22).
    for (var i = 1; i <= n; i++) {
        c.lineTo(bezierAt(8, 60, 120, i, n, width), bezierAt(yBase, yBase - 22, yBase, i, n, width))
    }
    // 2ª metade (T): controle refletido abaixo (y + 22).
    for (var j = 1; j <= n; j++) {
        c.lineTo(bezierAt(120, 180, 232, j, n, width), bezierAt(yBase, yBase + 22, yBase, j, n, width))
    }
    c.stroke()
}

// Desenho da logomarca com `width` px de largura e width/2 de altura.
Canvas brandMarkCanvas(Int width) {
    var c = Canvas(width, width / 2)
    var line = width * 7 / 480
    if (line < 2) {
        line = 2
    }
    c.setStroke(colorAccent())
    c.setLineWidth(line)
    drawBrandWave(c, width, 24, 1.0)
    drawBrandWave(c, width, 58, 0.78)
    drawBrandWave(c, width, 92, 0.58)
    c.setGlobalAlpha(1.0)
    return c
}

// Logomarca pronta para a tela. Canvas não tem setId/setStyle (SEM025 no
// 0.6.6), então o id e o alinhamento ficam num View em volta.
View brandMark(Int width, String id) {
    var holder = View(screenStyle())
    holder.setId(id)
    holder.setStyle(markCss())
    holder.bind(brandMarkCanvas(width))
    return holder
}
