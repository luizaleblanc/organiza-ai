package components

import kof.ui
import core.theme

// =============================================================================
// brandMark — logomarca oficial (frontend/assets/brand/organiza-simbolo.svg)
// =============================================================================
// O SVG oficial é a fonte da marca (docs/DESIGN_SYSTEM.md §1): 3 curvas
// quadráticas reais, gradiente #00D4FF → #0066FF, traço 3.5, opacidades
// 1/.78/.58 e pontas redondas. Por ser vetor, fica nítido em qualquer dpr
// (o desenho em Canvas ficava pixelado e foi abandonado).
// `width` segue o OrganizaMark do artefato (viewBox 240 de largura): o SVG
// oficial corta a margem (viewBox 231.5 x 97.5), então a imagem tem
// width * 231.5 / 240 de largura e mantém a proporção do viewBox.
// =============================================================================

String brandMarkSrc() {
    if (authLight()) {
        return "assets/brand/organiza-simbolo-light.svg"
    }
    return "assets/brand/organiza-simbolo.svg"
}

Int brandImageWidth(Int width) = width * 463 / 480

Int brandImageHeight(Int width) = width * 195 / 480

// Logomarca pronta para a tela; o id e o alinhamento ficam no View em volta.
View brandMark(Int width, String id) {
    var img = Image(brandMarkSrc())
    img.setAlt("OrganizaIA")
    img.setWidth(brandImageWidth(width))
    img.setHeight(brandImageHeight(width))
    var holder = View(screenStyle())
    holder.setId(id)
    holder.setStyle(markCss())
    holder.bind(img)
    return holder
}
