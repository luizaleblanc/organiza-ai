package components

import kof.ui
import core.theme
import core.app_state
import core.navigation

// =============================================================================
// T4 — Logomark (3 ondas paralelas) + cabeçalho com toggle Mobile/Desktop
// =============================================================================

// Uma onda: 9 pontos de uma senoide em Canvas(36, 22), traço de 3px.
drawWave(Canvas c, Int yBase, Color color) {
    c.setStroke(color)
    c.setLineWidth(3)
    c.beginPath()
    c.moveTo(1, yBase)
    c.lineTo(5, yBase - 3)
    c.lineTo(9, yBase - 4)
    c.lineTo(13, yBase - 3)
    c.lineTo(18, yBase)
    c.lineTo(23, yBase + 3)
    c.lineTo(27, yBase + 4)
    c.lineTo(31, yBase + 3)
    c.lineTo(35, yBase)
    c.stroke()
}

// Logomark 36x22: ondas a 1.0 / 0.7 / 0.45 de opacidade (cores já compostas).
Canvas buildLogomark() {
    var c = Canvas(36, 22)
    drawWave(c, 5, colorAccent())
    drawWave(c, 11, colorWave2())
    drawWave(c, 17, colorWave3())
    return c
}

View buildBrandHeader(Window w) {
    var name = Label("Organiza AI")
    name.fontSize = sizeSubtitle()
    name.bold = true
    name.color = colorTextPrimary()

    var toggleView = viewportIconButton(w)

    var row = Row(listOf(buildLogomark(), name, toggleView))
    var header = View(Style(colorBgPrimary(), colorTextPrimary(), 12, 0))
    header.bind(row)
    return header
}

// Controles fixos no canto superior direito, fora do fluxo e da rolagem das telas.
Style viewportBarFloatCss() = Style("position: fixed; top: 16; right: 16; width: auto; display: flex; flex-direction: row; flex-wrap: nowrap; gap: 8; align-items: center; z-index: 100; padding: 0; background: transparent")

// =============================================================================
// Toggle de tema (pílula com 3 posições: Sistema, Claro, Escuro). A opção ativa
// fica no círculo com o gradiente da marca; as outras, ícone em text-secondary.
// =============================================================================
Style themePillCss() {
    if (authLight()) {
        return Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; gap: 4; padding: 4; border-radius: 999; background: #FFFFFF; border: 1px solid #E5E7EB; box-shadow: 0 4px 14px rgba(37,99,235,.12)")
    }
    return Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; gap: 4; padding: 4; border-radius: 999; background: #12162A; border: 1px solid rgba(255,255,255,.1); box-shadow: 0 8px 24px rgba(0,0,0,.45)")
}
Style themeKnobIdleCss() = Style("outline: none; display: flex; align-items: center; justify-content: center; width: 40; height: 40; border-radius: 999; background: transparent; cursor: pointer; padding: 0; line-height: 0em")
Style themeKnobActiveCss() {
    if (authLight()) {
        return Style("outline: none; display: flex; align-items: center; justify-content: center; width: 40; height: 40; border-radius: 999; background: linear-gradient(135deg, #2563EB, #1D4ED8); box-shadow: 0 2px 8px rgba(37,99,235,.35); cursor: pointer; padding: 0; line-height: 0em")
    }
    return Style("outline: none; display: flex; align-items: center; justify-content: center; width: 40; height: 40; border-radius: 999; background: linear-gradient(135deg, #00D4FF, #0066FF); box-shadow: 0 0 0 3px rgba(0,212,255,.15), 0 4px 12px rgba(0,102,255,.4); cursor: pointer; padding: 0; line-height: 0em")
}

setThemeMode(Window w, String mode) {
    AppState.themeMode = mode
    AppState.lightAuth = mode == "light"
    mountScreen(w)
}

View themeKnob(Window w, String mode, String icon, String label) {
    val active = AppState.themeMode == mode
    var color = "secondary"
    if (authLight()) {
        color = "lightsecondary"
    }
    if (active) {
        color = "onaccent"
        if (authLight()) {
            color = "white"
        }
    }
    var img = Image("assets/icons/theme-" + icon + "-" + color + ".svg")
    img.setAlt(label)
    img.setWidth(20)
    img.setHeight(20)
    var knob = View(screenStyle())
    knob.setId("theme-" + mode)
    if (active) {
        knob.setStyle(themeKnobActiveCss())
    } else {
        knob.setStyle(themeKnobIdleCss())
    }
    knob.bind(img)
    knob.on("click", () -> setThemeMode(w, mode))
    return knob
}

View themeToggle(Window w) {
    var row = Row(listOf(
        themeKnob(w, "system", "monitor", "Tema do sistema"),
        themeKnob(w, "light", "sun", "Modo claro"),
        themeKnob(w, "dark", "moon", "Modo escuro")))
    row.setId("auth-theme-toggle")
    row.setStyle(themePillCss())
    return row
}

// Botão redondo de viewport (ícone de celular no Desktop, de monitor no Mobile), no mesmo
// estilo da pílula de tema.
View viewportIconButton(Window w) {
    var color = "secondary"
    if (authLight()) {
        color = "lightsecondary"
    }
    var icon = "phone"
    var label = "Ver como Mobile"
    if (!AppState.isDesktop) {
        icon = "monitor"
        label = "Ver como Desktop"
    }
    var img = Image("assets/icons/theme-" + icon + "-" + color + ".svg")
    img.setAlt(label)
    img.setWidth(20)
    img.setHeight(20)
    var knob = View(screenStyle())
    knob.setId("dev-viewport")
    knob.setStyle(themeKnobIdleCss())
    knob.bind(img)
    knob.on("click", () -> switchViewport(w))
    var pill = Row(listOf(knob))
    pill.setId("viewport-pill")
    pill.setStyle(themePillCss())
    return pill
}
