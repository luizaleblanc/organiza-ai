package components

import kof.ui
import core.theme
import core.app_state
import core.navigation

// =============================================================================
// T4 — Logomark (3 ondas paralelas) + cabeçalho com toggle Mobile/Desktop
// =============================================================================

// Uma onda: 9 pontos de uma senoide em Canvas(36, 22), traço de 3px.
drawWave(Canvas c, Int yBase, Color color) {
    c.setStroke(color)
    c.setLineWidth(3)
    c.beginPath()
    c.moveTo(1, yBase)
    c.lineTo(5, yBase - 3)
    c.lineTo(9, yBase - 4)
    c.lineTo(13, yBase - 3)
    c.lineTo(18, yBase)
    c.lineTo(23, yBase + 3)
    c.lineTo(27, yBase + 4)
    c.lineTo(31, yBase + 3)
    c.lineTo(35, yBase)
    c.stroke()
}

// Logomark 36x22: ondas a 1.0 / 0.7 / 0.45 de opacidade (cores já compostas).
Canvas buildLogomark() {
    var c = Canvas(36, 22)
    drawWave(c, 5, colorAccent())
    drawWave(c, 11, colorWave2())
    drawWave(c, 17, colorWave3())
    return c
}

String viewportLabel() {
    if (AppState.isDesktop) {
        return "Ver como Mobile"
    }
    return "Ver como Desktop"
}

View buildBrandHeader(Window w) {
    var name = Label("Organiza AI")
    name.fontSize = sizeSubtitle()
    name.bold = true
    name.color = colorTextPrimary()

    var toggle = Button(viewportLabel(), () -> switchViewport(w))
    var toggleView = View(cardSecondaryStyle())
    toggleView.bind(toggle)

    var row = Row(listOf(buildLogomark(), name, toggleView))
    var header = View(Style(colorBgPrimary(), colorTextPrimary(), 12, 0))
    header.bind(row)
    return header
}

// Controle discreto de viewport (tokens do DS: texto muted, borda border-soft).
// O .kof-button não herda a fonte do body, então o font-family é declarado.
Style viewportToggleCss() = Style("background: transparent; color: #4A5578; border: 1px solid rgba(255,255,255,.1); border-radius: 8; padding: 4px 10px; font-size: 12; font-weight: 500; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style viewportBarCss()    = Style("display: flex; flex-direction: row; flex-wrap: nowrap; justify-content: flex-end; width: 100%; flex-shrink: 0; padding: 0; background: transparent")

// Barra das telas: só o toggle Mobile/Desktop, sem marca
// (a Tela 1 já mostra a logomarca grande): "Ver como Mobile / Ver como Desktop".
View buildViewportToggle(Window w) {
    var toggle = Button(viewportLabel(), () -> switchViewport(w))
    toggle.setId("dev-viewport")
    toggle.setStyle(viewportToggleCss())
    var bar = View(screenStyle())
    bar.setStyle(viewportBarCss())
    bar.bind(toggle)
    return bar
}
