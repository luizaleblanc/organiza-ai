package components

import kof.ui
import core.navigation

// =============================================================================
// T4 — Logomark em View/Style (fallback sem Canvas)
// =============================================================================
// O runtime KOF atual não expõe Canvas no typecheck desta versão; por isso
// o logomark é montado com blocos em View/Row/Style, mantendo o mesmo visual
// e compatibilidade com o compilador.
// =============================================================================

View buildLogomark() {
    var wave1 = View(Style(colorAccent(), colorAccent(), 0, 6))
    var wave2 = View(Style(colorWave2(), colorWave2(), 0, 6))
    var wave3 = View(Style(colorWave3(), colorWave3(), 0, 6))

    var stack = Column(listOf(wave1, wave2, wave3))
    var wrapper = View(Style(colorBgPrimary(), colorTextPrimary(), 8, 0))
    wrapper.bind(stack)
    return wrapper
}

String viewportLabel() {
    if (AppState.isDesktop) {
        return "Desktop 1280x800"
    }
    return "Mobile 360x640"
}

View buildBrandHeader(Window w) {
    var name = Label("Organiza AI")
    name.fontSize = sizeSubtitle()
    name.bold = true
    name.color = colorTextPrimary()

    var toggle = Button(viewportLabel(), () -> switchViewport(w))
    var toggleView = View(cardSecondaryStyle())
    toggleView.bind(toggle)

    var row = Row(listOf(buildLogomark(), name, toggleView))
    var header = View(Style(colorBgPrimary(), colorTextPrimary(), 12, 0))
    header.bind(row)
    return header
}
