package components

import kof.ui
import core.theme
import core.app_state
import core.navigation

// O controle de viewport e exclusivamente de desenvolvimento. O bundle normal
// mantem este literal falso; a rota /dev troca somente esta inicializacao no
// modulo JS gerado. Assim, #dev-viewport nem chega a existir no DOM publico.
class ViewportDev {
    static Bool enabled = false
}

// =============================================================================
// T4 — Logomark (3 ondas paralelas) + cabeçalho com toggle Mobile/Desktop
// =============================================================================

// Uma onda: 9 pontos de uma senoide em Canvas(36, 22), traço de 3px.
drawWave(Canvas c, Int yBase, Color color) {
    c.setStroke(color)
    c.setLineWidth(3)
    c.beginPath()
    c.moveTo(1, yBase)
    c.lineTo(5, yBase - 3)
    c.lineTo(9, yBase - 4)
    c.lineTo(13, yBase - 3)
    c.lineTo(18, yBase)
    c.lineTo(23, yBase + 3)
    c.lineTo(27, yBase + 4)
    c.lineTo(31, yBase + 3)
    c.lineTo(35, yBase)
    c.stroke()
}

// Logomark 36x22: ondas a 1.0 / 0.7 / 0.45 de opacidade (cores já compostas).
Canvas buildLogomark() {
    var c = Canvas(36, 22)
    drawWave(c, 5, colorAccent())
    drawWave(c, 11, colorWave2())
    drawWave(c, 17, colorWave3())
    return c
}

View buildBrandHeader(Window w) {
    var name = Label("Organiza AI")
    name.fontSize = sizeSubtitle()
    name.bold = true
    name.color = colorTextPrimary()

    var row = Row(listOf(buildLogomark(), name))
    var header = View(Style(colorBgPrimary(), colorTextPrimary(), 12, 0))
    header.bind(row)
    return header
}

// Botão discreto (sem caixa) no canto superior direito, fora do fluxo e da rolagem das telas.
// Só o ícone de celular (Desktop) ou de monitor (Mobile): a troca de tema vive em Configurações.
Style viewportBarFloatCss() = Style("position: fixed; top: 12; right: 12; width: auto; display: flex; flex-direction: row; align-items: center; z-index: 100; padding: 0; background: transparent")
Style viewportButtonCss() = Style("outline: none; display: flex; align-items: center; justify-content: center; width: 36; height: 36; border-radius: 999; background: transparent; border: none; cursor: pointer; padding: 0; line-height: 0em")

// Ícone de viewport: celular no Desktop, monitor no Mobile (mesmo botão, mesma posição).
View viewportIconButton(Window w) {
    var color = "secondary"
    if (isLight()) {
        color = "lightsecondary"
    }
    var icon = "phone"
    var label = "Ver como Mobile"
    if (!AppState.isDesktop) {
        icon = "monitor"
        label = "Ver como Desktop"
    }
    var img = Image("assets/icons/theme-" + icon + "-" + color + ".svg")
    img.setAlt(label)
    img.setWidth(20)
    img.setHeight(20)
    var knob = View(screenStyle())
    knob.setId("dev-viewport")
    knob.setStyle(viewportButtonCss())
    knob.bind(img)
    knob.on("click", () -> switchViewport(w))
    return knob
}

// Wrapper sem id no bundle publico. Somente /dev monta o botao interno.
View viewportControlBar(Window w) {
    var bar = View(screenStyle())
    bar.setStyle(viewportBarFloatCss())
    if (ViewportDev.enabled) {
        bar.bind(viewportIconButton(w))
    }
    return bar
}
