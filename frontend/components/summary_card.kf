package components

import kof.ui
import core.theme

// =============================================================================
// SummaryCard
// =============================================================================
// Cartão de resumo do dia, mantendo o padrão atual de tokens em funções
// top-level e layouts em View + Style + Column.
// =============================================================================

View summaryCard(String title, String value, String note) {
    var titleLabel = Label(title)
    var valueLabel = Label(value)
    var noteLabel = Label(note)

    var content = Column(listOf(titleLabel, valueLabel, noteLabel))
    var style = Style(colorCardSecondary(), colorTextPrimary(), 16, 12)
    var view = View(style)
    view.bind(content)
    return view
}
