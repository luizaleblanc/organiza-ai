package components

import kof.ui
import core.theme

// =============================================================================
// Currency Input — campo "R$ 3.000" com cursor piscante
// DESIGN_SYSTEM.md seção 3.2 (campo de valor do onboarding)
// =============================================================================

// Prefixo "R$" (24px/400/cyan) + valor editável (24px/400/cyan) + cursor cyan
// Centralizado horizontal e verticalmente

Row buildCurrencyInput(String currentValue) {
    var prefix = Label("R$ ")
    prefix.fontSize = 24
    prefix.color = AppTheme.accent
    prefix.bold = true

    var amount = Label(currentValue)
    amount.fontSize = 24
    amount.color = AppTheme.accent
    amount.bold = true

    var cursor = Label("|")
    cursor.fontSize = 24
    cursor.color = AppTheme.accent
    cursor.bold = false

    return Row(listOf(prefix, amount, cursor))
}

