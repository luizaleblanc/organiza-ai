package components

import kof.ui
import core.theme

// =============================================================================
// Choice Card — card de escolha do onboarding (radio button)
// DESIGN_SYSTEM.md seção 3.7
// =============================================================================
// Altura: 72px, radius 12px, padding horizontal 16px
// Normal: fundo card, borda card
// Selecionado: borda cyan + fundo rgba(0,212,255,.08)
// Radio à direita: 20px, com ponto interno quando selecionado
//
// Componente puramente visual (sem callback): nenhuma sintaxe confirmada no
// corpus oficial do Kof4j declara um parâmetro de função como tipo (só
// lambdas passadas como VALOR em chamadas). A interação de clique é feita
// pelo Button construído em cada tela (ver debt_screen.kf/income_type_screen.kf),
// que já chama Router/estado diretamente.
// =============================================================================

Row buildChoiceCard(String label, Boolean selected) {
    var text = Label(label)

    // Radio circle: 20px, borda 1.5px
    var radio = View(Style(AppTheme.card, AppTheme.textMuted, 0, 10))

    // TODO: se selected, aplicar borda cyan + fundo translúcido

    return Row(listOf(text, radio))
}
