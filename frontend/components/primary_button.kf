package components

import kof.ui
import core.theme
import core.constants

// =============================================================================
// Botão Primário — gradiente cyan→azul, texto accent-contrast
// DESIGN_SYSTEM.md seção 3.1
// =============================================================================

Button buildPrimaryButton(String label, () -> callback) {
    var btn = Button(label, callback)
    // Altura 48px, largura 100%, border-radius 12px
    // Fundo: gradiente 90deg, #00D4FF → #0066FF
    // Texto: 16px / 600 / accent-contrast
    return btn
}

