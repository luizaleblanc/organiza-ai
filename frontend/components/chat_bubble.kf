package components

import kof.ui
import core.theme

// =============================================================================
// Chat Bubble - bolha de mensagem (IA a esquerda, Usuario a direita)
// DESIGN_SYSTEM.md secao 3.6
// =============================================================================

View buildChatBubble(String content, String role) {
    var label = Label(content)
    label.fontSize = 16

    if (role == "assistant") {
        label.color = AppTheme.textPrimary
        label.bold = false
        var bubbleView = View(Style(AppTheme.cardSecondary, AppTheme.textPrimary, 12, 12))
        bubbleView.bind(label)
        return bubbleView
    }

    label.color = AppTheme.accentContrast
    label.bold = true
    var bubbleView = View(Style(AppTheme.accent, AppTheme.accentContrast, 12, 12))
    bubbleView.bind(label)
    return bubbleView
}
