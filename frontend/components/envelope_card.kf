package components

import kof.ui
import core.theme

// =============================================================================
// Envelope Card - card de caixinha com chip colorido
// DESIGN_SYSTEM.md secao 3.3 (Card de caixinha)
// =============================================================================

Row buildEnvelopeCard(String name, String category, Int percentage, String spent, String limit) {
    // Chip de icone (simulando com View basica)
    var chip = View(Style(AppTheme.borderCard, AppTheme.textSecondary, 8, 10))

    var nameLabel = Label(name)
    nameLabel.fontSize = 16
    nameLabel.bold = true
    nameLabel.color = AppTheme.textPrimary

    var pctLabel = Label("" + percentage + "%")
    pctLabel.fontSize = 14
    pctLabel.bold = true
    if (percentage >= 100) {
        pctLabel.color = AppTheme.danger
    } else if (percentage >= 80) {
        pctLabel.color = AppTheme.warning
    } else {
        pctLabel.color = AppTheme.success
    }

    var spentLabel = Label(spent + " de " + limit)
    spentLabel.fontSize = 13
    spentLabel.bold = false
    spentLabel.color = AppTheme.textMuted

    var info = Column(listOf(nameLabel, pctLabel, spentLabel))
    return Row(listOf(chip, info))
}
