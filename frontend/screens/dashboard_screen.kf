// Fatia i do donut: Necessidades accent, Desejos #0066FF, Futuro success.
Color sliceColor(Int i) {
    if (i == 0) { return colorAccent() }
    if (i == 1) { return colorChartDes() }
    if (i == 2) { return colorSuccess() }
    return colorWarning()
}

// Esmaecimento das fatias não selecionadas: 30% da cor sobre colorCard (#12162A).
Color dimSliceColor(Color c) {
    val bg = colorCard()
    val r = (c.red() * 30 + bg.red() * 70) / 100
    val g = (c.green() * 30 + bg.green() * 70) / 100
    val b = (c.blue() * 30 + bg.blue() * 70) / 100
    return Color(r, g, b)
}

Style sliceBarCss(Int i) {
    if (i == 0) { return sliceBarAccentCss() }
    if (i == 1) { return sliceBarDesCss() }
    if (i == 2) { return sliceBarSuccessCss() }
    return sliceBarWarningCss()
}

Style sliceDotCss(Int i) {
    if (i == 0) { return legendDotAccentCss() }
    if (i == 1) { return legendDotDesCss() }
    if (i == 2) { return legendDotSuccessCss() }
    return legendDotWarningCss()
}

Style donutPctCss(Int i) {
    if (i == 0) { return donutPctAccentCss() }
    if (i == 1) { return donutPctDesCss() }
    if (i == 2) { return donutPctSuccessCss() }
    return donutPctWarningCss()
}

// ---------------------------------------------------------------- carga

loadDashboard(Window w) {
    try {
        DashState.raw = fetchDashboard(DashState.period)
        AppState.loadError = ""
    } catch (String e) {
        DashState.raw = ""
        AppState.loadError = e
    }
    DashState.loaded = true
    DashState.fresh = true
    AppState.loading = false
    if (SessionState.token == "") {
        AppState.formError = AppState.loadError
        navigateTo(w, "login")
        return
    }
    if (AppState.currentScreen == "dashboard") {
        mountScreen(w)
    }
}

startLoad(Window w) {
    if (AppState.loading) {
        return
    }
    AppState.loading = true
    DashState.loaded = false
    DashState.selectedSlice = -1
    DashState.keepSliceSelection = false
    spawn {
        loadDashboard(w)
    }
}

selectPeriod(Window w, String period) {
    if (period == DashState.period) {
        return
    }
    DashState.period = period
    DashState.raw = ""
    DashState.fresh = false
    DashState.selectedSlice = -1
    DashState.keepSliceSelection = false
    AppState.loadError = ""
    mountScreen(w)
}

retryDashboard(Window w) {
    DashState.fresh = false
    AppState.loadError = ""
    mountScreen(w)
}

toggleSlice(Window w, Int index) {
    if (DashState.selectedSlice == index) {
        DashState.selectedSlice = -1
    } else {
        DashState.selectedSlice = index
    }
    DashState.keepSliceSelection = true
    DashState.fresh = true
    mountScreen(w)
}

clearSlice(Window w) {
    if (DashState.selectedSlice == -1) {
        return
    }
    DashState.selectedSlice = -1
    DashState.fresh = true
    mountScreen(w)
}

clearSliceFromDistributionCard(Window w) {
    // Os itens da legenda também disparam o clique do cartão. Nesse caso,
    // preservamos a seleção recém-escolhida; qualquer clique no espaço vazio
    // restaura o gráfico ao seu estado natural.
    if (DashState.keepSliceSelection) {
        DashState.keepSliceSelection = false
        return
    }
    clearSlice(w)
}

// ---------------------------------------------------------------- partes

View tabButton(Window w, String text, String period) {
    var b = Button(text, () -> selectPeriod(w, period))
    b.setId("tab-" + period)
    val active = DashState.period == period
    if (AppState.isDesktop) {
        if (active) {
            b.setStyle(dashTabActiveCss())
        } else {
            b.setStyle(dashTabCss())
        }
    } else {
        if (active) {
            b.setStyle(dashTabActiveMobileCss())
        } else {
            b.setStyle(dashTabMobileCss())
        }
    }
    return b
}

View periodTabs(Window w) {
    var row = Row(listOf(tabButton(w, "Semana", "week"), tabButton(w, "Mês", "month"), tabButton(w, "Ano", "year")))
    row.setId("dash-tabs")
    row.setStyle(dashTabsCss())
    return row
}

Label idLabel(String text, String id, Style style) {
    var l = Label(text)
    l.setId(id)
    l.setStyle(style)
    return l
}

View tile(String key, String label, String value, Style valueStyle, String sub, Style cardStyle, Style labelStyle, Style subStyle) {
    var col = Column(listOf(
        idLabel(label, "tile-" + key + "-label", labelStyle),
        idLabel(value, "tile-" + key + "-value", valueStyle),
        idLabel(sub, "tile-" + key + "-sub", subStyle)))
    col.setId("tile-" + key)
    col.setStyle(cardStyle)
    return col
}

// Simulação visual temporária: não cria transação nem altera o histórico.
// Assim que houver lançamentos reais no mês, o dashboard passa a exibir o total
// retornado pela API.
Bool isSpentSimulation(DashboardResponse d) = DashState.period != "year" && d.totalSpent == 0.0

Double displayedSpent(DashboardResponse d) {
    if (isSpentSimulation(d)) {
        return 623.66
    }
    return d.totalSpent
}

Double displayedPulse(DashboardResponse d) {
    if (isSpentSimulation(d) && d.daysRemaining > 0) {
        return math.roundTo((d.salary - displayedSpent(d)) / (d.daysRemaining * 1.0), 2)
    }
    return d.pulse
}

String displayedSpentSub(DashboardResponse d) {
    if (isSpentSimulation(d)) {
        return "Simulação de gastos informados"
    }
    return "de " + brl(d.salary)
}

// A reserva informada é usada apenas enquanto a API não tiver um saldo real.
Bool isReserveSimulation(DashboardResponse d) = d.reserve.accumulated == 0.0

Double displayedReserve(DashboardResponse d) {
    if (isReserveSimulation(d)) {
        return 1491.0
    }
    return d.reserve.accumulated
}

View tiles(DashboardResponse d) {
    val currentSpent = displayedSpent(d)
    val currentPulse = displayedPulse(d)
    val spentSub = displayedSpentSub(d)
    var reserveSub = "Reserva informada"
    if (d.reserve.hasGoal) {
        reserveSub = "Meta: " + brlShort(brl(d.reserve.goal)) + " — " + String.valueOf(d.reserve.percent) + "%"
    }
    if (AppState.isDesktop) {
        var row = Row(listOf(
            tile("pulse", "Pode gastar hoje", brl(currentPulse), tileAccentCss(), daysRemainingText(d.daysRemaining), dashPulseCardCss(), tileLabelCss(), tileSubCss()),
            tile("spent", spentLabel(DashState.period), brl(currentSpent), tileValueCss(), spentSub, dashPulseCardCss(), tileLabelCss(), tileSubCss()),
            tile("reserve", "Reserva acumulada", brl(displayedReserve(d)), tileSuccessCss(), reserveSub, dashPulseCardCss(), tileLabelCss(), tileSubCss())))
        row.setId("dash-tiles")
        row.setStyle(dashGridG3Css())
        return row
    }
    var hero = tile("pulse", "Pode gastar hoje", brl(currentPulse), tileHeroValueCss(), daysRemainingText(d.daysRemaining), dashPulseHeroCss(), tileHeroLabelCss(), tileHeroSubCss())
    var pair = Row(listOf(
        tile("spent", spentLabel(DashState.period), brl(currentSpent), tileMobileValueCss(), spentSub, dashCardMobileCss(), tileMobileLabelCss(), tileSubCss()),
        tile("reserve", "Reserva acumulada", brl(displayedReserve(d)), tileMobileSuccessCss(), reserveSub, dashCardMobileCss(), tileMobileLabelCss(), tileSubCss())))
    pair.setStyle(dashMobileG2Css())
    var col = Column(listOf(hero, pair))
    col.setId("dash-tiles")
    col.setStyle(dashMobileStackCss())
    return col
}

// ---- Calendário de previsão -------------------------------------------------
// A previsão parte do saldo diário disponível e aplica uma cadência mais
// conservadora no fim de semana. É uma estimativa visual: não cria despesas.
Bool calendarLeapYear(Int year) = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0

Int calendarDaysInMonth(Int year, Int month) {
    if (month == 2) {
        if (calendarLeapYear(year)) { return 29 }
        return 28
    }
    if (month == 4 || month == 6 || month == 9 || month == 11) {
        return 30
    }
    return 31
}

// Índice do dia: segunda = 0, domingo = 6. A fórmula usa 1970-01-01 (quinta).
Int calendarWeekday(Int year, Int month, Int day) {
    var y = year
    if (month <= 2) {
        y = y - 1
    }
    var m = month - 3
    if (month <= 2) {
        m = month + 9
    }
    val era = y / 400
    val yoe = y - era * 400
    val doy = (153 * m + 2) / 5 + day - 1
    val doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    val days = era * 146097 + doe - 719468
    return (days + 3) % 7
}

Int calendarToday(DashboardResponse d, Int daysInMonth) {
    var day = daysInMonth - d.daysRemaining + 1
    if (day < 1) { return 1 }
    if (day > daysInMonth) { return daysInMonth }
    return day
}

Double dailyPrediction(DashboardResponse d, Int weekday) {
    var multiplier = 1.0
    if (weekday == 4) { multiplier = 0.95 }
    if (weekday == 5 || weekday == 6) { multiplier = 0.9 }
    return math.roundTo(displayedPulse(d) * multiplier, 2)
}

View calendarDay(DashboardResponse d, Int year, Int month, Int day, Int today) {
    val weekday = calendarWeekday(year, month, day)
    var amount = "Encerrado"
    var amountCss = calendarPastTextCss()
    if (day >= today) {
        amount = brl(dailyPrediction(d, weekday))
        amountCss = calendarForecastCss()
    }
    var cell = Column(listOf(
        idLabel(String.valueOf(day), "calendar-day-number-" + String.valueOf(day), calendarDayNumCss()),
        idLabel(amount, "calendar-day-forecast-" + String.valueOf(day), amountCss)))
    cell.setId("calendar-day-" + String.valueOf(day))
    if (day < today) {
        cell.setStyle(calendarPastCss())
    } else if (day == today) {
        cell.setStyle(calendarTodayCss())
    } else {
        cell.setStyle(calendarDayCss())
    }
    return cell
}

View spendingCalendar(DashboardResponse d) {
    val year = d.from.substring(0, 4).toInt()
    val month = d.from.substring(5, 7).toInt()
    val daysInMonth = calendarDaysInMonth(year, month)
    val today = calendarToday(d, daysInMonth)

    var weekdayLabels: List<View> = listOf()
    for (var name in "Seg,Ter,Qua,Qui,Sex,Sáb,Dom".split(",")) {
        weekdayLabels.add(idLabel(name, "calendar-weekday-" + name, calendarWeekdayCss()))
    }
    var weekdays = Column(weekdayLabels)
    weekdays.setStyle(calendarWeekdaysCss())

    var cells: List<View> = listOf()
    var blank = 0
    val startsAt = calendarWeekday(year, month, 1)
    while (blank < startsAt) {
        var spacer = View(screenStyle())
        spacer.setStyle(calendarBlankCss())
        cells.add(spacer)
        blank = blank + 1
    }
    var day = 1
    while (day <= daysInMonth) {
        cells.add(calendarDay(d, year, month, day, today))
        day = day + 1
    }
    var grid = Column(cells)
    grid.setId("spending-calendar-grid")
    grid.setStyle(calendarGridCss())

    var intro = Column(listOf(
        idLabel(monthYear(month, year), "spending-calendar-title", calendarTitleCss()),
        idLabel("Previsão personalizada pelo saldo e ritmo do mês", "spending-calendar-subtitle", calendarSubCss())))
    intro.setStyle(calendarIntroCss())
    var badge = idLabel("PREVISÃO INTELIGENTE", "spending-calendar-badge", calendarBadgeCss())
    var head = Row(listOf(intro, badge))
    head.setStyle(calendarHeadCss())
    var card = Column(listOf(head, weekdays, grid))
    card.setId("card-spending-calendar")
    card.setStyle(calendarCardCss())
    return card
}

// Donut em Canvas 4x (576px com zoom 0.25 -> 144px): setFill + fill apenas.
// Fatia selecionada desloca radialmente para fora e cresce; demais esmaecem.
Canvas donutCanvas(List<BucketBalanceDTO> buckets, Int selectedSlice) {
    val size = 576
    var c = Canvas(size, size)
    val pi = 3.14159265358979
    val cx = 288
    val cy = 288
    val r = 240
    val rSel = 252
    val pop = 24.0
    var total = 0
    var nonZero = 0
    for (var b in buckets) {
        if (b.percentage > 0) {
            total = total + b.percentage
            nonZero = nonZero + 1
        }
    }
    if (total <= 0) {
        c.setFill(colorCardSecondary())
        c.beginPath()
        c.arc(cx, cy, r, 0.0, 2.0 * pi)
        c.closePath()
        c.fill()
        c.setFill(colorCard())
        c.beginPath()
        c.arc(cx, cy, r * 62 / 100, 0.0, 2.0 * pi)
        c.closePath()
        c.fill()
        return c
    }
    var halfGap = 0.0
    if (nonZero > 1) {
        halfGap = 0.015
    }
    var start = 0.0 - pi / 2.0
    var i = 0
    for (var b in buckets) {
        val span = 2.0 * pi * b.percentage / total
        val end = start + span
        if (b.percentage > 0) {
            var col = sliceColor(i)
            if (selectedSlice >= 0 && selectedSlice != i) {
                col = dimSliceColor(col)
            }
            var sx = cx
            var sy = cy
            var sr = r
            if (selectedSlice == i) {
                val mid = (start + end) / 2.0
                sx = cx + (math.roundTo(pop * math.cos(mid), 0) as Int)
                sy = cy + (math.roundTo(pop * math.sin(mid), 0) as Int)
                sr = rSel
            }
            c.setFill(col)
            c.beginPath()
            c.moveTo(sx, sy)
            c.arc(sx, sy, sr, start + halfGap, end - halfGap)
            c.closePath()
            c.fill()
        }
        start = end
        i = i + 1
    }
    c.setFill(colorCard())
    c.beginPath()
    c.arc(cx, cy, r * 62 / 100, 0.0, 2.0 * pi)
    c.closePath()
    c.fill()
    return c
}

View donutCenterOverlay(DashboardResponse d, Int selectedSlice) {
    var items: List<View> = listOf()
    if (selectedSlice >= 0 && selectedSlice < d.buckets.size) {
        val sb = d.buckets.get(selectedSlice)
        items.add(idLabel(String.valueOf(sb.percentage) + "%", "donut-center-pct", donutPctCss(selectedSlice)))
        items.add(idLabel(sb.name, "donut-center-name", donutCenterTitleCss()))
        items.add(idLabel(brlShort(brl(sb.plannedAmount)), "donut-center-value", donutCenterSubCss()))
    } else {
        items.add(idLabel(modelFriendlyName(d.budgetModel), "donut-center-name", donutCenterModelCss()))
        items.add(idLabel(brlShort(brl(d.salary)), "donut-center-value", donutCenterSubCss()))
    }
    var overlay = Column(items)
    overlay.setId("donut-center")
    overlay.setStyle(donutCenterCss())
    return overlay
}

View legendItem(Window w, BucketBalanceDTO b, Int i, Int selectedSlice) {
    var dot = View(screenStyle())
    dot.setStyle(sliceDotCss(i))
    var nameStyle = legendNameCss()
    if (selectedSlice == i) {
        nameStyle = legendNameSelCss()
    }
    var left = Row(listOf(dot, idLabel(b.name, "legend-" + i + "-name", nameStyle)))
    left.setStyle(legendLeftCss())
    var top = Row(listOf(left, idLabel(brlShort(brl(b.plannedAmount)), "legend-" + i + "-value", legendValCss())))
    top.setStyle(rowBetweenCss())

    var p = b.percentage
    if (p > 100) { p = 100 }
    if (p < 0) { p = 0 }
    var fill = View(screenStyle())
    fill.setStyle(sliceBarCss(i))
    fill.setFlexBasis(p * 100)
    var rest = View(screenStyle())
    rest.setStyle(sliceRestCss())
    rest.setFlexBasis((100 - p) * 100)
    var parts = Row(listOf(fill, rest))
    parts.setStyle(sliceRowCss())
    var track = View(screenStyle())
    track.setStyle(sliceTrackCss())
    track.bind(parts)

    var item = View(screenStyle())
    item.setId("legend-" + i)
    if (selectedSlice == i) {
        item.setStyle(legendItemSelCss())
    } else if (selectedSlice >= 0) {
        item.setStyle(legendItemDimCss())
    } else {
        item.setStyle(legendItemCss())
    }
    item.bind(Column(listOf(top, track)))
    item.on("click", () -> toggleSlice(w, i))
    return item
}

View distributionCard(Window w, DashboardResponse d) {
    var sel = DashState.selectedSlice
    if (sel >= d.buckets.size) {
        sel = -1
    }
    var canvasWrap = View(screenStyle())
    canvasWrap.setStyle(canvasZoomCss())
    canvasWrap.bind(donutCanvas(d.buckets, sel))

    var holder = View(screenStyle())
    holder.setId("dash-donut")
    holder.setStyle(donutOuterCss())
    holder.bind(canvasWrap)
    holder.on("click", () -> clearSlice(w))

    var items: List<View> = listOf()
    var i = 0
    for (var b in d.buckets) {
        items.add(legendItem(w, b, i, sel))
        i = i + 1
    }
    if (i == 0) {
        items.add(idLabel("Sem divisões fixas neste modelo.", "legend-empty", tileSubCss()))
    }
    var legend = Column(items)
    legend.setStyle(legendCss())

    var body = Row(listOf(holder, legend))
    if (AppState.isDesktop) {
        body.setStyle(distBodyDesktopCss())
    } else {
        body = Column(listOf(holder, legend))
        body.setStyle(distBodyMobileCss())
    }
    var titleCss = cardTitleMobileCss()
    var cardCss = dashCardMobileCss()
    if (AppState.isDesktop) {
        titleCss = cardTitleCss()
        cardCss = dashCardCss()
    }
    var heading = Column(listOf(
        idLabel("Modelo de Economia", "dist-title", titleCss),
        idLabel(modelFriendlyName(d.budgetModel), "dist-model", distributionModelCss())))
    heading.setStyle(distributionHeadingCss())
    var card = Column(listOf(heading, body))
    card.setId("card-distribution")
    card.setStyle(cardCss)
    card.on("click", () -> clearSliceFromDistributionCard(w))
    return card
}

Canvas dotCanvas(Color color) {
    var c = Canvas(32, 32)
    c.setFill(color)
    c.beginPath()
    c.arc(16, 16, 16, 0.0, 6.2831853)
    c.closePath()
    c.fill()
    return c
}

View txRow(TransactionOutput t, Int i, Bool isLast) {
    var dot = View(screenStyle())
    dot.setStyle(canvasZoomCss())
    dot.bind(dotCanvas(categoryColor(t.category)))
    var text = Column(listOf(
        idLabel(t.description, "tx-" + i + "-name", txNameCss()),
        idLabel(categoryLabel(t.category), "tx-" + i + "-cat", txCatCss())))
    text.setStyle(txTextCss())
    var row = Row(listOf(dot, text, idLabel(brl(0.0 - t.value), "tx-" + i + "-value", txValueCss())))
    row.setId("tx-" + i)
    if (isLast) {
        row.setStyle(txRowLastCss())
    } else {
        row.setStyle(txRowCss())
    }
    return row
}

View transactionsCard(DashboardResponse d) {
    var titleCss = cardTitleMobileCss()
    var cardCss = dashCardMobileCss()
    if (AppState.isDesktop) {
        titleCss = cardTitleCss()
        cardCss = dashCardCss()
    }
    var rows: List<View> = listOf()
    val total = d.recentTransactions.size
    var i = 0
    for (var t in d.recentTransactions) {
        rows.add(txRow(t, i, i == total - 1))
        i = i + 1
    }
    if (i == 0) {
        rows.add(idLabel("Nenhuma transação no período.", "tx-empty", tileSubCss()))
    }
    var list = Column(rows)
    list.setStyle(txListCss())
    var card = Column(listOf(idLabel("Últimas transações", "tx-title", titleCss), list))
    card.setId("card-transactions")
    card.setStyle(cardCss)
    return card
}

// Mês: "Novembro 2026"; Semana: mês-ano do início da semana; Ano: "2026".
String dashSubtitle(DashboardResponse? d) {
    if (d == null) {
        return ""
    }
    if (d.from.length < 7) {
        return ""
    }
    if (DashState.period == "year") {
        return d.from.substring(0, 4)
    }
    return monthYearFromIso(d.from)
}

// ---------------------------------------------------------------- tela

View dashboardScreen(Window w) {
    if (DashState.fresh) {
        DashState.fresh = false
    } else {
        startLoad(w)
    }
    var d = dashboardData()
    var items: List<View> = listOf()
    items.add(topbar("Dashboard", dashSubtitle(d), periodTabs(w)))
    if (AppState.loadError != "") {
        items.add(idLabel(AppState.loadError, "dash-error", errorBannerCss()))
        var retry = Button("Tentar de novo", () -> retryDashboard(w))
        retry.setId("dash-retry")
        retry.setStyle(retryCss())
        items.add(retry)
    } else if (d == null) {
        items.add(idLabel("Carregando…", "dash-loading", captionCss()))
    } else {
        items.add(tiles(d))
        if (DashState.period == "week") {
            items.add(spendingCalendar(d))
        } else {
            if (AppState.isDesktop) {
                var cards = Row(listOf(distributionCard(w, d), transactionsCard(d)))
                cards.setId("dash-cards")
                cards.setStyle(dashGridG2Css())
                items.add(cards)
            } else {
                var cards = Column(listOf(distributionCard(w, d), transactionsCard(d)))
                cards.setId("dash-cards")
                cards.setStyle(dashMobileStackCss())
                items.add(cards)
            }
        }
    }
    var col = Column(items)
    col.setId("screen-dashboard")
    if (AppState.isDesktop) {
        col.setStyle(dashScreenDesktopCss())
    } else {
        col.setStyle(stackCss())
    }
    return col
}
