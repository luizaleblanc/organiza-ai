// Fatia i do donut: Necessidades accent, Desejos #0066FF, Futuro success.
Color sliceColor(Int i) {
    if (i == 0) { return colorAccent() }
    if (i == 1) { return colorChartDes() }
    if (i == 2) { return colorSuccess() }
    return colorWarning()
}

// Esmaecimento das fatias não selecionadas: 30% da cor sobre colorCard (#12162A).
Color dimSliceColor(Color c) {
    val bg = colorCard()
    val r = (c.red() * 30 + bg.red() * 70) / 100
    val g = (c.green() * 30 + bg.green() * 70) / 100
    val b = (c.blue() * 30 + bg.blue() * 70) / 100
    return Color(r, g, b)
}

Style sliceBarCss(Int i) {
    if (i == 0) { return sliceBarAccentCss() }
    if (i == 1) { return sliceBarDesCss() }
    if (i == 2) { return sliceBarSuccessCss() }
    return sliceBarWarningCss()
}

Style sliceDotCss(Int i) {
    if (i == 0) { return legendDotAccentCss() }
    if (i == 1) { return legendDotDesCss() }
    if (i == 2) { return legendDotSuccessCss() }
    return legendDotWarningCss()
}

Style donutPctCss(Int i) {
    if (i == 0) { return donutPctAccentCss() }
    if (i == 1) { return donutPctDesCss() }
    if (i == 2) { return donutPctSuccessCss() }
    return donutPctWarningCss()
}

// ---------------------------------------------------------------- carga

loadDashboard(Window w) {
    try {
        DashState.raw = fetchDashboard(DashState.period)
        if (DashState.period == "year") {
            DashState.yearRaw = fetchYearDashboard()
        }
        AppState.loadError = ""
    } catch (String e) {
        DashState.raw = ""
        DashState.yearRaw = ""
        AppState.loadError = e
    }
    DashState.loaded = true
    DashState.fresh = true
    AppState.loading = false
    if (SessionState.token == "") {
        AppState.formError = AppState.loadError
        navigateTo(w, "login")
        return
    }
    if (AppState.currentScreen == "dashboard") {
        mountScreen(w)
    }
}

startLoad(Window w) {
    if (AppState.loading) {
        return
    }
    AppState.loading = true
    DashState.loaded = false
    DashState.selectedSlice = -1
    DashState.keepSliceSelection = false
    spawn {
        loadDashboard(w)
    }
}

selectPeriod(Window w, String period) {
    if (period == DashState.period) {
        return
    }
    DashState.period = period
    DashState.raw = ""
    DashState.yearRaw = ""
    DashState.fresh = false
    DashState.chartPreferencesOpen = false
    DashState.selectedSlice = -1
    DashState.keepSliceSelection = false
    AppState.loadError = ""
    mountScreen(w)
}

retryDashboard(Window w) {
    DashState.fresh = false
    AppState.loadError = ""
    mountScreen(w)
}

toggleSlice(Window w, Int index) {
    if (DashState.selectedSlice == index) {
        DashState.selectedSlice = -1
    } else {
        DashState.selectedSlice = index
    }
    DashState.keepSliceSelection = true
    DashState.fresh = true
    mountScreen(w)
}

clearSlice(Window w) {
    if (DashState.selectedSlice == -1) {
        return
    }
    DashState.selectedSlice = -1
    DashState.fresh = true
    mountScreen(w)
}

clearSliceFromDistributionCard(Window w) {
    // Os itens da legenda também disparam o clique do cartão. Nesse caso,
    // preservamos a seleção recém-escolhida; qualquer clique no espaço vazio
    // restaura o gráfico ao seu estado natural.
    if (DashState.keepSliceSelection) {
        DashState.keepSliceSelection = false
        return
    }
    clearSlice(w)
}

// ---------------------------------------------------------------- partes

View tabButton(Window w, String text, String period) {
    var b = Button(text, () -> selectPeriod(w, period))
    b.setId("tab-" + period)
    val active = DashState.period == period
    if (AppState.isDesktop) {
        if (active) {
            b.setStyle(dashTabActiveCss())
        } else {
            b.setStyle(dashTabCss())
        }
    } else {
        if (active) {
            b.setStyle(dashTabActiveMobileCss())
        } else {
            b.setStyle(dashTabMobileCss())
        }
    }
    return b
}

View periodTabs(Window w) {
    var row = Row(listOf(tabButton(w, "Semana", "week"), tabButton(w, "Mês", "month"), tabButton(w, "Ano", "year")))
    row.setId("dash-tabs")
    row.setStyle(dashTabsCss())
    return row
}

toggleChartPreferences(Window w) {
    DashState.chartPreferencesOpen = !DashState.chartPreferencesOpen
    mountScreen(w)
}

toggleBudgetChart(Window w) {
    DashState.showBudgetChart = !DashState.showBudgetChart
    mountScreen(w)
}

toggleCategoryChart(Window w) {
    DashState.showCategoryChart = !DashState.showCategoryChart
    mountScreen(w)
}

toggleSummaryCard(Window w) {
    DashState.showSummaryCard = !DashState.showSummaryCard
    mountScreen(w)
}

// Botão de alternância de um gráfico no painel "Personalizar gráficos".
View chartToggle(String id, String name, Bool visible, Window w, Int which) {
    var label = "Exibir: " + name
    if (!visible) { label = "Oculto: " + name }
    var b = Button(label, () -> chartToggleAction(w, which))
    b.setId(id)
    b.setStyle(chartPreferenceButtonCss())
    return b
}

chartToggleAction(Window w, Int which) {
    if (which == 1) { toggleBudgetChart(w) }
    if (which == 2) { toggleCategoryChart(w) }
    if (which == 3) { toggleSummaryCard(w) }
}

View chartPreferenceAction(Window w) {
    var controls: List<View> = listOf(periodTabs(w))
    var customize = Button("Personalizar gráficos", () -> toggleChartPreferences(w))
    customize.setId("dash-chart-preferences-toggle")
    customize.setStyle(chartPreferenceButtonCss())
    controls.add(customize)
    if (DashState.chartPreferencesOpen) {
        var options: List<View> = listOf()
        options.add(chartToggle("dash-chart-budget-toggle", "Prévia do Modelo de Economia", DashState.showBudgetChart, w, 1))
        options.add(chartToggle("dash-chart-category-toggle", "Gastos por categoria", DashState.showCategoryChart, w, 2))
        options.add(chartToggle("dash-chart-summary-toggle", "Resumo do Planejamento", DashState.showSummaryCard, w, 3))
        var panel = Row(options)
        panel.setId("dash-chart-preferences-panel")
        panel.setStyle(chartPreferencePanelCss())
        controls.add(panel)
    }
    var col = Column(controls)
    if (!AppState.isDesktop) { col.setStyle(Style("display: flex; flex-direction: column; align-items: stretch; gap: 8; width: 100%")) } else { col.setStyle(Style("display: flex; flex-direction: column; align-items: flex-end; gap: 8")) }
    return col
}

Label idLabel(String text, String id, Style style) {
    var l = Label(text)
    l.setId(id)
    l.setStyle(style)
    return l
}

View tile(String key, String label, String value, Style valueStyle, String sub, Style cardStyle, Style labelStyle, Style subStyle) {
    var col = Column(listOf(
        idLabel(label, "tile-" + key + "-label", labelStyle),
        idLabel(value, "tile-" + key + "-value", valueStyle),
        idLabel(sub, "tile-" + key + "-sub", subStyle)))
    col.setId("tile-" + key)
    col.setStyle(cardStyle)
    return col
}

Double onboardingPlannedSpendable(DashboardResponse d) {
    var sum = 0.0
    for (var b in d.buckets) {
        if (b.name != "Poupança" && b.name != "Futuro" && b.name != "Guardar") {
            sum = sum + b.plannedAmount
        }
    }
    if (sum <= 0.0) {
        return d.salary
    }
    return sum
}

Double displayedSpent(DashboardResponse d) = d.salary

Double displayedPulse(DashboardResponse d) {
    if (d.salary > 0.0 && d.daysRemaining > 0) {
        return math.roundTo(d.salary / (d.daysRemaining * 1.0), 2)
    }
    return d.pulse
}

String displayedSpentSub(DashboardResponse d) = "Modelo " + modelFriendlyName(d.budgetModel)
Double displayedReserve(DashboardResponse d) = d.reserve.accumulated

View tiles(DashboardResponse d) {
    val currentSpent = displayedSpent(d)
    val currentPulse = displayedPulse(d)
    val spentSub = displayedSpentSub(d)
    val pulseSub = "Baseado no seu planejamento inicial · " + daysRemainingText(d.daysRemaining)
    var reserveSub = "Sem meta definida"
    if (d.reserve.hasGoal && d.reserve.goal > 0.0) {
        reserveSub = "Meta: " + brlShort(brl(d.reserve.goal)) + " — " + String.valueOf(d.reserve.percent) + "%"
    } else if (d.reserve.accumulated > 0.0) {
        reserveSub = "Total acumulado"
    }
    if (AppState.isDesktop) {
        var row = Row(listOf(
            tile("pulse", "Pode gastar hoje (prévia)", brl(currentPulse), tileAccentCss(), pulseSub, dashPulseCardCss(), tileLabelCss(), tileSubCss()),
            tile("spent", "Orçamento planejado", brl(currentSpent), tileValueCss(), spentSub, dashPulseCardCss(), tileLabelCss(), tileSubCss()),
            tile("reserve", "Reserva acumulada", brl(displayedReserve(d)), tileSuccessCss(), reserveSub, dashPulseCardCss(), tileLabelCss(), tileSubCss())))
        row.setId("dash-tiles")
        row.setStyle(dashGridG3Css())
        return row
    }
    var hero = tile("pulse", "Pode gastar hoje (prévia)", brl(currentPulse), tileHeroValueCss(), pulseSub, dashPulseHeroCss(), tileHeroLabelCss(), tileHeroSubCss())
    var pair = Column(listOf(
        tile("spent", "Orçamento planejado", brl(currentSpent), tileMobileValueCss(), spentSub, dashCardMobileCss(), tileMobileLabelCss(), tileSubCss()),
        tile("reserve", "Reserva acumulada", brl(displayedReserve(d)), tileMobileSuccessCss(), reserveSub, dashCardMobileCss(), tileMobileLabelCss(), tileSubCss())))
    pair.setStyle(dashMobileStackCss())
    var col = Column(listOf(hero, pair))
    col.setId("dash-tiles")
    col.setStyle(dashMobileStackCss())
    return col
}

// ---- Calendário de previsão -------------------------------------------------
// A previsão parte do saldo diário disponível e aplica uma cadência mais
// conservadora no fim de semana. É uma estimativa visual: não cria despesas.
Bool calendarLeapYear(Int year) = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0

Int calendarDaysInMonth(Int year, Int month) {
    if (month == 2) {
        if (calendarLeapYear(year)) { return 29 }
        return 28
    }
    if (month == 4 || month == 6 || month == 9 || month == 11) {
        return 30
    }
    return 31
}

// Índice do dia: segunda = 0, domingo = 6. A fórmula usa 1970-01-01 (quinta).
Int calendarWeekday(Int year, Int month, Int day) {
    var y = year
    if (month <= 2) {
        y = y - 1
    }
    var m = month - 3
    if (month <= 2) {
        m = month + 9
    }
    val era = y / 400
    val yoe = y - era * 400
    val doy = (153 * m + 2) / 5 + day - 1
    val doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    val days = era * 146097 + doe - 719468
    return (days + 3) % 7
}

Int calendarToday(DashboardResponse d, Int daysInMonth) {
    var day = daysInMonth - d.daysRemaining + 1
    if (day < 1) { return 1 }
    if (day > daysInMonth) { return daysInMonth }
    return day
}

Double dailyPrediction(DashboardResponse d, Int weekday) {
    var multiplier = 1.0
    if (weekday == 4) { multiplier = 0.95 }
    if (weekday == 5 || weekday == 6) { multiplier = 0.9 }
    return math.roundTo(displayedPulse(d) * multiplier, 2)
}

View calendarDay(DashboardResponse d, Int year, Int month, Int day, Int today) {
    val weekday = calendarWeekday(year, month, day)
    var amount = "Encerrado"
    var amountCss = calendarPastTextCss()
    if (day >= today) {
        amount = brl(dailyPrediction(d, weekday))
        amountCss = calendarForecastCss()
    }
    var cell = Column(listOf(
        idLabel(String.valueOf(day), "calendar-day-number-" + String.valueOf(day), calendarDayNumCss()),
        idLabel(amount, "calendar-day-forecast-" + String.valueOf(day), amountCss)))
    cell.setId("calendar-day-" + String.valueOf(day))
    if (day < today) {
        cell.setStyle(calendarPastCss())
    } else if (day == today) {
        cell.setStyle(calendarTodayCss())
    } else {
        cell.setStyle(calendarDayCss())
    }
    return cell
}

View spendingCalendar(DashboardResponse d) {
    val year = d.from.substring(0, 4).toInt()
    val month = d.from.substring(5, 7).toInt()
    val daysInMonth = calendarDaysInMonth(year, month)
    val today = calendarToday(d, daysInMonth)

    var weekdayLabels: List<View> = listOf()
    for (var name in "Seg,Ter,Qua,Qui,Sex,Sáb,Dom".split(",")) {
        weekdayLabels.add(idLabel(name, "calendar-weekday-" + name, calendarWeekdayCss()))
    }
    var weekdays = Column(weekdayLabels)
    weekdays.setStyle(calendarWeekdaysCss())

    var cells: List<View> = listOf()
    var blank = 0
    val startsAt = calendarWeekday(year, month, 1)
    while (blank < startsAt) {
        var spacer = View(screenStyle())
        spacer.setStyle(calendarBlankCss())
        cells.add(spacer)
        blank = blank + 1
    }
    var day = 1
    while (day <= daysInMonth) {
        cells.add(calendarDay(d, year, month, day, today))
        day = day + 1
    }
    var grid = Column(cells)
    grid.setId("spending-calendar-grid")
    grid.setStyle(calendarGridCss())

    var intro = Column(listOf(
        idLabel(monthYear(month, year), "spending-calendar-title", calendarTitleCss()),
        idLabel("Previsão personalizada pelo saldo e ritmo do mês", "spending-calendar-subtitle", calendarSubCss())))
    intro.setStyle(calendarIntroCss())
    var badge = idLabel("PREVISÃO INTELIGENTE", "spending-calendar-badge", calendarBadgeCss())
    var head = Row(listOf(intro, badge))
    head.setStyle(calendarHeadCss())
    var card = Column(listOf(head, weekdays, grid))
    card.setId("card-spending-calendar")
    card.setStyle(calendarCardCss())
    return card
}

// Donut em Canvas 4x (576px com zoom 0.25 -> 144px): setFill + fill apenas.
// Fatia selecionada desloca radialmente para fora e cresce; demais esmaecem.
Canvas donutCanvas(List<BucketBalanceDTO> buckets, Int selectedSlice) {
    val size = 576
    var c = Canvas(size, size)
    val pi = 3.14159265358979
    val cx = 288
    val cy = 288
    val r = 240
    val rSel = 252
    val pop = 24.0
    var total = 0
    var nonZero = 0
    for (var b in buckets) {
        if (b.percentage > 0) {
            total = total + b.percentage
            nonZero = nonZero + 1
        }
    }
    if (total <= 0) {
        c.setFill(colorCardSecondary())
        c.beginPath()
        c.arc(cx, cy, r, 0.0, 2.0 * pi)
        c.closePath()
        c.fill()
        c.setFill(colorCard())
        c.beginPath()
        c.arc(cx, cy, r * 62 / 100, 0.0, 2.0 * pi)
        c.closePath()
        c.fill()
        return c
    }
    var halfGap = 0.0
    if (nonZero > 1) {
        halfGap = 0.015
    }
    var start = 0.0 - pi / 2.0
    var i = 0
    for (var b in buckets) {
        val span = 2.0 * pi * b.percentage / total
        val end = start + span
        if (b.percentage > 0) {
            var col = sliceColor(i)
            if (selectedSlice >= 0 && selectedSlice != i) {
                col = dimSliceColor(col)
            }
            var sx = cx
            var sy = cy
            var sr = r
            if (selectedSlice == i) {
                val mid = (start + end) / 2.0
                sx = cx + (math.roundTo(pop * math.cos(mid), 0) as Int)
                sy = cy + (math.roundTo(pop * math.sin(mid), 0) as Int)
                sr = rSel
            }
            c.setFill(col)
            c.beginPath()
            c.moveTo(sx, sy)
            c.arc(sx, sy, sr, start + halfGap, end - halfGap)
            c.closePath()
            c.fill()
        }
        start = end
        i = i + 1
    }
    c.setFill(colorCard())
    c.beginPath()
    c.arc(cx, cy, r * 62 / 100, 0.0, 2.0 * pi)
    c.closePath()
    c.fill()
    return c
}

View donutCenterOverlay(DashboardResponse d, Int selectedSlice) {
    var items: List<View> = listOf()
    if (selectedSlice >= 0 && selectedSlice < d.buckets.size) {
        val sb = d.buckets.get(selectedSlice)
        items.add(idLabel(String.valueOf(sb.percentage) + "%", "donut-center-pct", donutPctCss(selectedSlice)))
        items.add(idLabel(sb.name, "donut-center-name", donutCenterTitleCss()))
        items.add(idLabel(brlShort(brl(sb.plannedAmount)), "donut-center-value", donutCenterSubCss()))
    } else {
        items.add(idLabel(modelFriendlyName(d.budgetModel), "donut-center-name", donutCenterModelCss()))
        items.add(idLabel(brlShort(brl(d.salary)), "donut-center-value", donutCenterSubCss()))
    }
    var overlay = Column(items)
    overlay.setId("donut-center")
    overlay.setStyle(donutCenterCss())
    return overlay
}

View legendItem(Window w, BucketBalanceDTO b, Int i, Int selectedSlice) {
    var dot = View(screenStyle())
    dot.setStyle(sliceDotCss(i))
    var nameStyle = legendNameCss()
    if (selectedSlice == i) {
        nameStyle = legendNameSelCss()
    }
    var left = Row(listOf(dot, idLabel(b.name, "legend-" + i + "-name", nameStyle)))
    left.setStyle(legendLeftCss())
    var top = Row(listOf(left, idLabel(brlShort(brl(b.plannedAmount)), "legend-" + i + "-value", legendValCss())))
    top.setStyle(rowBetweenCss())

    var p = b.percentage
    if (p > 100) { p = 100 }
    if (p < 0) { p = 0 }
    var fill = View(screenStyle())
    fill.setStyle(sliceBarCss(i))
    fill.setFlexBasis(p * 100)
    var rest = View(screenStyle())
    rest.setStyle(sliceRestCss())
    rest.setFlexBasis((100 - p) * 100)
    var parts = Row(listOf(fill, rest))
    parts.setStyle(sliceRowCss())
    var track = View(screenStyle())
    track.setStyle(sliceTrackCss())
    track.bind(parts)

    var item = View(screenStyle())
    item.setId("legend-" + i)
    if (selectedSlice == i) {
        item.setStyle(legendItemSelCss())
    } else if (selectedSlice >= 0) {
        item.setStyle(legendItemDimCss())
    } else {
        item.setStyle(legendItemCss())
    }
    var bot = Row(listOf(
        idLabel(brl(b.spentAmount) + " gastos", "legend-" + i + "-spent", tileSubCss()),
        idLabel(brl(b.remainingAmount) + " restantes", "legend-" + i + "-rem", tileSubCss())))
    bot.setStyle(rowBetweenCss())
    item.bind(Column(listOf(top, track, bot)))
    item.on("click", () -> toggleSlice(w, i))
    return item
}

Style barFillStyle(Int i) {
    if (i == 0) { return barPillarAccentCss() }
    if (i == 1) { return barPillarDesCss() }
    if (i == 2) { return barPillarSuccessCss() }
    return barPillarWarningCss()
}

View verticalBarPillar(BucketBalanceDTO b, Int i) {
    var p = b.percentage
    if (p > 100) { p = 100 }
    if (p < 5) { p = 5 }

    var rest = View(screenStyle())
    rest.setStyle(barSpacerCss())
    rest.setFlexBasis((100 - p) * 10)

    var fill = View(screenStyle())
    fill.setStyle(barFillStyle(i))
    fill.setFlexBasis(p * 10)

    var col = Column(listOf(rest, fill))
    col.setId("bar-col-" + i)
    col.setStyle(barColCss())
    return col
}

View verticalBarLabel(BucketBalanceDTO b, Int i) {
    var valLabel = idLabel(brlShort(brl(b.plannedAmount)), "bar-val-" + i, barValLabelCss())
    var name = idLabel(b.name, "bar-name-" + i, barNameLabelCss())
    var pct = idLabel(String.valueOf(b.percentage) + "%", "bar-pct-" + i, barPctLabelCss())
    var col = Column(listOf(valLabel, name, pct))
    col.setStyle(Style("display: flex; flex-direction: column; align-items: center; width: 72; flex-shrink: 0; gap: 2"))
    return col
}

Style distExplainBoxCss()       = themed(Style("display: flex; flex-direction: column; gap: 6; width: 100%; padding-top: 12; border-top: 1px solid rgba(0,0,0,.06); box-sizing: border-box"), Style("display: flex; flex-direction: column; gap: 6; width: 100%; padding-top: 12; border-top: 1px solid rgba(255,255,255,.06); box-sizing: border-box"))
Style distExplainLineCss()      = themed(Style("color: #6B7280; font-size: 0.8125rem; line-height: 1.45em; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"), Style("color: #7B8EAD; font-size: 0.8125rem; line-height: 1.45em; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"))

String bucketExplanation(String bucketName) {
    if (bucketName == "Necessidades") {
        return "Necessidades: tudo o que mantém seu mês funcionando — moradia, mercado, contas e transporte."
    }
    if (bucketName == "Folga") {
        return "Folga: seu espaço para aproveitar o hoje e cobrir pequenos imprevistos sem culpa."
    }
    if (bucketName == "Poupança") {
        return "Poupança: a parte que você guarda primeiro para dar fôlego à sua reserva e aos seus planos."
    }
    if (bucketName == "Desejos") {
        return "Desejos: seu espaço para aproveitar o hoje com lazer, compras e mimos sem culpa."
    }
    if (bucketName == "Futuro") {
        return "Futuro: a parte que você guarda primeiro para dar fôlego à sua reserva e aos seus planos."
    }
    if (bucketName == "Pessoal") {
        return "Pessoal: um espaço mínimo para você respirar no dia a dia enquanto coloca as contas em ordem."
    }
    if (bucketName == "Quitação de Dívida") {
        return "Quitação de Dívida: a fatia separada para reduzir seus débitos com prioridade até sair do vermelho."
    }
    if (bucketName == "Viver") {
        return "Viver: tudo o que mantém seu mês funcionando — contas essenciais e gastos do dia a dia."
    }
    if (bucketName == "Guardar") {
        return "Guardar: a parte que você guarda primeiro para dar fôlego à sua reserva e aos seus planos."
    }
    if (bucketName == "Essencial") {
        return "Essencial: tudo o que mantém seu mês funcionando — moradia, mercado, contas e saúde."
    }
    if (bucketName == "Lazer") {
        return "Lazer: seu espaço para aproveitar o hoje com passeios e momentos leves sem culpa."
    }
    if (bucketName == "Cultura") {
        return "Cultura: livros, cursos e experiências que ampliam seu repertório dentro do orçamento."
    }
    if (bucketName == "Extras") {
        return "Extras: aquela margem para presentes, celebrações e pequenos imprevistos do mês."
    }
    return bucketName + ": parte do seu orçamento reservada para manter esse pilar em equilíbrio."
}

View distributionExplanation(DashboardResponse d) {
    var lines: List<View> = listOf()
    var i = 0
    for (var b in d.buckets) {
        lines.add(idLabel(bucketExplanation(b.name), "dist-explain-" + i, distExplainLineCss()))
        i = i + 1
    }
    if (i == 0) {
        lines.add(idLabel(bucketExplanation("Necessidades"), "dist-explain-0", distExplainLineCss()))
        lines.add(idLabel(bucketExplanation("Folga"), "dist-explain-1", distExplainLineCss()))
        lines.add(idLabel(bucketExplanation("Poupança"), "dist-explain-2", distExplainLineCss()))
    }
    var box = Column(lines)
    box.setId("dist-explain")
    box.setStyle(distExplainBoxCss())
    return box
}

// Gráfico em barras verticais do Modelo de Economia fiel à referência
View distributionCard(Window w, DashboardResponse d) {
    var pillars: List<View> = listOf()
    var labels: List<View> = listOf()
    var i = 0
    for (var b in d.buckets) {
        pillars.add(verticalBarPillar(b, i))
        labels.add(verticalBarLabel(b, i))
        i = i + 1
    }
    if (i == 0) {
        pillars.add(idLabel("Sem divisões fixas neste modelo.", "legend-empty", tileSubCss()))
    }

    var chartGrid = Row(pillars)
    chartGrid.setId("bar-chart-grid")
    chartGrid.setStyle(barChartGridCss())

    var labelsRow = Row(labels)
    labelsRow.setId("bar-labels-row")
    labelsRow.setStyle(barNamesRowCss())

    var chartWrap = Column(listOf(chartGrid, labelsRow))
    chartWrap.setId("dash-bars")
    chartWrap.setStyle(barChartContainerCss())

    var explain = distributionExplanation(d)

    var titleCss = cardTitleMobileCss()
    var cardCss = dashCardMobileCss()
    if (AppState.isDesktop) {
        titleCss = cardTitleCss()
        cardCss = dashCardCss()
    }
    var heading = Column(listOf(
        idLabel("Prévia do Modelo de Economia", "dist-title", titleCss),
        idLabel(modelFriendlyName(d.budgetModel), "dist-model", distributionModelCss())))
    heading.setStyle(distributionHeadingCss())
    var card = Column(listOf(heading, chartWrap, explain))
    card.setId("card-distribution")
    card.setStyle(cardCss)
    return card
}

Style yearCategoryBarFullCss() = Style("height: 10; width: 100%; border-radius: 5; background: linear-gradient(90deg, #00D4FF, #0066FF)")
Style yearCategoryBar75Css() = Style("height: 10; width: 75%; border-radius: 5; background: linear-gradient(90deg, #00D4FF, #0066FF)")
Style yearCategoryBar50Css() = Style("height: 10; width: 50%; border-radius: 5; background: linear-gradient(90deg, #00D4FF, #0066FF)")
Style yearCategoryBar25Css() = Style("height: 10; width: 25%; border-radius: 5; background: linear-gradient(90deg, #00D4FF, #0066FF)")
Style yearCategoryBarSmallCss() = Style("height: 10; width: 10%; min-width: 2; border-radius: 5; background: linear-gradient(90deg, #00D4FF, #0066FF)")

// Gráfico anual por categoria, usado como opção de visualização no cabeçalho Ano.
View yearCategoryChart(DashboardResponse d) {
    var rows: List<View> = listOf()
    var maxPct = 0.0
    for (var item in d.categories) {
        if (item.percentage > maxPct) { maxPct = item.percentage }
    }
    var i = 0
    for (var item in d.categories) {
        if (i < 8) {
            var pct = 0.0
            if (maxPct > 0.0) { pct = item.percentage * 100.0 / maxPct }
            var bar = View(screenStyle())
            if (pct >= 87.5) {
                bar.setStyle(yearCategoryBarFullCss())
            } else if (pct >= 62.5) {
                bar.setStyle(yearCategoryBar75Css())
            } else if (pct >= 37.5) {
                bar.setStyle(yearCategoryBar50Css())
            } else if (pct >= 17.5) {
                bar.setStyle(yearCategoryBar25Css())
            } else {
                bar.setStyle(yearCategoryBarSmallCss())
            }
            var track = Row(listOf(bar))
            track.setStyle(Style("height: 10; width: 100%; border-radius: 5; background: rgba(255,255,255,.08); overflow: hidden"))
            var details = Column(listOf(
                idLabel(item.category, "year-category-name-" + i, txNameCss()),
                track))
            details.setStyle(Style("display: flex; flex-direction: column; flex: 1 1 auto; gap: 6; min-width: 0"))
            var row = Row(listOf(details, idLabel(brl(item.total), "year-category-value-" + i, txValueCss())))
            row.setId("year-category-" + i)
            row.setStyle(Style("display: flex; flex-direction: row; align-items: center; gap: 14; width: 100%; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,.06)"))
            rows.add(row)
        }
        i = i + 1
    }
    if (rows.size == 0) {
        rows.add(idLabel("Ainda não há gastos confirmados para comparar neste período.", "year-category-empty", tileSubCss()))
    }
    var titleCss = cardTitleMobileCss()
    var cardCss = dashCardMobileCss()
    if (AppState.isDesktop) {
        titleCss = cardTitleCss()
        cardCss = dashCardCss()
    }
    var card = Column(listOf(
        idLabel("Gastos por categoria", "year-category-title", titleCss),
        Column(rows)))
    card.setId("year-category-chart")
    card.setStyle(cardCss)
    return card
}

Canvas dotCanvas(Color color) {
    var c = Canvas(32, 32)
    c.setFill(color)
    c.beginPath()
    c.arc(16, 16, 16, 0.0, 6.2831853)
    c.closePath()
    c.fill()
    return c
}

View onboardingBucketPreviewRow(BucketBalanceDTO b, Int i, Bool isLast) {
    var dot = View(screenStyle())
    dot.setStyle(canvasZoomCss())
    dot.bind(dotCanvas(sliceColor(i)))
    var text = Column(listOf(
        idLabel(b.name + " (" + String.valueOf(b.percentage) + "% do salário)", "tx-" + i + "-name", txNameCss()),
        idLabel("Ritmo sugerido: " + brl(math.roundTo(b.plannedAmount / 30.0, 2)) + "/dia", "tx-" + i + "-cat", txCatCss())))
    text.setStyle(txTextCss())
    var row = Row(listOf(dot, text, idLabel(brl(b.plannedAmount), "tx-" + i + "-value", txValueCss())))
    row.setId("tx-" + i)
    if (isLast) {
        row.setStyle(txRowLastCss())
    } else {
        row.setStyle(txRowCss())
    }
    return row
}

View transactionsCard(DashboardResponse d) {
    var titleCss = cardTitleMobileCss()
    var cardCss = dashCardMobileCss()
    if (AppState.isDesktop) {
        titleCss = cardTitleCss()
        cardCss = dashCardCss()
    }
    var rows: List<View> = listOf()
    val total = d.buckets.size
    var i = 0
    for (var b in d.buckets) {
        rows.add(onboardingBucketPreviewRow(b, i, i == total - 1))
        i = i + 1
    }
    if (i == 0) {
        rows.add(idLabel("Complete a configuração inicial para visualizar a prévia do seu orçamento.", "tx-empty", tileSubCss()))
    }
    var list = Column(rows)
    list.setStyle(txListCss())
    var noteBox = Column(listOf(
        idLabel("Este painel é uma prévia fixa do seu planejamento inicial. Seus gastos reais e faturas ficam organizados nas suas Caixinhas editáveis.", "tx-onboarding-note", distExplainLineCss())))
    noteBox.setStyle(distExplainBoxCss())
    var card = Column(listOf(idLabel("Resumo do seu Planejamento", "tx-title", titleCss), list, noteBox))
    card.setId("card-transactions")
    card.setStyle(cardCss)
    return card
}

// Mês: "Novembro 2026"; Semana: mês-ano do início da semana; Ano: "2026".
String dashSubtitle(DashboardResponse? d) {
    if (d == null) {
        return "Prévia do Planejamento"
    }
    if (d.from.length < 7) {
        return "Prévia do Planejamento"
    }
    if (DashState.period == "year") {
        return "Prévia do Planejamento · " + d.from.substring(0, 4)
    }
    return "Prévia do Planejamento · " + monthYearFromIso(d.from)
}

// ---------------------------------------------------------------- tela

View dashboardScreen(Window w) {
    if (DashState.fresh && DashState.loaded) {
        DashState.fresh = false
    } else {
        DashState.fresh = false
        startLoad(w)
    }
    var d = dashboardData()
    var items: List<View> = listOf()
    // Personalizar gráficos só no Mês (aba padrão); Semana e Ano têm conteúdo fixo.
    var headerAction = periodTabs(w)
    if (DashState.period == "month") {
        headerAction = chartPreferenceAction(w)
    }
    items.add(topbar("Dashboard", dashSubtitle(d), headerAction))
    if (AppState.loadError != "") {
        items.add(idLabel(AppState.loadError, "dash-error", errorBannerCss()))
        var retry = Button("Tentar de novo", () -> retryDashboard(w))
        retry.setId("dash-retry")
        retry.setStyle(retryCss())
        items.add(retry)
    } else if (d == null) {
        items.add(idLabel("Carregando…", "dash-loading", captionCss()))
    } else {
        if (DashState.period != "year") {
            items.add(tiles(d))
        }
        if (DashState.period == "week") {
            items.add(spendingCalendar(d))
        } else if (DashState.period == "year") {
            for (var v in yearSections(w)) {
                items.add(v)
            }
        } else {
            var cardsToShow: List<View> = listOf()
            if (DashState.showBudgetChart) {
                cardsToShow.add(distributionCard(w, d))
            }
            if (DashState.showCategoryChart && (DashState.period == "year" || d.categories.size > 0)) {
                cardsToShow.add(yearCategoryChart(d))
            }
            if (DashState.period == "month" && DashState.showSummaryCard) {
                cardsToShow.add(transactionsCard(d))
            }
            if (cardsToShow.size == 0) {
                cardsToShow.add(idLabel("Nenhum gráfico selecionado. Use Personalizar gráficos no cabeçalho para escolher o que exibir.", "dash-no-charts", captionCss()))
            }
            if (AppState.isDesktop) {
                var cards = Row(cardsToShow)
                cards.setId("dash-cards")
                cards.setStyle(dashGridG2Css())
                items.add(cards)
            } else {
                var cards = Column(cardsToShow)
                cards.setId("dash-cards")
                cards.setStyle(dashMobileStackCss())
                items.add(cards)
            }
        }
    }
    var col = Column(items)
    col.setId("screen-dashboard")
    if (AppState.isDesktop) {
        col.setStyle(dashScreenDesktopCss())
    } else {
        col.setStyle(stackCss())
    }
    return col
}
