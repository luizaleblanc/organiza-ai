Style distBodyMobileCss()     = Style("display: flex; flex-direction: column; align-items: center; gap: 14; width: 100%")
Style donutOuterCss() {
    if (AppState.isDesktop) {
        return Style("outline: none; position: relative; width: 192; height: 192; flex-shrink: 0; padding: 0; background: transparent; cursor: pointer")
    }
    return Style("outline: none; position: relative; width: 144; height: 144; flex-shrink: 0; padding: 0; background: transparent; cursor: pointer")
}
Style canvasZoomCss() {
    if (AppState.isDesktop) {
        return Style("padding: 0; background: transparent; line-height: 0em; zoom: 0.333333")
    }
    return Style("padding: 0; background: transparent; line-height: 0em; zoom: 0.25")
}
