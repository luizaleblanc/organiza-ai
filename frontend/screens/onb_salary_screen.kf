package screens

import kof.ui
import core.theme
import core.app_state
import core.format
import core.navigation
import components.form_widgets

// =============================================================================
// Tela 4 — Salário (Etapa 1 de 5)
// =============================================================================
// Dots (0 de 5), título, subtítulo, bigMoneyAmount ("R$" + bigMoneyField 52/700
// com máscara de milhar), moneyHint e botão "Próximo".
// =============================================================================

Style salaryMoneyBlockCss() = Style("display: flex; flex-direction: column; align-items: center; gap: 0; width: 100%")

View onbSalaryScreen(Window w) {
    var title = onbTitle("Quanto você ganha por mês?", "onb-title")
    var subtitle = onbSubtitle("Vamos adaptar tudo ao seu salário", "onb-subtitle")

    var field = bigMoneyField(OnboardingState.salary, "salary-input")
    var amount = bigMoneyAmount(field, "salary-amount")
    var hint = moneyHint("O valor pode ser aproximado. Você pode ajustar o valor em \"configurações\".")
    var moneyCol = Column(listOf(amount, hint))
    moneyCol.setStyle(salaryMoneyBlockCss())
    var moneyBlock = View(screenStyle())
    moneyBlock.setStyle(blockCss())
    moneyBlock.bind(moneyCol)

    var next = primaryButton("Próximo", "btn-next", false, () -> submitSalary(w, field.text()))

    var items = listOf(dotsBlock(0), titleBlock(title, subtitle), moneyBlock)
    if (AppState.formError != "") {
        items.add(errorBlock(AppState.formError))
    }
    items.add(onbCtaBlock(next))
    return onbBody(items, onbColumn500Css())
}

submitSalary(Window w, String raw) {
    OnboardingState.salary = raw.trim()
    try {
        parseMoney(OnboardingState.salary)
    } catch (String e) {
        AppState.formError = "Digite um valor entre R$ 1 e R$ 1.000.000."
        mountScreen(w)
        return
    }
    AppState.formError = ""
    navigateTo(w, "onb_income")
}
