package screens.welcome

import kof.ui
import core.theme
import core.router_config

// =============================================================================
// Tela 1 — Boas-vindas (pré-login)
// DESIGN_SYSTEM.md seção 1.1, 1.2, 5 (Tela 1)
// =============================================================================
// - Ponto de entrada do app antes de qualquer autenticação
// - Marca hero (3 ondas SVG, 230px, proporção 2:1) centralizada
// - Slogan "SUA GRANA ORGANIZADA E SEM ESTRESSE." (14px/400/textSecondary, uppercase)
// - Rodapé: botão primário "Criar conta" + secundário "Já tenho conta" (gap 12px)
// - Ações: "Criar conta" -> Routes.register | "Já tenho conta" -> Routes.login
// =============================================================================

// Marca — 3 ondas horizontais com opacidade decrescente (1.0 / 0.70 / 0.45)
// DESIGN_SYSTEM.md seção 1.1 e 1.2 (proporção 2:1, largura 230px)
View buildBrandHero() {
    var wave1 = View(Style(AppTheme.accent, AppTheme.accent, 0, 2))
    var wave2 = View(Style(Color.rgba(0, 212, 255, 0.70), Color.rgba(0, 212, 255, 0.70), 0, 2))
    var wave3 = View(Style(Color.rgba(0, 212, 255, 0.45), Color.rgba(0, 212, 255, 0.45), 0, 2))

    var wavesCol = Column(listOf(wave1, wave2, wave3))
    var brandContainer = View(Style(Color.rgba(0, 0, 0, 0), AppTheme.accent, 8, 0))
    brandContainer.bind(wavesCol)
    return brandContainer
}

Component buildWelcomeScreen() {
    var c = Component("initial")

    c.view((state) -> {
        // Marca centralizada (230px hero)
        var brand = buildBrandHero()

        // Slogan: 14px / peso 400 / textSecondary (DESIGN_SYSTEM.md seção 1.2)
        var slogan = Label("SUA GRANA ORGANIZADA E SEM ESTRESSE.")
        slogan.fontSize = 14
        slogan.bold = false
        slogan.color = AppTheme.textSecondary

        var heroSection = Column(listOf(brand, slogan))

        // Botões de ação no rodapé (DESIGN_SYSTEM.md seção 3.1 e 5)
        var btnRegister = Button("Criar conta", () -> {
            Router.go(Routes.register)
        })

        var btnLogin = Button("Já tenho conta", () -> {
            Router.go(Routes.login)
        })

        var footerSection = Column(listOf(btnRegister, btnLogin))

        // Montagem da tela completa
        var content = Column(listOf(heroSection, footerSection))

        var screenView = View(screenStyle())
        screenView.bind(content)
        return screenView
    })

    c.onMount(() -> {
        // Lifecycle hook: montagem da tela de boas-vindas
    })

    c.onDispose(() -> {
        // Lifecycle hook: limpeza de recursos da tela
    })

    return c
}
