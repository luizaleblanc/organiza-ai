package screens

import kof.ui
import core.theme
import core.app_state
import core.navigation

// =============================================================================
// onboardingScreen
// =============================================================================
// Segunda etapa do fluxo real: coleta o contexto de renda e mostra um estado
// inicial vazio até que o onboarding real venha do backend. O objetivo é manter
// o fluxo estável sem carregar dados simulados ou pessoais no código.
// =============================================================================

View onboardingScreen(Window w) {
    var title = Label("Vamos organizar sua renda")
    title.fontSize = sizeTitle()
    title.bold = true
    title.color = colorTextPrimary()

    var subtitle = Label("Em poucos passos, vamos decidir como separar seu dinheiro com mais clareza.")
    subtitle.fontSize = sizeBody()
    subtitle.color = colorTextSecondary()

    var salaryTitle = Label("Salário mensal")
    salaryTitle.fontSize = sizeCaption()
    salaryTitle.color = colorTextMuted()

    var salaryValue = Label("R$ " + OnboardingState.salary)
    salaryValue.fontSize = sizeMoney()
    salaryValue.bold = true
    salaryValue.color = colorAccent()

    var incomeType = Label("Tipo principal de renda: " + OnboardingState.incomeType)
    incomeType.fontSize = sizeBody()
    incomeType.color = colorTextSecondary()

    var recommendedModel = Label("Modelo sugerido: " + OnboardingState.suggestedModel)
    recommendedModel.fontSize = sizeBody()
    recommendedModel.color = colorSuccess()

    var modelDescription = Label(OnboardingState.modelDescription)
    modelDescription.fontSize = sizeCaption()
    modelDescription.color = colorTextSecondary()

    var continueAction = Button("Continuar", () -> {
        DashboardState.budgetModel = OnboardingState.suggestedModel
        navigateTo(w, "dashboard")
    })

    var summaryCard = View(cardStyle())
    summaryCard.bind(Column(listOf(salaryTitle, salaryValue, incomeType, recommendedModel, modelDescription)))

    var content = Column(listOf(title, subtitle, summaryCard, continueAction))
    var view = View(screenStyle())
    view.bind(content)
    return view
}
