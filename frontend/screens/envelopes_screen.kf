Style envChoiceSelectedCss() = Style("color: #00D4FF; height: 48; width: 100%; box-sizing: border-box; border-radius: 12; padding: 0 12px; background: rgba(0,212,255,.08); border: 1px solid #00D4FF; font-size: 14; font-weight: 600; text-align: left; cursor: pointer")
