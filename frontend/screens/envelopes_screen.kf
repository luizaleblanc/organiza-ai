package screens

import kof.ui
import core.theme
import core.app_state
import core.format
import core.navigation
import core.envelopes_api
import components.topbar
import components.form_widgets

// =============================================================================
// Tela 11 Caixinhas (Batch 3, F3; spec b3 S11)
// =============================================================================
// GET /api/envelopes/overview agrupado por `bucket` (Necessidades/Desejos/
// Futuro no 50/30/20; outros modelos usam os nomes do próprio modelo). Bucket
// nulo cai em "Outras" (DECISÃO-8 provisória). Badge e tom vêm de format.kf.
// "+ Nova caixinha" abre o formulário definitivo (DECISÃO-9): modal centrado
// no Desktop e sheet de baixo no Mobile (mesmo padrão do "Rever meu salário").
// Categoria = Select com rótulos em PT (setSelected guarda a escolha no
// re-render), limite = parseMoney, grupo = cards de escolha com os buckets
// reais do modelo (GET /api/budgets/balance) -> POST /api/envelopes.
// "Excluir" pede confirmação no próprio card -> DELETE /api/envelopes/:id.
// =============================================================================

String bucketOf(EnvelopeItem e) {
    val b = e.bucket()
    if (b != null) {
        if (b != "") {
            return b
        }
    }
    return "Outras"
}

// Ordem dos grupos: os 3 do 50/30/20 primeiro, depois os demais na ordem em que aparecem.
List<String> bucketOrder(List<EnvelopeItem> items) {
    var seen: List<String> = listOf()
    for (var name in listOf("Necessidades", "Desejos", "Futuro")) {
        if (items.any((e: EnvelopeItem) -> bucketOf(e) == name)) {
            seen.add(name)
        }
    }
    for (var e in items) {
        if (!seen.contains(bucketOf(e))) {
            seen.add(bucketOf(e))
        }
    }
    return seen
}

List<String> categoryCodes() = listOf("HOUSING", "GROCERIES", "TRANSPORT", "FOOD", "SUBSCRIPTIONS", "LEISURE", "HEALTH", "PHARMA", "AUTO", "EDUCATION", "SHOPPING", "OTHER")

Style envBadgeCss(String tone) {
    if (tone == "danger") { return badgeDangerCss() }
    if (tone == "warning") { return badgeWarningCss() }
    return badgeSuccessCss()
}

Style envValueCss(String tone) {
    if (tone == "danger") { return envValueDangerCss() }
    if (tone == "warning") { return envValueWarningCss() }
    return envValueSuccessCss()
}

Style envFillCss(String tone) {
    if (tone == "danger") { return progressFillDangerCss() }
    if (tone == "warning") { return progressFillWarningCss() }
    return progressFillSuccessCss()
}

// Mesma técnica de bucketBar (form_widgets): fill + resto com flex-basis, teto 100%.
View envBar(Int pct, String tone, String id) {
    var p = pct
    if (p > 100) { p = 100 }
    if (p < 0) { p = 0 }
    var fill = View(screenStyle())
    fill.setStyle(envFillCss(tone))
    fill.setFlexBasis(p * 100)
    var rest = View(screenStyle())
    rest.setStyle(fillRestCss())
    rest.setFlexBasis((100 - p) * 100)
    var parts = Row(listOf(fill, rest))
    parts.setStyle(fillRowCss())
    var track = View(screenStyle())
    track.setId(id)
    track.setStyle(progressTrackCss())
    track.bind(parts)
    return track
}

View envelopeCard(Window w, EnvelopeItem e) {
    val tone = envelopeStatusTone(e.status())
    var name = Label(categoryLabel(e.categoryName()))
    name.setId("env-name-" + e.id())
    name.setStyle(envNameCss())
    var badge = Label(envelopeStatusLabel(e.status()))
    badge.setId("env-badge-" + e.id())
    badge.setStyle(envBadgeCss(tone))
    var head = Row(listOf(name, badge))
    head.setStyle(envHeadCss())
    var value = Label(brl(e.spentThisMonth()))
    value.setStyle(envValueCss(tone))
    var legend = Label(String.valueOf(e.percent()) + "% · " + brl(e.spentThisMonth()) + "/" + brl(e.limitAmount()))
    legend.setId("env-legend-" + e.id())
    legend.setStyle(captionCss())
    val id = e.id()
    var del: View = View(screenStyle())
    if (EnvState.confirmDelete == id) {
        var ask = Label("Excluir esta caixinha?")
        ask.setStyle(envConfirmTextCss())
        var yes = Button("Sim, excluir", () -> {
            spawn {
                removeEnvelope(w, id)
            }
        })
        yes.setId("env-delete-yes-" + id)
        yes.setStyle(envDangerButtonCss())
        var keep = Button("Manter", () -> {
            EnvState.confirmDelete = ""
            mountScreen(w)
        })
        keep.setId("env-delete-no-" + id)
        keep.setStyle(envGhostButtonCss())
        var confirm = Row(listOf(ask, keep, yes))
        confirm.setId("env-confirm-" + id)
        confirm.setStyle(envConfirmRowCss())
        del = confirm
    } else {
        var ask = Button("Excluir", () -> {
            EnvState.confirmDelete = id
            mountScreen(w)
        })
        ask.setId("env-delete-" + id)
        ask.setStyle(envDeleteCss())
        del = ask
    }
    var col = Column(listOf(head, value, envBar(e.percent(), tone, "env-bar-" + id), legend, del))
    col.setId("env-card-" + id)
    col.setStyle(cardCss())
    return col
}

View envelopeGroup(Window w, String bucket, List<EnvelopeItem> items) {
    var title = Label(bucket)
    title.setStyle(envGroupTitleCss())
    var cards: List<View> = listOf()
    for (var e in items) {
        if (bucketOf(e) == bucket) {
            cards.add(envelopeCard(w, e))
        }
    }
    var grid = Column(cards)
    if (AppState.isDesktop) {
        grid.setStyle(gridG3Css())
    } else {
        grid.setStyle(stackCss())
    }
    var group = Column(listOf(title, grid))
    group.setId("env-group-" + bucket)
    group.setStyle(stackCss())
    return group
}

removeEnvelope(Window w, String id) {
    if (EnvState.busy) {
        return
    }
    EnvState.busy = true
    try {
        deleteEnvelope(id)
        EnvState.formError = ""
    } catch (String e) {
        EnvState.formError = e
    }
    EnvState.confirmDelete = ""
    loadEnvelopes()
    EnvState.busy = false
    mountScreen(w)
}

// Guarda o que está nos campos antes de qualquer re-render do modal.
keepNewEnvelopeInput(Select category, Input limit) {
    EnvState.newCategoryIdx = category.selected()
    EnvState.newLimit = limit.text()
}

// Validação local primeiro; só chama o backend com limite > 0 e grupo escolhido.
submitNewEnvelope(Window w, Select category, Input limit) {
    if (EnvState.busy) {
        return
    }
    keepNewEnvelopeInput(category, limit)
    var amount = 0.0
    try {
        amount = parseMoney(EnvState.newLimit)
    } catch (String e) {
        EnvState.formError = "Informe um limite válido, por exemplo 300 ou 1.200,50."
        mountScreen(w)
        return
    }
    if (amount <= 0.0) {
        EnvState.formError = "O limite precisa ser maior que zero."
        mountScreen(w)
        return
    }
    if (EnvState.newBucket == "") {
        EnvState.formError = "Escolha o grupo da caixinha."
        mountScreen(w)
        return
    }
    EnvState.busy = true
    try {
        createEnvelope(categoryCodes().get(EnvState.newCategoryIdx), amount, EnvState.newBucket)
        EnvState.showNew = false
        resetNewEnvelopeForm()
        loadEnvelopes()
    } catch (String e) {
        EnvState.formError = e
    }
    EnvState.busy = false
    mountScreen(w)
}

// Grupos do modal: buckets do modelo; sem eles, os grupos que já aparecem na tela.
List<String> bucketChoices(List<String> groups) {
    if (EnvState.buckets.size() > 0) {
        return EnvState.buckets
    }
    var out: List<String> = listOf()
    for (var g in groups) {
        if (g != "Outras") {
            out.add(g)
        }
    }
    return out
}

Label envFieldLabel(String text) {
    var l = Label(text)
    l.setStyle(envFieldLabelCss())
    return l
}

// Modal "Nova caixinha" (DECISÃO-9): centrado no Desktop, sheet no Mobile.
View newEnvelopeModal(Window w, List<String> groups) {
    var title = Label("Nova caixinha")
    title.setStyle(envModalTitleCss())
    var sub = Label("Defina quanto pode sair por mês e em qual grupo do seu modelo ela entra.")
    sub.setStyle(envModalSubCss())
    var labels: List<String> = listOf()
    for (var c in categoryCodes()) {
        labels.add(categoryLabel(c))
    }
    var category = Select(labels)
    category.setId("env-new-category")
    category.setStyle(envSelectCss())
    category.setSelected(EnvState.newCategoryIdx)
    var limit = moneyFieldWith(EnvState.newLimit, "0,00", "env-new-limit")
    limit.setStyle(envInputCss())
    var choices: List<View> = listOf()
    for (var g in bucketChoices(groups)) {
        val name = g
        var card = choiceCard(name, "env-new-bucket-" + name, EnvState.newBucket == name, () -> {
            keepNewEnvelopeInput(category, limit)
            EnvState.newBucket = name
            mountScreen(w)
        })
        if (EnvState.newBucket == name) {
            card.setStyle(envChoiceSelectedCss())
        } else {
            card.setStyle(envChoiceCss())
        }
        choices.add(card)
    }
    var bucketList = Column(choices)
    bucketList.setId("env-new-buckets")
    if (AppState.isDesktop) {
        bucketList.setStyle(envChoiceRowCss())
    } else {
        bucketList.setStyle(envChoiceColCss())
    }
    var items: List<View> = listOf()
    items.add(title)
    items.add(sub)
    items.add(envFieldLabel("Categoria"))
    items.add(category)
    items.add(envFieldLabel("Limite por mês (R$)"))
    items.add(limit)
    items.add(envFieldLabel("Grupo"))
    items.add(bucketList)
    if (EnvState.formError != "") {
        var err = errorBanner(EnvState.formError)
        err.setId("env-new-error")
        items.add(err)
    }
    var cancel = Button("Cancelar", () -> {
        EnvState.showNew = false
        resetNewEnvelopeForm()
        mountScreen(w)
    })
    cancel.setId("env-new-cancel")
    var save = Button("Salvar caixinha", () -> {
        spawn {
            submitNewEnvelope(w, category, limit)
        }
    })
    save.setId("env-new-save")
    var actions: View = View(screenStyle())
    if (AppState.isDesktop) {
        cancel.setStyle(envGhostButtonCss())
        save.setStyle(envPrimaryButtonCss())
        var row = Row(listOf(cancel, save))
        row.setStyle(envModalActionsCss())
        actions = row
    } else {
        cancel.setStyle(envGhostWideCss())
        save.setStyle(envPrimaryWideCss())
        var col = Column(listOf(save, cancel))
        col.setStyle(envChoiceColCss())
        actions = col
    }
    items.add(actions)
    var box = Column(items)
    box.setId("env-new-form")
    var overlay = View(screenStyle())
    overlay.setId("env-new-modal")
    if (AppState.isDesktop) {
        box.setStyle(envModalBoxCss())
        overlay.setStyle(envModalOverlayCss())
    } else {
        box.setStyle(envSheetBoxCss())
        overlay.setStyle(envSheetOverlayCss())
    }
    overlay.bind(box)
    return overlay
}

View envelopesScreen(Window w) {
    var newBtn = Button("+ Nova caixinha", () -> {
        resetNewEnvelopeForm()
        EnvState.showNew = true
        EnvState.confirmDelete = ""
        mountScreen(w)
    })
    newBtn.setId("btn-new-envelope")
    newBtn.setStyle(envNewButtonCss())
    var items: List<View> = listOf(topbar("Caixinhas", "", newBtn))

    if (!EnvState.loaded) {
        if (!EnvState.loading) {
            EnvState.loading = true
            spawn {
                loadEnvelopes()
                mountScreen(w)
            }
        }
        var l = Label("Carregando caixinhas...")
        l.setId("env-loading")
        l.setStyle(captionCss())
        items.add(l)
    } else if (EnvState.loadError != "") {
        items.add(errorBanner(EnvState.loadError))
        items.add(secondaryButton("Tentar de novo", "env-retry", false, () -> {
            resetEnvelopes()
            mountScreen(w)
        }))
    } else {
        val list = envelopeItems()
        val groups = bucketOrder(list)
        if (!EnvState.showNew && EnvState.formError != "") {
            items.add(errorBanner(EnvState.formError))
        }
        if (list.size() == 0) {
            var empty = Label("Você ainda não tem caixinhas. Toque em \"+ Nova caixinha\" para criar a primeira.")
            empty.setId("env-empty")
            empty.setStyle(captionCss())
            items.add(empty)
        }
        for (var g in groups) {
            items.add(envelopeGroup(w, g, list))
        }
        if (EnvState.showNew) {
            items.add(newEnvelopeModal(w, groups))
        }
    }

    var col = Column(items)
    col.setId("screen-envelopes")
    col.setStyle(stackCss())
    return col
}

