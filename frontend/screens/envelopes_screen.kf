Style envValueSuccessCss() = Style("color: #00E5A0; font-size: 24; font-weight: 600; margin: 0")
Style envValueWarningCss() = Style("color: #FFB800; font-size: 24; font-weight: 600; margin: 0")
Style envValueDangerCss()  = Style("color: #FF4A6E; font-size: 24; font-weight: 600; margin: 0")
Style envDeleteCss()       = Style("align-self: flex-start; background: transparent; color: #4A5578; border: none; padding: 0; font-size: 12; cursor: pointer")
Style envNewButtonCss()    = Style("background: linear-gradient(90deg, #00D4FF, #0066FF); color: #06121C; height: 40; padding: 0 16px; border: none; border-radius: 12; font-size: 14; font-weight: 600; cursor: pointer; flex-shrink: 0")
