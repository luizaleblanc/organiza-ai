Style envPrimaryWideCss()   = Style("background: linear-gradient(90deg, #00D4FF, #0066FF); color: #06121C; height: 50; width: 100%; border: none; border-radius: 14; font-size: 15; font-weight: 700; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style envModalOverlayCss()  = Style("position: fixed; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,.65); z-index: 50")
Style envSheetOverlayCss()  = Style("position: fixed; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: flex-end; justify-content: center; background: rgba(0,0,0,.72); z-index: 50")
Style envModalBoxCss()      = Style("display: flex; flex-direction: column; gap: 10; width: 90%; max-width: 480; max-height: 90%; overflow-y: auto; padding: 24; box-sizing: border-box; background: #12162A; border: 1px solid rgba(255,255,255,.1); border-radius: 12")
Style envSheetBoxCss()      = Style("display: flex; flex-direction: column; gap: 10; width: 100%; max-height: 92%; overflow-y: auto; padding: 24px 20px 32px; box-sizing: border-box; background: #12162A; border-radius: 20px 20px 0 0")
Style envModalTitleCss()    = Style("color: #F0F0F0; font-size: 17; font-weight: 700; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style envModalSubCss()      = Style("color: #7B8EAD; font-size: 13; margin: 0 0 6px 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style envFieldLabelCss()    = Style("color: #7B8EAD; font-size: 12; font-weight: 600; letter-spacing: 0.04em; margin: 6px 0 0 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style envSelectCss()        = Style("background: rgba(255,255,255,.04); color: #F0F0F0; height: 44; width: 100%; box-sizing: border-box; border: 1px solid rgba(255,255,255,.1); border-radius: 8; padding: 0 12px; font-size: 14; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style envInputCss()         = Style("background: rgba(255,255,255,.04); color: #F0F0F0; height: 44; width: 100%; box-sizing: border-box; border: 1px solid rgba(255,255,255,.1); border-radius: 8; padding: 0 14px; font-size: 14; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style envChoiceRowCss()     = Style("display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8; width: 100%")
Style envChoiceColCss()     = Style("display: flex; flex-direction: column; gap: 10; width: 100%")
Style envChoiceCss()        = Style("color: #F0F0F0; height: 48; width: 100%; box-sizing: border-box; border-radius: 12; padding: 0 12px; background: #12162A; border: 1px solid rgba(255,255,255,.1); font-size: 14; font-weight: 500; text-align: left; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style envChoiceSelectedCss() = Style("color: #00D4FF; height: 48; width: 100%; box-sizing: border-box; border-radius: 12; padding: 0 12px; background: rgba(0,212,255,.08); border: 1px solid #00D4FF; font-size: 14; font-weight: 600; text-align: left; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style envModalActionsCss()  = Style("display: flex; flex-direction: row; justify-content: flex-end; align-items: center; gap: 12; margin-top: 8")
