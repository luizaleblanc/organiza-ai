package screens

import kof.ui
import core.theme
import core.app_state
import components.topbar

// =============================================================================
// Tela 13 Configurações (F5) — stub do shell (Batch 3, T0)
// =============================================================================
// Contrato: settingsScreen(Window w) devolve o corpo da rota "settings" (o shell já põe a
// sidebar/barra inferior). Começa pela topbar com o título exato; a tarefa
// dona da tela substitui o resto do corpo.
// =============================================================================

View settingsScreen(Window w) {
    var col = Column(listOf(topbar("Configurações", "", null)))
    col.setId("screen-settings")
    col.setStyle(stackCss())
    return col
}
