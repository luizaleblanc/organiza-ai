package screens.onboarding

import kof.ui
import core.theme
import core.router_config
import components.progress_dots
import components.choice_card
import screens.onboarding.state

// =============================================================================
// Tela 5 — Onboarding: Tipo de Renda
// DESIGN_SYSTEM.md seção 3.1, 3.7, 3.8, 5 (Tela 5)
// =============================================================================
// - Indicador de progresso: step 1 ativo (1º visitado, 2º ativo, demais inativos)
// - Título: "Sua renda é fixa ou variável?" (24px / 400 / textPrimary)
// - Subtítulo: "Isso muda como calculamos seu dia a dia" (16px / 400 / textSecondary)
// - Duas choice cards:
//     1. "Fixa (CLT, salário todo mês)"
//     2. "Variável (freela, PJ, bicos)"
// - Botão "Próximo": desabilitado até haver uma seleção. Ao clicar, salva o
//   tipo no OnboardingState.incomeType ("FIXED" ou "VARIABLE") e navega
//   para Routes.debt.
// =============================================================================

class IncomeScreenState {
    static String selectedType = ""
}

Component buildIncomeTypeScreen() {
    var c = Component("")

    c.view((ignored: String) -> {
        var dots = buildProgressDots(1, 4)

        var title = Label("Sua renda é fixa ou variável?")
        title.fontSize = 24
        title.bold = false
        title.color = AppTheme.textPrimary

        var subtitle = Label("Isso muda como calculamos seu dia a dia")
        subtitle.fontSize = 16
        subtitle.bold = false
        subtitle.color = AppTheme.textSecondary

        var headerSection = Column(listOf(dots, title, subtitle))

        // Cards de escolha (DESIGN_SYSTEM.md seção 3.7)
        var cardFixed = buildChoiceCard("Fixa (CLT, salário todo mês)", false)
        var cardVariable = buildChoiceCard("Variável (freela, PJ, bicos)", false)

        var nextBtn = Button("Próximo", () -> {
            if (IncomeScreenState.selectedType == "FIXED") {
                OnboardingState.incomeType = "FIXED"
                OnboardingState.currentStep = 2
                Router.go(Routes.debt)
            }
            if (IncomeScreenState.selectedType == "VARIABLE") {
                OnboardingState.incomeType = "VARIABLE"
                OnboardingState.currentStep = 2
                Router.go(Routes.debt)
            }
        })
        nextBtn.color = AppTheme.textMuted // Inicia cinza (desabilitado visualmente)

        var btnFixed = Button("Selecionar: Fixa (CLT, salário todo mês)", () -> {})
        var btnVariable = Button("Selecionar: Variável (freela, PJ, bicos)", () -> {})

        // Mutação direta das propriedades dos widgets via lambda (padrão oficial)
        btnFixed = Button("Selecionar: Fixa (CLT, salário todo mês)", () -> {
            IncomeScreenState.selectedType = "FIXED"
            btnFixed.text = "✓ Fixa (CLT, salário todo mês)"
            btnVariable.text = "Selecionar: Variável (freela, PJ, bicos)"
            nextBtn.color = AppTheme.textPrimary // Habilita o botão próximo visualmente
        })

        btnVariable = Button("Selecionar: Variável (freela, PJ, bicos)", () -> {
            IncomeScreenState.selectedType = "VARIABLE"
            btnVariable.text = "✓ Variável (freela, PJ, bicos)"
            btnFixed.text = "Selecionar: Fixa (CLT, salário todo mês)"
            nextBtn.color = AppTheme.textPrimary // Habilita o botão próximo visualmente
        })

        var choicesSection = Column(listOf(cardFixed, btnFixed, cardVariable, btnVariable))
        var footerSection = Column(listOf(nextBtn))

        var content = Column(listOf(headerSection, choicesSection, footerSection))
        var screenView = View(screenStyle())
        screenView.bind(content)
        return screenView
    })

    c.onMount(() -> {
        // Inicializa o passo atual no OnboardingState
        OnboardingState.currentStep = 1
    })

    c.onDispose(() -> {
        // Limpeza de recursos da tela
    })

    return c
}
