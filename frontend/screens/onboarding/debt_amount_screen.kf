package screens.onboarding

import kof.ui
import core.theme
import core.router_config
import core.http_client
import components.progress_dots
import components.currency_input
import components.primary_button
import screens.onboarding.state

// =============================================================================
// Tela 6.1 — Onboarding: Valor da Dívida
// DESIGN_SYSTEM.md seção 3.1, 3.2, 3.8, 5 (Tela 6.1)
// =============================================================================
// - Indicador de progresso: step 3 ativo (1º, 2º e 3º visitados, 4º ativo)
// - Título: "Qual o valor aproximado da sua dívida?" (24px / 400 / textPrimary)
// - Subtítulo: "Isso ajuda a modelar o modelo de economia que mais se adequa a sua realidade"
//   (16px / 400 / textSecondary)
// - Campo de valor CurrencyInput centralizado: prefixo "R$", valor, cursor piscante
// - Dica de preenchimento abaixo do campo
// - Botão "Próximo": salva debtAmount no OnboardingState, submete o onboarding
//   via ApiClient_post("/api/users/onboarding", OnboardingState_toJson())
//   e navega para Routes_result.
// =============================================================================

Component buildDebtAmountScreen() {
    var c = Component("DebtAmountScreen")

    // Estado local com valor inicial sugerido
    c.state(5000.0)

    c.view { currentDebt ->
        // Indicador de progresso: 4 passos, step 3 ativo (DESIGN_SYSTEM.md seção 3.8)
        var dots = buildProgressDots(3, 4)

        // Cabeçalho: Título + Subtítulo (DESIGN_SYSTEM.md seção 2 e 5 — Tela 6.1)
        var title = Label("Qual o valor aproximado da sua dívida?")
        title.fontSize = 24
        title.bold = false
        title.color = AppTheme_textPrimary

        var subtitle = Label("Isso ajuda a modelar o modelo de economia que mais se adequa a sua realidade")
        subtitle.fontSize = 16
        subtitle.bold = false
        subtitle.color = AppTheme_textSecondary

        var headerSection = Column(listOf(dots, title, subtitle))

        // Campo de valor monetário com prefixo e cursor (DESIGN_SYSTEM.md seção 3.2)
        var currencyInput = buildCurrencyInput("5.000")

        var hint = Label("Pode ser aproximado — você poderá detalhar as parcelas depois")
        hint.fontSize = 14
        hint.bold = false
        hint.color = AppTheme_textMuted

        var inputSection = Column(listOf(currencyInput, hint))

        // Botão "Próximo": salva dívida, submete ao BFF e navega para tela de resultado
        var nextBtn = buildPrimaryButton("Próximo", () -> {
            OnboardingState_debtAmount = 5000.0
            OnboardingState_currentStep = 3

            try {
                ApiClient_post("/api/users/onboarding", OnboardingState_toJson())
            } catch (String e) {
                // Tratamento com fallback gracioso em caso de erro de rede
            }

            Router.go(Routes_result)
        })

        var footerSection = Column(listOf(nextBtn))

        // Montagem do layout completo da tela
        var content = Column(listOf(headerSection, inputSection, footerSection))

        var screenView = View(screenStyle())
        screenView.bind(content)
        return screenView
    }

    c.onMount {
        // Inicializa o passo atual no OnboardingState
        OnboardingState_currentStep = 3
    }

    c.onDispose {
        // Limpeza de recursos da tela
    }

    return c
}
