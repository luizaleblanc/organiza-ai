package screens.onboarding

// =============================================================================
// Estado do Onboarding — campos estáticos compartilhados pelo fluxo
// DESIGN_SYSTEM.md seção 3.8, 5 (Telas 4, 5, 6, 6.1, 7)
// =============================================================================
// Mantém os dados coletados durante as etapas do onboarding adaptativo:
// - Step 0: Salário mensal (Tela 4)
// - Step 1: Tipo de renda — fixa ou variável (Tela 5)
// - Step 2: Presença de dívidas em atraso (Tela 6)
// - Step 3: Valor aproximado da dívida (Tela 6.1, se aplicável)
// - Step 4: Resultado e modelo de orçamento (Tela 7)
// =============================================================================

Float OnboardingState_salary        = 0.0
String OnboardingState_incomeType   = ""
Boolean OnboardingState_hasDebt     = false
Float OnboardingState_debtAmount    = 0.0
Int OnboardingState_currentStep     = 0
// -------------------------------------------------------------------------
// Reinicia o estado do onboarding para os valores padrão
// -------------------------------------------------------------------------
OnboardingState_reset() {
OnboardingState_salary = 0.0
OnboardingState_incomeType = ""
OnboardingState_hasDebt = false
OnboardingState_debtAmount = 0.0
OnboardingState_currentStep = 0

    // -------------------------------------------------------------------------
    // Serializa o estado para JSON via concatenação manual de strings
    // -------------------------------------------------------------------------
    static String toJson() {
        return "{\"salary\":" + OnboardingState_salary + ",\"incomeType\":\"" + OnboardingState_incomeType + "\",\"hasDebt\":" + OnboardingState_hasDebt + ",\"debtAmount\":" + OnboardingState_debtAmount + ",\"currentStep\":" + OnboardingState_currentStep + "}"
    }
}
