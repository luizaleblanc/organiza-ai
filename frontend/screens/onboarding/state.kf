package screens.onboarding

// =============================================================================
// Estado do Onboarding — campos estáticos compartilhados pelo fluxo
// DESIGN_SYSTEM.md seção 3.8, 5 (Telas 4, 5, 6, 6.1, 7)
// =============================================================================
// Mantém os dados coletados durante as etapas do onboarding adaptativo:
// - Step 0: Salário mensal (Tela 4)
// - Step 1: Tipo de renda — fixa ou variável (Tela 5)
// - Step 2: Presença de dívidas em atraso (Tela 6)
// - Step 3: Valor aproximado da dívida (Tela 6.1, se aplicável)
// - Step 4: Resultado e modelo de orçamento (Tela 7)
// =============================================================================

class OnboardingState {
    static Float salary        = 0.0
    static String incomeType   = ""
    static Boolean hasDebt     = false
    static Float debtAmount    = 0.0
    static Int currentStep     = 0

    static reset() {
        OnboardingState.salary = 0.0
        OnboardingState.incomeType = ""
        OnboardingState.hasDebt = false
        OnboardingState.debtAmount = 0.0
        OnboardingState.currentStep = 0
    }

    // Serializa o estado para JSON via concatenação de strings
    static String toJson() {
        return "{\"salary\":" + OnboardingState.salary + ",\"incomeType\":\"" + OnboardingState.incomeType + "\",\"hasDebt\":" + OnboardingState.hasDebt + ",\"debtAmount\":" + OnboardingState.debtAmount + ",\"currentStep\":" + OnboardingState.currentStep + "}"
    }
}
