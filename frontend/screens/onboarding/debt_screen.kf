package screens.onboarding

import kof.ui
import core.theme
import core.router_config
import core.http_client
import components.progress_dots
import components.choice_card
import screens.onboarding.state

// =============================================================================
// Tela 6 — Onboarding: Dívidas em Atraso
// DESIGN_SYSTEM.md seção 3.1, 3.7, 3.8, 5 (Tela 6)
// =============================================================================
// - Indicador de progresso: step 2 ativo (1º e 2º visitados, 3º ativo, 4º inativo)
// - Título: "Você tem dívidas em atraso?" (24px / 400 / textPrimary)
// - Subtítulo: "Isso ajuda a escolher o melhor modelo pra você" (16px / 400 / textSecondary)
// - Duas choice cards:
//     1. "Sim, tenho dívidas"
//     2. "Não, estou em dia"
// - Ao selecionar "Sim":
//     OnboardingState.hasDebt = true -> Router.go(Routes.debtAmount)
// - Ao selecionar "Não":
//     OnboardingState.hasDebt = false -> ApiClient.post("/api/users/onboarding", ...) -> Router.go(Routes.result)
// =============================================================================

class DebtScreenState {
    static String selectedChoice = ""
}

Component buildDebtScreen() {
    var c = Component("")

    c.view((ignored: String) -> {
        var dots = buildProgressDots(2, 4)

        var title = Label("Você tem dívidas em atraso?")
        title.fontSize = 24
        title.bold = false
        title.color = AppTheme.textPrimary

        var subtitle = Label("Isso ajuda a escolher o melhor modelo pra você")
        subtitle.fontSize = 16
        subtitle.bold = false
        subtitle.color = AppTheme.textSecondary

        var headerSection = Column(listOf(dots, title, subtitle))

        // Cards de escolha (DESIGN_SYSTEM.md seção 3.7)
        var cardYes = buildChoiceCard("Sim, tenho dívidas", false)
        var cardNo = buildChoiceCard("Não, estou em dia", false)

        var nextBtn = Button("Próximo", () -> {
            if (DebtScreenState.selectedChoice == "YES") {
                OnboardingState.hasDebt = true
                OnboardingState.currentStep = 3
                Router.go(Routes.debtAmount)
            }
            if (DebtScreenState.selectedChoice == "NO") {
                OnboardingState.hasDebt = false
                OnboardingState.debtAmount = 0.0
                OnboardingState.currentStep = 3

                try {
                    ApiClient.post("/api/users/onboarding", OnboardingState.toJson())
                } catch (String e) {
                    // Tratamento com fallback
                }

                Router.go(Routes.result)
            }
        })
        nextBtn.color = AppTheme.textMuted // Inicia cinza (desabilitado visualmente)

        var btnYes = Button("Selecionar: Sim, tenho dívidas", () -> {})
        var btnNo = Button("Selecionar: Não, estou em dia", () -> {})

        // Mutação direta das propriedades dos widgets via lambda (padrão oficial)
        btnYes = Button("Selecionar: Sim, tenho dívidas", () -> {
            DebtScreenState.selectedChoice = "YES"
            btnYes.text = "✓ Sim, tenho dívidas"
            btnNo.text = "Selecionar: Não, estou em dia"
            nextBtn.color = AppTheme.textPrimary // Habilita o botão próximo visualmente
        })

        btnNo = Button("Selecionar: Não, estou em dia", () -> {
            DebtScreenState.selectedChoice = "NO"
            btnNo.text = "✓ Não, estou em dia"
            btnYes.text = "Selecionar: Sim, tenho dívidas"
            nextBtn.color = AppTheme.textPrimary // Habilita o botão próximo visualmente
        })

        var choicesSection = Column(listOf(cardYes, btnYes, cardNo, btnNo))
        var footerSection = Column(listOf(nextBtn))

        var content = Column(listOf(headerSection, choicesSection, footerSection))
        var screenView = View(screenStyle())
        screenView.bind(content)
        return screenView
    })

    c.onMount(() -> {
        // Inicializa o passo atual no OnboardingState
        OnboardingState.currentStep = 2
    })

    c.onDispose(() -> {
        // Limpeza de recursos da tela
    })

    return c
}
