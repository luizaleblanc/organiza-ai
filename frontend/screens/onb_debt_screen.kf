package screens

import kof.ui
import core.theme
import core.app_state
import core.navigation
import components.form_widgets

// =============================================================================
// Tela 6 — Dívidas (Etapa 3 de 5)
// =============================================================================
// Dots (2 de 5), título, subtítulo, dois radioChoiceCard (radio 18px).
// "Sim" → "onb_debt_amount" (mesma etapa 3 de 5). "Não" → "onb_chips" (etapa 4).
// =============================================================================

chooseDebt(Window w, String choice) {
    OnboardingState.debtChoice = choice
    AppState.formError = ""
    mountScreen(w)
}

debtNext(Window w) {
    if (OnboardingState.debtChoice == "YES") {
        OnboardingState.hasDebt = true
        AppState.formError = ""
        navigateTo(w, "onb_debt_amount")
    } else if (OnboardingState.debtChoice == "NO") {
        OnboardingState.hasDebt = false
        OnboardingState.debtAmount = ""
        AppState.formError = ""
        navigateTo(w, "onb_chips")
    }
}

View onbDebtScreen(Window w) {
    var choice = OnboardingState.debtChoice

    var title = onbTitle("Você tem dívidas em atraso?", "debt-title")
    var subtitle = onbSubtitle("Isso ajuda a escolher o melhor modelo para você", "debt-subtitle")

    var yes = radioChoiceCard("Sim, tenho dívidas", "choice-debt-yes", choice == "YES", () -> chooseDebt(w, "YES"))
    var no = radioChoiceCard("Não, estou em dia", "choice-debt-no", choice == "NO", () -> chooseDebt(w, "NO"))
    var cards = Column(listOf(yes, no))
    cards.setStyle(choiceListCss())
    var cardsBlock = View(screenStyle())
    cardsBlock.setStyle(blockCss())
    cardsBlock.bind(cards)

    var next = disabledButton("Próximo", "btn-next")
    if (choice != "") {
        next = primaryButton("Próximo", "btn-next", false, () -> debtNext(w))
    }

    var items = listOf(dotsBlock(2), titleBlock(title, subtitle), cardsBlock)
    if (AppState.formError != "") {
        items.add(errorBlock(AppState.formError))
    }
    items.add(buttonBlock(next))
    return onbBody(items, onbColumn480Css())
}
