package screens

import kof.ui
import core.theme
import core.app_state
import core.navigation
import components.form_widgets

// =============================================================================
// Tela 6 — Dívidas (spec B2-06; design.md §5)
// =============================================================================
// Nenhum card selecionado ao abrir e "Próximo" desabilitado; a escolha fica em
// OnboardingState.debtChoice e re-renderiza com mountScreen.
// "Sim" → Tela 6.1. "Não" → envia hasDebt=false, debtAmount=0.0 → Tela 7.
// =============================================================================

chooseDebt(Window w, String choice) {
    OnboardingState.debtChoice = choice
    AppState.formError = ""
    mountScreen(w)
}

debtNext(Window w) {
    if (OnboardingState.debtChoice == "YES") {
        OnboardingState.hasDebt = true
        AppState.formError = ""
        navigateTo(w, "onb_debt_amount")
    } else if (OnboardingState.debtChoice == "NO") {
        OnboardingState.debtAmount = ""
        sendOnboarding(w, false, 0.0)
    }
}

View onbDebtScreen(Window w) {
    var choice = OnboardingState.debtChoice

    var title = Label("Você tem dívidas em atraso?")
    title.setId("debt-title")
    title.setStyle(titleCss())
    var subtitle = Label("Isso ajuda a escolher o melhor modelo pra você")
    subtitle.setStyle(captionCss())

    var yes = choiceCard("Sim, tenho dívidas", "choice-debt-yes", choice == "YES", () -> chooseDebt(w, "YES"))
    var no = choiceCard("Não, estou em dia", "choice-debt-no", choice == "NO", () -> chooseDebt(w, "NO"))
    var cards = Column(listOf(yes, no))
    cards.setStyle(choiceListCss())
    var cardsBlock = View(screenStyle())
    cardsBlock.setStyle(blockCss())
    cardsBlock.bind(cards)

    var next = disabledButton("Próximo", "btn-next")
    if (choice != "" && !OnboardingState.submitting) {
        next = primaryButton("Próximo", "btn-next", false, () -> { spawn { debtNext(w) } })
    }

    var items = listOf(dotsBlock(2), titleBlock(title, subtitle), cardsBlock)
    if (AppState.formError != "") {
        items.add(errorBlock(AppState.formError))
    }
    items.add(buttonBlock(next))
    return entryBody(items)
}

View errorBlock(String message) {
    var v = View(screenStyle())
    v.setStyle(blockCss())
    v.bind(errorBanner(message))
    return v
}

View entryBody(List<View> items) {
    var column = Column(items)
    column.setStyle(onbColumnCss())
    var body = View(screenStyle())
    body.setStyle(entryBodyCss())
    body.bind(column)
    return body
}
