package screens.dashboard

// =============================================================================
// Estado do Dashboard — campos estáticos compartilhados
// DESIGN_SYSTEM.md seção 3.3, 5 (Tela 8)
// =============================================================================
// Armazena as informações exibidas no dashboard principal:
// - availableToday: valor monetário formatado disponível para gasto no dia
// - daysRemaining: legenda de dias restantes no mês corrente
// - tip: dica contextual de economia opcional (ex.: "Dica: economize em Uber")
// - transactions: lista de identificadores/descrições de transações recentes
// =============================================================================

class DashboardState {
    static String availableToday       = "R$ 0,00"
    static String daysRemaining        = ""
    static String? tip                 = null
    static List<String> transactions   = listOf()

    static reset() {
        DashboardState.availableToday = "R$ 0,00"
        DashboardState.daysRemaining = ""
        DashboardState.tip = null
        DashboardState.transactions = listOf()
    }
}
