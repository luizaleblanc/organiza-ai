Style chatCheckOffCss()        = themed(Style("display: flex; align-items: center; justify-content: center; width: 20; height: 20; min-width: 20; box-sizing: border-box; border-radius: 6; background: #FFFFFF; border: 1.5px solid #9CA3AF; padding: 0; flex-shrink: 0"), Style("display: flex; align-items: center; justify-content: center; width: 20; height: 20; min-width: 20; box-sizing: border-box; border-radius: 6; background: rgba(255,255,255,.04); border: 1.5px solid #4A5578; padding: 0; flex-shrink: 0"))
Style chatCheckRowCss()        = themed(Style("outline: none; display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 12; width: 100%; box-sizing: border-box; padding: 12px 14px; background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 12; cursor: pointer"), Style("outline: none; display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 12; width: 100%; box-sizing: border-box; padding: 12px 14px; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.1); border-radius: 12; cursor: pointer"))
Style chatCheckRowSelectedCss() = themed(Style("outline: none; display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 12; width: 100%; box-sizing: border-box; padding: 12px 14px; background: rgba(37,99,235,.08); border: 1px solid #2563EB; border-radius: 12; cursor: pointer"), Style("outline: none; display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 12; width: 100%; box-sizing: border-box; padding: 12px 14px; background: rgba(0,212,255,.08); border: 1px solid #00D4FF; border-radius: 12; cursor: pointer"))
Style chatSelectAllRowCss()    = themed(Style("outline: none; display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 10; width: 100%; box-sizing: border-box; padding: 10px 14px; background: #F8F9FC; border: 1px solid #E5E7EB; border-radius: 10; cursor: pointer"), Style("outline: none; display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 10; width: 100%; box-sizing: border-box; padding: 10px 14px; background: #1A1F3A; border: 1px solid rgba(255,255,255,.1); border-radius: 10; cursor: pointer"))
Style chatNoticeBoxCss()       = themed(Style("display: flex; flex-direction: column; gap: 8; width: 100%; box-sizing: border-box; padding: 12px 14px; background: #F8F9FC; border: 1px solid #F59E0B; border-radius: 12"), Style("display: flex; flex-direction: column; gap: 8; width: 100%; box-sizing: border-box; padding: 12px 14px; background: #1A1F3A; border: 1px solid #FFB800; border-radius: 12"))
Style chatSuccessBoxCss()      = themed(Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; gap: 10; width: 100%; box-sizing: border-box; padding: 12px 14px; background: #F8F9FC; border: 1px solid #10B981; border-radius: 12"), Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; gap: 10; width: 100%; box-sizing: border-box; padding: 12px 14px; background: #1A1F3A; border: 1px solid #00E5A0; border-radius: 12"))
Style chatFooterRowCss()       = Style("display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10; width: 100%")
Style chatFooterBtnsCss()      = Style("display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 10; width: 100%")
Style chatHalfBtnWrapCss()     = Style("flex: 1 1 180; min-width: 140")

Style chatTrashBtnCss() = themed(Style("outline: none; display: inline-flex; align-items: center; justify-content: center; width: 44; height: 44; padding: 0; box-sizing: border-box; border: 1px solid rgba(220,38,38,.35); border-radius: 10; background: rgba(220,38,38,.06); cursor: pointer; flex-shrink: 0"), Style("outline: none; display: inline-flex; align-items: center; justify-content: center; width: 44; height: 44; padding: 0; box-sizing: border-box; border: 1px solid rgba(255,74,110,.35); border-radius: 10; background: rgba(255,74,110,.08); cursor: pointer; flex-shrink: 0"))

// Lixeira: apaga o histórico do chat (DELETE /api/chat/messages, o mesmo do
// "Novo chat"). Ação destrutiva: pede confirmação no próprio cabeçalho.
Style chatClearAskCss()    = themed(Style("color: #1A1D2E; font-size: 0.875rem; font-weight: 600; margin: 0; white-space: nowrap; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"), Style("color: #F0F0F0; font-size: 0.875rem; font-weight: 600; margin: 0; white-space: nowrap; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"))
Style chatClearCancelCss() = themed(Style("outline: none; height: 40; min-width: 44; padding: 0 14px; border-radius: 10; border: 1px solid #D1D5DB; background: transparent; color: #1A1D2E; font-size: 0.875rem; font-weight: 600; cursor: pointer; flex-shrink: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"), Style("outline: none; height: 40; min-width: 44; padding: 0 14px; border-radius: 10; border: 1px solid rgba(255,255,255,.2); background: transparent; color: #F0F0F0; font-size: 0.875rem; font-weight: 600; cursor: pointer; flex-shrink: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"))
Style chatClearDangerCss() = themed(Style("outline: none; height: 40; min-width: 44; padding: 0 14px; border-radius: 10; border: 1px solid #DC2626; background: #DC2626; color: #FFFFFF; font-size: 0.875rem; font-weight: 700; cursor: pointer; flex-shrink: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"), Style("outline: none; height: 40; min-width: 44; padding: 0 14px; border-radius: 10; border: 1px solid #FF4A6E; background: rgba(255,74,110,.16); color: #FF4A6E; font-size: 0.875rem; font-weight: 700; cursor: pointer; flex-shrink: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"))

View chatTrashButton(Window w) {
    if (ChatUi.confirmClear) {
        // Confirmação compacta na mesma linha do cabeçalho (mesma altura do
        // "Novo chat"). Apagar usa o tom de perigo, não o gradiente principal.
        var ask = Label("Apagar a conversa?")
        ask.setStyle(chatClearAskCss())
        var no = Button("Cancelar", () -> {
            ChatUi.confirmClear = false
            mountScreen(w)
        })
        no.setId("chat-clear-cancel")
        no.setStyle(chatClearCancelCss())
        var yes = Button("Apagar", () -> {
            ChatUi.confirmClear = false
            spawn {
                clearChatHistoryWith(false)
                mountScreen(w)
            }
        })
        yes.setId("chat-clear-confirm")
        yes.setStyle(chatClearDangerCss())
        var row = Row(listOf(ask, no, yes))
        row.setId("chat-clear-ask")
        row.setAccessibleName("Confirmar: apagar a conversa")
        row.setStyle(Style("display: inline-flex; flex-direction: row; flex-wrap: nowrap; align-items: center; gap: 8; white-space: nowrap"))
        return row
    }
    var btn = View(screenStyle())
    btn.setId("chat-clear-btn")
    btn.setAccessibleName("Apagar conversa")
    btn.setStyle(chatTrashBtnCss())
    btn.bind(icon("trash", 18, "danger"))
    btn.on("click", () -> {
        ChatUi.confirmClear = true
        mountScreen(w)
    })
    return btn
}

View chatHeaderActions(Window w) {
    var actions: List<View> = listOf(chatTrashButton(w))
    if (!ChatUi.confirmClear) {
        actions.add(newChatTopButton(w))
    }
    var row = Row(actions)
    row.setId("chat-header-actions")
    row.setStyle(Style("display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 8"))
    return row
}

View newChatTopButton(Window w) {
    var txt = Label("Novo chat")
    txt.setStyle(chatNewTopLabelCss())
    var inner = Row(listOf(icon("plus", 14, "accent"), txt))
    inner.setStyle(chatNewTopRowCss())
    var btn = View(screenStyle())
    btn.setId("chat-new-btn")
    btn.setAccessibleName("Novo chat")
    btn.setStyle(chatNewTopBtnCss())
    btn.bind(inner)
    btn.on("click", () -> {
        spawn {
            clearChatHistory()
            mountScreen(w)
        }
    })
    return btn
}

String chatGreeting() {
    var name = SessionState.userName.trim()
    var sp = name.indexOf(" ")
    if (sp > 0) {
        name = name.substring(0, sp)
    }
    var hi = "Oi!"
    if (name != "") {
        hi = "Oi, " + name + "!"
    }
    return hi + " Me fala seus gastos aí. Você pode digitar, falar por voz ou enviar sua fatura por aqui que eu leio e organizo tudo pra você."
}

Label chatBubble(String role, String text, String id) {
    var b = Label(text)
    b.setId(id)
    if (role == "USER") {
        b.setStyle(chatBubbleUserCss())
    } else {
        b.setStyle(chatBubbleAiCss())
    }
    return b
}

submitInteractionPrompt(Window w, String prompt) {
    var text = prompt.trim()
    if (text == "" || ChatUi.blocked) { return }
    queueChatMessage(text)
    ChatUi.draft = ""
    ChatUi.error = ""
    mountScreen(w)
    spawn {
        sendChatMessage(text)
        invalidateFinancialCaches()
        mountScreen(w)
    }
}

View interactionFlowLine(String label, String amount, String id) {
    var left = Label(label)
    left.setStyle(chatInteractionTextCss())
    var right = Label(amount)
    right.setStyle(chatInteractionTextCss())
    var row = Row(listOf(left, right))
    row.setId(id)
    row.setStyle(Style("display: flex; flex-direction: row; justify-content: space-between; align-items: center; gap: 12; width: 100%"))
    return row
}

View checkboxSquare(Bool isChecked) {
    var box = View(screenStyle())
    if (isChecked) {
        box.setStyle(chatCheckOnCss())
        box.bind(icon("check", 13, "onaccent"))
    } else {
        box.setStyle(chatCheckOffCss())
    }
    return box
}

View selectableCheckRow(Window w, String domId, Bool isChecked, String titleText, String? subtitleText, String rightAmount, () -> Void onToggle) {
    var cb = checkboxSquare(isChecked)
    var titleLbl = Label(titleText)
    titleLbl.setStyle(chatInteractionTextCss())
    var textParts: List<View> = listOf()
    textParts.add(titleLbl)
    if (subtitleText != null) {
        val subTrim = subtitleText.trim()
        if (subTrim != "") {
            var subLbl = Label(subTrim)
            subLbl.setStyle(chatInteractionMutedCss())
            textParts.add(subLbl)
        }
    }
    var textCol = Column(textParts)
    textCol.setStyle(Style("display: flex; flex-direction: column; gap: 2; min-width: 0; flex: 1 1 0"))
    var leftRow = Row(listOf(cb, textCol))
    leftRow.setStyle(Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; gap: 12; min-width: 0; flex: 1 1 0"))
    var amtLbl = Label(rightAmount)
    amtLbl.setStyle(chatInteractionAccentCss())
    var outer = Row(listOf(leftRow, amtLbl))
    var card = View(screenStyle())
    card.setId(domId)
    card.setAccessibleName(titleText + " " + rightAmount)
    if (isChecked) {
        card.setStyle(chatCheckRowSelectedCss())
    } else {
        card.setStyle(chatCheckRowCss())
    }
    card.bind(outer)
    card.on("click", onToggle)
    return card
}

View flowSummaryGroupBox(String boxId, String titleText, String totalText, List<ChatFlowLineItemResponse> lines, String emptyText, Bool isEntradas) {
    var dot = View(screenStyle())
    if (isEntradas) {
        dot.setStyle(chatDotInCss())
    } else {
        dot.setStyle(chatDotOutCss())
    }
    var tLbl = Label(titleText)
    tLbl.setStyle(chatInteractionSubTitleCss())
    var headLeft = Row(listOf(dot, tLbl))
    headLeft.setStyle(Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; gap: 8"))
    var totalLbl = Label(totalText)
    totalLbl.setStyle(chatInteractionAccentCss())
    var headParts: List<View> = listOf()
    headParts.add(headLeft)
    if (totalText.trim() != "") {
        headParts.add(totalLbl)
    }
    var head = Row(headParts)
    head.setStyle(Style("display: flex; flex-direction: row; justify-content: space-between; align-items: center; gap: 10; width: 100%"))
    var boxItems: List<View> = listOf()
    boxItems.add(head)
    if (lines.size == 0) {
        var emp = Label(emptyText)
        emp.setStyle(chatInteractionMutedCss())
        boxItems.add(emp)
    } else {
        for (var line in lines) {
            boxItems.add(interactionFlowLine(line.label(), line.formattedAmount(), boxId + "-" + line.label()))
            val note = line.note()
            if (note != null && note.trim() != "") {
                var noteLbl = Label(note.trim())
                noteLbl.setStyle(chatInteractionMutedCss())
                boxItems.add(noteLbl)
            }
        }
    }
    var box = Column(boxItems)
    box.setId(boxId)
    box.setStyle(chatFlowBoxCss())
    return box
}

View categoryChoiceChip(Window w, String code, String labelText) {
    val active = ChatUi.reviewCategory == code
    val catCode = code
    return chip(labelText, "chat-rev-cat-" + code, active, () -> {
        ChatUi.reviewCategory = catCode
        ChatUi.interactionError = ""
        mountScreen(w)
    })
}

addDetailsBlock(Window w, List<View> content, ChatInteractionResponse interaction) {
    val details = interaction.details()
    if (details == null) {
        return
    }
    var detailLabel = details.title()
    if (detailLabel.trim() == "") {
        detailLabel = "Detalhes da análise"
    }
    if (ChatUi.interactionDetailsOpen) {
        detailLabel = "Ocultar detalhes da análise"
    }
    var detailButton = Button(detailLabel, () -> {
        ChatUi.interactionDetailsOpen = !ChatUi.interactionDetailsOpen
        mountScreen(w)
    })
    detailButton.setId("chat-interaction-details-toggle")
    detailButton.setStyle(chatInteractionDetailCss())
    content.add(detailButton)
    if (ChatUi.interactionDetailsOpen) {
        for (var item in details.items()) {
            var detail = Label(item)
            detail.setStyle(chatInteractionMutedCss())
            content.add(detail)
        }
    }
}

addOptionButtons(Window w, List<View> content, List<ChatInteractionOptionResponse> options) {
    // Education First: "Entender meus gastos" sempre primeiro, qualquer que seja
    // a ordem enviada pelo backend. Sem contadores nos botões (só os itens).
    var ordered: List<ChatInteractionOptionResponse> = listOf()
    for (var o in options) {
        if (o.id() == "opt_understand_expenses") { ordered.add(o) }
    }
    for (var o in options) {
        if (o.id() != "opt_understand_expenses") { ordered.add(o) }
    }
    var actions: List<View> = listOf()
    for (var option in ordered) {
        val actionPrompt = option.label()
        var label = actionPrompt
        // A tag é só visual: a mensagem enviada ao chat continua sendo o label.
        if (option.id() == "opt_understand_expenses") {
            label = label + " (recomendado)"
        }
        var action = Button(label, () -> submitInteractionPrompt(w, actionPrompt))
        action.setId("chat-interaction-option-" + option.id())
        action.setAccessibleName(option.label())
        action.setStyle(chatInteractionActionCss())
        actions.add(action)
    }
    if (actions.size > 0) {
        var stack = Column(actions)
        stack.setId("chat-interaction-options")
        stack.setStyle(Style("display: flex; flex-direction: column; gap: 8; width: 100%"))
        content.add(stack)
    }
}

Bool categoryOrNullPt(String name) {
    for (var code in listOf("FOOD", "GROCERIES", "TRANSPORT", "HOUSING", "HEALTH", "LEISURE", "EDUCATION", "OTHER")) {
        if (categoryNamePt(code).toLowerCase() == name.toLowerCase()) {
            return false
        }
    }
    return true
}

View chatInteractionCard(Window w) {
    val interaction = json.decode<ChatInteractionResponse>(ChatUi.interactionJson)
    val kind = interaction.type()
    var content: List<View> = listOf()

    // Cabeçalho alinhado ao template oficial + Design System
    var brandTitle = Label("Organiza AI")
    brandTitle.setStyle(chatInteractionSubTitleCss())
    var brandLeft = Row(listOf(brandMark(24, "chat-interaction-brand"), brandTitle))
    brandLeft.setId("chat-interaction-brand-row")
    brandLeft.setStyle(chatInteractionBrandRowCss())
    var headerParts: List<View> = listOf()
    headerParts.add(brandLeft)
    var periodTagText = ""
    val pLabel = interaction.periodLabel()
    val sumForPeriod = interaction.summary()
    if (pLabel != null) {
        val pTrim = pLabel.trim()
        if (pTrim != "") {
            periodTagText = pTrim
        }
    }
    if (periodTagText == "" && sumForPeriod != null) {
        val sPeriod = sumForPeriod.periodLabel()
        if (sPeriod.trim() != "") {
            periodTagText = sPeriod.trim()
        }
    }
    if (periodTagText != "") {
        var pPill = Label(periodTagText)
        pPill.setId("chat-interaction-period")
        pPill.setStyle(chatPeriodBadgeCss())
        headerParts.add(pPill)
    }
    var headerRow = Row(headerParts)
    headerRow.setId("chat-interaction-header")
    headerRow.setStyle(chatInteractionHeaderCss())
    content.add(headerRow)

    var headline = interaction.headline()
    if (headline != null) {
        val hTrim = headline.trim()
        if (hTrim != "") {
            var title = Label(hTrim)
            title.setId("chat-interaction-headline")
            title.setStyle(chatInteractionTitleCss())
            content.add(title)
        }
    }

    var tip = interaction.educationTip()
    if (tip != null) {
        val tTrim = tip.trim()
        if (tTrim != "") {
            var tipLbl = Label(tTrim)
            tipLbl.setStyle(chatInteractionTextCss())
            var eduRow = Row(listOf(icon("pulse", 16, "accent"), tipLbl))
            eduRow.setId("chat-interaction-edu")
            eduRow.setStyle(chatEduBoxCss())
            content.add(eduRow)
        }
    }

    if (kind == "INVOICE_REGISTER") {
        ensureSelectionInitialized(interaction)
        val items = interaction.items()
        val selectedCount = countSelectedItems(items)
        val allChecked = items.size > 0 && selectedCount == items.size

        var prompt = Label(interaction.prompt())
        prompt.setStyle(chatInteractionSubTitleCss())
        content.add(prompt)

        if (items.size > 0) {
            var masterCb = checkboxSquare(allChecked)
            var masterText = Label("Selecionar todos os lançamentos")
            masterText.setStyle(chatInteractionTextCss())
            var masterLeft = Row(listOf(masterCb, masterText))
            masterLeft.setStyle(Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; gap: 10"))
            var countBadge = Label(String.valueOf(selectedCount) + " de " + String.valueOf(items.size))
            countBadge.setStyle(chatInteractionMutedCss())
            var masterInner = Row(listOf(masterLeft, countBadge))
            var selectAllRow = View(screenStyle())
            selectAllRow.setId("chat-reg-select-all")
            selectAllRow.setAccessibleName("Selecionar todos os lançamentos")
            selectAllRow.setStyle(chatSelectAllRowCss())
            selectAllRow.bind(masterInner)
            selectAllRow.on("click", () -> {
                if (allChecked) {
                    clearAllItems()
                } else {
                    selectAllItems(items)
                }
                mountScreen(w)
            })
            content.add(selectAllRow)

            var itemsColParts: List<View> = listOf()
            for (var item in items) {
                val itemId = item.id()
                val checked = isSelectedItem(itemId)
                itemsColParts.add(selectableCheckRow(
                    w,
                    "chat-reg-item-" + itemId,
                    checked,
                    item.label(),
                    item.subtitle(),
                    item.formattedAmount(),
                    () -> {
                        toggleSelectedItem(itemId)
                        mountScreen(w)
                    }
                ))
            }
            var itemsCol = Column(itemsColParts)
            itemsCol.setId("chat-reg-items")
            itemsCol.setStyle(Style("display: flex; flex-direction: column; gap: 8; width: 100%"))
            content.add(itemsCol)
        } else {
            var emptyItems = Label("Nenhuma despesa pronta para registrar encontrada neste arquivo.")
            emptyItems.setStyle(chatInteractionMutedCss())
            content.add(emptyItems)
        }

        val summary = interaction.summary()
        if (summary != null && summary.pendingCount() > 0) {
            var warnTitle = Label("Algumas movimentações (" + summary.pendingText() + ") aguardam sua revisão. Elas não são salvas sem você escolher a categoria.")
            warnTitle.setStyle(chatInteractionTextCss())
            var revBtn = Button("Revisar movimentações", () -> submitInteractionPrompt(w, "Revisar movimentações"))
            revBtn.setId("chat-reg-review-shortcut")
            revBtn.setStyle(chatInteractionActionCss())
            var noticeBox = Column(listOf(warnTitle, revBtn))
            noticeBox.setId("chat-reg-pending-notice")
            noticeBox.setStyle(chatNoticeBoxCss())
            content.add(noticeBox)
        }

        val rawPer = interaction.period()
        var hasPeriod = false
        if (rawPer != null) {
            if (rawPer.trim() != "") {
                hasPeriod = true
            }
        }
        if (!hasPeriod) {
            var periodField = textField("Mês e ano da fatura (AAAA-MM, ex.: 2026-11)", "text", "chat-reg-period-input")
            periodField.setText(ChatUi.manualPeriod)
            periodField.on("input", () -> {
                ChatUi.manualPeriod = periodField.text()
                ChatUi.interactionError = ""
            })
            content.add(labeled("Confirmar período da fatura", periodField))
        }

        addDetailsBlock(w, content, interaction)

        if (ChatUi.interactionError != "") {
            content.add(errorBanner(ChatUi.interactionError))
        }

        var divider = View(screenStyle())
        divider.setStyle(chatInteractionDividerCss())
        content.add(divider)

        var totalLabel = Label("Total selecionado para caixinhas")
        totalLabel.setStyle(chatInteractionMutedCss())
        var totalValue = Label(brlFromCents(sumSelectedCents(items)) + " (" + String.valueOf(selectedCount) + " selecionados)")
        totalValue.setId("chat-reg-total")
        totalValue.setStyle(chatInteractionAccentCss())
        var totalRow = Row(listOf(totalLabel, totalValue))
        totalRow.setStyle(chatFooterRowCss())
        content.add(totalRow)

        var cancelLabel = "Cancelar"
        if (ChatUi.registerPreview) { cancelLabel = "Voltar e corrigir" }
        var cancelBtn = secondaryButton(cancelLabel, "chat-reg-cancel", false, () -> {
            if (ChatUi.registerPreview) {
                ChatUi.registerPreview = false
            } else {
                cancelInteractiveTemplate()
            }
            mountScreen(w)
        })
        if (ChatUi.interactionBusy) {
            cancelBtn.setDisabled(true)
        }
        if (ChatUi.registerPreview) {
            var prevTitle = Label("Prévia: como os gastos vão para as caixinhas")
            prevTitle.setStyle(chatInteractionSubTitleCss())
            var prevParts: List<View> = listOf()
            prevParts.add(prevTitle)
            var groups: List<String> = listOf()
            for (var it in items) {
                if (isSelectedItem(it.id()) && !groups.contains(it.groupLabel())) {
                    groups.add(it.groupLabel())
                }
            }
            for (var g in groups) {
                var gCents = 0
                for (var it in items) {
                    if (isSelectedItem(it.id()) && it.groupLabel() == g) {
                        gCents = gCents + it.amountCents()
                    }
                }
                prevParts.add(interactionFlowLine(g, brlFromCents(gCents), "chat-reg-preview-" + g))
            }
            var prevNote = Label("Isso organiza seus gastos por categoria. Nenhum dinheiro é transferido.")
            prevNote.setStyle(chatInteractionMutedCss())
            prevParts.add(prevNote)
            var prevBox = Column(prevParts)
            prevBox.setId("chat-reg-preview")
            prevBox.setStyle(chatFlowBoxCss())
            content.add(prevBox)
        }
        var confirmLabel = "Ver prévia das caixinhas"
        if (ChatUi.registerPreview) {
            confirmLabel = "Confirmar e registrar"
        }
        if (ChatUi.interactionBusy) {
            confirmLabel = "Salvando nas caixinhas..."
        }
        var confirmBtn = primaryButton(confirmLabel, "chat-reg-confirm", false, () -> {
            if (!ChatUi.registerPreview) {
                if (countSelectedItems(interaction.items()) == 0) {
                    ChatUi.interactionError = "Selecione pelo menos um lançamento."
                } else {
                    ChatUi.interactionError = ""
                    ChatUi.registerPreview = true
                }
                mountScreen(w)
                return
            }
            spawn {
                confirmInvoiceRegistrationAction(interaction)
                invalidateFinancialCaches()
                mountScreen(w)
            }
        })
        if (ChatUi.interactionBusy) {
            confirmBtn.setDisabled(true)
        }
        var cancelWrap = View(screenStyle())
        cancelWrap.setStyle(chatHalfBtnWrapCss())
        cancelWrap.bind(cancelBtn)
        var confirmWrap = View(screenStyle())
        confirmWrap.setStyle(chatHalfBtnWrapCss())
        confirmWrap.bind(confirmBtn)
        var footerBtns = Row(listOf(cancelWrap, confirmWrap))
        footerBtns.setId("chat-reg-actions")
        footerBtns.setStyle(chatFooterBtnsCss())
        content.add(footerBtns)
    } else if (kind == "RESERVE_DECLARATION") {
        ensureSelectionInitialized(interaction)
        val items = interaction.items()
        var prompt = Label(interaction.prompt())
        prompt.setStyle(chatInteractionSubTitleCss())
        content.add(prompt)
        var choiceParts: List<View> = listOf()
        for (var item in items) {
            val itemId = item.id()
            choiceParts.add(selectableCheckRow(
                w,
                "chat-reserve-" + itemId,
                isSelectedItem(itemId),
                item.label(),
                item.subtitle(),
                item.formattedAmount(),
                () -> {
                    chooseSingleItem(itemId)
                    mountScreen(w)
                }
            ))
        }
        var choices = Column(choiceParts)
        choices.setId("chat-reserve-items")
        choices.setStyle(Style("display: flex; flex-direction: column; gap: 8; width: 100%"))
        content.add(choices)
        if (ChatUi.interactionError != "") {
            content.add(errorBanner(ChatUi.interactionError))
        }
        var cancelBtn = secondaryButton("Cancelar", "chat-reserve-cancel", false, () -> {
            cancelInteractiveTemplate()
            mountScreen(w)
        })
        var confirmLabel = "Confirmar escolha"
        if (ChatUi.interactionBusy) {
            confirmLabel = "Salvando..."
            cancelBtn.setDisabled(true)
        }
        var confirmBtn = primaryButton(confirmLabel, "chat-reserve-confirm", false, () -> {
            spawn {
                confirmReserveDeclarationAction(interaction)
                invalidateFinancialCaches()
                mountScreen(w)
            }
        })
        if (ChatUi.interactionBusy || countSelectedItems(items) != 1) {
            confirmBtn.setDisabled(true)
        }
        var cancelWrap = View(screenStyle())
        cancelWrap.setStyle(chatHalfBtnWrapCss())
        cancelWrap.bind(cancelBtn)
        var confirmWrap = View(screenStyle())
        confirmWrap.setStyle(chatHalfBtnWrapCss())
        confirmWrap.bind(confirmBtn)
        var footerBtns = Row(listOf(cancelWrap, confirmWrap))
        footerBtns.setId("chat-reserve-actions")
        footerBtns.setStyle(chatFooterBtnsCss())
        content.add(footerBtns)
    } else if (kind == "ASSIGN_CAIXINHAS") {
        ensureSelectionInitialized(interaction)
        val items = interaction.items()
        seedSuggestedCategories(items)
        if (!EnvState.loaded && !EnvState.loading) {
            spawn {
                try { loadEnvelopes() } catch (String e) {}
                mountScreen(w)
            }
        }
        var prompt = Label(interaction.prompt())
        prompt.setStyle(chatInteractionSubTitleCss())
        content.add(prompt)
        if (!ChatUi.registerPreview) {
            var parts: List<View> = listOf()
            for (var it in items) {
                val itemId = it.id()
                var name = Label(it.label())
                name.setStyle(chatInteractionTextCss())
                var sub = Label("")
                val st = it.subtitle()
                if (st != null) { sub = Label(st) }
                sub.setStyle(chatInteractionMutedCss())
                var left = Column(listOf(name, sub))
                left.setStyle(Style("display: flex; flex-direction: column; gap: 2; min-width: 0; flex: 1 1 0"))
                var amt = Label(it.formattedAmount())
                amt.setStyle(chatInteractionAccentCss())
                var head = Row(listOf(left, amt))
                head.setStyle(Style("display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 12; width: 100%"))
                var chips: List<View> = listOf()
                for (var code in listOf("FOOD", "GROCERIES", "TRANSPORT", "HOUSING", "HEALTH", "LEISURE", "EDUCATION", "OTHER")) {
                    val c = code
                    chips.add(chip(categoryNamePt(c), "chat-assign-" + itemId + "-" + c, itemCategory(itemId) == c, () -> {
                        setItemCategory(itemId, c)
                        mountScreen(w)
                    }))
                }
                for (var env in envelopeItems()) {
                    if (categoryOrNullPt(env.categoryName())) {
                        val envCode = "ENV:" + env.id()
                        chips.add(chip(env.categoryName(), "chat-assign-" + itemId + "-env-" + env.id(), itemCategory(itemId) == envCode, () -> {
                            setItemCategory(itemId, envCode)
                            mountScreen(w)
                        }))
                    }
                }
                chips.add(chip("+ Criar caixinha", "chat-assign-new-" + itemId, false, () -> {
                    ChatUi.newBoxOpen = true
                    mountScreen(w)
                }))
                var block = Column(listOf(head, chipGroup("Caixinha", chips, "chat-assign-chips-" + itemId)))
                block.setId("chat-assign-item-" + itemId)
                block.setStyle(chatFlowBoxCss())
                parts.add(block)
            }
            if (ChatUi.newBoxOpen) {
                var boxField = textField("Nome da caixinha (ex.: Empréstimos)", "text", "chat-assign-new-box-name")
                boxField.setText(ChatUi.newBoxName)
                boxField.on("input", () -> {
                    ChatUi.newBoxName = boxField.text()
                })
                var createBtn = primaryButton("Criar caixinha", "chat-assign-new-box-create", false, () -> {
                    spawn {
                        createBoxFromReview(interaction)
                        invalidateEnvelopes()
                        mountScreen(w)
                    }
                })
                var closeBtn = secondaryButton("Cancelar", "chat-assign-new-box-cancel", false, () -> {
                    ChatUi.newBoxOpen = false
                    mountScreen(w)
                })
                var boxBtns = Row(listOf(closeBtn, createBtn))
                boxBtns.setStyle(chatFooterBtnsCss())
                var boxForm = Column(listOf(labeled("Nova caixinha", boxField), boxBtns))
                boxForm.setId("chat-assign-new-box")
                boxForm.setStyle(chatFlowBoxCss())
                parts.add(boxForm)
            }
            var col = Column(parts)
            col.setId("chat-assign-items")
            col.setStyle(Style("display: flex; flex-direction: column; gap: 10; width: 100%"))
            content.add(col)
        } else {
            // Prévia: soma por caixinha escolhida, antes de salvar.
            var groups: List<String> = listOf()
            for (var it in items) {
                val c = itemCategory(it.id())
                if (!groups.contains(c)) { groups.add(c) }
            }
            var pv: List<View> = listOf()
            var pvTitle = Label("Prévia: como os gastos vão para as caixinhas")
            pvTitle.setStyle(chatInteractionSubTitleCss())
            pv.add(pvTitle)
            for (var g in groups) {
                var cents = 0
                for (var it in items) {
                    if (itemCategory(it.id()) == g) { cents = cents + it.amountCents() }
                }
                pv.add(interactionFlowLine(categoryNamePt(g), brlFromCents(cents), "chat-assign-preview-" + g))
            }
            var note = Label("Isso organiza seus gastos por caixinha. Nenhum dinheiro é transferido.")
            note.setStyle(chatInteractionMutedCss())
            pv.add(note)
            var pvBox = Column(pv)
            pvBox.setId("chat-assign-preview")
            pvBox.setStyle(chatFlowBoxCss())
            content.add(pvBox)
        }
        if (ChatUi.interactionError != "") {
            content.add(errorBanner(ChatUi.interactionError))
        }
        var backLabel = "Cancelar"
        if (ChatUi.registerPreview) { backLabel = "Voltar e corrigir" }
        var backBtn = secondaryButton(backLabel, "chat-assign-cancel", false, () -> {
            if (ChatUi.registerPreview) {
                ChatUi.registerPreview = false
            } else {
                cancelInteractiveTemplate()
            }
            mountScreen(w)
        })
        var goLabel = "Ver prévia"
        if (ChatUi.registerPreview) { goLabel = "Confirmar e registrar" }
        if (ChatUi.interactionBusy) { goLabel = "Salvando suas alterações..." }
        var goBtn = primaryButton(goLabel, "chat-assign-confirm", false, () -> {
            if (!ChatUi.registerPreview) {
                ChatUi.registerPreview = true
                mountScreen(w)
                return
            }
            spawn {
                assignAndRegisterAction(interaction)
                invalidateFinancialCaches()
                mountScreen(w)
            }
        })
        if (ChatUi.interactionBusy || items.size == 0) {
            goBtn.setDisabled(true)
        }
        var backWrap = View(screenStyle())
        backWrap.setStyle(chatHalfBtnWrapCss())
        backWrap.bind(backBtn)
        var goWrap = View(screenStyle())
        goWrap.setStyle(chatHalfBtnWrapCss())
        goWrap.bind(goBtn)
        var btns = Row(listOf(backWrap, goWrap))
        btns.setId("chat-assign-actions")
        btns.setStyle(chatFooterBtnsCss())
        content.add(btns)
    } else if (kind == "EXPENSE_LIST") {
        ensureSelectionInitialized(interaction)
        val items = interaction.items()
        // Chips: "Todas" + cada categoria presente nos gastos.
        var cats: List<String> = listOf()
        for (var it in items) {
            if (!cats.contains(it.groupLabel())) {
                cats.add(it.groupLabel())
            }
        }
        var filterChips: List<View> = listOf()
        filterChips.add(chip("Todas", "chat-exp-filter-all", ChatUi.expenseFilter == "", () -> {
            ChatUi.expenseFilter = ""
            mountScreen(w)
        }))
        for (var c in cats) {
            val cat = c
            filterChips.add(chip(cat, "chat-exp-filter-" + cat, ChatUi.expenseFilter == cat, () -> {
                ChatUi.expenseFilter = cat
                mountScreen(w)
            }))
        }
        content.add(chipGroup(interaction.prompt(), filterChips, "chat-exp-filters"))

        var rows: List<View> = listOf()
        var totalCents = 0
        var shown = 0
        for (var it in items) {
            if (ChatUi.expenseFilter == "" || it.groupLabel() == ChatUi.expenseFilter) {
                var name = Label(it.label())
                name.setStyle(chatInteractionTextCss())
                var sub = Label("")
                val st = it.subtitle()
                if (st != null) { sub = Label(st) }
                sub.setStyle(chatInteractionMutedCss())
                var left = Column(listOf(name, sub))
                left.setStyle(Style("display: flex; flex-direction: column; gap: 2; min-width: 0; flex: 1 1 0"))
                var amt = Label(it.formattedAmount())
                amt.setStyle(chatInteractionAccentCss())
                var row = Row(listOf(left, amt))
                row.setId("chat-exp-item-" + it.id())
                row.setStyle(Style("display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 12; width: 100%; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,.06)"))
                rows.add(row)
                totalCents = totalCents + it.amountCents()
                shown = shown + 1
            }
        }
        if (shown == 0) {
            var none = Label("Nenhum gasto identificado neste extrato ainda.")
            none.setStyle(chatInteractionMutedCss())
            rows.add(none)
        }
        var list = Column(rows)
        list.setId("chat-exp-list")
        list.setStyle(Style("display: flex; flex-direction: column; width: 100%"))
        content.add(list)

        var totalLabel = "Total dos gastos listados"
        if (ChatUi.expenseFilter != "") {
            totalLabel = "Total em " + ChatUi.expenseFilter
        }
        var tl = Label(totalLabel)
        tl.setStyle(chatInteractionMutedCss())
        var tv = Label(brlFromCents(totalCents))
        tv.setId("chat-exp-total")
        tv.setStyle(chatInteractionAccentCss())
        var totalRow = Row(listOf(tl, tv))
        totalRow.setStyle(chatFooterRowCss())
        content.add(totalRow)
        addOptionButtons(w, content, interaction.options())
    } else if (kind == "REVIEW_CHECKLIST") {
        ensureSelectionInitialized(interaction)
        if (!EnvState.loaded && !EnvState.loading) {
            spawn {
                try { loadEnvelopes() } catch (String e) {}
                mountScreen(w)
            }
        }
        val items = interaction.items()

        var prompt = Label(interaction.prompt())
        prompt.setStyle(chatInteractionSubTitleCss())
        content.add(prompt)

        if (items.size > 0 && !ChatUi.reviewPreview) {
            var revItemsColParts: List<View> = listOf()
            for (var item in items) {
                val itemId = item.id()
                val checked = isSelectedItem(itemId)
                revItemsColParts.add(selectableCheckRow(
                    w,
                    "chat-rev-item-" + itemId,
                    checked,
                    item.label(),
                    item.subtitle(),
                    item.formattedAmount(),
                    () -> {
                        toggleSelectedItem(itemId)
                        mountScreen(w)
                    }
                ))
                // Categoria escolhida pelo usuário para ESTE item (sem palpite pelo nome).
                if (checked) {
                    var itemChips: List<View> = listOf()
                    for (var code in listOf("FOOD", "GROCERIES", "TRANSPORT", "HOUSING", "HEALTH", "LEISURE", "EDUCATION", "OTHER")) {
                        val c = code
                        itemChips.add(chip(categoryNamePt(c), "chat-rev-cat-" + itemId + "-" + c, itemCategory(itemId) == c, () -> {
                            setItemCategory(itemId, c)
                            mountScreen(w)
                        }))
                    }
                    // Caixinhas criadas pelo usuário (nome livre) também são destino.
                    for (var env in envelopeItems()) {
                        if (categoryOrNullPt(env.categoryName())) {
                            val envCode = "ENV:" + env.id()
                            itemChips.add(chip(env.categoryName(), "chat-rev-cat-" + itemId + "-env-" + env.id(), itemCategory(itemId) == envCode, () -> {
                                setItemCategory(itemId, envCode)
                                mountScreen(w)
                            }))
                        }
                    }
                    itemChips.add(chip("+ Criar caixinha", "chat-rev-new-box-" + itemId, false, () -> {
                        ChatUi.newBoxOpen = true
                        mountScreen(w)
                    }))
                    revItemsColParts.add(chipGroup("Para que foi esse gasto?", itemChips, "chat-rev-cats-" + itemId))
                }
            }
            if (ChatUi.newBoxOpen) {
                var boxField = textField("Nome da caixinha (ex.: Empréstimos)", "text", "chat-rev-new-box-name")
                boxField.setText(ChatUi.newBoxName)
                boxField.on("input", () -> {
                    ChatUi.newBoxName = boxField.text()
                })
                var createBtn = primaryButton("Criar caixinha", "chat-rev-new-box-create", false, () -> {
                    spawn {
                        createBoxFromReview(interaction)
                        invalidateEnvelopes()
                        mountScreen(w)
                    }
                })
                var closeBtn = secondaryButton("Cancelar", "chat-rev-new-box-cancel", false, () -> {
                    ChatUi.newBoxOpen = false
                    mountScreen(w)
                })
                var boxBtns = Row(listOf(closeBtn, createBtn))
                boxBtns.setStyle(chatFooterBtnsCss())
                var boxForm = Column(listOf(labeled("Nova caixinha", boxField), boxBtns))
                boxForm.setId("chat-rev-new-box")
                boxForm.setStyle(chatFlowBoxCss())
                revItemsColParts.add(boxForm)
            }
            var revCol = Column(revItemsColParts)
            revCol.setId("chat-rev-items")
            revCol.setStyle(Style("display: flex; flex-direction: column; gap: 8; width: 100%"))
            content.add(revCol)
        } else if (items.size > 0) {
            var pvParts: List<View> = listOf()
            var pvTitle = Label("Prévia antes de salvar")
            pvTitle.setStyle(chatInteractionSubTitleCss())
            pvParts.add(pvTitle)
            for (var item in items) {
                if (isSelectedItem(item.id())) {
                    pvParts.add(interactionFlowLine(item.label() + " → " + categoryNamePt(itemCategory(item.id())), item.formattedAmount(), "chat-rev-preview-" + item.id()))
                }
            }
            var pvNote = Label("Depois de confirmar, esses valores passam a contar nos seus gastos e no Dashboard.")
            pvNote.setStyle(chatInteractionMutedCss())
            pvParts.add(pvNote)
            var pvBox = Column(pvParts)
            pvBox.setId("chat-rev-preview")
            pvBox.setStyle(chatFlowBoxCss())
            content.add(pvBox)
        } else {
            var nonePend = Label("Não há movimentações pendentes aguardando classificação neste documento.")
            nonePend.setStyle(chatInteractionMutedCss())
            content.add(nonePend)
        }

        addDetailsBlock(w, content, interaction)

        if (ChatUi.interactionError != "") {
            content.add(errorBanner(ChatUi.interactionError))
        }

        var revDivider = View(screenStyle())
        revDivider.setStyle(chatInteractionDividerCss())
        content.add(revDivider)

        var cancelRevLabel = "Cancelar"
        if (ChatUi.reviewPreview) { cancelRevLabel = "Voltar e corrigir" }
        var cancelRevBtn = secondaryButton(cancelRevLabel, "chat-rev-cancel", false, () -> {
            if (ChatUi.reviewPreview) {
                ChatUi.reviewPreview = false
            } else {
                cancelInteractiveTemplate()
            }
            mountScreen(w)
        })
        var cancelRevWrap = View(screenStyle())
        cancelRevWrap.setStyle(chatHalfBtnWrapCss())
        cancelRevWrap.bind(cancelRevBtn)

        var confirmRevLabel = "Ver prévia"
        if (ChatUi.reviewPreview) { confirmRevLabel = "Confirmar e salvar" }
        if (ChatUi.interactionBusy) {
            confirmRevLabel = "Salvando suas alterações..."
        }
        var confirmRevBtn = primaryButton(confirmRevLabel, "chat-rev-confirm", false, () -> {
            if (!ChatUi.reviewPreview) {
                openReviewPreview(interaction)
                mountScreen(w)
                return
            }
            spawn {
                confirmReviewPerItemAction(interaction)
                invalidateFinancialCaches()
                mountScreen(w)
            }
        })
        if (ChatUi.interactionBusy || items.size == 0) {
            confirmRevBtn.setDisabled(true)
        }
        var confirmRevWrap = View(screenStyle())
        confirmRevWrap.setStyle(chatHalfBtnWrapCss())
        confirmRevWrap.bind(confirmRevBtn)

        var revBtns = Row(listOf(cancelRevWrap, confirmRevWrap))
        revBtns.setId("chat-rev-actions")
        revBtns.setStyle(chatFooterBtnsCss())
        content.add(revBtns)

        var gotoRegBtn = Button("Ir para registro da fatura", () -> submitInteractionPrompt(w, "Organizar caixinhas"))
        gotoRegBtn.setId("chat-rev-goto-register")
        gotoRegBtn.setStyle(chatInteractionActionCss())
        content.add(gotoRegBtn)
    } else if (kind == "VIEW_CATEGORIES") {
        ensureSelectionInitialized(interaction)
        val items = interaction.items()
        val selectedCount = countSelectedItems(items)

        var prompt = Label(interaction.prompt())
        prompt.setStyle(chatInteractionSubTitleCss())
        content.add(prompt)

        if (items.size > 0) {
            var catParts: List<View> = listOf()
            for (var item in items) {
                val catId = item.id()
                catParts.add(selectableCheckRow(
                    w,
                    "chat-cat-item-" + catId,
                    isSelectedItem(catId),
                    item.label(),
                    item.subtitle(),
                    item.formattedAmount(),
                    () -> {
                        toggleSelectedItem(catId)
                        mountScreen(w)
                    }
                ))
            }
            var catCol = Column(catParts)
            catCol.setId("chat-cat-items")
            catCol.setStyle(Style("display: flex; flex-direction: column; gap: 8; width: 100%"))
            content.add(catCol)
        }

        addDetailsBlock(w, content, interaction)

        if (ChatUi.interactionError != "") {
            content.add(errorBanner(ChatUi.interactionError))
        }
        if (ChatUi.interactionInfo != "") {
            var infoLbl = Label(ChatUi.interactionInfo)
            infoLbl.setStyle(chatInteractionTextCss())
            var infoBox = Row(listOf(icon("check", 16, "success"), infoLbl))
            infoBox.setId("chat-cat-info")
            infoBox.setStyle(chatSuccessBoxCss())
            content.add(infoBox)
        }

        var catDivider = View(screenStyle())
        catDivider.setStyle(chatInteractionDividerCss())
        content.add(catDivider)

        var catSumLeft = Label("Categorias marcadas")
        catSumLeft.setStyle(chatInteractionMutedCss())
        var catSumRight = Label(brlFromCents(sumSelectedCents(items)) + " (" + String.valueOf(selectedCount) + " de " + String.valueOf(items.size) + ")")
        catSumRight.setId("chat-cat-total")
        catSumRight.setStyle(chatInteractionAccentCss())
        var catSumRow = Row(listOf(catSumLeft, catSumRight))
        catSumRow.setStyle(chatFooterRowCss())
        content.add(catSumRow)

        var cancelCatBtn = secondaryButton("Fechar", "chat-cat-cancel", false, () -> {
            cancelInteractiveTemplate()
            mountScreen(w)
        })
        var cancelCatWrap = View(screenStyle())
        cancelCatWrap.setStyle(chatHalfBtnWrapCss())
        cancelCatWrap.bind(cancelCatBtn)

        var applyCatBtn = primaryButton("Ver categorias selecionadas", "chat-cat-apply", false, () -> {
            spawn {
                applyViewCategoriesAction(interaction)
                mountScreen(w)
            }
        })
        if (ChatUi.interactionBusy) {
            applyCatBtn.setDisabled(true)
        }
        var applyCatWrap = View(screenStyle())
        applyCatWrap.setStyle(chatHalfBtnWrapCss())
        applyCatWrap.bind(applyCatBtn)

        var catBtns = Row(listOf(cancelCatWrap, applyCatWrap))
        catBtns.setStyle(chatFooterBtnsCss())
        content.add(catBtns)

        var regCta = Button("Registrar gastos nas caixinhas", () -> submitInteractionPrompt(w, "Organizar caixinhas"))
        regCta.setId("chat-cat-goto-register")
        regCta.setStyle(chatInteractionActionCss())
        content.add(regCta)

        var dashCta = Button("Abrir Dashboard", () -> navigateTo(w, "dashboard"))
        dashCta.setId("chat-cat-goto-dash")
        dashCta.setStyle(chatInteractionActionCss())
        content.add(dashCta)
    } else if (kind == "INVOICE_REGISTERED") {
        val summary = interaction.summary()
        var okText = "Gastos confirmados e salvos nas suas caixinhas."
        if (summary != null) {
            okText = "Registrado: " + summary.totalOutflowsText() + " em " + String.valueOf(summary.outflowsCount()) + " lançamento(s) confirmado(s)."
        }
        var okLbl = Label(okText)
        okLbl.setStyle(chatInteractionTextCss())
        var okBox = Row(listOf(icon("check", 16, "success"), okLbl))
        okBox.setId("chat-registered-box")
        okBox.setStyle(chatSuccessBoxCss())
        content.add(okBox)

        var regDivider = View(screenStyle())
        regDivider.setStyle(chatInteractionDividerCss())
        content.add(regDivider)

        var regPrompt = Label(interaction.prompt())
        regPrompt.setStyle(chatInteractionSubTitleCss())
        content.add(regPrompt)

        var dashBtn = primaryButton("Abrir Dashboard", "chat-registered-dash", false, () -> navigateTo(w, "dashboard"))
        var envsBtn = secondaryButton("Ver minhas Caixinhas", "chat-registered-envs", false, () -> navigateTo(w, "envelopes"))
        var dWrap = View(screenStyle())
        dWrap.setStyle(chatHalfBtnWrapCss())
        dWrap.bind(dashBtn)
        var eWrap = View(screenStyle())
        eWrap.setStyle(chatHalfBtnWrapCss())
        eWrap.bind(envsBtn)
        var regRow = Row(listOf(dWrap, eWrap))
        regRow.setId("chat-registered-actions")
        regRow.setStyle(chatFooterBtnsCss())
        content.add(regRow)
    } else {
        // SINGLE_ACTION — Resumo Entradas / Saídas + Detalhes + 4 botões principais
        val summary = interaction.summary()
        if (summary != null) {
            content.add(flowSummaryGroupBox("chat-entradas-box", "Entradas", summary.totalInflowsText(), summary.entradas(), "Nenhuma entrada neste extrato", true))
            var gastosTitle = "Seus gastos"
            val per = summary.periodLabel().trim()
            if (per != "" && per != "Período a confirmar") {
                gastosTitle = "Seus gastos de " + per.split(" ")[0].toLowerCase()
            }
            content.add(flowSummaryGroupBox("chat-saidas-box", gastosTitle, "", summary.saidas(), "Nenhum gasto identificado ainda", false))
            if (summary.pendingText() != "" && summary.pendingCount() > 0) {
                var pending = Label("Aguardando sua revisão: " + summary.pendingText() + " (" + String.valueOf(summary.pendingCount()) + ")")
                pending.setStyle(chatInteractionMutedCss())
                content.add(pending)
            }
        }
        addDetailsBlock(w, content, interaction)
        var divider = View(screenStyle())
        divider.setStyle(chatInteractionDividerCss())
        content.add(divider)
        var prompt = Label(interaction.prompt())
        prompt.setStyle(chatInteractionSubTitleCss())
        content.add(prompt)
        addOptionButtons(w, content, interaction.options())
    }

    var card = Column(content)
    card.setId("chat-interaction-card")
    card.setStyle(chatInteractionCardCss())
    return card
}

// Bolhas da mais nova para a mais antiga (a lista usa column-reverse).
List<View> chatBubblesNewestFirst() {
    var out: List<View> = listOf()
    if (ChatUi.activeRequests > 0) {
        var t = Label("Organizando...")
        t.setId("chat-typing")
        t.setStyle(chatTypingCss())
        out.add(t)
    }
    var pendingIndex = 0
    for (var pending in ChatUi.pendingQueue.split("\n")) {
        if (pending != "") {
            pendingIndex = pendingIndex + 1
            out.add(chatBubble("USER", chatDecode(pending), "chat-pending-" + String.valueOf(pendingIndex)))
        }
    }
    var lines = ChatState.messages.split("\n")
    var n = 0
    for (var i = lines.size - 1; i >= 0; i--) {
        var line = lines[i]
        var bar = line.indexOf("|")
        if (bar > 0) {
            n = n + 1
            var role = line.substring(0, bar)
            var idPrefix = "chat-user-msg-"
            if (role == "ASSISTANT") {
                idPrefix = "chat-assistant-msg-"
            }
            out.add(chatBubble(role, chatDecode(line.substring(bar + 1)), idPrefix + String.valueOf(i + 1)))
        }
    }
    out.add(chatBubble("ASSISTANT", chatGreeting(), "chat-greeting"))
    return out
}

Bool showChatCounter() {
    if (!ChatUi.usageKnown || ChatUi.limit < 0) {
        return false
    }
    return ChatUi.blocked || (ChatUi.limit - ChatUi.used <= 5)
}

String chatCounterText() {
    if (!showChatCounter()) {
        return ""
    }
    return String.valueOf(ChatUi.used) + " de " + String.valueOf(ChatUi.limit) + " mensagens neste mês"
}

View chatFeatureButton(String iconName, Int size, String tone, String id, Bool enabled, Style enabledCss, Style disabledCss, String label) {
    var b = View(screenStyle())
    b.setId(id)
    b.setAccessibleName(label)
    if (enabled) {
        b.setStyle(enabledCss)
    } else {
        b.setDisabled(true)
        b.setStyle(disabledCss)
    }
    b.bind(icon(iconName, size, tone))
    return b
}

// Reprodutor e gravador de áudio STT com o ícone oficial de microfone do DS.
View chatVoiceButton(Bool enabled, String label) {
    var b = View(screenStyle())
    b.setId("chat-mic")
    b.setAccessibleName(label)
    if (enabled) {
        b.setStyle(chatMicCss())
    } else {
        b.setDisabled(true)
        b.setStyle(chatMicOffCss())
    }
    b.bind(icon("mic", 22, "secondary"))
    return b
}

ensureChatLoaded(Window w) {
    if (SessionState.token == "" || ChatUi.loadedFor == SessionState.token) {
        return
    }
    ChatUi.loadedFor = SessionState.token
    ChatUi.loading = true
    spawn {
        loadChat()
        mountScreen(w)
    }
}

// Lista de conversas ("Seus chats"). No desktop é montada dentro do menu
// lateral; no mobile, ao lado do chat.
View chatSessionsBlock(Window w) {
    var sideTitle = Label("Seus chats")
    sideTitle.setStyle(chatSidebarTitleCss())
    var c1 = Button("Chat 1 · Conversa anterior", () -> {
        switchChatSession(1)
        mountScreen(w)
    })
    c1.setId("chat-session-1")
    if (!AppState.isDesktop && ChatUi.currentChatId == 1) {
        c1.setStyle(chatSessionActiveMobileCss())
    } else if (ChatUi.currentChatId == 1) {
        c1.setStyle(chatSessionActiveCss())
    } else if (!AppState.isDesktop) {
        c1.setStyle(chatSessionBtnMobileCss())
    } else {
        c1.setStyle(chatSessionBtnCss())
    }
    var c2 = Button("Chat 2 · Fatura atual", () -> {
        switchChatSession(2)
        mountScreen(w)
    })
    c2.setId("chat-session-2")
    if (!AppState.isDesktop && ChatUi.currentChatId == 2) {
        c2.setStyle(chatSessionActiveMobileCss())
    } else if (ChatUi.currentChatId == 2) {
        c2.setStyle(chatSessionActiveCss())
    } else if (!AppState.isDesktop) {
        c2.setStyle(chatSessionBtnMobileCss())
    } else {
        c2.setStyle(chatSessionBtnCss())
    }
    var sideCol = Column(listOf(sideTitle, c2, c1))
    sideCol.setId("chat-sessions-sidebar")
    if (AppState.isDesktop) {
        sideCol.setStyle(Style("display: flex; flex-direction: column; gap: 6; width: 100%; padding: 12px 0 0 0; margin-top: 8; box-sizing: border-box; border-top: 1px solid rgba(255,255,255,.1)"))
    } else {
        sideCol.setStyle(chatSidebarMobileCss())
    }
    return sideCol
}

// Menu lateral (desktop): bloco "Seus chats" quando há conversas e a tela é o chat.
View? chatSidebarExtra(Window w) {
    if (AppState.currentScreen == "chat" && ChatUi.totalChats >= 2) {
        return chatSessionsBlock(w)
    }
    return null
}

View chatScreen(Window w) {
    ensureChatLoaded(w)

    var messages: List<View> = listOf()
    if (ChatUi.interactionJson != "") {
        messages.add(chatInteractionCard(w))
    }
    messages.addAll(chatBubblesNewestFirst())
    var list = Column(messages)
    list.setId("chat-messages")
    list.setStyle(chatListCss())

    var field = textField("Fale com o Organiza e ele te explicará seus gastos...", "text", "chat-input")
    field.setText(ChatUi.draft)
    if (AppState.isDesktop) {
        field.setStyle(chatInputCss())
    } else {
        field.setStyle(chatInputMobileCss())
    }
    field.on("input", () -> {
        ChatUi.draft = field.text()
    })

    var off = ChatUi.blocked
    var attach = chatFeatureButton("plus", 20, "secondary", "chat-attach", true, chatAttachCss(), chatAttachOffCss(), "Anexar PDF, PNG ou fatura")
    var mic = chatVoiceButton(true, "Entrada por voz")

    var send = View(screenStyle())
    send.setId("chat-send")
    send.setAccessibleName("Enviar")
    if (off) {
        field.setDisabled(true)
        send.setDisabled(true)
        send.setStyle(chatSendOffCss())
        send.bind(sendSymbol("chat-send-mark"))
    } else {
        send.setStyle(chatSendCss())
        send.bind(sendSymbol("chat-send-mark"))
    }

    var bar = Form(listOf(attach, field, mic, send))
    bar.setId("chat-form")
    if (AppState.isDesktop) {
        bar.setStyle(chatBarCss())
    } else {
        bar.setStyle(chatBarMobileCss())
    }
    bar.onSubmit(() -> {
        var text = field.text().trim()
        if (text != "" && !ChatUi.blocked) {
            queueChatMessage(text)
            ChatUi.draft = ""
            ChatUi.error = ""
            mountScreen(w)
            spawn {
                sendChatMessage(text)
                invalidateFinancialCaches()
                mountScreen(w)
            }
        }
    })
    if (!off) {
        send.on("click", () -> bar.submit())
    }

    var composerParts: List<View> = listOf()
    composerParts.add(bar)
    if (showChatCounter()) {
        var counter = Label(chatCounterText())
        counter.setId("chat-counter")
        counter.setStyle(chatCounterCss())
        composerParts.add(counter)
    }
    var composer = Column(composerParts)
    composer.setId("chat-composer")
    composer.setStyle(chatComposerCss())

    var parts: List<View> = listOf()
    parts.add(list)
    if (ChatUi.error != "") {
        var err = errorBanner(ChatUi.error)
        err.setId("chat-error")
        parts.add(err)
    }
    parts.add(composer)

    var body = Column(parts)
    body.setStyle(chatBodyCss())

    var mainArea: View = body
    // Desktop: "Seus chats" fica no menu lateral (navigation.kf). Mobile: ao lado do chat.
    if (ChatUi.totalChats >= 2 && !AppState.isDesktop) {
        var wsRow = Row(listOf(chatSessionsBlock(w), body))
        wsRow.setId("chat-workspace-row")
        wsRow.setStyle(chatWorkspaceRowMobileCss())
        mainArea = wsRow
    }

    var col = Column(listOf(topbar("Organiza AI", "Assistente online", chatHeaderActions(w)), mainArea))
    col.setId("screen-chat")
    if (AppState.isDesktop) {
        col.setStyle(chatScreenDesktopCss())
    } else {
        col.setStyle(chatScreenMobileCss())
    }
    return col
}
