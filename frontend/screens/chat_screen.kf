View newChatTopButton(Window w) {
    var txt = Label("Novo chat")
    txt.setStyle(chatNewTopLabelCss())
    var inner = Row(listOf(icon("plus", 14, "accent"), txt))
    inner.setStyle(chatNewTopRowCss())
    var btn = View(screenStyle())
    btn.setId("chat-new-btn")
    btn.setAccessibleName("Novo chat")
    btn.setStyle(chatNewTopBtnCss())
    btn.bind(inner)
    btn.on("click", () -> {
        spawn {
            clearChatHistory()
            mountScreen(w)
        }
    })
    return btn
}

String chatGreeting() {
    var name = SessionState.userName.trim()
    var sp = name.indexOf(" ")
    if (sp > 0) {
        name = name.substring(0, sp)
    }
    var hi = "Oi!"
    if (name != "") {
        hi = "Oi, " + name + "!"
    }
    return hi + " Me fala seus gastos aí. Você pode digitar, falar por voz ou enviar sua fatura por aqui que eu leio e organizo tudo pra você."
}

Label chatBubble(String role, String text, String id) {
    var b = Label(text)
    b.setId(id)
    if (role == "USER") {
        b.setStyle(chatBubbleUserCss())
    } else {
        b.setStyle(chatBubbleAiCss())
    }
    return b
}

submitInteractionPrompt(Window w, String prompt) {
    var text = prompt.trim()
    if (text == "" || ChatUi.blocked) { return }
    queueChatMessage(text)
    ChatUi.draft = ""
    ChatUi.error = ""
    mountScreen(w)
    spawn {
        sendChatMessage(text)
        invalidateFinancialCaches()
        mountScreen(w)
    }
}

View interactionFlowLine(String label, String amount, String id) {
    var left = Label(label)
    left.setStyle(chatInteractionTextCss())
    var right = Label(amount)
    right.setStyle(chatInteractionTextCss())
    var row = Row(listOf(left, right))
    row.setId(id)
    row.setStyle(Style("display: flex; flex-direction: row; justify-content: space-between; align-items: center; gap: 12; width: 100%"))
    return row
}

View chatInteractionCard(Window w) {
    val interaction = json.decode<ChatInteractionResponse>(ChatUi.interactionJson)
    var content: List<View> = listOf()
    var brand = Row(listOf(brandMark(24, "chat-interaction-brand"), Label("Organiza AI")))
    brand.setId("chat-interaction-header")
    brand.setStyle(chatInteractionHeaderCss())
    content.add(brand)
    var headline = interaction.headline()
    if (headline != null && headline.trim() != "") {
        var title = Label(headline)
        title.setStyle(chatInteractionTitleCss())
        content.add(title)
    }
    val summary = interaction.summary()
    if (summary != null) {
        var period = summary.periodLabel()
        if (period != "") {
            var label = Label("Resumo de " + period.toLowerCase())
            label.setStyle(chatInteractionTextCss())
            content.add(label)
        }
        for (var entry in summary.entradas()) {
            content.add(interactionFlowLine(entry.label(), entry.formattedAmount(), "chat-flow-in-" + entry.label()))
        }
        for (var expense in summary.saidas()) {
            content.add(interactionFlowLine(expense.label(), expense.formattedAmount(), "chat-flow-out-" + expense.label()))
        }
        if (summary.pendingText() != "") {
            var pending = Label(summary.pendingText())
            pending.setStyle(chatInteractionTextCss())
            content.add(pending)
        }
    }
    var tip = interaction.educationTip()
    if (tip != null && tip.trim() != "") {
        var note = Label("💡 " + tip)
        note.setStyle(chatInteractionTextCss())
        content.add(note)
    }
    var divider = View(screenStyle())
    divider.setStyle(chatInteractionDividerCss())
    content.add(divider)
    var prompt = Label(interaction.prompt())
    prompt.setStyle(chatInteractionTitleCss())
    content.add(prompt)
    val details = interaction.details()
    if (details != null) {
        var detailLabel = "Detalhes da análise"
        if (ChatUi.interactionDetailsOpen) { detailLabel = "Ocultar detalhes da análise" }
        var detailButton = Button(detailLabel, () -> {
            ChatUi.interactionDetailsOpen = !ChatUi.interactionDetailsOpen
            mountScreen(w)
        })
        detailButton.setId("chat-interaction-details-toggle")
        detailButton.setStyle(chatInteractionDetailCss())
        content.add(detailButton)
        if (ChatUi.interactionDetailsOpen) {
            for (var item in details.items()) {
                var detail = Label(item)
                detail.setStyle(chatInteractionTextCss())
                content.add(detail)
            }
        }
    }
    var actions: List<View> = listOf()
    var index = 0
    for (var option in interaction.options()) {
        val actionPrompt = option.label()
        var label = actionPrompt
        if (option.badgeCount() > 0) {
            label = label + " (" + String.valueOf(option.badgeCount()) + ")"
        }
        var action = Button(label, () -> submitInteractionPrompt(w, actionPrompt))
        action.setId("chat-interaction-option-" + option.id())
        action.setAccessibleName(option.label())
        action.setStyle(chatInteractionActionCss())
        actions.add(action)
        index = index + 1
    }
    if (actions.size > 0) {
        var stack = Column(actions)
        stack.setId("chat-interaction-options")
        stack.setStyle(Style("display: flex; flex-direction: column; gap: 8; width: 100%"))
        content.add(stack)
    }
    var card = Column(content)
    card.setId("chat-interaction-card")
    card.setStyle(chatInteractionCardCss())
    return card
}

// Bolhas da mais nova para a mais antiga (a lista usa column-reverse).
List<View> chatBubblesNewestFirst() {
    var out: List<View> = listOf()
    if (ChatUi.activeRequests > 0) {
        var t = Label("Organizando...")
        t.setId("chat-typing")
        t.setStyle(chatTypingCss())
        out.add(t)
    }
    var pendingIndex = 0
    for (var pending in ChatUi.pendingQueue.split("\n")) {
        if (pending != "") {
            pendingIndex = pendingIndex + 1
            out.add(chatBubble("USER", chatDecode(pending), "chat-pending-" + String.valueOf(pendingIndex)))
        }
    }
    var lines = ChatState.messages.split("\n")
    var n = 0
    for (var i = lines.size - 1; i >= 0; i--) {
        var line = lines[i]
        var bar = line.indexOf("|")
        if (bar > 0) {
            n = n + 1
            var role = line.substring(0, bar)
            var idPrefix = "chat-user-msg-"
            if (role == "ASSISTANT") {
                idPrefix = "chat-assistant-msg-"
            }
            out.add(chatBubble(role, chatDecode(line.substring(bar + 1)), idPrefix + String.valueOf(i + 1)))
        }
    }
    out.add(chatBubble("ASSISTANT", chatGreeting(), "chat-greeting"))
    return out
}

Bool showChatCounter() {
    if (!ChatUi.usageKnown || ChatUi.limit < 0) {
        return false
    }
    return ChatUi.blocked || (ChatUi.limit - ChatUi.used <= 5)
}

String chatCounterText() {
    if (!showChatCounter()) {
        return ""
    }
    return String.valueOf(ChatUi.used) + " de " + String.valueOf(ChatUi.limit) + " mensagens neste mês"
}

View chatFeatureButton(String iconName, Int size, String tone, String id, Bool enabled, Style enabledCss, Style disabledCss, String label) {
    var b = View(screenStyle())
    b.setId(id)
    b.setAccessibleName(label)
    if (enabled) {
        b.setStyle(enabledCss)
    } else {
        b.setDisabled(true)
        b.setStyle(disabledCss)
    }
    b.bind(icon(iconName, size, tone))
    return b
}

// Reprodutor e gravador de áudio STT com o ícone oficial de microfone do DS.
View chatVoiceButton(Bool enabled, String label) {
    var b = View(screenStyle())
    b.setId("chat-mic")
    b.setAccessibleName(label)
    if (enabled) {
        b.setStyle(chatMicCss())
    } else {
        b.setDisabled(true)
        b.setStyle(chatMicOffCss())
    }
    b.bind(icon("mic", 22, "secondary"))
    return b
}

ensureChatLoaded(Window w) {
    if (SessionState.token == "" || ChatUi.loadedFor == SessionState.token) {
        return
    }
    ChatUi.loadedFor = SessionState.token
    ChatUi.loading = true
    spawn {
        loadChat()
        mountScreen(w)
    }
}

View chatScreen(Window w) {
    ensureChatLoaded(w)

    var messages: List<View> = listOf()
    if (ChatUi.interactionJson != "") {
        messages.add(chatInteractionCard(w))
    }
    messages.addAll(chatBubblesNewestFirst())
    var list = Column(messages)
    list.setId("chat-messages")
    list.setStyle(chatListCss())

    var field = textField("Fale com o Organiza e ele te explicará seus gastos...", "text", "chat-input")
    field.setText(ChatUi.draft)
    field.setStyle(chatInputCss())
    field.on("input", () -> {
        ChatUi.draft = field.text()
    })

    var off = ChatUi.blocked
    var attach = chatFeatureButton("plus", 20, "secondary", "chat-attach", true, chatAttachCss(), chatAttachOffCss(), "Anexar PDF, PNG ou fatura")
    var mic = chatVoiceButton(true, "Entrada por voz")

    var send = View(screenStyle())
    send.setId("chat-send")
    send.setAccessibleName("Enviar")
    if (off) {
        field.setDisabled(true)
        send.setDisabled(true)
        send.setStyle(chatSendOffCss())
        send.bind(sendSymbol("chat-send-mark"))
    } else {
        send.setStyle(chatSendCss())
        send.bind(sendSymbol("chat-send-mark"))
    }

    var bar = Form(listOf(attach, field, mic, send))
    bar.setId("chat-form")
    bar.setStyle(chatBarCss())
    bar.onSubmit(() -> {
        var text = field.text().trim()
        if (text != "" && !ChatUi.blocked) {
            queueChatMessage(text)
            ChatUi.draft = ""
            ChatUi.error = ""
            mountScreen(w)
            spawn {
                sendChatMessage(text)
                invalidateFinancialCaches()
                mountScreen(w)
            }
        }
    })
    if (!off) {
        send.on("click", () -> bar.submit())
    }

    var composerParts: List<View> = listOf()
    composerParts.add(bar)
    if (showChatCounter()) {
        var counter = Label(chatCounterText())
        counter.setId("chat-counter")
        counter.setStyle(chatCounterCss())
        composerParts.add(counter)
    }
    var composer = Column(composerParts)
    composer.setId("chat-composer")
    composer.setStyle(chatComposerCss())

    var parts: List<View> = listOf()
    parts.add(list)
    if (ChatUi.error != "") {
        var err = errorBanner(ChatUi.error)
        err.setId("chat-error")
        parts.add(err)
    }
    parts.add(composer)

    var body = Column(parts)
    body.setStyle(chatBodyCss())

    var mainArea: View = body
    if (ChatUi.totalChats >= 2) {
        var sideTitle = Label("Seus chats")
        sideTitle.setStyle(chatSidebarTitleCss())
        var c1 = Button("Chat 1 · Conversa anterior", () -> {
            switchChatSession(1)
            mountScreen(w)
        })
        c1.setId("chat-session-1")
        if (ChatUi.currentChatId == 1) {
            c1.setStyle(chatSessionActiveCss())
        } else {
            c1.setStyle(chatSessionBtnCss())
        }
        var c2 = Button("Chat 2 · Fatura atual", () -> {
            switchChatSession(2)
            mountScreen(w)
        })
        c2.setId("chat-session-2")
        if (ChatUi.currentChatId == 2) {
            c2.setStyle(chatSessionActiveCss())
        } else {
            c2.setStyle(chatSessionBtnCss())
        }
        var sideCol = Column(listOf(sideTitle, c2, c1))
        sideCol.setId("chat-sessions-sidebar")
        sideCol.setStyle(chatSidebarColCss())
        var wsRow = Row(listOf(sideCol, body))
        wsRow.setId("chat-workspace-row")
        wsRow.setStyle(chatWorkspaceRowCss())
        mainArea = wsRow
    }

    var col = Column(listOf(topbar("Organiza AI", "Assistente online", newChatTopButton(w)), mainArea))
    col.setId("screen-chat")
    if (AppState.isDesktop) {
        col.setStyle(chatScreenDesktopCss())
    } else {
        col.setStyle(chatScreenMobileCss())
    }
    return col
}
