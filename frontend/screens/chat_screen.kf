package screens

import kof.ui
import core.theme
import core.app_state
import components.topbar

// =============================================================================
// Tela 10 Organiza AI (F2) — stub do shell (Batch 3, T0)
// =============================================================================
// Contrato: chatScreen(Window w) devolve o corpo da rota "chat" (o shell já põe a
// sidebar/barra inferior). Começa pela topbar com o título exato; a tarefa
// dona da tela substitui o resto do corpo.
// =============================================================================

View chatScreen(Window w) {
    var col = Column(listOf(topbar("Organiza AI", "Assistente online", null)))
    col.setId("screen-chat")
    col.setStyle(stackCss())
    return col
}
