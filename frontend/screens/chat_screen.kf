package screens

import kof.ui
import core.theme
import core.app_state
import core.chat_api
import core.navigation
import components.topbar
import components.form_widgets
import components.icons
import components.brand_mark

// =============================================================================
// Tela 10 Organiza AI (Batch 3, F2; B1 fidelidade Desktop + Mobile)
// =============================================================================
// Topbar "Organiza AI" + "Assistente online" (ponto verde em topbar.kf);
// bolhas fiéis ao artefato (max-width 75%, 13px, canto de 3px, IA #1A1F3A sem
// borda, usuária #00D4FF peso 600); saudação fixa sem prometer voz nem PDF;
// lista flex (flex: 1 1 0; min-height: 0) com column-reverse entre topbar e
// composer preso embaixo; composer em caixa única (raio 14) com plus e mic
// 26px desativados + enviar 30px gradiente com icon("send", ..., "onaccent");
// contador "N de 30" visível só quando faltam <= 5 ou no limite; 402/503
// mantêm o rascunho.
// =============================================================================

Style chatScreenDesktopCss() = Style("display: flex; flex-direction: column; gap: 16; width: 100%; flex: 1 1 0; min-height: 0")
Style chatScreenMobileCss()  = Style("display: flex; flex-direction: column; gap: 12; width: 100%; flex: 1 1 0; min-height: 0")
Style chatBodyCss()          = Style("display: flex; flex-direction: column; gap: 12; width: 100%; flex: 1 1 0; min-height: 0; padding-top: 10px; box-sizing: border-box")
Style chatListCss()          = Style("display: flex; flex-direction: column-reverse; gap: 18; width: 100%; max-width: 1088; align-self: center; flex: 1 1 0; min-height: 0; overflow-y: auto; padding: 16px 10px; box-sizing: border-box")
Style chatBubbleAiCss()      = Style("align-self: flex-start; max-width: 74%; background: #1A1F3A; color: #F0F0F0; border: none; border-radius: 20px 20px 20px 4px; padding: 18px 22px; font-size: 1.125rem; font-weight: 500; line-height: 1.4em; white-space: pre-wrap; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatBubbleUserCss()    = Style("align-self: flex-end; max-width: 62%; background: #00C8F5; color: #06121C; font-weight: 600; border: none; border-radius: 20px 20px 4px 20px; padding: 18px 22px; font-size: 1.125rem; line-height: 1.4em; white-space: pre-wrap; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatTypingCss()        = Style("align-self: flex-start; max-width: 74%; background: #1A1F3A; color: #AAB9D3; border: none; border-radius: 20px 20px 20px 4px; padding: 18px 22px; font-size: 1rem; line-height: 1.4em; font-style: italic; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatComposerCss()      = Style("display: flex; flex-direction: column; width: 100%; max-width: 1088; align-self: center; flex-shrink: 0; gap: 8")
Style chatBarCss()           = Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; gap: 10; width: 100%; min-height: 70; flex-shrink: 0; box-sizing: border-box; background: #12141F; border: 1px solid rgba(255,255,255,.12); border-radius: 22; padding: 9px 12px")
Style chatInputCss()         = Style("background: transparent; color: #F0F0F0; border: none; outline: none; height: 48; width: auto; flex: 1 1 0; min-width: 0; box-sizing: border-box; padding: 0 6px; font-size: 1.0625rem; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatAttachCss()        = Style("outline: none; width: 46; height: 46; min-width: 46; flex-shrink: 0; border-radius: 23; background: transparent; border: 1px solid rgba(255,255,255,.14); display: flex; align-items: center; justify-content: center; padding: 0; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatAttachOffCss()     = Style("width: 46; height: 46; min-width: 46; flex-shrink: 0; border-radius: 23; background: transparent; border: 1px solid rgba(255,255,255,.1); display: flex; align-items: center; justify-content: center; padding: 0; opacity: 0.4; cursor: not-allowed; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatMicCss()           = Style("outline: none; width: 42; height: 42; min-width: 42; flex-shrink: 0; border-radius: 21; background: transparent; border: none; display: flex; align-items: center; justify-content: center; padding: 0; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatMicOffCss()        = Style("width: 42; height: 42; min-width: 42; flex-shrink: 0; border-radius: 21; background: transparent; border: none; display: flex; align-items: center; justify-content: center; padding: 0; opacity: 0.4; cursor: not-allowed; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatSendCss()          = Style("outline: none; width: 48; height: 48; min-width: 48; flex-shrink: 0; border-radius: 24; background: linear-gradient(135deg, #00D4FF, #0066FF); border: none; display: flex; align-items: center; justify-content: center; padding: 0; cursor: pointer; box-shadow: 0 6px 18px rgba(0,102,255,.3); font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatSendOffCss()       = Style("width: 48; height: 48; min-width: 48; flex-shrink: 0; border-radius: 24; background: #1A1F3A; border: none; display: flex; align-items: center; justify-content: center; padding: 0; opacity: 0.45; cursor: not-allowed; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatCounterCss()       = Style("color: #AAB9D3; font-size: 0.8125rem; align-self: flex-end; flex-shrink: 0; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")

String chatGreeting() {
    var name = SessionState.userName.trim()
    var sp = name.indexOf(" ")
    if (sp > 0) {
        name = name.substring(0, sp)
    }
    var hi = "Oi!"
    if (name != "") {
        hi = "Oi, " + name + "!"
    }
    return hi + " Me fala seus gastos aí. Você pode digitar, falar por voz ou enviar sua fatura por aqui que eu leio e organizo tudo pra você."
}

Label chatBubble(String role, String text, String id) {
    var b = Label(text)
    b.setId(id)
    if (role == "USER") {
        b.setStyle(chatBubbleUserCss())
    } else {
        b.setStyle(chatBubbleAiCss())
    }
    return b
}

// Bolhas da mais nova para a mais antiga (a lista usa column-reverse).
List<View> chatBubblesNewestFirst() {
    var out: List<View> = listOf()
    if (ChatUi.activeRequests > 0) {
        var t = Label("Organiza AI está digitando…")
        t.setId("chat-typing")
        t.setStyle(chatTypingCss())
        out.add(t)
    }
    var pendingIndex = 0
    for (var pending in ChatUi.pendingQueue.split("\n")) {
        if (pending != "") {
            pendingIndex = pendingIndex + 1
            out.add(chatBubble("USER", chatDecode(pending), "chat-pending-" + String.valueOf(pendingIndex)))
        }
    }
    var lines = ChatState.messages.split("\n")
    var n = 0
    for (var i = lines.size - 1; i >= 0; i--) {
        var line = lines[i]
        var bar = line.indexOf("|")
        if (bar > 0) {
            n = n + 1
            var role = line.substring(0, bar)
            var idPrefix = "chat-user-msg-"
            if (role == "ASSISTANT") {
                idPrefix = "chat-assistant-msg-"
            }
            out.add(chatBubble(role, chatDecode(line.substring(bar + 1)), idPrefix + String.valueOf(i + 1)))
        }
    }
    if (n == 0 && !ChatUi.loading) {
        out.add(chatBubble("ASSISTANT", chatGreeting(), "chat-greeting"))
    }
    return out
}

Bool showChatCounter() {
    if (!ChatUi.usageKnown || ChatUi.limit < 0) {
        return false
    }
    return ChatUi.blocked || (ChatUi.limit - ChatUi.used <= 5)
}

String chatCounterText() {
    if (!showChatCounter()) {
        return ""
    }
    return String.valueOf(ChatUi.used) + " de " + String.valueOf(ChatUi.limit) + " mensagens neste mês"
}

View chatFeatureButton(String iconName, Int size, String tone, String id, Bool enabled, Style enabledCss, Style disabledCss, String label) {
    var b = View(screenStyle())
    b.setId(id)
    b.setAccessibleName(label)
    if (enabled) {
        b.setStyle(enabledCss)
    } else {
        b.setDisabled(true)
        b.setStyle(disabledCss)
    }
    b.bind(icon(iconName, size, tone))
    return b
}

ensureChatLoaded(Window w) {
    if (SessionState.token == "" || ChatUi.loadedFor == SessionState.token) {
        return
    }
    ChatUi.loadedFor = SessionState.token
    ChatUi.loading = true
    spawn {
        loadChat()
        mountScreen(w)
    }
}

View chatScreen(Window w) {
    ensureChatLoaded(w)

    var list = Column(chatBubblesNewestFirst())
    list.setId("chat-messages")
    list.setStyle(chatListCss())

    var field = textField("Pergunte qualquer coisa", "text", "chat-input")
    field.setText(ChatUi.draft)
    field.setStyle(chatInputCss())
    field.on("input", () -> {
        ChatUi.draft = field.text()
    })

    // O Pro pode usar anexos sem limite e voz. Usuários gratuitos enxergam o
    // controle bloqueado, mantendo a regra de plano também explícita na UI.
    var off = ChatUi.blocked
    var attachLabel = "Anexar PDF, DOCX ou JPEG — disponível no Pro"
    var attach = chatFeatureButton("plus", 20, "secondary", "chat-attach", ChatUi.pro, chatAttachCss(), chatAttachOffCss(), attachLabel)
    var micLabel = "Entrada por voz — disponível no Pro"
    var mic = chatFeatureButton("mic", 20, "secondary", "chat-mic", ChatUi.voiceEnabled, chatMicCss(), chatMicOffCss(), micLabel)

    var send = View(screenStyle())
    send.setId("chat-send")
    send.setAccessibleName("Enviar")
    if (off) {
        field.setDisabled(true)
        send.setDisabled(true)
        send.setStyle(chatSendOffCss())
        send.bind(brandMarkOnAccent(34, "chat-send-mark"))
    } else {
        send.setStyle(chatSendCss())
        send.bind(brandMarkOnAccent(34, "chat-send-mark"))
    }

    var bar = Form(listOf(attach, field, mic, send))
    bar.setId("chat-form")
    bar.setStyle(chatBarCss())
    bar.onSubmit(() -> {
        var text = field.text().trim()
        if (text != "" && !ChatUi.blocked) {
            queueChatMessage(text)
            ChatUi.draft = ""
            ChatUi.error = ""
            mountScreen(w)
            spawn {
                sendChatMessage(text)
                mountScreen(w)
            }
        }
    })
    if (!off) {
        send.on("click", () -> bar.submit())
    }

    var composerParts: List<View> = listOf()
    composerParts.add(bar)
    if (showChatCounter()) {
        var counter = Label(chatCounterText())
        counter.setId("chat-counter")
        counter.setStyle(chatCounterCss())
        composerParts.add(counter)
    }
    var composer = Column(composerParts)
    composer.setId("chat-composer")
    composer.setStyle(chatComposerCss())

    var parts: List<View> = listOf()
    parts.add(list)
    if (ChatUi.error != "") {
        var err = errorBanner(ChatUi.error)
        err.setId("chat-error")
        parts.add(err)
    }
    parts.add(composer)

    var body = Column(parts)
    body.setStyle(chatBodyCss())

    var col = Column(listOf(topbar("Organiza AI", "Assistente online", null), body))
    col.setId("screen-chat")
    if (AppState.isDesktop) {
        col.setStyle(chatScreenDesktopCss())
    } else {
        col.setStyle(chatScreenMobileCss())
    }
    return col
}
