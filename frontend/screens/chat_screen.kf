package screens

import kof.ui
import core.theme
import core.app_state
import core.chat_api
import core.navigation
import components.topbar
import components.form_widgets

// =============================================================================
// Tela 10 Organiza AI (Batch 3, F2) — spec S10
// =============================================================================
// Topbar "Organiza AI" + "Assistente online"; bolhas IA (esquerda) e usuário
// (direita); saudação fixa quando o histórico está vazio; "digitando…" durante
// o envio; contador "N de M mensagens"; erros 402 (limite, bloqueia), outros 4xx (mensagem do backend) e 503/rede.
// Anexo (+) e voz ficam DESATIVADOS com "Em breve" (decisões 5 e 6 pendentes).
// A lista usa column-reverse: o navegador mantém o scroll no fim sem JS.
// =============================================================================

Style chatBodyCss()      = Style("display: flex; flex-direction: column; gap: 12; width: 100%; flex-grow: 1; min-height: 0")
Style chatListCss()      = Style("display: flex; flex-direction: column-reverse; gap: 12; width: 100%; flex-grow: 1; min-height: 240; max-height: 60vh; overflow-y: auto; padding: 4px 0")
Style chatTypingCss()    = Style("align-self: flex-start; background: #12162A; color: #7B8EAD; border: 1px solid rgba(255,255,255,.1); border-radius: 12; padding: 12px 16px; font-size: 14; font-style: italic; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatBarCss()       = Style("display: flex; flex-direction: row; align-items: center; gap: 8; width: 100%; flex-wrap: wrap; justify-content: flex-end")
Style chatInputCss()     = Style("background: #12162A; color: #F0F0F0; height: 48; flex: 1 1 240px; min-width: 0; box-sizing: border-box; border: 1px solid rgba(255,255,255,.06); border-radius: 8; padding: 0 16px; font-size: 16; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatIconOffCss()   = Style("width: 48; height: 48; flex-shrink: 0; background: #12162A; color: #4A5578; border: 1px solid rgba(255,255,255,.1); border-radius: 12; font-size: 14; font-weight: 600; cursor: not-allowed; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatSendCss()      = Style("width: 72; height: 48; flex-shrink: 0; background: #00D4FF; color: #06121C; border: none; border-radius: 12; font-size: 14; font-weight: 600; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatSendOffCss()   = Style("width: 72; height: 48; flex-shrink: 0; background: #1A1F3A; color: #4A5578; border: none; border-radius: 12; font-size: 14; font-weight: 600; cursor: not-allowed; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatFootCss()      = Style("display: flex; flex-direction: row; justify-content: space-between; gap: 8; width: 100%")
Style chatHintCss()      = Style("color: #4A5578; font-size: 12; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatCounterCss()   = Style("color: #7B8EAD; font-size: 12; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")

String chatGreeting() {
    var name = SessionState.userName.trim()
    var sp = name.indexOf(" ")
    if (sp > 0) {
        name = name.substring(0, sp)
    }
    var hi = "Oi!"
    if (name != "") {
        hi = "Oi, " + name + "!"
    }
    return hi + " Me fala seus gastos aí. Você pode digitar, falar por voz ou enviar sua fatura por aqui que eu leio e organizo tudo pra você."
}

Label chatBubble(String role, String text, String id) {
    var b = Label(text)
    b.setId(id)
    if (role == "USER") {
        b.setStyle(bubbleUserCss())
    } else {
        b.setStyle(bubbleAiCss())
    }
    return b
}

// Bolhas da mais nova para a mais antiga (a lista usa column-reverse).
List<View> chatBubblesNewestFirst() {
    var out: List<View> = listOf()
    if (ChatUi.pending != "") {
        var t = Label("Organiza AI está digitando…")
        t.setId("chat-typing")
        t.setStyle(chatTypingCss())
        out.add(t)
        out.add(chatBubble("USER", ChatUi.pending, "chat-pending"))
    }
    var lines = ChatState.messages.split("
")
    var n = 0
    for (var i = lines.size - 1; i >= 0; i--) {
        var line = lines[i]
        var bar = line.indexOf("|")
        if (bar > 0) {
            n = n + 1
            out.add(chatBubble(line.substring(0, bar), chatDecode(line.substring(bar + 1)), "chat-msg-" + String.valueOf(i + 1)))
        }
    }
    if (n == 0 && !ChatUi.loading) {
        out.add(chatBubble("ASSISTANT", chatGreeting(), "chat-greeting"))
    }
    return out
}

String chatCounterText() {
    if (!ChatUi.usageKnown) {
        return ""
    }
    if (ChatUi.limit < 0) {
        return String.valueOf(ChatUi.used) + " mensagens neste mês (Pro: ilimitado)"
    }
    return String.valueOf(ChatUi.used) + " de " + String.valueOf(ChatUi.limit) + " mensagens neste mês"
}

Button soonButton(String label, String id) {
    var b = Button(label, () -> {})
    b.setId(id)
    b.setDisabled(true)
    b.setStyle(chatIconOffCss())
    return b
}

ensureChatLoaded(Window w) {
    if (SessionState.token == "" || ChatUi.loadedFor == SessionState.token) {
        return
    }
    ChatUi.loadedFor = SessionState.token
    ChatUi.loading = true
    spawn {
        loadChat()
        mountScreen(w)
    }
}

View chatScreen(Window w) {
    ensureChatLoaded(w)

    var list = Column(chatBubblesNewestFirst())
    list.setId("chat-messages")
    list.setStyle(chatListCss())

    var field = textField("Pergunte qualquer coisa", "text", "chat-input")
    field.setText(ChatUi.draft)
    field.setStyle(chatInputCss())
    var off = ChatUi.sending || ChatUi.blocked
    var send = Button("Enviar", () -> {})
    send.setId("chat-send")
    send.setStyle(chatSendCss())
    if (off) {
        field.setDisabled(true)
        send.setDisabled(true)
        send.setStyle(chatSendOffCss())
    }
    var bar = Form(listOf(soonButton("+", "chat-attach"), field, soonButton("Voz", "chat-mic"), send))
    bar.setId("chat-form")
    bar.setStyle(chatBarCss())
    bar.onSubmit(() -> {
        var text = field.text().trim()
        if (text != "" && !ChatUi.sending && !ChatUi.blocked) {
            ChatUi.sending = true
            ChatUi.pending = text
            ChatUi.draft = ""
            ChatUi.error = ""
            mountScreen(w)
            spawn {
                sendChatMessage(text)
                mountScreen(w)
            }
        }
    })

    var hint = Label("Anexar fatura e voz: Em breve")
    hint.setId("chat-soon")
    hint.setStyle(chatHintCss())
    var counter = Label(chatCounterText())
    counter.setId("chat-counter")
    counter.setStyle(chatCounterCss())
    var foot = Row(listOf(hint, counter))
    foot.setStyle(chatFootCss())

    var parts: List<View> = listOf()
    parts.add(list)
    if (ChatUi.error != "") {
        var err = errorBanner(ChatUi.error)
        err.setId("chat-error")
        parts.add(err)
    }
    parts.add(bar)
    parts.add(foot)
    var body = Column(parts)
    body.setStyle(chatBodyCss())

    var col = Column(listOf(topbar("Organiza AI", "Assistente online", null), body))
    col.setId("screen-chat")
    col.setStyle(stackCss())
    return col
}
