package screens

import kof.ui
import core.theme
import core.app_state
import core.chat_api
import core.navigation
import components.topbar
import components.form_widgets
import components.icons

// =============================================================================
// Tela 10 Organiza AI (Batch 3, F2; B1 fidelidade Desktop + Mobile)
// =============================================================================
// Topbar "Organiza AI" + "Assistente online" (ponto verde em topbar.kf);
// bolhas fiéis ao artefato (max-width 75%, 13px, canto de 3px, IA #1A1F3A sem
// borda, usuária #00D4FF peso 600); saudação fixa sem prometer voz nem PDF;
// lista flex (flex: 1 1 0; min-height: 0) com column-reverse entre topbar e
// composer preso embaixo; composer em caixa única (raio 14) com plus e mic
// 26px desativados + enviar 30px gradiente com icon("send", ..., "onaccent");
// contador "N de 30" visível só quando faltam <= 5 ou no limite; 402/503
// mantêm o rascunho.
// =============================================================================

Style chatScreenDesktopCss() = Style("display: flex; flex-direction: column; gap: 16; width: 100%; height: 690; min-height: 0")
Style chatScreenMobileCss()  = Style("display: flex; flex-direction: column; gap: 16; width: 100%; flex: 1 1 0; min-height: 0")
Style chatBodyCss()       = Style("display: flex; flex-direction: column; gap: 12; width: 100%; flex: 1 1 0; min-height: 0")
Style chatListCss()       = Style("display: flex; flex-direction: column-reverse; gap: 10; width: 100%; flex: 1 1 0; min-height: 0; overflow-y: auto; padding: 4px 0")
Style chatBubbleAiCss()   = Style("align-self: flex-start; max-width: 75%; background: #1A1F3A; color: #F0F0F0; border: none; border-radius: 12px 12px 12px 3px; padding: 10px 14px; font-size: 0.8125rem; line-height: 1.45em; white-space: pre-wrap; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatBubbleUserCss() = Style("align-self: flex-end; max-width: 75%; background: #00D4FF; color: #06121C; font-weight: 600; border: none; border-radius: 12px 12px 3px 12px; padding: 10px 14px; font-size: 0.8125rem; line-height: 1.45em; white-space: pre-wrap; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatTypingCss()     = Style("align-self: flex-start; max-width: 75%; background: #1A1F3A; color: #7B8EAD; border: none; border-radius: 12px 12px 12px 3px; padding: 10px 14px; font-size: 0.8125rem; line-height: 1.45em; font-style: italic; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatBarCss()        = Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; gap: 8; width: 100%; flex-shrink: 0; box-sizing: border-box; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.1); border-radius: 14; padding: 6px 8px 6px 10px")
Style chatInputCss()      = Style("background: transparent; color: #F0F0F0; border: none; outline: none; height: 34; width: auto; flex: 1 1 0; min-width: 0; box-sizing: border-box; padding: 0 4px; font-size: 0.8125rem; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatAttachOffCss()  = Style("width: 30; height: 30; min-width: 30; flex-shrink: 0; border-radius: 15; background: transparent; border: 1px solid rgba(255,255,255,.1); display: flex; align-items: center; justify-content: center; padding: 0; opacity: 0.5; cursor: not-allowed; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatMicOffCss()     = Style("width: 26; height: 26; min-width: 26; flex-shrink: 0; border-radius: 13; background: transparent; border: none; display: flex; align-items: center; justify-content: center; padding: 0; opacity: 0.5; cursor: not-allowed; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatSendCss()       = Style("outline: none; width: 30; height: 30; min-width: 30; flex-shrink: 0; border-radius: 15; background: linear-gradient(135deg, #00D4FF, #0066FF); border: none; display: flex; align-items: center; justify-content: center; padding: 0; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatSendOffCss()    = Style("width: 30; height: 30; min-width: 30; flex-shrink: 0; border-radius: 15; background: #1A1F3A; border: none; display: flex; align-items: center; justify-content: center; padding: 0; opacity: 0.5; cursor: not-allowed; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chatCounterCss()    = Style("color: #7B8EAD; font-size: 0.75rem; align-self: flex-end; flex-shrink: 0; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")

String chatGreeting() {
    var name = SessionState.userName.trim()
    var sp = name.indexOf(" ")
    if (sp > 0) {
        name = name.substring(0, sp)
    }
    var hi = "Oi!"
    if (name != "") {
        hi = "Oi, " + name + "!"
    }
    return hi + " Me fala seus gastos aí que eu organizo tudo pra você."
}

Label chatBubble(String role, String text, String id) {
    var b = Label(text)
    b.setId(id)
    if (role == "USER") {
        b.setStyle(chatBubbleUserCss())
    } else {
        b.setStyle(chatBubbleAiCss())
    }
    return b
}

// Bolhas da mais nova para a mais antiga (a lista usa column-reverse).
List<View> chatBubblesNewestFirst() {
    var out: List<View> = listOf()
    if (ChatUi.pending != "") {
        var t = Label("Organiza AI está digitando…")
        t.setId("chat-typing")
        t.setStyle(chatTypingCss())
        out.add(t)
        out.add(chatBubble("USER", ChatUi.pending, "chat-pending"))
    }
    var lines = ChatState.messages.split("\n")
    var n = 0
    for (var i = lines.size - 1; i >= 0; i--) {
        var line = lines[i]
        var bar = line.indexOf("|")
        if (bar > 0) {
            n = n + 1
            out.add(chatBubble(line.substring(0, bar), chatDecode(line.substring(bar + 1)), "chat-msg-" + String.valueOf(i + 1)))
        }
    }
    if (n == 0 && !ChatUi.loading) {
        out.add(chatBubble("ASSISTANT", chatGreeting(), "chat-greeting"))
    }
    return out
}

Bool showChatCounter() {
    if (!ChatUi.usageKnown || ChatUi.limit < 0) {
        return false
    }
    return ChatUi.blocked || (ChatUi.limit - ChatUi.used <= 5)
}

String chatCounterText() {
    if (!showChatCounter()) {
        return ""
    }
    return String.valueOf(ChatUi.used) + " de " + String.valueOf(ChatUi.limit) + " mensagens neste mês"
}

View soonIconButton(String iconName, Int size, String tone, String id, Style css, String label) {
    var b = View(screenStyle())
    b.setId(id)
    b.setDisabled(true)
    b.setAccessibleName(label)
    b.setStyle(css)
    b.bind(icon(iconName, size, tone))
    return b
}

ensureChatLoaded(Window w) {
    if (SessionState.token == "" || ChatUi.loadedFor == SessionState.token) {
        return
    }
    ChatUi.loadedFor = SessionState.token
    ChatUi.loading = true
    spawn {
        loadChat()
        mountScreen(w)
    }
}

View chatScreen(Window w) {
    ensureChatLoaded(w)

    var list = Column(chatBubblesNewestFirst())
    list.setId("chat-messages")
    list.setStyle(chatListCss())

    var field = textField("Pergunte qualquer coisa", "text", "chat-input")
    field.setText(ChatUi.draft)
    field.setStyle(chatInputCss())
    field.on("input", () -> {
        ChatUi.draft = field.text()
    })

    var off = ChatUi.sending || ChatUi.blocked
    var attach = soonIconButton("plus", 16, "secondary", "chat-attach", chatAttachOffCss(), "Anexar fatura (em breve)")
    var mic = soonIconButton("mic", 16, "muted", "chat-mic", chatMicOffCss(), "Voz (em breve)")

    var send = View(screenStyle())
    send.setId("chat-send")
    send.setAccessibleName("Enviar")
    if (off) {
        field.setDisabled(true)
        send.setDisabled(true)
        send.setStyle(chatSendOffCss())
        send.bind(icon("send", 14, "muted"))
    } else {
        send.setStyle(chatSendCss())
        send.bind(icon("send", 14, "onaccent"))
    }

    var bar = Form(listOf(attach, field, mic, send))
    bar.setId("chat-form")
    bar.setStyle(chatBarCss())
    bar.onSubmit(() -> {
        var text = field.text().trim()
        if (text != "" && !ChatUi.sending && !ChatUi.blocked) {
            ChatUi.sending = true
            ChatUi.pending = text
            ChatUi.draft = ""
            ChatUi.error = ""
            mountScreen(w)
            spawn {
                sendChatMessage(text)
                mountScreen(w)
            }
        }
    })
    if (!off) {
        send.on("click", () -> bar.submit())
    }

    var parts: List<View> = listOf()
    parts.add(list)
    if (ChatUi.error != "") {
        var err = errorBanner(ChatUi.error)
        err.setId("chat-error")
        parts.add(err)
    }
    parts.add(bar)
    if (showChatCounter()) {
        var counter = Label(chatCounterText())
        counter.setId("chat-counter")
        counter.setStyle(chatCounterCss())
        parts.add(counter)
    }

    var body = Column(parts)
    body.setStyle(chatBodyCss())

    var col = Column(listOf(topbar("Organiza AI", "Assistente online", null), body))
    col.setId("screen-chat")
    if (AppState.isDesktop) {
        col.setStyle(chatScreenDesktopCss())
    } else {
        col.setStyle(chatScreenMobileCss())
    }
    return col
}
