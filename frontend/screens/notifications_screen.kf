package screens

import kof.ui
import core.theme
import core.app_state
import core.format
import core.navigation
import core.notifications_api
import components.topbar
import components.nav_bar
import components.icons

// =============================================================================
// Tela 12 Notificações (Batch 3, F4; fidelidade Desktop + Mobile)
// =============================================================================
// Lista de GET /api/notifications (max 560). Item = trilho de 56 px no tom do
// `kind` com borda esquerda de 3px no tom + ícone do design system (Image .svg)
// + corpo (badge, tempo, título 13/700, texto 12/400). REMINDER não tem badge:
// o tempo fica ao lado do título.
// Topbar traz o botão "Marcar todas como lidas", que chama
// POST /api/notifications/read-all e atualiza a lista.
// Os artefatos não possuem estilo visual divergente para lida/não lida;
// o estado de leitura é registrado na classe do item (notif-read / notif-unread)
// e refletido no backend.
// =============================================================================

Style notifListCss()        = Style("display: flex; flex-direction: column; gap: 10; width: 100%; max-width: 560")
Style notifItemCss()        = Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: stretch; gap: 0; min-height: 76; width: 100%; background: #12162A; border: 1px solid rgba(255,255,255,.1); border-radius: 12; overflow: hidden; min-width: 0")
Style notifItemReadCss()    = Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: stretch; gap: 0; min-height: 76; width: 100%; background: #12162A; border: 1px solid rgba(255,255,255,.06); border-radius: 12; overflow: hidden; min-width: 0; opacity: 0.72")
Style notifRailDangerCss()  = Style("display: flex; align-items: center; justify-content: center; width: 56; flex-shrink: 0; background: rgba(255,74,110,.12); border-left: 3px solid #FF4A6E")
Style railWarningCssLocal() = Style("display: flex; align-items: center; justify-content: center; width: 56; flex-shrink: 0; background: rgba(255,184,0,.12); border-left: 3px solid #FFB800")
Style railSuccessCssLocal() = Style("display: flex; align-items: center; justify-content: center; width: 56; flex-shrink: 0; background: rgba(0,229,160,.12); border-left: 3px solid #00E5A0")
Style railAccentCssLocal()  = Style("display: flex; align-items: center; justify-content: center; width: 56; flex-shrink: 0; background: rgba(0,212,255,.12); border-left: 3px solid #00D4FF")

Style notifBodyCss()        = Style("display: flex; flex-direction: column; justify-content: center; gap: 6; padding: 14px 16px; min-width: 0; flex: 1 1 0")
Style notifMetaCss()        = Style("display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 8; min-height: 20")
Style notifTimeCss()        = Style("color: #4A5578; font-size: 0.75rem; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style notifTitleCss()       = Style("color: #F0F0F0; font-size: 0.8125rem; font-weight: 700; line-height: 1.3em; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style notifTextCss()        = Style("color: #7B8EAD; font-size: 0.75rem; line-height: 1.5em; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style notifEmptyCss()       = Style("color: #7B8EAD; font-size: 0.875rem; text-align: center; padding: 32; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style notifReadAllBtnCss()  = Style("outline: none; background: transparent; border: none; color: #00D4FF; font-size: 0.75rem; font-weight: 600; cursor: pointer; padding: 0; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")

// Ícone do trilho (design system, components/icons.kf): aviso, pulso, check
// ou sino, no tom do `kind`.
String notifIconName(String kind) {
    if (kind == "REMINDER") { return "bell" }
    if (kind == "ENVELOPE_EXCEEDED" || kind == "ENVELOPE_ALERT") { return "warn" }
    if (kind == "GOAL_REACHED") { return "check" }
    return "pulse"
}

Style railCssFor(String tone) {
    if (tone == "danger") { return notifRailDangerCss() }
    if (tone == "warning") { return railWarningCssLocal() }
    if (tone == "success") { return railSuccessCssLocal() }
    return railAccentCssLocal()
}

Style badgeCssFor(String tone) {
    if (tone == "danger") { return badgeDangerCss() }
    if (tone == "warning") { return badgeWarningCss() }
    if (tone == "success") { return badgeSuccessCss() }
    return badgeAccentCss()
}

View notifItem(NotificationItem n) {
    val tone = notificationTone(n.kind())
    val badge = notificationBadge(n.kind())
    var holder = iconView(notifIconName(n.kind()), 22, tone, "notif-icon-" + n.kind())
    var rail = Column(listOf(holder))
    rail.setStyle(railCssFor(tone))

    var time = Label(relativeTime(secondsSince(n.createdAt())))
    time.setId("notif-time-" + n.kind())
    time.setStyle(notifTimeCss())
    var title = Label(n.title())
    title.setId("notif-title-" + n.kind())
    title.setStyle(notifTitleCss())
    var text = Label(n.message())
    text.setId("notif-text-" + n.kind())
    text.setStyle(notifTextCss())

    var body = Column(listOf(title, text))
    if (badge == "") {
        // REMINDER: sem badge, tempo ao lado do título.
        var head = Row(listOf(title, time))
        head.setStyle(notifMetaCss())
        body = Column(listOf(head, text))
    } else {
        var b = Label(badge)
        b.setId("notif-badge-" + n.kind())
        b.setStyle(badgeCssFor(tone))
        var meta = Row(listOf(b, time))
        meta.setStyle(notifMetaCss())
        body = Column(listOf(meta, title, text))
    }
    body.setStyle(notifBodyCss())

    var item = Row(listOf(rail, body))
    item.setId("notif-" + n.kind())
    if (n.read()) {
        item.setClass("notif-read")
        item.setStyle(notifItemReadCss())
    } else {
        item.setClass("notif-unread")
        item.setStyle(notifItemCss())
    }
    return item
}

loadNotifications(Window w) {
    try {
        NotifState.raw = fetchNotificationsRaw()
        AppState.loadError = ""
    } catch (String e) {
        AppState.loadError = e
    }
    AppState.loading = false
    NotifState.loaded = true
    if (AppState.currentScreen == "notifications") {
        mountScreen(w)
    }
}

markAllReadAction(Window w) {
    try {
        markAllNotificationsRead()
        NotifState.raw = fetchNotificationsRaw()
        AppState.loadError = ""
    } catch (String e) {
        AppState.loadError = e
    }
    mountScreen(w)
}

View notifMessage(String id, String text) {
    var l = Label(text)
    l.setId(id)
    l.setStyle(notifEmptyCss())
    return l
}

View notifContent() {
    if (AppState.loadError != "") {
        var err = Label(AppState.loadError)
        err.setId("notif-error")
        err.setStyle(errorBannerCss())
        return err
    }
    if (NotifState.raw == "") {
        return notifMessage("notif-loading", "Carregando…")
    }
    val items = decodeNotifications(NotifState.raw)
    if (items.isEmpty()) {
        return notifMessage("notif-empty", "Nenhuma notificação por enquanto.")
    }
    var views = items.map((n: NotificationItem) -> notifItem(n))
    var list = Column(views)
    list.setId("notif-list")
    list.setStyle(notifListCss())
    return list
}

View notificationsScreen(Window w) {
    if (NotifState.loaded) {
        NotifState.loaded = false
    } else if (!AppState.loading) {
        AppState.loading = true
        spawn {
            loadNotifications(w)
        }
    }
    var markAll = Button("Marcar todas como lidas", () -> {
        spawn {
            markAllReadAction(w)
        }
    })
    markAll.setId("btn-read-all")
    markAll.setStyle(notifReadAllBtnCss())

    var col = Column(listOf(topbar("Notificações", "", markAll), notifContent()))
    col.setId("screen-notifications")
    col.setStyle(stackCss())
    return col
}
