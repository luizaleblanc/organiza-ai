package screens

import kof.ui
import core.theme
import core.app_state
import core.navigation
import components.brand_mark

// =============================================================================
// Tela 1 — Boas-vindas (artefatos Desktop WelcomeWin e Mobile WelcomeScreen)
// =============================================================================
// Logomarca de 3 ondas, slogan em caixa alta e duas ações:
// "Criar conta grátis" → signup (Tela 3) e "Já tenho conta" → login (Tela 2).
// Mobile: marca 180px, gap 28, padding lateral extra, botões empilhados 50px / r14.
// Desktop: marca 200px, gap 32, botões lado a lado 200x48px / r10 (gap 16).
// =============================================================================

Style welcomeColDesktopCss() = Style("display: flex; flex-direction: column; align-items: center; gap: 40; width: 100%; max-width: 600")
Style welcomeColMobileCss()  = Style("display: flex; flex-direction: column; align-items: center; gap: 28; width: 100%; padding: 0 16px; box-sizing: border-box")
Style welcomeSloganDesktopCss() = Style("color: #7B8EAD; font-size: 1.375rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; text-align: center; max-width: 560; align-self: center; margin: 8px 0 0 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style welcomeSloganMobileCss()  = Style("color: #7B8EAD; font-size: 1.125rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; text-align: center; align-self: center; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style welcomeBtnPrimaryDesktopCss()   = Style("outline: none; background: linear-gradient(90deg, #00D4FF, #0066FF); color: #06121C; height: 60; width: 260; border: none; border-radius: 12; font-size: 1.125rem; font-weight: 600; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style welcomeBtnSecondaryDesktopCss() = Style("outline: none; background: transparent; color: #00D4FF; height: 60; width: 260; border: 1.5px solid #00D4FF; border-radius: 12; font-size: 1.125rem; font-weight: 600; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style welcomeBtnPrimaryMobileCss()    = Style("outline: none; background: linear-gradient(90deg, #00D4FF, #0066FF); color: #06121C; height: 50; width: 100%; border: none; border-radius: 14; font-size: 0.9375rem; font-weight: 700; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style welcomeBtnSecondaryMobileCss()  = Style("outline: none; background: transparent; color: #00D4FF; height: 50; width: 100%; border: 1.5px solid #00D4FF; border-radius: 14; font-size: 0.9375rem; font-weight: 700; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")

View welcomeScreen(Window w) {
    var desktop = AppState.isDesktop

    var markWidth = 180
    if (desktop) {
        markWidth = 300
    }
    var mark = brandMark(markWidth, "brand-mark")

    var slogan = Label("Sua grana organizada e sem estresse.")
    slogan.setId("welcome-slogan")
    if (desktop) {
        slogan.setStyle(welcomeSloganDesktopCss())
    } else {
        slogan.setStyle(welcomeSloganMobileCss())
    }

    var signup = Button("Criar conta grátis", () -> navigateTo(w, "signup"))
    signup.setId("btn-signup")
    var login = Button("Já tenho conta", () -> navigateTo(w, "login"))
    login.setId("btn-login")
    if (desktop) {
        signup.setStyle(welcomeBtnPrimaryDesktopCss())
        login.setStyle(welcomeBtnSecondaryDesktopCss())
    } else {
        signup.setStyle(welcomeBtnPrimaryMobileCss())
        login.setStyle(welcomeBtnSecondaryMobileCss())
    }

    var body = View(screenStyle())
    body.setStyle(entryBodyCss())
    body.bind(welcomeColumn(mark, slogan, signup, login, desktop))
    return body
}

// Mobile: botões empilhados; Desktop: lado a lado e coluna limitada a 480px.
Column welcomeColumn(View mark, Label slogan, Button signup, Button login, Bool desktop) {
    if (desktop) {
        var row = Row(listOf(signup, login))
        row.setStyle(actionsDesktopCss())
        var wide = Column(listOf(mark, slogan, row))
        wide.setStyle(welcomeColDesktopCss())
        return wide
    }
    var stacked = Column(listOf(signup, login))
    stacked.setStyle(actionsMobileCss())
    var narrow = Column(listOf(mark, slogan, stacked))
    narrow.setStyle(welcomeColMobileCss())
    return narrow
}
