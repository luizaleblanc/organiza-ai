package screens

import kof.ui
import core.theme
import core.app_state
import core.navigation
import components.brand_mark
import components.form_widgets

// =============================================================================
// Tela 1 — Boas-vindas (spec B2-01; design.md §5)
// =============================================================================
// Logomarca de 3 ondas, slogan em caixa alta e duas ações:
// "Criar conta" → signup (Tela 3) e "Já tenho conta" → login (Tela 2).
// Mobile: marca 230px e botões empilhados em largura total.
// Desktop: marca 200px e botões lado a lado com 200px (artefato Desktop).
// =============================================================================

View welcomeScreen(Window w) {
    var desktop = AppState.isDesktop

    var markWidth = 230
    if (desktop) {
        markWidth = 200
    }
    var mark = brandMark(markWidth, "brand-mark")

    var slogan = Label("SUA GRANA ORGANIZADA E SEM ESTRESSE.")
    slogan.setId("welcome-slogan")
    if (desktop) {
        slogan.setStyle(sloganDesktopCss())
    } else {
        slogan.setStyle(sloganMobileCss())
    }

    var signup = primaryButton("Criar conta", "btn-signup", desktop, () -> navigateTo(w, "signup"))
    var login = secondaryButton("Já tenho conta", "btn-login", desktop, () -> navigateTo(w, "login"))

    var body = View(screenStyle())
    body.setStyle(entryBodyCss())
    body.bind(welcomeColumn(mark, slogan, signup, login, desktop))
    return body
}

// Mobile: botões empilhados; Desktop: lado a lado e coluna limitada a 480px.
Column welcomeColumn(View mark, Label slogan, Button signup, Button login, Bool desktop) {
    if (desktop) {
        var row = Row(listOf(signup, login))
        row.setStyle(actionsDesktopCss())
        var wide = Column(listOf(mark, slogan, row))
        wide.setStyle(entryColumnDesktopCss())
        return wide
    }
    var stacked = Column(listOf(signup, login))
    stacked.setStyle(actionsMobileCss())
    var narrow = Column(listOf(mark, slogan, stacked))
    narrow.setStyle(entryColumnMobileCss())
    return narrow
}
