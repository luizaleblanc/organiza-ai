package screens

import kof.ui
import core.theme
import core.app_state
import core.navigation

// =============================================================================
// welcomeScreen
// =============================================================================
// Tela inicial do app. Ela transmite a proposta do produto e dispara a próxima
// etapa via navegação centralizada no módulo de navigation, seguindo o padrão
// do projeto em vez de rebind direto sem uma rota explícita.
// =============================================================================

View welcomeScreen(Window w) {
    var title = Label("Organiza AI")
    title.fontSize = sizeTitle()
    title.bold = true
    title.color = colorTextPrimary()

    var subtitle = Label("Seu coach financeiro pessoal")
    subtitle.fontSize = sizeBody()
    subtitle.color = colorTextSecondary()

    var helper = Label("Organize sua renda, seus envelopes e seus objetivos em poucos passos.")
    helper.fontSize = sizeCaption()
    helper.color = colorTextMuted()

    var primary = Button("Começar", () -> {
        navigateTo(w, "onboarding")
    })

    var content = Column(listOf(title, subtitle, helper, primary))
    var view = View(screenStyle())
    view.bind(content)
    return view
}
