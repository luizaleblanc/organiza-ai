package screens.chat

// =============================================================================
// Chat State — Gerenciamento de Estado da Tela de Chat
// DESIGN_SYSTEM.md seção 3.6 e 5 (Tela 9 — Chat)
// =============================================================================
// Em KOF, o estado mutável entre eventos de UI e cliques de botão vive em campos
// estáticos de classe, pois lambdas capturam escopo de forma somente-leitura.
// =============================================================================

class ChatState {
    static List<String> messages   = listOf()
    static String currentInput     = ""
    static Boolean loading         = false

    static reset() {
        ChatState.messages = listOf()
        ChatState.currentInput = ""
        ChatState.loading = false
    }

    // Registra nova mensagem com role ("user" ou "assistant") e conteúdo
    static addMessage(String role, String content) {
        ChatState.messages.add(role + ":" + content)
    }
}
