// Medidor de força da senha (0..4) — atualizado in-place em on("input").
Style strengthWrapCss()        = Style("display: flex; flex-direction: column; gap: 6; width: 100%; padding: 0; background: transparent")
Style strengthTrackRowCss()    = Style("display: flex; flex-direction: row; flex-wrap: nowrap; gap: 6; width: 100%; align-items: center")
Style strengthSegIdleCss()     = Style("flex-grow: 1; height: 4; border-radius: 2; background: rgba(255,255,255,.08); padding: 0")
