Style strengthSegFairCss()     = Style("flex-grow: 1; height: 4; border-radius: 2; background: #FFB800; padding: 0")
Style strengthSegGoodCss()     = Style("flex-grow: 1; height: 4; border-radius: 2; background: #00D4FF; padding: 0")
Style strengthSegStrongCss()   = Style("flex-grow: 1; height: 4; border-radius: 2; background: #00E5A0; padding: 0")
Style strengthMetaRowCss()     = Style("display: flex; flex-direction: row; flex-wrap: nowrap; justify-content: space-between; align-items: center; gap: 8; width: 100%")
