// =============================================================================
// Tela 2 — Login + Esqueci minha senha / Redefinir senha (Desktop 2 cols + Mobile)
// =============================================================================
// Desktop (artefato 64FYjX5UiveVxTtRGYurQP, LoginWin): painel da marca à
// esquerda (340 px) + formulário à direita.
// Mobile (artefato 8b3jFV4BrGj4YkDQAwDvDF, LoginScreen): coluna única.
// Usa formField, labeled e passwordBox (olho toggle) de form_widgets.kf.
// Fluxo "Esqueci minha senha" integrado a /api/auth/forgot-password e
// /api/auth/reset-password.
// =============================================================================

class LoginForm {
    static String email = ""
    static String password = ""
    static Bool busy = false
    static String mode = "login"
    static String infoMessage = ""
    static String forgotEmail = ""
    static String resetToken = ""
    static String resetPassword = ""
    static String resetConfirm = ""
}

clearLoginForm() {
    LoginForm.email = ""
    LoginForm.password = ""
    LoginForm.busy = false
    LoginForm.mode = "login"
    LoginForm.infoMessage = ""
    LoginForm.forgotEmail = ""
    LoginForm.resetToken = ""
    LoginForm.resetPassword = ""
    LoginForm.resetConfirm = ""
    AppState.formError = ""
    PasswordToggle.visible = false
}

