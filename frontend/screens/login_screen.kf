// ---- Helpers compartilhados entre Login e Cadastro ---------------------------

Button authSubmitButton(String label, String busyLabel, String id, Bool busy, Bool desktop) {
    if (busy) {
        var b = Button(busyLabel, () -> {})
        b.setId(id)
        b.setDisabled(true)
        if (desktop) {
            b.setStyle(authBusyDesktopCss())
        } else {
            b.setStyle(authBusyMobileCss())
        }
        return b
    }
    var b = Button(label, () -> {})
    b.setId(id)
    if (desktop) {
        b.setStyle(authSubmitDesktopCss())
    } else {
        b.setStyle(authSubmitMobileCss())
    }
    return b
}

Column authFooter(String question, String linkLabel, String linkId, () -> Void action) {
    var q = Label(question)
    q.setStyle(captionCss())
    var link = Button(linkLabel, action)
    link.setId(linkId)
    link.setStyle(authLinkCss())
    var col = Column(listOf(q, link))
    col.setStyle(authFooterCss())
    return col
}

Input filledFormField(String placeholder, String type, String id, String value) {
    var f = formField(placeholder, type, id)
    f.setText(value)
    return f
}

Input filledPasswordField(String placeholder, String id, String value) {
    var f = passwordField(placeholder, id)
    f.setText(value)
    return f
}

// passwordBox() de form_widgets.kf usa display:flex em volta do Row, o que
// encolhe o Input; display:block devolve largura 100% mantendo o olho em
// position:absolute à direita.
View fullPasswordBox(Input field, String id) {
    var box = passwordBox(field, id)
    box.setStyle(passwordBoxBlockCss())
    return box
}

Label infoBanner(String message) {
    var l = Label(message)
    l.setId("form-info")
    l.setStyle(infoBannerCss())
    return l
}

// Três ondas presas dentro do painel (fundos exportados pela usuária, escuro e claro).
String authPanelWavesSrc() {
    if (authLight()) {
        return "assets/brand/auth-panel-waves-light.svg"
    }
    return "assets/brand/auth-panel-waves-dark.svg"
}

// Título do painel palavra a palavra: o kof.ui não estiliza trecho de Label, então cada
// palavra é um Label numa linha que quebra; as palavras de "quanto gastar por dia" levam
// sublinhado (artefato: underline em text-secondary, offset 3px). Espaço não separável
// dentro do trecho para o sublinhado ficar contínuo.
Style headlineWrapCss() = Style("display: flex; flex-direction: row; flex-wrap: wrap; align-items: baseline; gap: 0; margin: 44px 0 18px 0; padding: 0; background: transparent; max-width: 100%")
Style headlineWordCss() {
    if (authLight()) {
        return Style("color: #6B7280; font-size: 1.375rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; line-height: 2.125rem; margin: 0; white-space: pre; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
    }
    return Style("color: #7B8EAD; font-size: 1.375rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; line-height: 2.125rem; margin: 0; white-space: pre; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
}
Style headlineUnderCss() {
    if (authLight()) {
        return Style("color: #6B7280; font-size: 1.375rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; line-height: 2.125rem; margin: 0 9px 0 0; white-space: pre; text-decoration: underline; text-decoration-color: #6B7280; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
    }
    return Style("color: #7B8EAD; font-size: 1.375rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; line-height: 2.125rem; margin: 0 9px 0 0; white-space: pre; text-decoration: underline; text-decoration-color: #7B8EAD; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
}

View brandHeadline(String headline) {
    val mark = "quanto gastar por dia"
    val at = headline.indexOf(mark)
    List<View> words = listOf()
    if (at < 0) {
        var whole = Label(headline)
        whole.setStyle(headlineWordCss())
        words.add(whole)
    } else {
        val before = headline.substring(0, at).trim().split(" ")
        for (var i = 0; i < before.length; i++) {
            val part = before[i]
            var l = Label(part + " ")
            l.setStyle(headlineWordCss())
            words.add(l)
        }
        var under = Label("quanto gastar por dia")
        under.setId("brand-headline-underline")
        under.setStyle(headlineUnderCss())
        words.add(under)
        val rest = headline.substring(at + mark.length()).trim()
        var first = true
        val after = rest.split(" ")
        for (var j = 0; j < after.length; j++) {
            val part = after[j]
            first = false
            var l = Label(part + " ")
            l.setStyle(headlineWordCss())
            words.add(l)
        }
    }
    var row = Row(words)
    row.setId("brand-headline")
    row.setStyle(headlineWrapCss())
    return row
}

View authBrandPanel(String headline, String subtitle, String panelId) {
    var mark = brandMark(120, "brand-mark")
    var markBox = View(screenStyle())
    markBox.setStyle(authBrandMarkLeftCss())
    markBox.bind(mark)

    var h2 = brandHeadline(headline)
    var p = Label(subtitle)
    p.setStyle(authBrandSubCss())

    var content = Column(listOf(markBox, h2, p))
    content.setStyle(authPanelContentCss())
    var wavesImg = Image(authPanelWavesSrc())
    wavesImg.setAlt("")
    wavesImg.setStyle(wavesImageCss())
    var wavesLayer = View(screenStyle())
    wavesLayer.setId(panelId + "-waves")
    wavesLayer.setStyle(wavesLayerCss())
    wavesLayer.bind(wavesImg)

    var panel = View(screenStyle())
    panel.setId(panelId)
    panel.setStyle(authBrandPanelCss())
    panel.bind(Column(listOf(wavesLayer, content)))
    return panel
}

View authDesktopSplit(View brandPanel, View formCol, String shellId, String formPanelId) {
    var formPanel = View(screenStyle())
    formPanel.setId(formPanelId)
    formPanel.setStyle(authFormPanelCss())
    formPanel.bind(formCol)

    var row = Row(listOf(brandPanel, formPanel))
    row.setId(shellId)
    row.setStyle(authDesktopShellCss())
    return row
}

Style activeSegStyle(Int score) {
    if (score == 1) { return strengthSegWeakCss() }
    if (score == 2) { return strengthSegFairCss() }
    if (score == 3) { return strengthSegGoodCss() }
    return strengthSegStrongCss()
}

class StrengthMeter {
    View root
    View s1
    View s2
    View s3
    View s4
    Label lbl
    Label r1
    Label r2
    Label r3
    Label r4
    Label r5

    public constructor(View root, View s1, View s2, View s3, View s4, Label lbl, Label r1, Label r2, Label r3, Label r4, Label r5) {
        this.r1 = r1
        this.r2 = r2
        this.r3 = r3
        this.r4 = r4
        this.r5 = r5
        this.root = root
        this.s1 = s1
        this.s2 = s2
        this.s3 = s3
        this.s4 = s4
        this.lbl = lbl
    }
}

// Uma regra da senha: "✓" verde quando cumprida, "○" cinza enquanto falta.
refreshRule(Label l, String text, Bool met) {
    if (met) {
        l.setText("✓  " + text)
        l.setStyle(strengthRuleMetCss())
    } else {
        l.setText("○  " + text)
        l.setStyle(strengthRuleIdleCss())
    }
}

refreshStrengthMeter(StrengthMeter m, String pwd) {
    refreshRule(m.r1, "Mínimo de 8 caracteres", pwd.length() >= MIN_PASSWORD_LEN())
    refreshRule(m.r2, "Uma letra maiúscula", hasUpperLetter(pwd))
    refreshRule(m.r3, "Uma letra minúscula", hasLowerLetter(pwd))
    refreshRule(m.r4, "Um número", hasDigitChar(pwd))
    refreshRule(m.r5, "Um caractere especial", hasSpecialChar(pwd))
    val score = passwordStrengthScore(pwd)
    val text = passwordStrengthLabel(score)
    m.lbl.setText(text)
    if (score <= 0) {
        m.lbl.setStyle(strengthLblIdleCss())
        m.s1.setStyle(strengthSegIdleCss())
        m.s2.setStyle(strengthSegIdleCss())
        m.s3.setStyle(strengthSegIdleCss())
        m.s4.setStyle(strengthSegIdleCss())
        return
    }
    val activeCss = activeSegStyle(score)
    if (score == 1) { m.lbl.setStyle(strengthLblWeakCss()) }
    else if (score == 2) { m.lbl.setStyle(strengthLblFairCss()) }
    else if (score == 3) { m.lbl.setStyle(strengthLblGoodCss()) }
    else { m.lbl.setStyle(strengthLblStrongCss()) }

    m.s1.setStyle(activeCss)
    if (score >= 2) { m.s2.setStyle(activeCss) } else { m.s2.setStyle(strengthSegIdleCss()) }
    if (score >= 3) { m.s3.setStyle(activeCss) } else { m.s3.setStyle(strengthSegIdleCss()) }
    if (score >= 4) { m.s4.setStyle(activeCss) } else { m.s4.setStyle(strengthSegIdleCss()) }
}

StrengthMeter createStrengthMeter(String prefix, String initialPwd) {
    var s1 = View(screenStyle())
    s1.setId(prefix + "-seg-1")
    var s2 = View(screenStyle())
    s2.setId(prefix + "-seg-2")
    var s3 = View(screenStyle())
    s3.setId(prefix + "-seg-3")
    var s4 = View(screenStyle())
    s4.setId(prefix + "-seg-4")

    var barRow = Row(listOf(s1, s2, s3, s4))
    barRow.setId(prefix + "-bars")
    barRow.setStyle(strengthTrackRowCss())

    var hint = Label("Força da senha")
    hint.setStyle(strengthHintCss())
    var lbl = Label("")
    lbl.setId(prefix + "-label")

    var metaRow = Row(listOf(hint, lbl))
    metaRow.setStyle(strengthMetaRowCss())

    var r1 = Label("")
    r1.setId(prefix + "-rule-len")
    var r2 = Label("")
    r2.setId(prefix + "-rule-upper")
    var r3 = Label("")
    r3.setId(prefix + "-rule-lower")
    var r4 = Label("")
    r4.setId(prefix + "-rule-digit")
    var r5 = Label("")
    r5.setId(prefix + "-rule-special")
    var rules = Row(listOf(r1, r2, r3, r4, r5))
    rules.setId(prefix + "-rules")
    rules.setStyle(strengthRulesGridCss())

    var note = Label("Caracteres especiais: ! @ # $ % & *")
    note.setId(prefix + "-rule-identity")
    note.setStyle(strengthHintCss())

    var wrap = Column(listOf(barRow, metaRow, rules, note))
    wrap.setId(prefix + "-meter")
    wrap.setStyle(strengthWrapCss())

    var meter = StrengthMeter(wrap, s1, s2, s3, s4, lbl, r1, r2, r3, r4, r5)
    refreshStrengthMeter(meter, initialPwd)
    return meter
}

// ---- Ações de Login / Esqueci a Senha / Redefinir Senha ----------------------

submitLogin(Window w, Input emailField, Input passwordField) {
    if (LoginForm.busy) {
        return
    }
    LoginForm.email = emailField.text()
    LoginForm.password = passwordField.text()
    LoginForm.infoMessage = ""
    if (LoginForm.email.trim() == "" || LoginForm.password == "") {
        AppState.formError = "Preencha e-mail e senha."
        mountScreen(w)
        return
    }
    AppState.formError = ""
    LoginForm.busy = true
    mountScreen(w)
    try {
        login(LoginForm.email, LoginForm.password)
        val profile = me()
        clearLoginForm()
        if (profile.onboardingCompleted()) {
            navigateTo(w, "dashboard")
        } else {
            navigateTo(w, "onb_salary")
        }
    } catch (String e) {
        SessionState.token = ""
        LoginForm.busy = false
        AppState.formError = e
        mountScreen(w)
    }
}

submitForgot(Window w, Input emailField) {
    if (LoginForm.busy) {
        return
    }
    LoginForm.forgotEmail = emailField.text()
    LoginForm.infoMessage = ""
    val clean = LoginForm.forgotEmail.trim()
    if (!isEmailLike(clean) || clean.length() > 255) {
        AppState.formError = "Digite um e-mail válido."
        mountScreen(w)
        return
    }
    AppState.formError = ""
    LoginForm.busy = true
    mountScreen(w)
    try {
        val msg = forgotPassword(clean)
        LoginForm.busy = false
        LoginForm.infoMessage = msg
        mountScreen(w)
    } catch (String e) {
        LoginForm.busy = false
        AppState.formError = e
        mountScreen(w)
    }
}

Bool isSixDigits(String v) {
    if (v.length() != 6) {
        return false
    }
    for (var i = 0; i < v.length(); i++) {
        if (!isDigitUnit(v.charAt(i))) {
            return false
        }
    }
    return true
}

submitReset(Window w, Input emailField, Input tokenField, Input pwdField, Input confirmField) {
    if (LoginForm.busy) {
        return
    }
    LoginForm.forgotEmail = emailField.text()
    LoginForm.resetToken = tokenField.text()
    LoginForm.resetPassword = pwdField.text()
    LoginForm.resetConfirm = confirmField.text()
    LoginForm.infoMessage = ""
    if (!isEmailLike(LoginForm.forgotEmail.trim())) {
        AppState.formError = "Digite o e-mail da sua conta."
        mountScreen(w)
        return
    }
    if (!isSixDigits(LoginForm.resetToken.trim())) {
        AppState.formError = "Digite o código de 6 números que enviamos por e-mail."
        mountScreen(w)
        return
    }
    val shapeErr = passwordShapeError(LoginForm.resetPassword)
    if (shapeErr != "") {
        AppState.formError = shapeErr
        mountScreen(w)
        return
    }
    if (LoginForm.resetPassword != LoginForm.resetConfirm) {
        AppState.formError = "As senhas não conferem."
        mountScreen(w)
        return
    }
    AppState.formError = ""
    LoginForm.busy = true
    mountScreen(w)
    try {
        val msg = resetPassword(LoginForm.forgotEmail, LoginForm.resetToken, LoginForm.resetPassword)
        LoginForm.busy = false
        LoginForm.mode = "login"
        LoginForm.resetToken = ""
        LoginForm.resetPassword = ""
        LoginForm.resetConfirm = ""
        LoginForm.infoMessage = msg
        mountScreen(w)
    } catch (String e) {
        LoginForm.busy = false
        AppState.formError = e
        mountScreen(w)
    }
}

switchLoginMode(Window w, String nextMode) {
    AppState.formError = ""
    LoginForm.infoMessage = ""
    if (nextMode == "forgot" && LoginForm.forgotEmail == "" && LoginForm.email.trim() != "") {
        LoginForm.forgotEmail = LoginForm.email.trim()
    }
    LoginForm.mode = nextMode
    mountScreen(w)
}

// ---- Construção da coluna de formulário por modo -----------------------------

View buildLoginHeading(String title, String subtitle, Bool desktop) {
    if (desktop) {
        var h1 = Label(title)
        h1.setStyle(authHeadingDesktopCss())
        var sub = Label(subtitle)
        sub.setStyle(authSubheadingCss())
        var block = Column(listOf(h1, sub))
        block.setStyle(authHeaderBlockCss())
        return block
    }
    var mark = brandMark(110, "brand-mark")
    var h1 = Label(title)
    h1.setStyle(authHeadingMobileCss())
    var sub = Label(subtitle)
    sub.setStyle(authSubheadingMobCss())
    var hdr = Column(listOf(mark, h1, sub))
    hdr.setStyle(authMobileHeaderCss())
    return hdr
}

Style authLinkViewCss() = Style("outline: none; display: flex; padding: 0; background: transparent; cursor: pointer")

View buildLoginModeForm(Window w, Bool desktop) {
    var emailField = filledFormField("seu@email.com", "text", "login-email", LoginForm.email)
    var pwdField = filledPasswordField("Sua senha", "login-password", LoginForm.password)

    // Não é Button: um <button> dentro do <form> antes de "Entrar" virava o botão de envio
    // (Enter ou o envio do form abriam "Esqueci minha senha"). Um View clicável não envia o form.
    var forgotText = Label("Esqueci a senha")
    forgotText.setStyle(authLinkCss())
    var forgotLink = View(screenStyle())
    forgotLink.setId("link-forgot-password")
    forgotLink.setStyle(authLinkViewCss())
    forgotLink.bind(forgotText)
    forgotLink.on("click", () -> switchLoginMode(w, "forgot"))
    var forgotRow = Row(listOf(forgotLink))
    forgotRow.setStyle(authRightLinkRowCss())

    var submit = authSubmitButton("Entrar", "Entrando…", "btn-login-submit", LoginForm.busy, desktop)

    var form = Form(listOf(
        labeled("E-mail", emailField),
        labeled("Senha", fullPasswordBox(pwdField, "login-password-box")),
        forgotRow,
        submit
    ))
    form.setId("login-form")
    form.setStyle(authFormCss())
    form.onSubmit(() -> {
        spawn {
            submitLogin(w, emailField, pwdField)
        }
    })
    return form
}

View buildForgotModeForm(Window w, Bool desktop) {
    var emailField = filledFormField("seu@email.com", "text", "forgot-email", LoginForm.forgotEmail)
    var submit = authSubmitButton("Enviar link", "Enviando…", "btn-forgot-submit", LoginForm.busy, desktop)

    var form = Form(listOf(
        labeled("E-mail", emailField),
        submit
    ))
    form.setId("forgot-form")
    form.setStyle(authFormCss())
    form.onSubmit(() -> {
        spawn {
            submitForgot(w, emailField)
        }
    })
    return form
}

View buildResetModeForm(Window w, Bool desktop) {
    var emailField = filledFormField("Seu e-mail", "text", "reset-email", LoginForm.forgotEmail)
    var tokenField = filledFormField("000000", "text", "reset-token", LoginForm.resetToken)
    var pwdField = filledPasswordField("Crie uma nova senha", "reset-password", LoginForm.resetPassword)
    var confirmField = filledPasswordField("Repita a nova senha", "reset-confirm", LoginForm.resetConfirm)
    var meter = createStrengthMeter("reset-strength", LoginForm.resetPassword)
    pwdField.on("input", () -> {
        LoginForm.resetPassword = pwdField.text()
        refreshStrengthMeter(meter, LoginForm.resetPassword)
    })
    var submit = authSubmitButton("Salvar nova senha", "Salvando…", "btn-reset-submit", LoginForm.busy, desktop)

    var form = Form(listOf(
        labeled("E-mail", emailField),
        labeled("Código de 6 números", tokenField),
        labeled("Nova senha", fullPasswordBox(pwdField, "reset-password-box")),
        meter.root,
        labeled("Confirmar nova senha", fullPasswordBox(confirmField, "reset-confirm-box")),
        submit
    ))
    form.setId("reset-form")
    form.setStyle(authFormCss())
    form.onSubmit(() -> {
        spawn {
            submitReset(w, emailField, tokenField, pwdField, confirmField)
        }
    })
    return form
}

View loginScreen(Window w) {
    PasswordToggle.visible = false
    val desktop = AppState.isDesktop

    var title = "Entrar na conta"
    var subtitle = "Bem-vinda de volta"
    if (!desktop && LoginForm.mode == "login") {
        title = "Entrar na sua conta"
    }
    if (LoginForm.mode == "forgot") {
        title = "Esqueci minha senha"
        subtitle = "Digite seu e-mail para receber o link de redefinição."
    } else if (LoginForm.mode == "reset") {
        title = "Redefinir senha"
        subtitle = "Digite o código de 6 números que enviamos por e-mail e escolha uma nova senha."
    }

    List<View> items = listOf(buildLoginHeading(title, subtitle, desktop))
    if (AppState.formError != "") {
        items.add(errorBanner(AppState.formError))
    }
    if (LoginForm.infoMessage != "") {
        items.add(infoBanner(LoginForm.infoMessage))
    }

    if (LoginForm.mode == "forgot") {
        items.add(buildForgotModeForm(w, desktop))
        var haveToken = Button("Já tenho o código", () -> switchLoginMode(w, "reset"))
        haveToken.setId("link-reset-password")
        haveToken.setStyle(authLinkCss())
        var backBtn = Button("Voltar para o login", () -> switchLoginMode(w, "login"))
        backBtn.setId("link-back-login")
        backBtn.setStyle(authLinkCss())
        var links = Column(listOf(haveToken, backBtn))
        links.setStyle(authLinksCenterCss())
        items.add(links)
    } else if (LoginForm.mode == "reset") {
        items.add(buildResetModeForm(w, desktop))
        var forgotAgain = Button("Pedir novo link", () -> switchLoginMode(w, "forgot"))
        forgotAgain.setId("link-forgot-again")
        forgotAgain.setStyle(authLinkCss())
        var backBtn = Button("Voltar para o login", () -> switchLoginMode(w, "login"))
        backBtn.setId("link-back-login")
        backBtn.setStyle(authLinkCss())
        var links = Column(listOf(forgotAgain, backBtn))
        links.setStyle(authLinksCenterCss())
        items.add(links)
    } else {
        items.add(buildLoginModeForm(w, desktop))
        items.add(authFooter("Não tem conta?", "Criar conta", "link-signup", () -> {
            clearLoginForm()
            navigateTo(w, "signup")
        }))
    }

    var formBox = Column(items)
    if (desktop) {
        formBox.setStyle(authDesktopBoxCss())
        var brand = authBrandPanel(
            "Falta de planejamento financeiro\nnunca mais.",
            "O Organiza escolhe o melhor modelo de economia baseado na sua realidade.",
            "login-brand-panel"
        )
        return authDesktopSplit(brand, formBox, "login-desktop-split", "login-form-panel")
    }

    formBox.setStyle(authMobileBoxCss())
    var body = View(screenStyle())
    body.setStyle(entryBodyCss())
    body.bind(formBox)
    return body
}
