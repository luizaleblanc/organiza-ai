package screens

import kof.ui
import core.theme
import core.app_state
import core.format
import core.navigation
import components.form_widgets

// =============================================================================
// Tela 6.1 — Valor da dívida (sub-etapa da Etapa 3 de 5)
// =============================================================================
// Dots (2 de 5), título, subtítulo, bigMoneyAmount ("R$" + bigMoneyField com
// máscara de milhar), validação via parseMoney e "Próximo" → "onb_chips".
// =============================================================================

String msgInvalidAmount() = "Digite um valor entre R$ 1 e R$ 1.000.000."

debtAmountNext(Window w, Input field) {
    val raw = field.text().trim()
    OnboardingState.debtAmount = raw
    try {
        parseMoney(raw)
    } catch (String e) {
        AppState.formError = msgInvalidAmount()
        mountScreen(w)
        return
    }
    OnboardingState.hasDebt = true
    AppState.formError = ""
    navigateTo(w, "onb_chips")
}

View onbDebtAmountScreen(Window w) {
    var title = onbTitle("Qual o valor aproximado da sua dívida?", "debt-amount-title")
    var subtitle = onbSubtitle("Isso ajuda a modelar o modelo de economia que mais se adequa a sua realidade", "debt-amount-subtitle")

    var field = bigMoneyField(OnboardingState.debtAmount, "debt-amount")
    var amount = bigMoneyAmount(field, "debt-amount-box")
    var hint = moneyHint("O valor pode ser aproximado.")
    var moneyCol = Column(listOf(amount, hint))
    moneyCol.setStyle(salaryMoneyBlockCss())
    var moneyBlock = View(screenStyle())
    moneyBlock.setStyle(blockCss())
    moneyBlock.bind(moneyCol)

    var next = primaryButton("Próximo", "btn-next", false, () -> debtAmountNext(w, field))

    var items = listOf(dotsBlock(2), titleBlock(title, subtitle), moneyBlock)
    if (AppState.formError != "") {
        items.add(errorBlock(AppState.formError))
    }
    items.add(buttonBlock(next))
    return onbBody(items, onbColumn480Css())
}
