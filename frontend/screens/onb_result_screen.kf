package screens

import kof.ui
import core.theme
import core.app_state
import core.format
import core.auth_api
import core.onb_api
import core.navigation
import components.form_widgets

// =============================================================================
// Tela 7 — Resultado do onboarding + helpers compartilhados do fluxo (5 etapas)
// =============================================================================
// Etapas: 0 Salário → 1 Renda → 2 Dívida (e Valor) → 3 Chips → 4 Resultado.
// `sendOnboardingAndChips` envia POST /api/users/onboarding antes de
// POST /api/envelopes/from-chips (o backend exige onboarding concluído antes
// de criar as caixinhas) e navega para `onb_result`.
// =============================================================================

class ResultState {
    static OnboardingResponse? last
}

sendOnboardingAndChips(Window w, List<String> fixed, List<String> variable) {
    if (OnboardingState.submitting) {
        return
    }
    OnboardingState.submitting = true
    AppState.formError = ""
    mountScreen(w)
    var debt = 0.0
    if (OnboardingState.hasDebt) {
        debt = parseMoney(OnboardingState.debtAmount)
    }
    try {
        val result = submitOnboarding(parseMoney(OnboardingState.salary), OnboardingState.incomeType, OnboardingState.hasDebt, debt)
        ResultState.last = result
        submitChips(fixed, variable)
        OnboardingState.submitting = false
        navigateTo(w, "onb_result")
    } catch (String e) {
        OnboardingState.submitting = false
        if (SessionState.token == "") {
            AppState.formError = msgSessionExpired()
            navigateTo(w, "login")
        } else {
            AppState.formError = e
            mountScreen(w)
        }
    }
}

Int resultBarWidth() {
    if (AppState.isDesktop) {
        return 540
    }
    return 328
}

// Cores das barras conforme os artefatos: Necessidades accent, Desejos #0066FF, Futuro success.
Style onbFillCss(Int index) {
    if (index == 0) { return progressFillAccentCss() }
    if (index == 1) { return progressFillDesCss() }
    if (index == 2) { return progressFillSuccessCss() }
    return progressFillWarningCss()
}

View coloredBucketBar(Int pct, Int index, Int widthPx, String id) {
    var p = pct
    if (p > 100) {
        p = 100
    }
    if (p < 0) {
        p = 0
    }
    var fill = View(screenStyle())
    fill.setStyle(onbFillCss(index))
    fill.setFlexBasis(p * 100)
    var rest = View(screenStyle())
    rest.setStyle(fillRestCss())
    rest.setFlexBasis((100 - p) * 100)
    var track = View(screenStyle())
    track.setId(id)
    track.setStyle(progressTrackCss())
    track.setMaxWidth(widthPx)
    var parts = Row(listOf(fill, rest))
    parts.setStyle(fillRowCss())
    track.bind(parts)
    return track
}

// Nome + percentual em muted à esquerda; valor R$ à direita; barra colorida embaixo.
View bucketRow(BucketSummary b, Int index) {
    var name = Label(b.name())
    name.setId("bucket-name-" + String.valueOf(index))
    name.setStyle(bucketNameCss())
    var pct = Label(String.valueOf(b.percentage()) + "%")
    pct.setId("bucket-pct-" + String.valueOf(index))
    pct.setStyle(bucketPctCss())
    var left = Row(listOf(name, pct))
    left.setStyle(bucketLeftCss())

    var value = Label(brl(b.amount()))
    value.setId("bucket-value-" + String.valueOf(index))
    value.setStyle(bucketValueCss())

    var head = Row(listOf(left, value))
    head.setStyle(bucketHeadCss())
    var col = Column(listOf(head, coloredBucketBar(b.percentage(), index, resultBarWidth(), "bucket-bar-" + String.valueOf(index))))
    col.setStyle(bucketRowCss())
    var row = View(screenStyle())
    row.setStyle(bucketWrapCss())
    row.bind(col)
    return row
}

View resultInfoCard() {
    var brand = Label("Organiza AI")
    brand.setStyle(infoBrandCss())
    var copy = Label("Calcula o modelo de economia que mais se adequa a sua realidade do momento.")
    copy.setStyle(infoCopyCss())
    var col = Column(listOf(brand, copy))
    col.setStyle(infoCardColCss())
    var card = View(screenStyle())
    card.setId("result-info-card")
    card.setStyle(infoCardCss())
    card.bind(col)
    return card
}

View onbResultScreen(Window w) {
    var model = ""
    var description = ""
    val r = ResultState.last
    if (r != null) {
        model = r.suggestedModel()
        description = r.description()
    }

    var title = onbTitle("Seu modelo: " + modelFriendlyName(model), "result-title")
    var text = onbSubtitle(description, "result-description")

    var items = listOf(dotsBlock(4), titleBlock(title, text))
    if (r != null) {
        var bucketRows: List<View> = listOf()
        var i = 0
        for (var b in r.buckets()) {
            bucketRows.add(bucketRow(b, i))
            i = i + 1
        }
        if (!bucketRows.isEmpty()) {
            var listCol = Column(bucketRows)
            listCol.setStyle(bucketListCss())
            var listWrap = View(screenStyle())
            listWrap.setStyle(blockCss())
            listWrap.bind(listCol)
            items.add(listWrap)
        }
    }
    items.add(resultInfoCard())
    items.add(buttonBlock(primaryButton("Começar a organizar", "btn-start", false, () -> navigateTo(w, "dashboard"))))

    return onbBody(items, onbColumn540Css())
}

// ---- Helpers compartilhados entre as telas de onboarding --------------------

Row onbProgressDots(Int current) {
    var r = Row(listOf(
        progressDot(0, current),
        progressDot(1, current),
        progressDot(2, current),
        progressDot(3, current),
        progressDot(4, current)))
    r.setId("onb-dots")
    r.setStyle(dotsCss())
    return r
}

View dotsBlock(Int current) {
    var v = View(screenStyle())
    v.setStyle(blockCss())
    v.bind(onbProgressDots(current))
    return v
}

Label onbTitle(String text, String id) {
    var l = Label(text)
    l.setId(id)
    if (AppState.isDesktop) {
        l.setStyle(onbTitleDesktopCss())
    } else {
        l.setStyle(onbTitleMobileCss())
    }
    return l
}

Label onbSubtitle(String text, String id) {
    var l = Label(text)
    l.setId(id)
    if (AppState.isDesktop) {
        l.setStyle(onbSubtitleDesktopCss())
    } else {
        l.setStyle(onbSubtitleMobileCss())
    }
    return l
}

View titleBlock(Label title, Label text) {
    var col = Column(listOf(title, text))
    col.setStyle(titleBlockCss())
    var v = View(screenStyle())
    v.setStyle(blockCss())
    v.bind(col)
    return v
}

View buttonBlock(Button b) {
    var v = View(screenStyle())
    v.setStyle(blockCss())
    v.bind(b)
    return v
}

// Botão limitado a 300 px centrado no Desktop (Salário e Chips nos artefatos).
View onbCtaBlock(Button b) {
    var v = View(screenStyle())
    if (AppState.isDesktop) {
        v.setStyle(onbCtaCenteredCss())
    } else {
        v.setStyle(blockCss())
    }
    v.bind(b)
    return v
}

View errorBlock(String message) {
    var v = View(screenStyle())
    v.setStyle(blockCss())
    v.bind(errorBanner(message))
    return v
}

View onbBody(List<View> items, Style desktopColStyle) {
    var column = Column(items)
    if (AppState.isDesktop) {
        column.setStyle(desktopColStyle)
    } else {
        column.setStyle(onbColumnMobileCss())
    }
    var body = View(screenStyle())
    body.setStyle(entryBodyCss())
    body.bind(column)
    return body
}

// ---- Estilos locais das telas de onboarding (Style("css")) ------------------
