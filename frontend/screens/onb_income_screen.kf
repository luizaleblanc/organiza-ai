package screens

import kof.ui
import core.theme
import core.app_state
import core.navigation
import components.form_widgets

// =============================================================================
// Tela 5 — Tipo de renda (spec B2-05; design.md F8a)
// =============================================================================
// Dois cards; nenhum selecionado ao abrir e "Próximo" desabilitado. Tocar um
// card grava OnboardingState.incomeType ("FIXED"/"VARIABLE"), marca
// incomeChosen e re-renderiza. "Próximo" vai para "onb_debt" (Tela 6, F8b).
// =============================================================================

View onbIncomeScreen(Window w) {
    var title = Label("Sua renda é fixa ou variável?")
    title.setId("onb-title")
    title.setStyle(titleCss())

    var chosen = OnboardingState.incomeChosen
    var fixed = choiceCard("Fixa (CLT, salário todo mês)", "card-fixed",
        chosen && OnboardingState.incomeType == "FIXED", () -> chooseIncome(w, "FIXED"))
    var variable = choiceCard("Variável (freela, PJ, bicos)", "card-variable",
        chosen && OnboardingState.incomeType == "VARIABLE", () -> chooseIncome(w, "VARIABLE"))
    var cards = Column(listOf(fixed, variable))
    cards.setStyle(choiceListCss())

    var next = disabledButton("Próximo", "btn-next")
    if (chosen) {
        next = primaryButton("Próximo", "btn-next", false, () -> navigateTo(w, "onb_debt"))
    }

    var col = Column(listOf(progressDots(1), title, cards, next))
    col.setStyle(onbColumnCss())

    var body = View(screenStyle())
    body.setStyle(entryBodyCss())
    body.bind(col)
    return body
}

chooseIncome(Window w, String type) {
    OnboardingState.incomeType = type
    OnboardingState.incomeChosen = true
    mountScreen(w)
}
