package core

import kof.ui
import core.theme

// =============================================================================
// Batch 2 (F5) — Dinheiro e e-mail (design §4.4)
// =============================================================================
// Dinheiro trafega em centavos (Long) para não acumular erro de Double.
// String.format lança no navegador e math.round não existe (design §1 h):
// a saída é montada aqui com math.roundTo.
// =============================================================================

Bool isDigit(Char c) = c >= '0' && c <= '9'

// "1234567" -> "1.234.567"
String groupThousands(String digits) {
    var out = ""
    var i = 0
    val n = digits.length
    while (i < n) {
        if (i > 0 && (n - i) % 3 == 0) {
            out = out + "."
        }
        out = out + String.valueOf(digits.charAt(i))
        i = i + 1
    }
    return out
}

// 1234.5 -> "R$ 1.234,50"; -3.0 -> "- R$ 3,00"
String brl(Double value) {
    var cents = math.roundTo(value * 100.0, 0) as Long
    var sign = ""
    if (cents < 0) {
        sign = "- "
        cents = 0 - cents
    }
    val reais = cents / 100
    val rest = cents % 100
    var centsText = String.valueOf(rest)
    if (rest < 10) {
        centsText = "0" + centsText
    }
    return sign + "R$ " + groupThousands(String.valueOf(reais)) + "," + centsText
}

Int lastIndexOfChar(String s, Char target) {
    var found = -1
    var i = 0
    while (i < s.length) {
        if (s.charAt(i) == target) {
            found = i
        }
        i = i + 1
    }
    return found
}

// Aceita "3000", "3.000", "3000,5", "3.000,50", "R$ 1.234,56", "3000.50".
// Com vírgula, os pontos são milhar. Sem vírgula, o último ponto é milhar se
// tiver exatamente 3 dígitos depois; senão é decimal. Até 2 casas e
// 0 < valor <= 1.000.000; fora disso lança "valor inválido".
Double parseMoney(String raw) {
    var clean = ""
    for (var c in raw.toCharArray()) {
        if (isDigit(c) || c == ',' || c == '.') {
            clean = clean + String.valueOf(c)
        } else if (c != ' ' && c != 'R' && c != '$') {
            throw "valor inválido"
        }
    }
    var decimalSep = ' '
    if (clean.contains(",")) {
        decimalSep = ','
    } else {
        val lastDot = lastIndexOfChar(clean, '.')
        if (lastDot >= 0 && clean.length - lastDot - 1 != 3) {
            decimalSep = '.'
        }
    }
    var intDigits = ""
    var fracDigits = ""
    var inFrac = false
    for (var c in clean.toCharArray()) {
        if (c == decimalSep) {
            if (inFrac) {
                throw "valor inválido"
            }
            inFrac = true
        } else if (isDigit(c)) {
            if (inFrac) {
                fracDigits = fracDigits + String.valueOf(c)
            } else {
                intDigits = intDigits + String.valueOf(c)
            }
        }
    }
    if (intDigits == "" && fracDigits == "") {
        throw "valor inválido"
    }
    if (fracDigits.length > 2 || intDigits.length > 7) {
        throw "valor inválido"
    }
    while (fracDigits.length < 2) {
        fracDigits = fracDigits + "0"
    }
    if (intDigits == "") {
        intDigits = "0"
    }
    // Int basta (no máximo 7 dígitos inteiros + 2 casas). Não usar
    // String.toLong(): no KofJS ele devolve BigInt e o toDouble() seguinte
    // lança "Cannot mix BigInt and other types" (medido no kof 0.6.6 e 0.6.7).
    val cents = intDigits.toInt() * 100 + fracDigits.toInt()
    if (cents <= 0 || cents > 100000000) {
        throw "valor inválido"
    }
    return cents.toDouble() / 100.0
}

// "@" com texto antes e depois, sem espaço (spec B2-03 item 6).
Bool isEmailLike(String email) {
    val at = email.indexOf("@")
    return at > 0 && at < email.length - 1 && !email.contains(" ")
}

// =============================================================================
// Batch 3 (F0) — rótulos e tons das telas do shell (spec b3, LACUNA-1/2)
// =============================================================================
// Os enums do backend chegam como String no JSON; o mapeamento para PT e cor
// fica todo aqui. Valor desconhecido nunca lança: cai num rótulo neutro.

// Nome amigável do modelo (design.md §4.1; movido da Tela 7).
String modelFriendlyName(String model) {
    if (model == "STANDARD_503020") {
        return "50/30/20"
    }
    if (model == "SURVIVAL_702010") {
        return "70/20/10"
    }
    if (model == "ANTI_DEBT_701020") {
        return "Anti-Dívida"
    }
    if (model == "SIMPLE_8020") {
        return "80/20"
    }
    if (model == "KAKEIBO") {
        return "Kakeibo"
    }
    if (model == "FREELANCER_BASE_ZERO") {
        return "Base Zero"
    }
    return model
}

// Título do card do Dashboard a partir do modelo do usuário (DECISÃO-2):
// "Distribuição 50/30/20", "Distribuição 70/20/10", "Distribuição Kakeibo"...
String distributionTitle(String model) = "Distribuição " + modelFriendlyName(model)

// Category (backend/models.kf) -> rótulo PT.
String categoryLabel(String category) {
    if (category == "GROCERIES") { return "Mercado" }
    if (category == "LEISURE") { return "Lazer" }
    if (category == "FOOD") { return "Alimentação" }
    if (category == "PHARMA") { return "Farmácia" }
    if (category == "HEALTH") { return "Saúde" }
    if (category == "AUTO") { return "Carro" }
    if (category == "TRANSPORT") { return "Transporte" }
    if (category == "HOUSING") { return "Moradia" }
    if (category == "EDUCATION") { return "Educação" }
    if (category == "SHOPPING") { return "Compras" }
    if (category == "SUBSCRIPTIONS") { return "Assinaturas" }
    return "Outros"
}

// Category -> cor do ponto (paleta de categorias do theme.kf).
Color categoryColor(String category) {
    if (category == "HOUSING") { return colorCatMoradia() }
    if (category == "GROCERIES") { return colorCatMercado() }
    if (category == "TRANSPORT" || category == "AUTO") { return colorCatTransporte() }
    if (category == "FOOD" || category == "SUBSCRIPTIONS" || category == "SHOPPING") { return colorCatDelivery() }
    if (category == "LEISURE") { return colorCatLazer() }
    if (category == "HEALTH" || category == "PHARMA" || category == "EDUCATION") { return colorCatReserva() }
    return colorTextSecondary()
}

// Status de caixinha (EnvelopeOverview.status) -> badge e tom.
String envelopeStatusLabel(String status) {
    if (status == "ESTOURADA") { return "Estourada" }
    if (status == "ALERTA") { return "Alerta" }
    return "Em dia"
}

String envelopeStatusTone(String status) {
    if (status == "ESTOURADA") { return "danger" }
    if (status == "ALERTA") { return "warning" }
    return "success"
}

// NotificationOutput.kind -> badge ("" = sem badge) e tom.
String notificationBadge(String kind) {
    if (kind == "ENVELOPE_EXCEEDED") { return "Estourada" }
    if (kind == "ENVELOPE_ALERT") { return "Alerta" }
    if (kind == "DAILY_PULSE") { return "Dica" }
    if (kind == "GOAL_REACHED") { return "Sucesso" }
    return ""
}

String notificationTone(String kind) {
    if (kind == "ENVELOPE_EXCEEDED") { return "danger" }
    if (kind == "ENVELOPE_ALERT") { return "warning" }
    if (kind == "GOAL_REACHED") { return "success" }
    return "accent"
}

// Tom -> cor (success/warning/danger/accent).
Color toneColor(String tone) {
    if (tone == "success") { return colorSuccess() }
    if (tone == "warning") { return colorWarning() }
    if (tone == "danger") { return colorDanger() }
    return colorAccent()
}

// Segundos decorridos -> "agora", "2 min", "1h", "3 d". Quem chama calcula a
// diferença (createdAt é ISO UTC); negativo (relógio adiantado) vira "agora".
String relativeTime(Int seconds) {
    if (seconds < 60) { return "agora" }
    if (seconds < 3600) { return String.valueOf(seconds / 60) + " min" }
    if (seconds < 86400) { return String.valueOf(seconds / 3600) + "h" }
    return String.valueOf(seconds / 86400) + " d"
}

String monthName(Int month) {
    val names = "Janeiro,Fevereiro,Março,Abril,Maio,Junho,Julho,Agosto,Setembro,Outubro,Novembro,Dezembro".split(",")
    if (month < 1 || month > 12) { return "" }
    return names[month - 1]
}

// (9, 2026) -> "Setembro 2026"; aceita o prefixo de uma data ISO "2026-09-...".
String monthYear(Int month, Int year) = monthName(month) + " " + String.valueOf(year)

String monthYearFromIso(String iso) {
    if (iso.length < 7) { return "" }
    return monthYear(iso.substring(5, 7).toInt(), iso.substring(0, 4).toInt())
}
