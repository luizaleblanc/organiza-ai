package core

import kof.json
import core.app_state
import core.api_client
import core.auth_api

// =============================================================================
// Tela 11 Caixinhas (Batch 3, F3) — estado e chamadas de /api/envelopes
// =============================================================================
// GET /api/envelopes/overview devolve cada caixinha com bucket, gasto do mês,
// percent e status (EM_DIA|ALERTA|ESTOURADA). `limitType` não é lido aqui: o
// JSON dele ainda está sendo corrigido no backend.
// =============================================================================

record EnvelopeItem(String id, String categoryName, String? bucket, Double limitAmount, Double spentThisMonth, Int percent, String status)
record CreateEnvelopeRequest(String categoryName, Double limitAmount, String bucket)
// GET /api/budgets/balance: só o nome de cada bucket do modelo é lido (json.decode ignora o resto).
record EnvBucketName(String name)
record EnvBalance(String model, List<EnvBucketName> buckets)

class EnvState {
    static String raw = ""
    static Bool loaded = false
    static Bool showNew = false
    static Bool loading = false
    static Bool busy = false
    static String loadError = ""
    static String formError = ""
    // Modal "Nova caixinha": a escolha sobrevive ao re-render (erro, troca de grupo).
    static Int newCategoryIdx = 0
    static String newLimit = ""
    static String newBucket = ""
    // Buckets reais do modelo do usuário (GET /api/budgets/balance).
    static List<String> buckets = listOf()
    // Id da caixinha com confirmação de exclusão aberta ("" = nenhuma).
    static String confirmDelete = ""
}

resetNewEnvelopeForm() {
    EnvState.newCategoryIdx = 0
    EnvState.newLimit = ""
    EnvState.newBucket = ""
    EnvState.formError = ""
}

String msgEnvelopeBucket() = "Esse grupo não existe no seu modelo de orçamento. Escolha um dos grupos sugeridos."

resetEnvelopes() {
    EnvState.raw = ""
    EnvState.loaded = false
    EnvState.loadError = ""
}

// Carrega o overview; falha vira EnvState.loadError (texto fixo em PT).
loadEnvelopes() {
    EnvState.loading = true
    try {
        EnvState.raw = getOrThrow("/api/envelopes/overview")
        EnvState.loadError = ""
    } catch (String e) {
        EnvState.loadError = e
    }
    loadBuckets()
    EnvState.loaded = true
    EnvState.loading = false
}

// Buckets do modelo atual; falha deixa a lista vazia e a tela usa os grupos do overview.
loadBuckets() {
    try {
        val raw = getOrThrow("/api/budgets/balance")
        var names: List<String> = listOf()
        for (var b in json.decode<EnvBalance>(raw).buckets()) {
            names.add(b.name())
        }
        EnvState.buckets = names
    } catch (String e) {
        EnvState.buckets = listOf()
    }
}

List<EnvelopeItem> envelopeItems() {
    if (EnvState.raw == "") {
        return listOf()
    }
    return json.decode<List<EnvelopeItem>>(EnvState.raw)
}

// POST /api/envelopes {categoryName, limitAmount, bucket}. Bucket fora do
// modelo = 400 "Bucket inválido..." -> mensagem fixa.
createEnvelope(String category, Double limit, String bucket) {
    var body = ""
    try {
        body = apiPost("/api/envelopes", json.encode(CreateEnvelopeRequest(category, limit, bucket)))
    } catch (String e) {
        throw msgNetwork()
    }
    if (isApiError(body)) {
        if (body.contains("Bucket")) {
            throw msgEnvelopeBucket()
        }
        throw apiErrorMessage(body)
    }
}

// DELETE /api/envelopes/:id (204 = corpo vazio).
deleteEnvelope(String id) {
    var body = ""
    try {
        body = apiDelete("/api/envelopes/" + id)
    } catch (String e) {
        throw msgNetwork()
    }
    if (isApiError(body)) {
        throw apiErrorMessage(body)
    }
}
