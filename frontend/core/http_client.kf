package core

import kof.http
import kof.security

// =============================================================================
// HTTP Client — wrapper para chamadas ao BFF (KOF web)
// =============================================================================

String ApiClient_baseUrl = "http://localhost:3000"
String? ApiClient_token  = null
// -------------------------------------------------------------------------
// Configuração
// -------------------------------------------------------------------------
ApiClient_setBaseUrl(String url) {
ApiClient_baseUrl = url

    static setToken(String t) {
        ApiClient_token = t
    }

    static clearToken() {
        ApiClient_token = null
    }

    // -------------------------------------------------------------------------
    // Headers
    // -------------------------------------------------------------------------

    static String _authHeader() {
        if (ApiClient_token != null) {
            return "Authorization: Bearer " + ApiClient_token + "\nContent-Type: application/json"
        }
        return "Content-Type: application/json"
    }

    // -------------------------------------------------------------------------
    // Verbos HTTP (delegam para kof.http)
    // -------------------------------------------------------------------------

    static String get(String path) {
        return http.get(ApiClient_baseUrl + path, _authHeader())
    }

    static String post(String path, String body) {
        return http.post(ApiClient_baseUrl + path, body, _authHeader())
    }

    static String put(String path, String body) {
        return http.put(ApiClient_baseUrl + path, body, _authHeader())
    }

    static String delete(String path) {
        return http.delete(ApiClient_baseUrl + path, _authHeader())
    }

    static String patch(String path, String body) {
        return http.patch(ApiClient_baseUrl + path, body, _authHeader())
    }

    // -------------------------------------------------------------------------
    // Status check
    // -------------------------------------------------------------------------

    static Int status(String path) {
        return http.status(ApiClient_baseUrl + path)
    }
}

