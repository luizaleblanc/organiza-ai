package core

// =============================================================================
// Constantes de Layout — DESIGN_SYSTEM.md, seção 4
// =============================================================================

class Layout {
    // Grid
    static Int gridBase          = 8
    static Int screenWidth       = 360
    static Int screenHeight      = 640
    static Int marginHorizontal  = 16
    // Componentes
    static Int buttonHeight      = 48
    static Int inputHeight       = 48
    static Int navBarHeight      = 64
    static Int iconButtonSize    = 40
    static Int sendButtonSize    = 48
    // Border radius
    static Int radiusButton      = 12
    static Int radiusCard        = 12
    static Int radiusInput       = 8
    static Int radiusNavBar      = 16
    // Gap / Spacing
    static Int gapItems          = 16
    static Int gapSections       = 24
    static Int gapProgressBars   = 20
    static Int gapOnboardingDots = 12
    // Status bar & home indicator
    static Int statusBarHeight   = 24
    static Int homeIndicatorH    = 24
    // Dots de onboarding
    static Int dotSize           = 8
    static Int totalSteps        = 4
    // Tipografia (tamanhos)
    static Int fontTitle         = 24
    static Int fontSubtitle      = 18
    static Int fontBody          = 16
    static Int fontCaption       = 14
    static Int fontMonetary      = 24
    static Int fontLogo          = 28
    // Tipografia (pesos) — 400 = regular, 600 = semibold
    static Int weightRegular     = 400
    static Int weightSemibold    = 600
}
