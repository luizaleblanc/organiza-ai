package core

// =============================================================================
// T2 — Estado global da UI
// =============================================================================
// Estado mutável compartilhado entre telas vive em campos `static` de classes
// (lambdas de Button capturam snapshots, mas leem/escrevem campos estáticos).
// Todos os defaults são LITERAIS não-nulos: sem `= null` (SEM048) e sem
// inicializadores computados (o KofJS só inicializa literais diretos).
// Coleções são codificadas em String (uma linha por item) pelo mesmo motivo.
// =============================================================================

class AppState {
    static String currentScreen = "welcome"
    static Bool isDesktop = true
    // Modo claro de Login e Cadastro (botão "Modo claro / Modo escuro").
    static Bool lightAuth = false
    // Toggle de tema: "system", "light" ou "dark". O kof.ui não lê a preferência do sistema,
    // então "system" usa o escuro (padrão do app).
    static String themeMode = "dark"
    static String activeToast = ""
    static String activeNotificationModel = ""
    static Bool showNotificationOverlay = false
    // Mensagem de erro da tela de entrada ativa ("" = sem erro). Quem navega
    // limpa antes de trocar de tela (design §2.4).
    static String formError = ""
    // Shell autenticado (Batch 3, T0). Rotas fixas: "dashboard", "chat",
    // "envelopes", "notifications", "settings". loadError/loading são da tela
    // ativa; navigateTo limpa os dois ao trocar de rota.
    static String loadError = ""
    static Bool loading = false
}

class SessionState {
    static String token = ""
    static String userId = ""
    static String userName = ""
    static String userEmail = ""
    static String tier = "FREE"
}

// Estado do onboarding (Telas 4 a 7), lido pela Tela 7 para o POST.
// - salary: texto digitado na Tela 4, já validado por parseMoney (F5); quem
//   precisa do número chama parseMoney(OnboardingState.salary) de novo.
// - incomeType: "FIXED" ou "VARIABLE"; só vale se incomeChosen = true.
// - incomeChosen: a pessoa tocou um card da Tela 5 (habilita "Próximo").
// Tela 4 -> "onb_income" (Tela 5) -> "onb_debt" (Tela 6, F8b).
class OnboardingState {
    static String salary = ""
    static String incomeType = "FIXED"
    static Bool incomeChosen = false
    // Renda mensal como PJ (renda variável), texto com máscara; vira o salário do onboarding.
    static String pjIncome = ""
    static Bool hasDebt = false
    static String debtAmount = ""
    static String suggestedModel = ""
    static String modelDescription = ""
    // Tela 6 (F8b): "" (nada escolhido), "YES" ou "NO".
    static String debtChoice = ""
    // Telas 6/6.1: envio do onboarding em andamento (um toque = uma chamada).
    static Bool submitting = false
    // Etapa 4 (chips): selecionados separados por "," (defaults dos artefatos).
    static String fixedChips = "Aluguel,Contas,Transporte"
    static String variableChips = "Alimentação,Delivery"
}

// Deprecado (Batch 3): F1 usa DashState em core/dashboard_api.kf. Remover num
// batch posterior.
class DashboardState {
    static String dailyPulse = "0,00"
    static Double monthlyBalance = 0.0
    static Int daysRemaining = 0
    static String tipText = ""
    static String budgetModel = "STANDARD_503020"
    static Int needsPct = 0
    static Int wantsPct = 0
    static Int savingsPct = 0
    static String selectedBucket = ""
    // Uma caixinha por linha: "nome:gasto:limite"
    static String envelopes = ""
}

class ChatState {
    // Uma mensagem por linha: "USER|texto" ou "ASSISTANT|texto"
    static String messages = ""
    static Int remainingFreeMsgs = 10
}

// ---- Helpers de estado -----------------------------------------------------

Bool isLoggedIn() = SessionState.token != ""

chatAppend(String role, String text) {
    ChatState.messages = ChatState.messages + role + "|" + text + "\n"
}

resetSession() {
    SessionState.token = ""
    SessionState.userId = ""
    SessionState.userName = ""
    SessionState.userEmail = ""
    SessionState.tier = "FREE"
    ChatState.messages = ""
    AppState.currentScreen = "welcome"
}
