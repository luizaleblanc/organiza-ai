package core

import kof.json
import core.app_state
import core.api_client

// =============================================================================
// Batch 3 (F2) — API e estado da Tela 10 Organiza AI (chat)
// =============================================================================
// Rotas: POST /api/chat/message {message} -> {reply, messagesUsed, messagesLimit}
// (402 no limite do plano, 503 com o provedor fora), GET /api/chat/messages
// (página 1 = mais recentes, em ordem cronológica) e GET /api/users/tier-status
// (contador ao abrir a tela).
// As mensagens ficam em ChatState.messages (uma por linha, "ROLE|texto"), só
// via chatAppend. Quebras de linha do texto viram '¶' na linha e voltam ao
// mostrar.
// No alvo js o corpo chega sem status: 4xx devolve {"error": ...} e 5xx/rede
// lança String (aqui o 503 ou falta de conexão). Sem status, o 402 do limite
// é reconhecido pelo texto do backend (enforceCanSendMessage, services.kf);
// qualquer outro {"error"} mostra a mensagem do backend e mantém o rascunho.
// =============================================================================

// Contrato tipado do chat. A ponte de voz do navegador transcreve para texto
// antes do envio, portanto a mesma requisição KOF valida tanto texto digitado
// quanto fala (STT); a resposta tipada alimenta a leitura TTS no cliente.
record ChatMessageRequest(String message)
record ChatReplyResponse(String reply, Int messagesUsed, Int messagesLimit)
record ChatHistoryItem(String role, String content, String createdAt)
record ChatHistoryPage(List<ChatHistoryItem> items, Int page, Int limit, Int offset, Bool hasNext)
record ChatApiError(String error)
record ChatTierStatus(String tier, Int messagesUsed, Int messagesLimit, Bool voiceEnabled, Bool canSendMessage)

class ChatUi {
    static String draft = ""
    static Bool sending = false
    // Várias mensagens podem estar aguardando resposta ao mesmo tempo.
    static Int activeRequests = 0
    static Bool blocked = false
    // Mensagem do usuário em envio (bolha provisória até a resposta chegar).
    static String pending = ""
    // Uma mensagem codificada por linha, usada para renderizar os envios que
    // ainda não receberam resposta.
    static String pendingQueue = ""
    // Token para o qual o histórico já foi pedido ("" = nunca).
    static String loadedFor = ""
    static Bool loading = false
    static String error = ""
    // Contador "N de M"; usageKnown = false até a 1ª leitura. limit -1 = Pro.
    static Bool usageKnown = false
    static Int used = 0
    static Int limit = 0
    static Bool voiceEnabled = false
    static Bool pro = false
}

String chatLimitText() = "Você chegou ao limite de " + String.valueOf(ChatUi.limit) + " mensagens do plano Gratuito neste mês. Assine o Pro para continuar conversando."
String chatOfflineText() = "O Organiza AI está indisponível agora (serviço fora do ar ou sem conexão). Tente de novo em instantes."
String chatHistoryErrorText() = "Não foi possível carregar o histórico. Tente de novo em instantes."

// Texto do 402 em backend/services.kf: "Você atingiu o limite de 30 mensagens
// gratuitas este mês." Só ele bloqueia o envio.
Bool isChatLimitError(String message) = message.contains("limite de") && message.contains("mensagens")

String chatEncode(String text) = text.replace('\n', '¶')
String chatDecode(String text) = text.replace('¶', '\n')

String pendingChatKey(String text) = chatEncode(text)

queueChatMessage(String text) {
    ChatUi.pendingQueue = ChatUi.pendingQueue + pendingChatKey(text) + "\n"
    ChatUi.pending = text
    ChatUi.activeRequests = ChatUi.activeRequests + 1
    ChatUi.sending = true
}

removePendingChatMessage(String text) {
    val key = pendingChatKey(text)
    var removed = false
    var out = ""
    for (var line in ChatUi.pendingQueue.split("\n")) {
        if (line != "") {
            if (!removed && line == key) {
                removed = true
            } else {
                out = out + line + "\n"
            }
        }
    }
    ChatUi.pendingQueue = out
    if (ChatUi.activeRequests > 0) {
        ChatUi.activeRequests = ChatUi.activeRequests - 1
    }
    ChatUi.sending = ChatUi.activeRequests > 0
    if (ChatUi.activeRequests == 0) {
        ChatUi.pending = ""
    }
}

// Carrega contador + página 1 do histórico (uma vez por sessão/token).
loadChat() {
    ChatUi.loading = true
    ChatUi.error = ""
    ChatUi.draft = ""
    ChatUi.pending = ""
    ChatUi.pendingQueue = ""
    ChatUi.sending = false
    ChatUi.activeRequests = 0
    ChatUi.blocked = false
    ChatUi.usageKnown = false
    ChatUi.used = 0
    ChatUi.limit = 0
    ChatUi.voiceEnabled = false
    ChatUi.pro = false
    try {
        val tierBody = apiGet("/api/users/tier-status")
        if (isApiError(tierBody)) {
            ChatUi.error = chatHistoryErrorText()
            ChatUi.loading = false
            return
        }
        val tier = json.decode<ChatTierStatus>(tierBody)
        ChatUi.used = tier.messagesUsed()
        ChatUi.limit = tier.messagesLimit()
        ChatUi.voiceEnabled = tier.voiceEnabled()
        ChatUi.pro = tier.tier() == "PREMIUM"
        ChatUi.usageKnown = true
        ChatUi.blocked = !tier.canSendMessage()
        val body = apiGet("/api/chat/messages?page=1&limit=50")
        if (isApiError(body)) {
            ChatUi.error = chatHistoryErrorText()
        } else {
            val page = json.decode<ChatHistoryPage>(body)
            ChatState.messages = ""
            for (var item in page.items()) {
                chatAppend(item.role(), chatEncode(item.content()))
            }
        }
    } catch (String e) {
        ChatUi.error = chatHistoryErrorText()
    }
    ChatUi.loading = false
}

// Envia uma mensagem. Sucesso: grava as duas bolhas e o contador. 402 (texto do
// limite): bloqueia o envio. Outro {"error"}: mostra a mensagem do backend.
// 503/rede: mensagem fixa. Nos erros o rascunho fica para tentar de novo.
sendChatMessage(String text) {
    ChatUi.error = ""
    try {
        val body = apiPost("/api/chat/message", json.encode(ChatMessageRequest(text)))
        if (isApiError(body)) {
            ChatUi.draft = text
            val message = json.decode<ChatApiError>(body).error()
            if (isChatLimitError(message)) {
                ChatUi.blocked = true
                if (ChatUi.limit <= 0) {
                    ChatUi.limit = 30
                }
                ChatUi.used = ChatUi.limit
                ChatUi.usageKnown = true
                ChatUi.error = chatLimitText()
            } else {
                ChatUi.error = message
            }
        } else {
            val r = json.decode<ChatReplyResponse>(body)
            chatAppend("USER", chatEncode(text))
            chatAppend("ASSISTANT", chatEncode(r.reply()))
            ChatUi.used = r.messagesUsed()
            ChatUi.limit = r.messagesLimit()
            ChatUi.usageKnown = true
            ChatUi.draft = ""
            if (ChatUi.limit >= 0 && ChatUi.used >= ChatUi.limit) {
                ChatUi.blocked = true
            }
        }
    } catch (String e) {
        ChatUi.draft = text
        ChatUi.error = chatOfflineText()
    }
    removePendingChatMessage(text)
}
