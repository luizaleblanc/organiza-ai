package core

import kof.json
import core.app_state
import core.api_client
import core.format
import core.envelopes_api

// =============================================================================
// Batch 3 (F2) — API e estado da Tela 10 Organiza AI (chat)
// =============================================================================
// Rotas: POST /api/chat/message {message} -> {reply, messagesUsed, messagesLimit}
// (402 no limite do plano, 503 com o provedor fora), GET /api/chat/messages
// (página 1 = mais recentes, em ordem cronológica) e GET /api/users/tier-status
// (contador ao abrir a tela).
// As mensagens ficam em ChatState.messages (uma por linha, "ROLE|texto"), só
// via chatAppend. Quebras de linha do texto viram '¶' na linha e voltam ao
// mostrar.
// No alvo js o corpo chega sem status: 4xx devolve {"error": ...} e 5xx/rede
// lança String (aqui o 503 ou falta de conexão). Sem status, o 402 do limite
// é reconhecido pelo texto do backend (enforceCanSendMessage, services.kf);
// qualquer outro {"error"} mostra a mensagem do backend e mantém o rascunho.
// =============================================================================

// Contrato tipado do chat. A ponte de voz do navegador transcreve para texto
// antes do envio, portanto a mesma requisição KOF valida tanto texto digitado
// quanto fala (STT); a resposta tipada alimenta a leitura TTS no cliente.
record ChatMessageRequest(String message)
record ChatInteractionOptionResponse(String id, String label, String action, String intent, String icon, Int badgeCount)
record ChatFlowLineItemResponse(String label, String formattedAmount, Int count, String? note)
record ChatInteractionSummaryResponse(String periodLabel, String totalInflowsText, Int inflowsCount, List<ChatFlowLineItemResponse> entradas, String totalOutflowsText, Int outflowsCount, List<ChatFlowLineItemResponse> saidas, String pendingText, Int pendingCount)
record ChatInteractionDetailsResponse(String title, List<String> items)
record ChatSelectableItemResponse(String id, String label, String groupLabel, String categoryCode, String formattedAmount, Int amountCents, String? subtitle, Bool defaultSelected)
record ChatInteractionResponse(String type, String prompt, String? documentId, String? period, String? periodLabel, String? headline, String? educationTip, ChatInteractionSummaryResponse? summary, ChatInteractionDetailsResponse? details, List<ChatInteractionOptionResponse> options, List<ChatSelectableItemResponse> items)
record ChatReplyResponse(String reply, Int messagesUsed, Int messagesLimit, ChatInteractionResponse? interaction)
record ConfirmImportParamsRequest(String selectedIds, String period)
record ConfirmImportDispatchRequest(String intent, List<String> attachmentIds, ConfirmImportParamsRequest parameters)
record QueryCategoriesParamsRequest(String period, String categories)
record QueryCategoriesDispatchRequest(String intent, QueryCategoriesParamsRequest parameters)
record IntentDispatchApiResponse(String status, String intent, String correlationId, Bool requiresConfirmation, String message, String? dataJson)
record ReclassifyTxRequest(List<String> txIds, String category)
record ReclassifyTxToEnvelopeRequest(List<String> txIds, String category, String envelopeId)
record LatestDocSyncResponse(Bool hasDocument, String? status, ChatInteractionResponse? interaction)
record ChatHistoryItem(String role, String content, String createdAt)
record ChatHistoryPage(List<ChatHistoryItem> items, Int page, Int limit, Int offset, Bool hasNext)
record ChatApiError(String error)
record ChatTierStatus(String tier, Int messagesUsed, Int messagesLimit, Bool voiceEnabled, Bool canSendMessage)

class ChatUi {
    static String draft = ""
    static Bool sending = false
    // Várias mensagens podem estar aguardando resposta ao mesmo tempo.
    static Int activeRequests = 0
    static Bool blocked = false
    // Mensagem do usuário em envio (bolha provisória até a resposta chegar).
    static String pending = ""
    // Uma mensagem codificada por linha, usada para renderizar os envios que
    // ainda não receberam resposta.
    static String pendingQueue = ""
    // Token para o qual o histórico já foi pedido ("" = nunca).
    static String loadedFor = ""
    static Bool loading = false
    static String error = ""
    // Payload tipado da última resposta interativa; renderizado em KOF UI.
    static String interactionJson = ""
    static Bool interactionDetailsOpen = false
    // Estado local dos checkboxes dos templates interativos (nenhuma gravação antes de Confirmar).
    static String selectedIds = ""
    static String selectionInitKey = ""
    static String reviewCategory = "FOOD"
    // Revisão item a item: "|txId=CAT|" por movimentação; prévia antes de salvar.
    static String itemCategories = ""
    static Bool reviewPreview = false
    // Registro da fatura: prévia por caixinha antes de confirmar.
    static Bool registerPreview = false
    // "+ Criar caixinha" na revisão: formulário aberto e nome digitado.
    static Bool newBoxOpen = false
    // Lixeira do cabeçalho: primeiro clique pede confirmação, o segundo apaga.
    static Bool confirmClear = false
    // "Entender meus gastos": categoria filtrada ("" = todas).
    static String expenseFilter = ""
    static String newBoxName = ""
    static String manualPeriod = ""
    static Bool interactionBusy = false
    static String interactionError = ""
    static String interactionInfo = ""
    // Contador "N de M"; usageKnown = false até a 1ª leitura. limit -1 = Pro.
    static Bool usageKnown = false
    static Int used = 0
    static Int limit = 0
    static Bool voiceEnabled = false
    static Bool pro = false
    static Int currentChatId = 1
    static Int totalChats = 1
    static String archivedSession = ""
}

String chatLimitText() = "Você chegou ao limite de " + String.valueOf(ChatUi.limit) + " mensagens do plano Gratuito neste mês. Assine o Pro para continuar conversando."
String chatOfflineText() = "O Organiza AI está indisponível agora (serviço fora do ar ou sem conexão). Tente de novo em instantes."
String chatHistoryErrorText() = "Não foi possível carregar o histórico. Tente de novo em instantes."

// Texto do 402 em backend/services.kf: "Você atingiu o limite de 30 mensagens
// gratuitas este mês." Só ele bloqueia o envio.
Bool isChatLimitError(String message) = message.contains("limite de") && message.contains("mensagens")

String chatEncode(String text) = text.replace('\n', '¶')
String chatDecode(String text) = text.replace('¶', '\n')

String pendingChatKey(String text) = chatEncode(text)

queueChatMessage(String text) {
    ChatUi.pendingQueue = ChatUi.pendingQueue + pendingChatKey(text) + "\n"
    ChatUi.pending = text
    ChatUi.activeRequests = ChatUi.activeRequests + 1
    ChatUi.sending = true
}

removePendingChatMessage(String text) {
    val key = pendingChatKey(text)
    var removed = false
    var out = ""
    for (var line in ChatUi.pendingQueue.split("\n")) {
        if (line != "") {
            if (!removed && line == key) {
                removed = true
            } else {
                out = out + line + "\n"
            }
        }
    }
    ChatUi.pendingQueue = out
    if (ChatUi.activeRequests > 0) {
        ChatUi.activeRequests = ChatUi.activeRequests - 1
    }
    ChatUi.sending = ChatUi.activeRequests > 0
    if (ChatUi.activeRequests == 0) {
        ChatUi.pending = ""
    }
}

String brlFromCents(Int cents) = brl(cents.toDouble() / 100.0)

resetInteractionSelectionState() {
    ChatUi.selectedIds = ""
    ChatUi.selectionInitKey = ""
    ChatUi.manualPeriod = ""
    ChatUi.interactionBusy = false
    ChatUi.interactionError = ""
    ChatUi.interactionInfo = ""
}

ensureSelectionInitialized(ChatInteractionResponse interaction) {
    var docId = ""
    val rawDocId = interaction.documentId()
    if (rawDocId != null) {
        docId = rawDocId
    }
    val key = interaction.type() + ":" + docId + ":" + String.valueOf(interaction.items().size)
    if (ChatUi.selectionInitKey == key) {
        return
    }
    ChatUi.selectionInitKey = key
    ChatUi.itemCategories = ""
    ChatUi.expenseFilter = ""
    ChatUi.reviewPreview = false
    ChatUi.registerPreview = false
    ChatUi.interactionError = ""
    ChatUi.interactionInfo = ""
    var buf = ""
    for (var item in interaction.items()) {
        if (item.defaultSelected()) {
            buf = buf + "|" + item.id() + "|"
        }
    }
    ChatUi.selectedIds = buf
    val p = interaction.period()
    if (p != null) {
        ChatUi.manualPeriod = p
    } else {
        ChatUi.manualPeriod = ""
    }
}

Bool isSelectedItem(String id) {
    if (id == "") {
        return false
    }
    return ChatUi.selectedIds.contains("|" + id + "|")
}

toggleSelectedItem(String id) {
    if (id == "") {
        return
    }
    val tok = "|" + id + "|"
    if (ChatUi.selectedIds.contains(tok)) {
        ChatUi.selectedIds = ChatUi.selectedIds.replace(tok, "")
    } else {
        ChatUi.selectedIds = ChatUi.selectedIds + tok
    }
    ChatUi.interactionError = ""
}

selectAllItems(List<ChatSelectableItemResponse> items) {
    var buf = ""
    for (var item in items) {
        buf = buf + "|" + item.id() + "|"
    }
    ChatUi.selectedIds = buf
    ChatUi.interactionError = ""
}

clearAllItems() {
    ChatUi.selectedIds = ""
    ChatUi.interactionError = ""
}

Int countSelectedItems(List<ChatSelectableItemResponse> items) {
    var count = 0
    for (var item in items) {
        if (isSelectedItem(item.id())) {
            count = count + 1
        }
    }
    return count
}

Int sumSelectedCents(List<ChatSelectableItemResponse> items) {
    var total = 0
    for (var item in items) {
        if (isSelectedItem(item.id())) {
            total = total + item.amountCents()
        }
    }
    return total
}

List<String> collectSelectedIds(List<ChatSelectableItemResponse> items) {
    var out: List<String> = listOf()
    for (var item in items) {
        if (isSelectedItem(item.id())) {
            out.add(item.id())
        }
    }
    return out
}

String joinComma(List<String> ids) {
    var out = ""
    for (var id in ids) {
        if (out != "") {
            out = out + ","
        }
        out = out + id
    }
    return out
}

// DECLARAR_RESERVA: checklist com uma escolha (o usuário decide o destino).
chooseSingleItem(String id) {
    ChatUi.selectedIds = "|" + id + "|"
    ChatUi.interactionError = ""
}

confirmReserveDeclarationAction(ChatInteractionResponse interaction) {
    if (ChatUi.interactionBusy) {
        return
    }
    val chosen = collectSelectedIds(interaction.items())
    if (chosen.size != 1) {
        ChatUi.interactionError = "Escolha uma opção para eu continuar."
        return
    }
    var proposal = ""
    val rawProposal = interaction.documentId()
    if (rawProposal != null) {
        proposal = rawProposal.trim()
    }
    ChatUi.interactionBusy = true
    ChatUi.interactionError = ""
    try {
        val reqJson = json.encode(ConfirmImportDispatchRequest(
            "DECLARAR_RESERVA",
            listOf(proposal),
            ConfirmImportParamsRequest(chosen.get(0), "")
        ))
        val body = apiPost("/api/intents/dispatch", reqJson)
        if (isApiError(body)) {
            ChatUi.interactionError = json.decode<ChatApiError>(body).error()
        } else {
            val res = json.decode<IntentDispatchApiResponse>(body)
            if (res.status() == "OK") {
                chatAppend("ASSISTANT", chatEncode(res.message()))
                cancelInteractiveTemplate()
            } else {
                ChatUi.interactionError = res.message()
            }
        }
    } catch (String e) {
        ChatUi.interactionError = e
    }
    ChatUi.interactionBusy = false
}

cancelInteractiveTemplate() {
    ChatUi.interactionJson = ""
    ChatUi.interactionDetailsOpen = false
    resetInteractionSelectionState()
}

confirmInvoiceRegistrationAction(ChatInteractionResponse interaction) {
    if (ChatUi.interactionBusy) {
        return
    }
    val chosen = collectSelectedIds(interaction.items())
    if (chosen.size == 0) {
        ChatUi.interactionError = "Selecione pelo menos um lançamento para registrar a fatura."
        return
    }
    var docId = ""
    val rawDocId = interaction.documentId()
    if (rawDocId != null) {
        docId = rawDocId.trim()
    }
    if (docId == "") {
        ChatUi.interactionError = "Não encontrei a referência deste documento. Envie a fatura novamente."
        return
    }
    var period = ""
    val rawPeriod = interaction.period()
    if (rawPeriod != null) {
        val pTrim = rawPeriod.trim()
        if (pTrim != "") {
            period = pTrim
        }
    }
    if (period == "" && ChatUi.manualPeriod.trim() != "") {
        period = ChatUi.manualPeriod.trim()
    }
    if (period == "") {
        ChatUi.interactionError = "Informe o mês e o ano da fatura (ex.: 2026-11) antes de confirmar."
        return
    }
    val totalCents = sumSelectedCents(interaction.items())
    ChatUi.interactionBusy = true
    ChatUi.interactionError = ""
    ChatUi.interactionInfo = ""
    try {
        val reqJson = json.encode(ConfirmImportDispatchRequest(
            "CONFIRMAR_IMPORTACAO",
            listOf(docId),
            ConfirmImportParamsRequest(joinComma(chosen), period)
        ))
        val body = apiPost("/api/intents/dispatch", reqJson)
        if (isApiError(body)) {
            ChatUi.interactionError = json.decode<ChatApiError>(body).error()
        } else {
            val res = json.decode<IntentDispatchApiResponse>(body)
            if (res.status() == "NEEDS_PERIOD") {
                ChatUi.interactionError = res.message()
            } else if (res.status() == "ERROR" || res.status() == "UNAUTHORIZED") {
                ChatUi.interactionError = res.message()
            } else {
                chatAppend("ASSISTANT", chatEncode(res.message()))
                var periodLabel = period
                val pl = interaction.periodLabel()
                if (pl != null) {
                    val plTrim = pl.trim()
                    if (plTrim != "") {
                        periodLabel = plTrim
                    }
                }
                val regSummary = ChatInteractionSummaryResponse(
                    periodLabel,
                    "R$ 0,00",
                    0,
                    listOf(),
                    brlFromCents(totalCents),
                    chosen.size,
                    listOf(ChatFlowLineItemResponse("Despesas registradas", brlFromCents(totalCents), chosen.size, "Salvas nas suas caixinhas sem duplicidade")),
                    "R$ 0,00",
                    0
                )
                val regInteraction = ChatInteractionResponse(
                    "INVOICE_REGISTERED",
                    "O que você quer acompanhar agora?",
                    docId,
                    period,
                    periodLabel,
                    "Fatura registrada nas suas caixinhas!",
                    "Com seus gastos confirmados no mês certo, suas caixinhas e o painel Gastos Calculados passam a refletir seu orçamento real.",
                    regSummary,
                    null,
                    listOf(),
                    listOf()
                )
                resetInteractionSelectionState()
                ChatUi.interactionDetailsOpen = false
                ChatUi.interactionJson = json.encode(regInteraction)
            }
        }
    } catch (String e) {
        ChatUi.interactionError = chatOfflineText()
    }
    ChatUi.interactionBusy = false
}

String itemCategory(String id) {
    val key = "|" + id + "="
    val at = ChatUi.itemCategories.indexOf(key)
    if (at < 0) {
        return ""
    }
    val start = at + key.length
    val end = ChatUi.itemCategories.indexOf("|", start)
    return ChatUi.itemCategories.substring(start, end)
}

setItemCategory(String id, String code) {
    val old = itemCategory(id)
    if (old != "") {
        ChatUi.itemCategories = ChatUi.itemCategories.replace("|" + id + "=" + old + "|", "")
    }
    ChatUi.itemCategories = ChatUi.itemCategories + "|" + id + "=" + code + "|"
    ChatUi.interactionError = ""
}

// Código de categoria escolhido na revisão: fixo ("FOOD") ou caixinha do
// usuário ("ENV:<id>").
String envelopeIdFromCode(String code) {
    if (code.startsWith("ENV:")) {
        return code.substring(4)
    }
    return ""
}

String categoryNamePt(String code) {
    val envId = envelopeIdFromCode(code)
    if (envId != "") {
        for (var e in envelopeItems()) {
            if (e.id() == envId) {
                return e.categoryName()
            }
        }
        return "Caixinha"
    }
    if (code == "FOOD") { return "Alimentação" }
    if (code == "GROCERIES") { return "Mercado" }
    if (code == "TRANSPORT") { return "Transporte" }
    if (code == "HOUSING") { return "Moradia" }
    if (code == "HEALTH") { return "Saúde" }
    if (code == "LEISURE") { return "Lazer" }
    if (code == "EDUCATION") { return "Educação" }
    if (code == "OTHER") { return "Outros" }
    return code
}

// Prévia: toda movimentação marcada precisa de categoria escolhida pelo usuário.
openReviewPreview(ChatInteractionResponse interaction) {
    val chosen = collectSelectedIds(interaction.items())
    if (chosen.size == 0) {
        ChatUi.interactionError = "Selecione pelo menos uma movimentação para revisar."
        return
    }
    for (var id in chosen) {
        if (itemCategory(id) == "") {
            ChatUi.interactionError = "Escolha a categoria de cada movimentação marcada antes de ver a prévia."
            return
        }
    }
    ChatUi.interactionError = ""
    ChatUi.reviewPreview = true
}

// Confirmação da revisão item a item: um POST por categoria (endpoint existente),
// só com os itens marcados. Falha preserva a prévia e mostra o erro no card.
confirmReviewPerItemAction(ChatInteractionResponse interaction) {
    if (ChatUi.interactionBusy) {
        return
    }
    val chosen = collectSelectedIds(interaction.items())
    var docId = ""
    val rawDocId = interaction.documentId()
    if (rawDocId != null) {
        docId = rawDocId.trim()
    }
    if (docId == "" || chosen.size == 0) {
        ChatUi.interactionError = "Não encontrei a referência deste documento."
        return
    }
    var codes: List<String> = listOf()
    for (var id in chosen) {
        val c = itemCategory(id)
        if (!codes.contains(c)) {
            codes.add(c)
        }
    }
    ChatUi.interactionBusy = true
    ChatUi.interactionError = ""
    try {
        for (var code in codes) {
            var ids: List<String> = listOf()
            for (var id in chosen) {
                if (itemCategory(id) == code) {
                    ids.add(id)
                }
            }
            val envId = envelopeIdFromCode(code)
            var payload = json.encode(ReclassifyTxRequest(ids, code))
            if (envId != "") {
                payload = json.encode(ReclassifyTxToEnvelopeRequest(ids, "OTHER", envId))
            }
            val body = apiPost("/api/documents/" + docId + "/reclassify", payload)
            if (isApiError(body)) {
                ChatUi.interactionError = json.decode<ChatApiError>(body).error()
                ChatUi.interactionBusy = false
                return
            }
        }
        ChatUi.interactionBusy = false
        ChatUi.reviewPreview = false
        sendChatMessage("Organizar caixinhas")
        return
    } catch (String e) {
        ChatUi.interactionError = chatOfflineText()
    }
    ChatUi.interactionBusy = false
}

// "+ Criar caixinha": cria pela API existente (POST /api/envelopes, sem limite)
// e aplica aos itens marcados que ainda não têm categoria.
createBoxFromReview(ChatInteractionResponse interaction) {
    val name = ChatUi.newBoxName.trim()
    if (name == "" || name.length > 40) {
        ChatUi.interactionError = msgEnvelopeName()
        return
    }
    ChatUi.interactionBusy = true
    try {
        createEnvelope(name, 0.0, "")
        loadEnvelopes()
        var newId = ""
        for (var e in envelopeItems()) {
            if (e.categoryName().toLowerCase() == name.toLowerCase()) {
                newId = e.id()
            }
        }
        if (newId != "") {
            for (var id in collectSelectedIds(interaction.items())) {
                if (itemCategory(id) == "") {
                    setItemCategory(id, "ENV:" + newId)
                }
            }
        }
        ChatUi.newBoxOpen = false
        ChatUi.newBoxName = ""
        ChatUi.interactionError = ""
    } catch (String e) {
        ChatUi.interactionError = e
    }
    ChatUi.interactionBusy = false
}

// ASSIGN_CAIXINHAS: começa com a caixinha sugerida de cada gasto.
// Só gastos atribuíveis (fatura mais recente, ainda não registrados).
Bool isAssignableItem(ChatSelectableItemResponse it) {
    val c = it.categoryCode()
    return !c.startsWith("SAVED:") && !c.startsWith("VIEW:")
}

seedSuggestedCategories(List<ChatSelectableItemResponse> items) {
    if (ChatUi.itemCategories != "") {
        return
    }
    for (var it in items) {
        if (isAssignableItem(it)) {
            setItemCategory(it.id(), it.categoryCode())
        }
    }
}

// Salva só as trocas feitas pelo usuário (endpoint de reclassificação existente)
// e registra todos os gastos nas caixinhas (CONFIRMAR_IMPORTACAO, idempotente).
assignAndRegisterAction(ChatInteractionResponse interaction) {
    if (ChatUi.interactionBusy) {
        return
    }
    var docId = ""
    val rawDocId = interaction.documentId()
    if (rawDocId != null) {
        docId = rawDocId.trim()
    }
    if (docId == "") {
        ChatUi.interactionError = "Não encontrei a referência deste documento."
        return
    }
    var codes: List<String> = listOf()
    for (var it in interaction.items()) {
        val c = itemCategory(it.id())
        if (isAssignableItem(it) && c != "" && c != it.categoryCode() && !codes.contains(c)) {
            codes.add(c)
        }
    }
    ChatUi.interactionBusy = true
    ChatUi.interactionError = ""
    try {
        for (var code in codes) {
            var ids: List<String> = listOf()
            for (var it in interaction.items()) {
                if (isAssignableItem(it) && itemCategory(it.id()) == code && code != it.categoryCode()) {
                    ids.add(it.id())
                }
            }
            val envId = envelopeIdFromCode(code)
            var payload = json.encode(ReclassifyTxRequest(ids, code))
            if (envId != "") {
                payload = json.encode(ReclassifyTxToEnvelopeRequest(ids, "OTHER", envId))
            }
            val body = apiPost("/api/documents/" + docId + "/reclassify", payload)
            if (isApiError(body)) {
                ChatUi.interactionError = json.decode<ChatApiError>(body).error()
                ChatUi.interactionBusy = false
                return
            }
        }
    } catch (String e) {
        ChatUi.interactionError = chatOfflineText()
        ChatUi.interactionBusy = false
        return
    }
    ChatUi.interactionBusy = false
    var buf = ""
    for (var it in interaction.items()) {
        if (isAssignableItem(it)) {
            buf = buf + "|" + it.id() + "|"
        }
    }
    ChatUi.selectedIds = buf
    confirmInvoiceRegistrationAction(interaction)
}

reclassifySelectedItemsAction(ChatInteractionResponse interaction) {
    if (ChatUi.interactionBusy) {
        return
    }
    val chosen = collectSelectedIds(interaction.items())
    if (chosen.size == 0) {
        ChatUi.interactionError = "Selecione pelo menos uma movimentação pendente para classificar."
        return
    }
    var docId = ""
    val rawDocId = interaction.documentId()
    if (rawDocId != null) {
        docId = rawDocId.trim()
    }
    if (docId == "") {
        ChatUi.interactionError = "Não encontrei a referência deste documento."
        return
    }
    ChatUi.interactionBusy = true
    ChatUi.interactionError = ""
    ChatUi.interactionInfo = ""
    try {
        val body = apiPost("/api/documents/" + docId + "/reclassify", json.encode(ReclassifyTxRequest(chosen, ChatUi.reviewCategory)))
        if (isApiError(body)) {
            ChatUi.interactionError = json.decode<ChatApiError>(body).error()
        } else {
            ChatUi.interactionBusy = false
            sendChatMessage("Organizar caixinhas")
            return
        }
    } catch (String e) {
        ChatUi.interactionError = chatOfflineText()
    }
    ChatUi.interactionBusy = false
}

applyViewCategoriesAction(ChatInteractionResponse interaction) {
    if (ChatUi.interactionBusy) {
        return
    }
    val chosen = collectSelectedIds(interaction.items())
    if (chosen.size == 0) {
        ChatUi.interactionError = "Selecione pelo menos uma categoria para visualizar."
        return
    }
    var period = "month"
    val rawPeriod = interaction.period()
    if (rawPeriod != null) {
        val pTrim = rawPeriod.trim()
        if (pTrim != "") {
            period = pTrim
        }
    }
    val totalSelected = brlFromCents(sumSelectedCents(interaction.items()))
    ChatUi.interactionBusy = true
    ChatUi.interactionError = ""
    ChatUi.interactionInfo = ""
    try {
        val reqJson = json.encode(QueryCategoriesDispatchRequest(
            "CONSULTAR_GASTOS",
            QueryCategoriesParamsRequest(period, joinComma(chosen))
        ))
        val body = apiPost("/api/intents/dispatch", reqJson)
        if (isApiError(body)) {
            ChatUi.interactionError = json.decode<ChatApiError>(body).error()
        } else {
            val res = json.decode<IntentDispatchApiResponse>(body)
            if (res.status() == "ERROR" || res.status() == "UNAUTHORIZED") {
                ChatUi.interactionError = res.message()
            } else {
                ChatUi.interactionInfo = res.message() + " Na prévia da fatura selecionada: " + totalSelected + " em " + String.valueOf(chosen.size) + " categoria(s)."
            }
        }
    } catch (String e) {
        ChatUi.interactionError = chatOfflineText()
    }
    ChatUi.interactionBusy = false
}

// Carrega contador + página 1 do histórico (uma vez por sessão/token).
loadChat() {
    ChatUi.loading = true
    ChatUi.error = ""
    ChatUi.draft = ""
    ChatUi.pending = ""
    ChatUi.pendingQueue = ""
    ChatUi.sending = false
    ChatUi.activeRequests = 0
    ChatUi.blocked = false
    ChatUi.usageKnown = false
    ChatUi.used = 0
    ChatUi.limit = 0
    ChatUi.voiceEnabled = false
    ChatUi.pro = false
    resetInteractionSelectionState()
    try {
        val tierBody = apiGet("/api/users/tier-status")
        if (isApiError(tierBody)) {
            ChatUi.error = chatHistoryErrorText()
            ChatUi.loading = false
            return
        }
        val tier = json.decode<ChatTierStatus>(tierBody)
        ChatUi.used = tier.messagesUsed()
        ChatUi.limit = tier.messagesLimit()
        ChatUi.voiceEnabled = tier.voiceEnabled()
        ChatUi.pro = tier.tier() == "PREMIUM"
        ChatUi.usageKnown = true
        ChatUi.blocked = !tier.canSendMessage()
        val body = apiGet("/api/chat/messages?page=1&limit=50")
        if (isApiError(body)) {
            ChatUi.error = chatHistoryErrorText()
        } else {
            val page = json.decode<ChatHistoryPage>(body)
            ChatState.messages = ""
            for (var item in page.items()) {
                chatAppend(item.role(), chatEncode(item.content()))
            }
            if (ChatState.messages != "" && ChatUi.interactionJson == "") {
                val latestBody = apiGet("/api/documents/latest")
                if (!isApiError(latestBody) && latestBody.contains("\"hasDocument\":true")) {
                    val latest = json.decode<LatestDocSyncResponse>(latestBody)
                    val latestStatus = latest.status()
                    val latestInteraction = latest.interaction()
                    if (latest.hasDocument() && latestStatus == "EM_REVISAO" && latestInteraction != null) {
                        ChatUi.interactionJson = json.encode(latestInteraction)
                    }
                }
            }
        }
    } catch (String e) {
        ChatUi.error = chatHistoryErrorText()
    }
    ChatUi.loading = false
}

// Envia uma mensagem. Sucesso: grava as duas bolhas e o contador. 402 (texto do
// limite): bloqueia o envio. Outro {"error"}: mostra a mensagem do backend.
// 503/rede: mensagem fixa. Nos erros o rascunho fica para tentar de novo.
sendChatMessage(String text) {
    ChatUi.error = ""
    try {
        val body = apiPost("/api/chat/message", json.encode(ChatMessageRequest(text)))
        if (isApiError(body)) {
            ChatUi.draft = text
            val message = json.decode<ChatApiError>(body).error()
            if (isChatLimitError(message)) {
                ChatUi.blocked = true
                if (ChatUi.limit <= 0) {
                    ChatUi.limit = 30
                }
                ChatUi.used = ChatUi.limit
                ChatUi.usageKnown = true
                ChatUi.error = chatLimitText()
            } else {
                ChatUi.error = message
            }
        } else {
            val r = json.decode<ChatReplyResponse>(body)
            chatAppend("USER", chatEncode(text))
            chatAppend("ASSISTANT", chatEncode(r.reply()))
            ChatUi.interactionJson = ""
            ChatUi.interactionDetailsOpen = false
            resetInteractionSelectionState()
            if (r.interaction() != null) {
                ChatUi.interactionJson = json.encode(r.interaction())
            }
            ChatUi.used = r.messagesUsed()
            ChatUi.limit = r.messagesLimit()
            ChatUi.usageKnown = true
            ChatUi.draft = ""
            if (ChatUi.limit >= 0 && ChatUi.used >= ChatUi.limit) {
                ChatUi.blocked = true
            }
        }
    } catch (String e) {
        ChatUi.draft = text
        ChatUi.error = chatOfflineText()
    }
    removePendingChatMessage(text)
}

// archive = true ("Novo chat"): a conversa atual vai para o histórico.
// archive = false (lixeira): apaga sem criar entrada no histórico.
clearChatHistory() {
    clearChatHistoryWith(true)
}

clearChatHistoryWith(Bool archive) {
    ChatUi.error = ""
    if (!archive) {
        // nada vai para o histórico; sessões já arquivadas continuam como estão
    } else if (ChatState.messages != "") {
        ChatUi.archivedSession = ChatState.messages
        if (ChatUi.totalChats < 2) {
            ChatUi.totalChats = 2
        }
        ChatUi.currentChatId = 2
    } else if (ChatUi.totalChats < 2) {
        ChatUi.totalChats = 2
        ChatUi.currentChatId = 2
    }
    try {
        val body = apiDelete("/api/chat/messages")
        if (isApiError(body)) {
            ChatUi.error = json.decode<ChatApiError>(body).error()
            return
        }
        ChatState.messages = ""
        ChatUi.interactionJson = ""
        ChatUi.interactionDetailsOpen = false
        resetInteractionSelectionState()
        ChatUi.draft = ""
        ChatUi.pending = ""
        ChatUi.pendingQueue = ""
        ChatUi.activeRequests = 0
        ChatUi.sending = false
    } catch (String e) {
        ChatUi.error = chatOfflineText()
    }
}

switchChatSession(Int targetId) {
    if (targetId == ChatUi.currentChatId) {
        return
    }
    var prevMsgs = ChatState.messages
    ChatState.messages = ChatUi.archivedSession
    ChatUi.archivedSession = prevMsgs
    ChatUi.currentChatId = targetId
    ChatUi.draft = ""
    ChatUi.error = ""
}
