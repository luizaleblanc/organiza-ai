package core

import core.http_client

// =============================================================================
// Service Locator — registry de inicialização
// =============================================================================
// Padrão necessário porque KOF não tem IoC/DI nativo.
// Inicializado uma vez em main.kf via ServiceLocator.init(...)
// =============================================================================

class ServiceLocator {
    static Boolean initialized = false

    static init(String bffBaseUrl) {
        ApiClient.setBaseUrl(bffBaseUrl)
        ServiceLocator.initialized = true
    }

    static Boolean isReady() {
        return ServiceLocator.initialized
    }
}
