package core

import kof.ui
import core.theme
import core.app_state
import core.auth_api
import core.envelopes_api
import components.brand_header
import components.nav_bar
import components.background_waves
import screens.welcome_screen
import screens.onb_salary_screen
import screens.onb_income_screen
import screens.onb_debt_screen
import screens.onb_debt_amount_screen
import screens.onb_chips_screen
import screens.onb_result_screen
import screens.login_screen
import screens.signup_screen
import screens.dashboard_screen
import screens.chat_screen
import screens.envelopes_screen
import screens.notifications_screen
import screens.settings_screen

// =============================================================================
// T5 — Dispatcher raiz e navegação (Dual Viewport)
// =============================================================================
// Navegação sem Router/Component: AppState.currentScreen + re-render explícito
// `mountScreen(window)` = remove() do root anterior +
// `window.bind(buildActiveScreen(window))`.
// Shell autenticado (Batch 3, T0): Desktop = Row(sidebar 190,
// Column(conteúdo da rota)); Mobile = Column(conteúdo, barra inferior de 5
// abas). Os dois ocupam a janela toda (position: fixed). O conteúdo de cada rota começa pela topbar
// (components/topbar.kf) e vem de <rota>Screen(w) em screens/.
//
// Vive fora de main.kf porque o ponto de entrada não é importável (PKG006) e
// brand_header/nav_bar precisam chamar navigateTo/buildActiveScreen (import
// cíclico entre módulos não-main é aceito pelo compilador).
// Rotas do shell: "dashboard", "chat", "envelopes", "notifications",
// "settings"; rota desconhecida fora das de entrada cai no Dashboard.
// Exceção: as telas de entrada (welcome, login, signup e onb_*) não têm nav bar
// nem sidebar (design.md do Batch 2, §2.2); usam o layout de entrada com
// Style("css") e só a barra de dev do toggle de viewport.
// =============================================================================

// Root montado atualmente. Window.bind ACRESCENTA ao DOM (não substitui), então o
// root anterior é removido antes de montar o novo. `View?` sem inicializador lê
// null antes da primeira escrita (contrato de campos anuláveis).
class NavState {
    static View? mounted
    // me() já disparado para preencher SessionState ao entrar no shell.
    static Bool profileRequested = false
}

// O kof.ui não expõe a largura da janela nem um evento de resize (rascunhos de
// issue upstream em work/a3-rebased), então o layout é escolhido à mão pelo controle
// "Ver como Mobile / Ver como Desktop". A janela não é mais fixada em
// 360x640/1280x800: o root usa position: fixed com os offsets da moldura do
// index.html do Kof (abaixo) e ocupa toda a área útil nas duas viewports.
applyViewport(Window w) {
}

// Moldura fixa do index.html do Kof ("Default / Kof output / terminated", no
// JsArtifactWriter): medida no Edge headless (0.6.6 e 0.7.2) com
// getBoundingClientRect do #kof-root. Style("css") recusa calc() (SEM078) e
// o kof.ui não dá a altura da janela, por isso os offsets são literais.
Style shellFrameDesktopCss()    = Style("position: fixed; top: 0; bottom: 0; left: 0; right: 0; z-index: 5; display: flex; flex-direction: row; flex-wrap: nowrap; align-items: stretch; overflow: hidden; background: #0A0D18; color: #F0F0F0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style shellFrameMobileCss()     = Style("position: fixed; top: 0; bottom: 0; left: 0; right: 0; z-index: 5; display: flex; flex-direction: column; flex-wrap: nowrap; overflow: hidden; background: #0A0D18; color: #F0F0F0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
// Só o conteúdo rola; a sidebar e a barra inferior ficam presas.
Style shellMainFixedCss()       = Style("display: flex; flex-direction: column; flex-grow: 1; align-self: stretch; min-width: 0; min-height: 0; gap: 24; padding: 24; box-sizing: border-box; overflow-y: auto; overflow-x: hidden")
Style shellMobileMainFixedCss() = Style("display: flex; flex-direction: column; flex-grow: 1; min-width: 0; min-height: 0; gap: 16; padding: 16; box-sizing: border-box; overflow-y: auto; overflow-x: hidden")
// Telas de entrada: tela cheia nas duas viewports, conteúdo na largura total.
Style entryFrameCss() {
    if (authLight()) {
        return Style("position: fixed; top: 0; bottom: 0; left: 0; right: 0; z-index: 5; display: flex; flex-direction: column; box-sizing: border-box; padding: 16; overflow-y: auto; overflow-x: hidden; background: #F8F9FC; color: #1A1D2E; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
    }
    return Style("position: fixed; top: 0; bottom: 0; left: 0; right: 0; z-index: 5; display: flex; flex-direction: column; box-sizing: border-box; padding: 16; overflow-y: auto; overflow-x: hidden; background: #0A0D18; color: #F0F0F0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
}

Style entryFrameFlushCss() {
    if (authLight()) {
        return Style("position: fixed; top: 0; bottom: 0; left: 0; right: 0; z-index: 5; display: flex; flex-direction: column; box-sizing: border-box; padding: 0; overflow-y: auto; overflow-x: hidden; background: #F8F9FC; color: #1A1D2E; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
    }
    return Style("position: fixed; top: 0; bottom: 0; left: 0; right: 0; z-index: 5; display: flex; flex-direction: column; box-sizing: border-box; padding: 0; overflow-y: auto; overflow-x: hidden; background: #0A0D18; color: #F0F0F0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
}

// Re-renderiza: remove o root anterior e monta o layout da viewport ativa.
mountScreen(Window w) {
    View? old = NavState.mounted
    if (old != null) {
        old.remove()
    }
    var fresh = buildActiveScreen(w)
    NavState.mounted = fresh
    w.bind(fresh)
}

// Troca a tela ativa e re-renderiza.
navigateTo(Window w, String screen) {
    AppState.loadError = ""
    AppState.loading = false
    if (screen == "envelopes" || screen == "welcome" || screen == "login") {
        resetEnvelopes()
    }
    AppState.currentScreen = screen
    mountScreen(w)
}

// Alterna entre o layout Mobile e o Desktop (o app abre em Desktop).
switchViewport(Window w) {
    AppState.isDesktop = !AppState.isDesktop
    applyViewport(w)
    mountScreen(w)
}

// Fallback das rotas de entrada sem tela própria ("onboarding").
View buildScreenContent() {
    var title = Label("Organiza AI")
    title.setStyle(titleCss())
    var card = View(screenStyle())
    card.setStyle(cardCss())
    card.bind(Column(listOf(title)))
    return card
}

// Telas de entrada (design.md §2.2): sem nav bar e sem sidebar, em Mobile e
// Desktop. Telas 2–7 ainda são placeholder até as tarefas F7/F8.
Bool isEntryScreen() {
    var s = AppState.currentScreen
    return s == "welcome" || s == "login" || s == "signup" || s == "onboarding"
        || s == "onb_salary" || s == "onb_income" || s == "onb_debt"
        || s == "onb_debt_amount" || s == "onb_chips" || s == "onb_result"
}

View buildEntryContent(Window w) {
    if (AppState.currentScreen == "welcome") {
        return welcomeScreen(w)
    }
    if (AppState.currentScreen == "onb_salary") {
        return onbSalaryScreen(w)
    }
    if (AppState.currentScreen == "onb_income") {
        return onbIncomeScreen(w)
    }
    if (AppState.currentScreen == "onb_debt") {
        return onbDebtScreen(w)
    }
    if (AppState.currentScreen == "onb_debt_amount") {
        return onbDebtAmountScreen(w)
    }
    if (AppState.currentScreen == "onb_chips") {
        return onbChipsScreen(w)
    }
    if (AppState.currentScreen == "onb_result") {
        return onbResultScreen(w)
    }
    if (AppState.currentScreen == "login") {
        return loginScreen(w)
    }
    if (AppState.currentScreen == "signup") {
        return signupScreen(w)
    }
    return buildScreenContent()
}

View buildEntryLayout(Window w) {
    var root = View(screenStyle())
    root.setId("shell")
    var flush = AppState.isDesktop && (AppState.currentScreen == "login" || AppState.currentScreen == "signup")
    if (flush) {
        root.setStyle(entryFrameFlushCss())
    } else {
        root.setStyle(entryFrameCss())
    }
    var toggleBar = Row(listOf(themeToggle(w), viewportIconButton(w)))
    toggleBar.setStyle(viewportBarFloatCss())
    var stack = Column(listOf(buildEntryContent(w), toggleBar))
    stack.setStyle(entryStackCss())
    // Ondas de fundo (components/background_waves.kf) só nas telas de entrada
    // em que os artefatos as mostram; o conteúdo fica por cima em z-index 1.
    if (screenHasWaves(AppState.currentScreen, AppState.isDesktop)) {
        var layered = Column(listOf(backgroundWaves(), overWaves(stack)))
        layered.setStyle(entryStackCss())
        root.bind(layered)
    } else {
        root.bind(stack)
    }
    return root
}

// Conteúdo da rota do shell.
View buildShellContent(Window w) {
    var s = AppState.currentScreen
    if (s == "chat") {
        return chatScreen(w)
    }
    if (s == "envelopes") {
        return envelopesScreen(w)
    }
    if (s == "notifications") {
        return notificationsScreen(w)
    }
    if (s == "settings") {
        return settingsScreen(w)
    }
    return dashboardScreen(w)
}

// Ao entrar no shell, me() preenche nome/e-mail da sessão (uma vez). Sessão
// inválida (401: apiErrorMessage já chamou resetSession) volta ao login.
loadProfile(Window w) {
    try {
        me()
        mountScreen(w)
    } catch (String e) {
        if (SessionState.token == "") {
            AppState.formError = e
            navigateTo(w, "login")
        }
    }
}

ensureProfile(Window w) {
    if (SessionState.token == "" || NavState.profileRequested) {
        return
    }
    if (SessionState.userEmail != "") {
        return
    }
    NavState.profileRequested = true
    spawn {
        loadProfile(w)
    }
}

View buildMobileLayout(Window w) {
    var main = Column(listOf(buildShellContent(w)))
    main.setId("shell-main")
    main.setStyle(shellMobileMainFixedCss())
    var controls = Row(listOf(themeToggle(w), viewportIconButton(w)))
    controls.setStyle(viewportBarFloatCss())
    var root = Column(listOf(main, buildNavBar(w), controls))
    root.setId("shell")
    root.setStyle(shellFrameMobileCss())
    return root
}

View buildDesktopLayout(Window w) {
    var main = Column(listOf(buildShellContent(w)))
    main.setId("shell-main")
    main.setStyle(shellMainFixedCss())
    var controls = Row(listOf(themeToggle(w), viewportIconButton(w)))
    controls.setStyle(viewportBarFloatCss())
    var root = Row(listOf(buildSidebar(w), main, controls))
    root.setId("shell")
    root.setStyle(shellFrameDesktopCss())
    return root
}

// Dispatcher raiz: escolhe o layout pela rota e pela viewport ativa.
View buildActiveScreen(Window w) {
    if (isEntryScreen()) {
        return buildEntryLayout(w)
    }
    ensureProfile(w)
    if (AppState.isDesktop) {
        return buildDesktopLayout(w)
    }
    return buildMobileLayout(w)
}
