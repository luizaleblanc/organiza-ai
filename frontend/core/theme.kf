Style secondaryButtonCss()    = themed(Style("outline: none; background: transparent; color: #2563EB; height: 48; width: 100%; border: 1.5px solid #2563EB; border-radius: 10; font-size: 1rem; font-weight: 600; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"), Style("outline: none; background: transparent; color: #00D4FF; height: 48; width: 100%; border: 1.5px solid #00D4FF; border-radius: 10; font-size: 1rem; font-weight: 600; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"))
Style disabledButtonCss()     = themed(Style("background: #FFFFFF; color: #6B7280; height: 48; width: 100%; border: 1px solid rgba(0,0,0,.06); border-radius: 10; font-size: 1rem; font-weight: 600; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"), Style("background: #12162A; color: #4A5578; height: 48; width: 100%; border: 1px solid rgba(255,255,255,.06); border-radius: 10; font-size: 1rem; font-weight: 600; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"))
// Desktop: botões lado a lado com 200px (artefato Desktop).
Style primaryButtonWideCss()  = themed(Style("outline: none; background: linear-gradient(90deg, #2563EB, #1D4ED8); color: #FFFFFF; height: 48; width: 200; border: none; border-radius: 10; font-size: 1rem; font-weight: 600; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"), Style("outline: none; background: linear-gradient(90deg, #00D4FF, #0066FF); color: #06121C; height: 48; width: 200; border: none; border-radius: 10; font-size: 1rem; font-weight: 600; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"))
Style secondaryButtonWideCss() = themed(Style("outline: none; background: transparent; color: #2563EB; height: 48; width: 200; border: 1.5px solid #2563EB; border-radius: 10; font-size: 1rem; font-weight: 600; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"), Style("outline: none; background: transparent; color: #00D4FF; height: 48; width: 200; border: 1.5px solid #00D4FF; border-radius: 10; font-size: 1rem; font-weight: 600; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"))

// ---- Formulário (Telas 2–7) -------------------------------------------------
