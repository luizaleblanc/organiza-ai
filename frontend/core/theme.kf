Style choiceCss()             = themed(Style("outline: none; color: #1A1D2E; height: 72; width: 100%; box-sizing: border-box; border-radius: 12; padding: 0 16px; background: #FFFFFF; border: 1px solid rgba(0,0,0,.06); font-size: 1rem; text-align: left; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"), Style("outline: none; color: #F0F0F0; height: 72; width: 100%; box-sizing: border-box; border-radius: 12; padding: 0 16px; background: #12162A; border: 1px solid rgba(255,255,255,.06); font-size: 1rem; text-align: left; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"))
Style choiceSelectedCss()     = themed(Style("outline: none; color: #1A1D2E; height: 72; width: 100%; box-sizing: border-box; border-radius: 12; padding: 0 16px; background: rgba(37,99,235,.08); border: 1px solid #2563EB; font-size: 1rem; text-align: left; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"), Style("outline: none; color: #F0F0F0; height: 72; width: 100%; box-sizing: border-box; border-radius: 12; padding: 0 16px; background: rgba(0,212,255,.08); border: 1px solid #00D4FF; font-size: 1rem; text-align: left; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"))
Style titleCss()              = themed(Style("color: #1A1D2E; font-size: 1.5rem; font-weight: 500; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"), Style("color: #F0F0F0; font-size: 1.5rem; font-weight: 500; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"))
Style captionCss() {
    if (isLight()) {
        return Style("color: #6B7280; font-size: 0.9375rem; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
    }
    return Style("color: #7B8EAD; font-size: 0.9375rem; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
}
Style errorBannerCss() {
    if (isLight()) {
        return Style("color: #E63946; background: rgba(230,57,70,.08); border: 1px solid #E63946; border-radius: 8; padding: 12; font-size: 0.875rem; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
    }
    return Style("color: #FF4A6E; background: rgba(255,74,110,.12); border: 1px solid #FF4A6E; border-radius: 8; padding: 12; font-size: 0.875rem; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
}
Style dotsCss()               = Style("display: flex; flex-direction: row; gap: 12; justify-content: center")
Style dotActiveCss()          = themed(Style("width: 8; height: 8; border-radius: 4; background: #2563EB"), Style("width: 8; height: 8; border-radius: 4; background: #00D4FF"))
Style dotVisitedCss()         = themed(Style("width: 8; height: 8; border-radius: 4; background: rgba(37,99,235,.4)"), Style("width: 8; height: 8; border-radius: 4; background: rgba(0,212,255,.4)"))
Style dotInactiveCss()        = themed(Style("width: 8; height: 8; border-radius: 4; background: rgba(0,0,0,.15)"), Style("width: 8; height: 8; border-radius: 4; background: rgba(255,255,255,.15)"))
// Telas 4 e 5 (F8a): coluna do onboarding, linha "R$ + valor" e lista de cards.
Style onbColumnCss()          = Style("display: flex; flex-direction: column; align-items: stretch; gap: 24; width: 100%; max-width: 480")
Style moneyRowCss()           = Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: center; gap: 8; width: 100%")
Style moneyPrefixCss()        = themed(Style("color: #2563EB; font-size: 2rem; font-weight: 600; margin: 0; white-space: nowrap; flex-shrink: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"), Style("color: #00D4FF; font-size: 2rem; font-weight: 600; margin: 0; white-space: nowrap; flex-shrink: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"))
Style choiceListCss()         = Style("display: flex; flex-direction: column; gap: 12; width: 100%")
// Barra de bucket: preenchimento + resto com flex-basis proporcionais (ver bucketBar).
Style trackCss()              = themed(Style("display: flex; height: 8; width: 100%; border-radius: 4; background: #E5E7EB; overflow: hidden"), Style("display: flex; height: 8; width: 100%; border-radius: 4; background: #12162A; overflow: hidden"))
Style fillCss()               = themed(Style("height: 8; border-radius: 4; background: #2563EB; min-width: 0"), Style("height: 8; border-radius: 4; background: #00D4FF; min-width: 0"))
Style fillRowCss()            = Style("display: flex; flex-direction: row; flex-wrap: nowrap; width: 100%; height: 8; gap: 0")
Style fillRestCss()           = Style("height: 8; background: transparent; padding: 0; min-width: 0")

// =============================================================================
// Batch 3 (F0) — Styles do shell autenticado (spec b3, telas 9 a 13)
// =============================================================================
// Style("css") só aceita literal (o compilador valida o texto: SEM076/077/078),
// então os hex do DS se repetem aqui em vez de virem de constantes.
// Shell: sidebar Desktop 190 + topbar + conteúdo.
Style shellRowCss()        = themed(Style("display: flex; flex-direction: row; flex-wrap: nowrap; width: 100%; min-height: 800; background: #F8F9FC; color: #1A1D2E; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"), Style("display: flex; flex-direction: row; flex-wrap: nowrap; width: 100%; min-height: 800; background: #0A0D18; color: #F0F0F0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"))
Style shellMainCss()       = Style("display: flex; flex-direction: column; flex-grow: 1; min-width: 0; gap: 24; padding: 24; box-sizing: border-box")
Style sidebarCss()         = themed(Style("display: flex; flex-direction: column; align-self: stretch; width: 256; flex-shrink: 0; gap: 8; padding: 28px 16px; box-sizing: border-box; background: #F8F9FC; border-right: 1px solid #E5E7EB"), Style("display: flex; flex-direction: column; align-self: stretch; width: 256; flex-shrink: 0; gap: 8; padding: 28px 16px; box-sizing: border-box; background: #05060B; border-right: 1px solid rgba(255,255,255,.1)"))
Style sidebarItemCss()     = themed(Style("outline: none; display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: 12; width: 100%; height: 48; padding: 0 14px; border: none; border-radius: 10; background: transparent; color: #6B7280; font-size: 0.9375rem; font-weight: 600; white-space: nowrap; text-align: left; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"), Style("outline: none; display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: 12; width: 100%; height: 48; padding: 0 14px; border: none; border-radius: 10; background: transparent; color: #7B8EAD; font-size: 0.9375rem; font-weight: 600; white-space: nowrap; text-align: left; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"))
Style sidebarItemActiveCss() = themed(Style("outline: none; display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: 12; width: 100%; height: 48; padding: 0 14px; border: none; border-radius: 10; background: rgba(37,99,235,.08); color: #2563EB; font-size: 0.9375rem; font-weight: 700; white-space: nowrap; text-align: left; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"), Style("outline: none; display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: 12; width: 100%; height: 48; padding: 0 14px; border: none; border-radius: 10; background: rgba(0,212,255,.08); color: #00D4FF; font-size: 0.9375rem; font-weight: 700; white-space: nowrap; text-align: left; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"))
Style topbarCss() {
    if (AppState.isDesktop) {
        if (AppState.currentScreen == "dashboard" || AppState.currentScreen == "envelopes") {
            return themed(Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 16; width: 100%; height: 72; min-height: 72; flex-shrink: 0; box-sizing: border-box; border-bottom: 1px solid #E5E7EB"), Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 16; width: 100%; height: 72; min-height: 72; flex-shrink: 0; box-sizing: border-box; border-bottom: 1px solid rgba(255,255,255,.1)"))
        }
        return themed(Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 16; width: 100%; height: 72; min-height: 72; flex-shrink: 0; box-sizing: border-box; padding-right: 48; border-bottom: 1px solid #E5E7EB"), Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 16; width: 100%; height: 72; min-height: 72; flex-shrink: 0; box-sizing: border-box; padding-right: 48; border-bottom: 1px solid rgba(255,255,255,.1)"))
    }
    if (AppState.currentScreen == "dashboard") { return themed(Style("display: flex; flex-direction: column; flex-wrap: wrap; align-items: stretch; justify-content: flex-start; gap: 10; width: 100%; height: auto; min-height: 0; flex-shrink: 0; box-sizing: border-box; padding: 0 44px 12px 0; border-bottom: 1px solid #E5E7EB"), Style("display: flex; flex-direction: column; flex-wrap: wrap; align-items: stretch; justify-content: flex-start; gap: 10; width: 100%; height: auto; min-height: 0; flex-shrink: 0; box-sizing: border-box; padding: 0 44px 12px 0; border-bottom: 1px solid rgba(255,255,255,.1)")) }
    return themed(Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 16; width: 100%; height: 72; min-height: 72; flex-shrink: 0; box-sizing: border-box; padding-right: 44; border-bottom: 1px solid #E5E7EB"), Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 16; width: 100%; height: 72; min-height: 72; flex-shrink: 0; box-sizing: border-box; padding-right: 44; border-bottom: 1px solid rgba(255,255,255,.1)"))
}
