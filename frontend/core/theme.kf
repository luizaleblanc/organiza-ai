package core

import kof.ui
import core.app_state

// =============================================================================
// T1 — Tokens do Design System (artefato JVjueTmHeJsnHLsow3LDVb / docs/DESIGN_SYSTEM.md)
// =============================================================================
// Todas as cores são FUNÇÕES top-level. Campos "static Color x = Color(...)"
// são emitidos como "static x;" (sem valor) no KofJS (Default.mjs) e a cor
// chega "undefined" no runtime — por isso nenhum token vive em campo estático.
// Tamanhos (Int) também são funções, para manter um único idioma.
// =============================================================================

// ---- Base (dark) -----------------------------------------------------------
Color colorBgPrimary()     = Color(10, 13, 24)     // #0A0D18
Color colorCard()          = Color(18, 22, 42)     // #12162A
Color colorCardSecondary() = Color(26, 31, 58)     // #1A1F3A

// ---- Accent ----------------------------------------------------------------
Color colorAccent()        = Color(0, 212, 255)    // #00D4FF (cyan)
Color colorAccent2()       = Color(0, 102, 255)    // #0066FF (blue)
Color colorAccentContrast() = Color(6, 18, 28)     // #06121C (texto sobre cyan)

// ---- Texto -----------------------------------------------------------------
Color colorTextPrimary()   = Color(240, 240, 240)  // #F0F0F0
Color colorTextSecondary() = Color(123, 142, 173)  // #7B8EAD
Color colorTextMuted()     = Color(74, 85, 120)    // #4A5578

// ---- Estado ----------------------------------------------------------------
Color colorSuccess()       = Color(0, 229, 160)    // #00E5A0
Color colorWarning()       = Color(255, 184, 0)    // #FFB800
Color colorDanger()        = Color(255, 74, 110)   // #FF4A6E

// ---- Categorias (ícones das Caixinhas) -------------------------------------
// Só cores da paleta (docs/DESIGN_SYSTEM.md §2: nenhum hex fora da lista).
Color colorCatMoradia()    = colorAccent()
Color colorCatMercado()    = colorWarning()
Color colorCatTransporte() = colorTextSecondary()
Color colorCatDelivery()   = colorChartDes()
Color colorCatLazer()      = colorDanger()
Color colorCatReserva()    = colorSuccess()

// ---- Ondas do cabeçalho antigo (brand_header): tons da paleta -------------
Color colorWave2()         = colorAccent2()
Color colorWave3()         = colorTextSecondary()

// ---- Tokens do DS (canvas, chart-des, border-soft) ---------------------------
Color colorCanvas()        = Color(5, 6, 11)       // #05060B
Color colorChartDes()      = Color(0, 102, 255)    // #0066FF (fatia Desejos)
// border-soft = rgba(255,255,255,.1). Color não carrega alfa de forma confiável
// no KofJS, então a versão Color é a mesma borda já composta sobre colorCard;
// dentro de Style("css") use sempre o literal rgba(255,255,255,.1).
Color borderSoft()         = Color(42, 45, 63)     // rgba(255,255,255,.1) sobre #12162A

// ---- Tipografia (system-ui, px; escala em docs/DESIGN_SYSTEM.md §3) ---------------------------------
Int sizeTitle()    = 24
Int sizeSubtitle() = 18
Int sizeBody()     = 16
Int sizeCaption()  = 14
Int sizeMoney()    = 28

// ---- Viewports canônicos ---------------------------------------------------
Int mobileWidth()   = 360
Int mobileHeight()  = 640
Int desktopWidth()  = 1280
Int desktopHeight() = 800

// =============================================================================
// Styles — Style(background, foreground, padding, radius)
// =============================================================================

Style screenStyle()        = Style(colorBgPrimary(), colorTextPrimary(), 16, 0)
Style cardStyle()          = Style(colorCard(), colorTextPrimary(), 16, 12)
Style cardSecondaryStyle() = Style(colorCardSecondary(), colorTextPrimary(), 12, 10)
Style inputStyle()         = Style(colorCard(), colorTextPrimary(), 12, 8)
Style navBarStyle()        = Style(colorCard(), colorTextSecondary(), 8, 0)
Style sidebarStyle()       = Style(colorCard(), colorTextSecondary(), 16, 0)
Style buttonStyle()        = Style(colorAccent(), colorAccentContrast(), 12, 10)
Style dangerStyle()        = Style(colorDanger(), colorTextPrimary(), 12, 8)

// =============================================================================
// Styles CSS — Style("<css>") (Batch 2, design.md §3)
// =============================================================================
// O compilador valida o texto (SEM076/077/078) e o argumento precisa ser
// literal, por isso cada estilo é uma função. Int sem unidade = px.
// Todo texto define `color`: sem cor, o Label herda o verde do index.html.
// Tokens: #0A0D18 bg · #12162A card · #00D4FF/#0066FF accent ·
// #06121C texto sobre accent · #F0F0F0/#7B8EAD/#4A5578 texto · #FF4A6E danger.
// =============================================================================

// ---- Layout das telas de entrada (§2.2) -------------------------------------
// O View raiz recebe o fundo; a Column filha é que organiza o conteúdo (o
// layout flex vale para os filhos diretos). A altura vem do viewport canônico
// (640 / 800): `min-height: 100%` não tem referência no root do runtime.
Style entryScreenMobileCss()  = Style("background: #0A0D18; position: relative; overflow: hidden; color: #F0F0F0; min-height: 640; box-sizing: border-box; padding: 16; display: flex; flex-direction: column; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style entryScreenDesktopCss() = Style("background: #0A0D18; position: relative; overflow: hidden; color: #F0F0F0; min-height: 800; box-sizing: border-box; padding: 16; display: flex; flex-direction: column; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style entryStackCss()         = Style("display: flex; flex-direction: column; flex-grow: 1; gap: 0; width: 100%")
// Corpo da tela: ocupa o resto da altura e centraliza na vertical.
Style entryBodyCss()          = Style("display: flex; flex-direction: column; justify-content: center; align-items: center; flex-grow: 1; width: 100%; padding: 0; background: transparent")
// Coluna de conteúdo: largura total no Mobile, até 480px no Desktop (§2.2).
Style entryColumnMobileCss()  = Style("display: flex; flex-direction: column; align-items: stretch; gap: 32; width: 100%")
Style entryColumnDesktopCss() = Style("display: flex; flex-direction: column; align-items: center; gap: 32; width: 100%; max-width: 480")
// Barra de dev (toggle de viewport) no topo das telas de entrada.
Style devBarCss()             = Style("display: flex; flex-direction: row; justify-content: flex-end; width: 100%; padding: 0; background: transparent")
Style devToggleCss()          = Style("background: transparent; color: #4A5578; border: 1px solid rgba(255,255,255,.06); border-radius: 8; padding: 4px 8px; font-size: 0.75rem; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")

// ---- Tela 1 ----------------------------------------------------------------
// Login e Cadastro têm modo claro (fundos do design system); o resto do app segue escuro.
Bool authLight() = AppState.lightAuth && (AppState.currentScreen == "login" || AppState.currentScreen == "signup")

Style markCss()               = Style("align-self: center; padding: 0; background: transparent; line-height: 0em")
// Slogan: captionCss em caixa alta, 600, letter-spacing .08em, max-width 240 (§5).
Style sloganMobileCss()       = Style("color: #7B8EAD; font-size: 0.875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; text-align: center; max-width: 240; align-self: center; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
// Desktop (artefato 64FYjX5UiveVxTtRGYurQP, WelcomeWin): 16px, max-width 320.
Style sloganDesktopCss()      = Style("color: #7B8EAD; font-size: 1rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; text-align: center; max-width: 320; align-self: center; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style actionsMobileCss()      = Style("display: flex; flex-direction: column; align-items: stretch; gap: 12; width: 100%")
Style actionsDesktopCss()     = Style("display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 16")

// ---- Botões (spec B2-01 AC4) -----------------------------------------------
Style primaryButtonCss()      = Style("outline: none; background: linear-gradient(90deg, #00D4FF, #0066FF); color: #06121C; height: 48; width: 100%; border: none; border-radius: 10; font-size: 1rem; font-weight: 600; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style secondaryButtonCss()    = Style("outline: none; background: transparent; color: #00D4FF; height: 48; width: 100%; border: 1.5px solid #00D4FF; border-radius: 10; font-size: 1rem; font-weight: 600; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style disabledButtonCss()     = Style("background: #12162A; color: #4A5578; height: 48; width: 100%; border: 1px solid rgba(255,255,255,.06); border-radius: 10; font-size: 1rem; font-weight: 600; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
// Desktop: botões lado a lado com 200px (artefato Desktop).
Style primaryButtonWideCss()  = Style("outline: none; background: linear-gradient(90deg, #00D4FF, #0066FF); color: #06121C; height: 48; width: 200; border: none; border-radius: 10; font-size: 1rem; font-weight: 600; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style secondaryButtonWideCss() = Style("outline: none; background: transparent; color: #00D4FF; height: 48; width: 200; border: 1.5px solid #00D4FF; border-radius: 10; font-size: 1rem; font-weight: 600; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")

// ---- Formulário (Telas 2–7) -------------------------------------------------
Style inputCss()              = Style("outline: none; background: #12162A; color: #F0F0F0; height: 48; width: 100%; box-sizing: border-box; border: 1px solid rgba(255,255,255,.06); border-radius: 8; padding: 0 16px; font-size: 1rem; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style moneyCss()              = Style("background: transparent; color: #00D4FF; height: 56; width: 100%; min-width: 0; flex-grow: 1; box-sizing: border-box; border: none; text-align: center; font-size: 2rem; font-weight: 600; font-variant: tabular-nums; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style choiceCss()             = Style("outline: none; color: #F0F0F0; height: 72; width: 100%; box-sizing: border-box; border-radius: 12; padding: 0 16px; background: #12162A; border: 1px solid rgba(255,255,255,.06); font-size: 1rem; text-align: left; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style choiceSelectedCss()     = Style("outline: none; color: #F0F0F0; height: 72; width: 100%; box-sizing: border-box; border-radius: 12; padding: 0 16px; background: rgba(0,212,255,.08); border: 1px solid #00D4FF; font-size: 1rem; text-align: left; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style titleCss()              = Style("color: #F0F0F0; font-size: 1.5rem; font-weight: 500; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style captionCss() {
    if (authLight()) {
        return Style("color: #6B7280; font-size: 0.9375rem; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
    }
    return Style("color: #7B8EAD; font-size: 0.9375rem; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
}
Style errorBannerCss() {
    if (authLight()) {
        return Style("color: #E63946; background: rgba(230,57,70,.08); border: 1px solid #E63946; border-radius: 8; padding: 12; font-size: 0.875rem; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
    }
    return Style("color: #FF4A6E; background: rgba(255,74,110,.12); border: 1px solid #FF4A6E; border-radius: 8; padding: 12; font-size: 0.875rem; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
}
Style dotsCss()               = Style("display: flex; flex-direction: row; gap: 12; justify-content: center")
Style dotActiveCss()          = Style("width: 8; height: 8; border-radius: 4; background: #00D4FF")
Style dotVisitedCss()         = Style("width: 8; height: 8; border-radius: 4; background: rgba(0,212,255,.4)")
Style dotInactiveCss()        = Style("width: 8; height: 8; border-radius: 4; background: rgba(255,255,255,.15)")
// Telas 4 e 5 (F8a): coluna do onboarding, linha "R$ + valor" e lista de cards.
Style onbColumnCss()          = Style("display: flex; flex-direction: column; align-items: stretch; gap: 24; width: 100%; max-width: 480")
Style moneyRowCss()           = Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: center; gap: 8; width: 100%")
Style moneyPrefixCss()        = Style("color: #00D4FF; font-size: 2rem; font-weight: 600; margin: 0; white-space: nowrap; flex-shrink: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style choiceListCss()         = Style("display: flex; flex-direction: column; gap: 12; width: 100%")
// Barra de bucket: preenchimento + resto com flex-basis proporcionais (ver bucketBar).
Style trackCss()              = Style("display: flex; height: 8; width: 100%; border-radius: 4; background: #12162A; overflow: hidden")
Style fillCss()               = Style("height: 8; border-radius: 4; background: #00D4FF; min-width: 0")
Style fillRowCss()            = Style("display: flex; flex-direction: row; flex-wrap: nowrap; width: 100%; height: 8; gap: 0")
Style fillRestCss()           = Style("height: 8; background: transparent; padding: 0; min-width: 0")

// =============================================================================
// Batch 3 (F0) — Styles do shell autenticado (spec b3, telas 9 a 13)
// =============================================================================
// Style("css") só aceita literal (o compilador valida o texto: SEM076/077/078),
// então os hex do DS se repetem aqui em vez de virem de constantes.
// Shell: sidebar Desktop 190 + topbar + conteúdo.
Style shellRowCss()        = Style("display: flex; flex-direction: row; flex-wrap: nowrap; width: 100%; min-height: 800; background: #0A0D18; color: #F0F0F0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style shellMainCss()       = Style("display: flex; flex-direction: column; flex-grow: 1; min-width: 0; gap: 24; padding: 24; box-sizing: border-box")
Style sidebarCss()         = Style("display: flex; flex-direction: column; align-self: stretch; width: 224; flex-shrink: 0; gap: 8; padding: 28px 16px; box-sizing: border-box; background: #05060B; border-right: 1px solid rgba(255,255,255,.1)")
Style sidebarItemCss()     = Style("outline: none; display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: 14; width: 100%; height: 54; padding: 0 18px; border: none; border-radius: 10; background: transparent; color: #AAB9D3; font-size: 1.125rem; font-weight: 600; text-align: left; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style sidebarItemActiveCss() = Style("outline: none; display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: 14; width: 100%; height: 54; padding: 0 18px; border: none; border-radius: 10; background: rgba(0,212,255,.08); color: #00D4FF; font-size: 1.125rem; font-weight: 700; text-align: left; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style topbarCss() {
    if (AppState.isDesktop) {
        return Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 16; width: 100%; height: 72; min-height: 72; flex-shrink: 0; box-sizing: border-box; padding-right: 200; border-bottom: 1px solid rgba(255,255,255,.1)")
    }
    return Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 16; width: 100%; height: 72; min-height: 72; flex-shrink: 0; box-sizing: border-box; border-bottom: 1px solid rgba(255,255,255,.1)")
}
Style topbarTitleCss()     = Style("color: #F0F0F0; font-size: 1.5rem; font-weight: 700; line-height: 1.1em; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style topbarSubtitleCss()  = Style("color: #AAB9D3; font-size: 0.9375rem; font-weight: 500; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
// Cards e grades.
Style cardCss()            = Style("display: flex; flex-direction: column; gap: 12; padding: 20; box-sizing: border-box; background: #12162A; border: 1px solid rgba(255,255,255,.1); border-radius: 12; min-width: 0")
Style pulseCardCss()       = Style("display: flex; flex-direction: column; gap: 8; padding: 20; box-sizing: border-box; background: linear-gradient(135deg, #00D4FF, #0066FF); color: #06121C; border: none; border-radius: 12; min-width: 0")
Style gridG2Css()          = Style("display: grid; grid-template-columns: 1fr 1fr; gap: 16; width: 100%")
Style gridG3Css()          = Style("display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16; width: 100%")
Style stackCss()           = Style("display: flex; flex-direction: column; gap: 16; width: 100%")
// Tabs (Semana/Mês/Ano).
Style tabsCss()            = Style("display: flex; flex-direction: row; gap: 4; padding: 4; background: #12162A; border-radius: 8")
Style tabCss()             = Style("outline: none; background: transparent; color: #7B8EAD; border: none; border-radius: 6; padding: 6px 14px; font-size: 0.875rem; font-weight: 500; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style tabActiveCss()       = Style("outline: none; background: #1A1F3A; color: #00D4FF; border: none; border-radius: 6; padding: 6px 14px; font-size: 0.875rem; font-weight: 600; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
// Badges por tom.
Style badgeSuccessCss()    = Style("color: #00E5A0; background: rgba(0,229,160,.12); border-radius: 999; padding: 2px 10px; font-size: 0.75rem; font-weight: 600; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style badgeWarningCss()    = Style("color: #FFB800; background: rgba(255,184,0,.12); border-radius: 999; padding: 2px 10px; font-size: 0.75rem; font-weight: 600; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style badgeDangerCss()     = Style("color: #FF4A6E; background: rgba(255,74,110,.12); border-radius: 999; padding: 2px 10px; font-size: 0.75rem; font-weight: 600; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style badgeAccentCss()     = Style("color: #00D4FF; background: rgba(0,212,255,.12); border-radius: 999; padding: 2px 10px; font-size: 0.75rem; font-weight: 600; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
// Trilho de 56 px do card de notificação, por tom.
Style railSuccessCss()     = Style("display: flex; align-items: center; justify-content: center; width: 56; flex-shrink: 0; background: rgba(0,229,160,.12); border-radius: 12")
Style railWarningCss()     = Style("display: flex; align-items: center; justify-content: center; width: 56; flex-shrink: 0; background: rgba(255,184,0,.12); border-radius: 12")
Style railDangerCss()      = Style("display: flex; align-items: center; justify-content: center; width: 56; flex-shrink: 0; background: rgba(255,74,110,.12); border-radius: 12")
Style railAccentCss()      = Style("display: flex; align-items: center; justify-content: center; width: 56; flex-shrink: 0; background: rgba(0,212,255,.12); border-radius: 12")
// Toggle, select e modal (Configurações).
Style toggleOnCss()        = Style("outline: none; width: 44; height: 24; border-radius: 12; border: none; background: #00D4FF; cursor: pointer")
Style toggleOffCss()       = Style("outline: none; width: 44; height: 24; border-radius: 12; border: 1px solid rgba(255,255,255,.1); background: #1A1F3A; cursor: pointer")
Style selectCss()          = Style("outline: none; background: #12162A; color: #F0F0F0; height: 40; box-sizing: border-box; border: 1px solid rgba(255,255,255,.1); border-radius: 8; padding: 0 12px; font-size: 0.875rem; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style modalOverlayCss()    = Style("position: fixed; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: rgba(5,6,11,.8)")
// Bolhas do chat.
Style bubbleAiCss()        = Style("align-self: flex-start; max-width: 80%; background: #12162A; color: #F0F0F0; border: 1px solid rgba(255,255,255,.1); border-radius: 12; padding: 12px 16px; font-size: 0.875rem; white-space: pre-wrap; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style bubbleUserCss()      = Style("align-self: flex-end; max-width: 80%; background: linear-gradient(90deg, #00D4FF, #0066FF); color: #06121C; border-radius: 12; padding: 12px 16px; font-size: 0.875rem; white-space: pre-wrap; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
// Barra de progresso (track + fill por cor; o fill usa a mesma técnica de bucketBar).
Style progressTrackCss()   = Style("display: flex; height: 8; width: 100%; border-radius: 4; background: #1A1F3A; overflow: hidden")
Style progressFillSuccessCss() = Style("height: 8; border-radius: 4; background: #00E5A0; min-width: 0")
Style progressFillWarningCss() = Style("height: 8; border-radius: 4; background: #FFB800; min-width: 0")
Style progressFillDangerCss()  = Style("height: 8; border-radius: 4; background: #FF4A6E; min-width: 0")
Style progressFillAccentCss()  = Style("height: 8; border-radius: 4; background: #00D4FF; min-width: 0")
Style progressFillDesCss()     = Style("height: 8; border-radius: 4; background: #0066FF; min-width: 0")

// ---- Batch 3 (T0) — itens do shell (sidebar, barra inferior, usuário) ------
// Item da nav = View(sidebarItemCss) + Row(ícone Canvas, Button): o View não
// tem onClick, então o rótulo é um Button transparente que herda o tom do item.
Style navLabelCss()        = Style("outline: none; flex-grow: 1; background: transparent; color: #AAB9D3; border: none; padding: 0; font-size: 1.125rem; font-weight: 600; text-align: left; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style navLabelActiveCss()  = Style("outline: none; flex-grow: 1; background: transparent; color: #00D4FF; border: none; padding: 0; font-size: 1.125rem; font-weight: 700; text-align: left; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style navIconCss()         = Style("display: flex; align-items: center; padding: 0; background: transparent; line-height: 0em; flex-shrink: 0")
Style sidebarLogoCss()     = Style("display: flex; justify-content: center; align-items: center; width: 100%; padding: 8px 0 22px; background: transparent; line-height: 0em")
Style sidebarNavCss()      = Style("display: flex; flex-direction: column; align-items: center; gap: 6; flex-grow: 1; width: 100%")
Style sidebarFooterCss()   = Style("display: flex; flex-direction: column; align-items: center; gap: 14; width: 100%; padding-top: 16; border-top: 1px solid rgba(255,255,255,.06)")
Style userBlockCss()       = Style("display: flex; flex-direction: column; align-items: center; gap: 8; padding: 0 10px; min-width: 0; text-align: center")
Style avatarCss()          = Style("display: flex; align-items: center; justify-content: center; width: 42; height: 42; flex-shrink: 0; border-radius: 21; background: linear-gradient(135deg, #00D4FF, #0066FF); color: #06121C; font-size: 1rem; font-weight: 700; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style userTextCss()        = Style("display: flex; flex-direction: column; align-items: center; gap: 2; min-width: 0; width: 100%; text-align: center")
Style userNameCss()        = Style("color: #F0F0F0; font-size: 1rem; font-weight: 700; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style userEmailCss()       = Style("color: #AAB9D3; font-size: 0.8125rem; font-weight: 500; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 180; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
// Mobile 360 (artefato Mobile, BottomTab): 5 abas, ativa em #F0F0F0, demais #4A5578.
Style shellMobileCss()     = Style("display: flex; flex-direction: column; width: 100%; min-height: 640; background: #0A0D18; color: #F0F0F0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style shellMobileMainCss() = Style("display: flex; flex-direction: column; flex-grow: 1; gap: 16; padding: 16; box-sizing: border-box; min-width: 0")
Style bottomTabCss()       = Style("display: flex; flex-direction: row; justify-content: space-around; align-items: flex-start; width: 100%; height: 74; padding-top: 10; box-sizing: border-box; background: #12162A; border-top: 1px solid rgba(255,255,255,.06)")
Style bottomTabItemCss()   = Style("display: flex; flex-direction: column; align-items: center; gap: 4; padding: 0; background: transparent")
Style bottomTabLabelCss()  = Style("outline: none; background: transparent; color: #4A5578; border: none; padding: 0; font-size: 0.625rem; font-weight: 600; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style bottomTabLabelActiveCss() = Style("outline: none; background: transparent; color: #F0F0F0; border: none; padding: 0; font-size: 0.625rem; font-weight: 600; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style topbarTextCss()      = Style("display: flex; flex-direction: column; gap: 2; min-width: 0")

// =============================================================================
// A1 — fundações fiéis aos artefatos (docs/DESIGN_SYSTEM.md)
// =============================================================================
// Topbar: subtítulo com ponto verde de 6 px quando "Assistente online".
Style topbarSubRowCss()    = Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; gap: 5; margin-top: 1")
Style onlineDotCss()       = Style("width: 6; height: 6; min-width: 6; border-radius: 3; background: #00E5A0; flex-shrink: 0")
Style topbarActionCss()    = Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: flex-end; gap: 8; margin-left: auto; flex-shrink: 0; background: transparent; padding: 0")
// Ícones (components/icons.kf): holder sem altura de linha extra.
Style iconHolderCss()      = Style("display: flex; align-items: center; justify-content: center; padding: 0; background: transparent; line-height: 0em; flex-shrink: 0")
// Marca (components/brand_mark.kf): Image do SVG oficial.
Style brandImageCss()      = Style("display: block; height: auto; max-width: 100%")
// Ondas de fundo (components/background_waves.kf).
Style wavesLayerCss()      = Style("position: absolute; top: 0; left: 0; width: 100%; height: 100%; overflow: hidden; pointer-events: none; padding: 0; background: transparent; z-index: 0")
Style wavesImageCss()      = Style("display: block; width: 100%; height: 100%; object-fit: cover; pointer-events: none")
Style overWavesCss()       = Style("position: relative; z-index: 1; display: flex; flex-direction: column; flex-grow: 1; width: 100%; background: transparent")
// Campo de 38 px (login e cadastro do Desktop) e label 12/600 com 6 px.
Style inputSmCss() {
    if (authLight()) {
        return Style("outline: none; background: #FFFFFF; color: #1A1D2E; height: 46; width: 100%; box-sizing: border-box; border: 1px solid #E5E7EB; border-radius: 8; padding: 0 14px; font-size: 1rem; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
    }
    return Style("outline: none; background: rgba(255,255,255,.04); color: #F0F0F0; height: 46; width: 100%; box-sizing: border-box; border: 1px solid rgba(255,255,255,.1); border-radius: 8; padding: 0 14px; font-size: 1rem; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
}
Style inputSmPasswordCss() {
    if (authLight()) {
        return Style("outline: none; background: #FFFFFF; color: #1A1D2E; height: 46; width: 100%; box-sizing: border-box; border: 1px solid #E5E7EB; border-radius: 8; padding: 0 38px 0 14px; font-size: 1rem; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
    }
    return Style("outline: none; background: rgba(255,255,255,.04); color: #F0F0F0; height: 46; width: 100%; box-sizing: border-box; border: 1px solid rgba(255,255,255,.1); border-radius: 8; padding: 0 38px 0 14px; font-size: 1rem; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
}
Style fieldLabelCss() {
    if (authLight()) {
        return Style("color: #6B7280; font-size: 0.875rem; font-weight: 600; letter-spacing: 0.04em; margin: 0 0 6px 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
    }
    return Style("color: #7B8EAD; font-size: 0.875rem; font-weight: 600; letter-spacing: 0.04em; margin: 0 0 6px 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
}
Style labeledCss()         = Style("display: flex; flex-direction: column; gap: 0; width: 100%; padding: 0; background: transparent")
Style passwordBoxCss()     = Style("position: relative; display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; width: 100%; padding: 0; background: transparent")
Style eyeButtonCss()       = Style("outline: none; position: absolute; right: 14; top: 15; padding: 0; background: transparent; line-height: 0em; cursor: pointer")
// Radio de 18 px (ponto de 9) dentro do choice card.
Style radioCardCss()       = Style("outline: none; display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 12; width: 100%; box-sizing: border-box; padding: 14px 16px; border-radius: 12; background: #12162A; border: 1px solid rgba(255,255,255,.06); cursor: pointer")
Style radioCardSelectedCss() = Style("outline: none; display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 12; width: 100%; box-sizing: border-box; padding: 14px 16px; border-radius: 12; background: rgba(0,212,255,.08); border: 1px solid #00D4FF; cursor: pointer")
Style radioLabelCss()      = Style("color: #F0F0F0; font-size: 0.875rem; font-weight: 500; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style radioCss()           = Style("display: flex; align-items: center; justify-content: center; width: 18; height: 18; min-width: 18; box-sizing: border-box; border-radius: 9; border: 1.5px solid #4A5578; background: transparent; padding: 0; flex-shrink: 0")
Style radioOnCss()         = Style("display: flex; align-items: center; justify-content: center; width: 18; height: 18; min-width: 18; box-sizing: border-box; border-radius: 9; border: 1.5px solid #00D4FF; background: transparent; padding: 0; flex-shrink: 0")
Style radioDotCss()        = Style("width: 9; height: 9; border-radius: 5; background: #00D4FF; padding: 0")
// Valor grande do salário: 52/700 accent, com prefixo "R$".
Style bigMoneyRowCss()     = Style("display: flex; flex-direction: row; flex-wrap: nowrap; align-items: baseline; justify-content: center; gap: 4; width: 100%")
Style bigMoneyPrefixCss()  = Style("color: #00D4FF; font-size: 3.25rem; font-weight: 700; margin: 0 6px 0 0; white-space: nowrap; flex-shrink: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style bigMoneyInputCss()   = Style("outline: none; background: transparent; color: #00D4FF; height: 4rem; width: 100%; max-width: 480; min-width: 0; box-sizing: border-box; border: none; text-align: center; font-size: 3.25rem; font-weight: 700; padding: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style moneyHintCss()       = Style("color: #7B8EAD; font-size: 1rem; line-height: 1.5rem; text-align: center; margin: 16px 0 0 0; overflow-wrap: break-word; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
