package core

import kof.ui

// =============================================================================
// Paleta de Cores e Tema — DESIGN_SYSTEM.md
// =============================================================================
// Estado mutável/compartilhado em KOF vive em campos estáticos de classe
// (training/learn/35-kof-ui.md; CLAUDE.md regra 5) — nunca em variáveis
// soltas em nível de arquivo.
// =============================================================================

class AppTheme {
    // Base
    static Color background      = Color(10, 13, 24)
    static Color card            = Color(18, 22, 42)
    static Color cardSecondary   = Color(26, 31, 58)
    static Color borderCard      = Color.rgba(255, 255, 255, 0.06)
    static Color borderChrome    = Color.rgba(255, 255, 255, 0.08)

    // Accent
    static Color accent          = Color(0, 212, 255)
    static Color accentBlue      = Color(0, 102, 255)
    static Color accentContrast  = Color(6, 18, 28)

    // Texto
    static Color textPrimary     = Color(240, 240, 240)
    static Color textSecondary   = Color(123, 142, 173)
    static Color textMuted       = Color(74, 85, 120)

    // Estado
    static Color success         = Color(0, 229, 160)
    static Color warning         = Color(255, 184, 0)
    static Color danger          = Color(255, 74, 110)

    // Categoria (ícones de caixinhas)
    static Color catMoradia      = Color(124, 140, 255)
    static Color catMercado      = Color(45, 212, 191)
    static Color catTransporte   = Color(56, 189, 248)
    static Color catDelivery     = Color(167, 139, 250)
    static Color catLazer        = Color(244, 114, 182)
    static Color catReserva      = Color(163, 230, 53)
}

// =============================================================================
// Estilos pré-definidos (funções top-level — sem estado, sem cerimônia)
// =============================================================================

Style screenStyle() = Style(AppTheme.background, AppTheme.textPrimary, 16, 0)
Style cardStyle()   = Style(AppTheme.card, AppTheme.textPrimary, 16, 12)
Style inputStyle()  = Style(AppTheme.card, AppTheme.textPrimary, 16, 8)
