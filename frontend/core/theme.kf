package core

import kof.ui
import core.app_state

// =============================================================================
// T1 — Tokens do Design System (artefato JVjueTmHeJsnHLsow3LDVb / docs/DESIGN_SYSTEM.md)
// =============================================================================
// Todas as cores são FUNÇÕES top-level. Campos "static Color x = Color(...)"
// são emitidos como "static x;" (sem valor) no KofJS (Default.mjs) e a cor
// chega "undefined" no runtime — por isso nenhum token vive em campo estático.
// Tamanhos (Int) também são funções, para manter um único idioma.
// =============================================================================

// Tema: AppState.themeMode "dark" (padrão) ou "light". O Style("css") só aceita literal
// (SEM077/078: sem var()), então cada token/Style é um par escolhido na hora de desenhar.
Bool isLight() = AppState.themeMode == "light"
Color pickColor(Color light, Color dark) {
    if (isLight()) {
        return light
    }
    return dark
}
Style themed(Style light, Style dark) {
    if (isLight()) {
        return light
    }
    return dark
}

// ---- Base (dark) -----------------------------------------------------------
Color colorBgPrimary()     = pickColor(Color(248, 249, 252), Color(10, 13, 24))     // #0A0D18
Color colorCard()          = pickColor(Color(255, 255, 255), Color(18, 22, 42))     // #12162A
Color colorCardSecondary() = pickColor(Color(255, 255, 255), Color(26, 31, 58))     // #1A1F3A

// ---- Accent ----------------------------------------------------------------
Color colorAccent()        = pickColor(Color(37, 99, 235), Color(0, 212, 255))    // #00D4FF (cyan)
Color colorAccent2()       = pickColor(Color(29, 78, 216), Color(0, 102, 255))    // #0066FF (blue)
Color colorAccentContrast() = pickColor(Color(255, 255, 255), Color(6, 18, 28))     // #06121C (texto sobre cyan)

// ---- Texto -----------------------------------------------------------------
Color colorTextPrimary()   = pickColor(Color(26, 29, 46), Color(240, 240, 240))  // #F0F0F0
Color colorTextSecondary() = pickColor(Color(107, 114, 128), Color(123, 142, 173))  // #7B8EAD
Color colorTextMuted()     = pickColor(Color(156, 163, 175), Color(74, 85, 120))    // #4A5578

// ---- Estado ----------------------------------------------------------------
Color colorSuccess()       = pickColor(Color(16, 185, 129), Color(0, 229, 160))    // #00E5A0
Color colorWarning()       = pickColor(Color(245, 158, 11), Color(255, 184, 0))    // #FFB800
Color colorDanger()        = pickColor(Color(230, 57, 70), Color(255, 74, 110))   // #FF4A6E

// ---- Categorias (ícones das Caixinhas) -------------------------------------
// Só cores da paleta (docs/DESIGN_SYSTEM.md §2: nenhum hex fora da lista).
Color colorCatMoradia()    = colorAccent()
Color colorCatMercado()    = colorWarning()
Color colorCatTransporte() = colorTextSecondary()
Color colorCatDelivery()   = colorChartDes()
Color colorCatLazer()      = colorDanger()
Color colorCatReserva()    = colorSuccess()

// ---- Ondas do cabeçalho antigo (brand_header): tons da paleta -------------
Color colorWave2()         = colorAccent2()
Color colorWave3()         = colorTextSecondary()

// ---- Tokens do DS (canvas, chart-des, border-soft) ---------------------------
Color colorCanvas()        = pickColor(Color(231, 234, 242), Color(5, 6, 11))       // #05060B
Color colorChartDes()      = pickColor(Color(124, 58, 237), Color(0, 102, 255))    // #0066FF (fatia Desejos)
// border-soft = rgba(255,255,255,.1). Color não carrega alfa de forma confiável
// no KofJS, então a versão Color é a mesma borda já composta sobre colorCard;
// dentro de Style("css") use sempre o literal rgba(255,255,255,.1).
Color borderSoft()         = pickColor(Color(229, 231, 235), Color(42, 45, 63))     // rgba(255,255,255,.1) sobre #12162A

// ---- Tipografia (system-ui, px; escala em docs/DESIGN_SYSTEM.md §3) ---------------------------------
Int sizeTitle()    = 24
Int sizeSubtitle() = 18
Int sizeBody()     = 16
Int sizeCaption()  = 14
Int sizeMoney()    = 28

// ---- Viewports canônicos ---------------------------------------------------
Int mobileWidth()   = 360
Int mobileHeight()  = 640
Int desktopWidth()  = 1280
Int desktopHeight() = 800

// =============================================================================
// Styles — Style(background, foreground, padding, radius)
// =============================================================================

Style screenStyle()        = Style(colorBgPrimary(), colorTextPrimary(), 16, 0)
Style cardStyle()          = Style(colorCard(), colorTextPrimary(), 16, 12)
Style cardSecondaryStyle() = Style(colorCardSecondary(), colorTextPrimary(), 12, 10)
Style inputStyle()         = Style(colorCard(), colorTextPrimary(), 12, 8)
Style navBarStyle()        = Style(colorCard(), colorTextSecondary(), 8, 0)
Style sidebarStyle()       = Style(colorCard(), colorTextSecondary(), 16, 0)
Style buttonStyle()        = Style(colorAccent(), colorAccentContrast(), 12, 10)
Style dangerStyle()        = Style(colorDanger(), colorTextPrimary(), 12, 8)

// =============================================================================
// Styles CSS — Style("<css>") (Batch 2, design.md §3)
// =============================================================================
// O compilador valida o texto (SEM076/077/078) e o argumento precisa ser
// literal, por isso cada estilo é uma função. Int sem unidade = px.
// Todo texto define `color`: sem cor, o Label herda o verde do index.html.
// Tokens: #0A0D18 bg · #12162A card · #00D4FF/#0066FF accent ·
// #06121C texto sobre accent · #F0F0F0/#7B8EAD/#4A5578 texto · #FF4A6E danger.
// =============================================================================

// ---- Layout das telas de entrada (§2.2) -------------------------------------
// O View raiz recebe o fundo; a Column filha é que organiza o conteúdo (o
// layout flex vale para os filhos diretos). A altura vem do viewport canônico
// (640 / 800): `min-height: 100%` não tem referência no root do runtime.
Style entryScreenMobileCss()  = themed(Style("background: #F8F9FC; position: relative; overflow: hidden; color: #1A1D2E; min-height: 640; box-sizing: border-box; padding: 16; display: flex; flex-direction: column; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"), Style("background: #0A0D18; position: relative; overflow: hidden; color: #F0F0F0; min-height: 640; box-sizing: border-box; padding: 16; display: flex; flex-direction: column; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"))
Style entryScreenDesktopCss() = themed(Style("background: #F8F9FC; position: relative; overflow: hidden; color: #1A1D2E; min-height: 800; box-sizing: border-box; padding: 16; display: flex; flex-direction: column; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"), Style("background: #0A0D18; position: relative; overflow: hidden; color: #F0F0F0; min-height: 800; box-sizing: border-box; padding: 16; display: flex; flex-direction: column; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"))
Style entryStackCss()         = Style("display: flex; flex-direction: column; flex-grow: 1; gap: 0; width: 100%")
// Corpo da tela: ocupa o resto da altura e centraliza na vertical.
Style entryBodyCss()          = Style("display: flex; flex-direction: column; justify-content: center; align-items: center; flex-grow: 1; width: 100%; padding: 0; background: transparent")
// Coluna de conteúdo: largura total no Mobile, até 480px no Desktop (§2.2).
Style entryColumnMobileCss()  = Style("display: flex; flex-direction: column; align-items: stretch; gap: 32; width: 100%")
Style entryColumnDesktopCss() = Style("display: flex; flex-direction: column; align-items: center; gap: 32; width: 100%; max-width: 480")

// ---- Tela 1 ----------------------------------------------------------------

Style markCss()               = Style("align-self: center; padding: 0; background: transparent; line-height: 0em")
// Slogan: captionCss em caixa alta, 600, letter-spacing .08em, max-width 240 (§5).
Style sloganMobileCss()       = themed(Style("color: #6B7280; font-size: 0.875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; text-align: center; max-width: 240; align-self: center; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"), Style("color: #7B8EAD; font-size: 0.875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; text-align: center; max-width: 240; align-self: center; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"))
// Desktop (artefato 64FYjX5UiveVxTtRGYurQP, WelcomeWin): 16px, max-width 320.
Style sloganDesktopCss()      = themed(Style("color: #6B7280; font-size: 1rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; text-align: center; max-width: 320; align-self: center; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"), Style("color: #7B8EAD; font-size: 1rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; text-align: center; max-width: 320; align-self: center; margin: 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"))
Style actionsMobileCss()      = Style("display: flex; flex-direction: column; align-items: stretch; gap: 16; width: 100%")
Style actionsDesktopCss()     = Style("display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 24")

// ---- Botões (spec B2-01 AC4) -----------------------------------------------
