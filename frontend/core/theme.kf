Style chipSelectedCss()    = Style("outline: none; background: rgba(0,212,255,.08); color: #00D4FF; border: 1.5px solid #00D4FF; border-radius: 20; padding: 6px 12px; font-size: 0.8125rem; font-weight: 600; cursor: pointer; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
Style chipGroupCss()       = Style("display: flex; flex-direction: row; flex-wrap: wrap; gap: 8; width: 100%")
Style chipGroupTitleCss()  = Style("color: #4A5578; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px 0; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif")
