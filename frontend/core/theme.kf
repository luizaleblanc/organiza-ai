package core

import kof.ui

// =============================================================================
// Paleta de Cores e Tema — DESIGN_SYSTEM.md
// =============================================================================
// Estado mutável/compartilhado em KOF vive em campos estáticos de classe
// (training/learn/35-kof-ui.md; CLAUDE.md regra 5) — nunca em variáveis
// soltas em nível de arquivo.
// =============================================================================

class AppTheme {
    // Base
    static Color background      = Color(18, 18, 20)
    static Color card            = Color(24, 24, 27)
    static Color cardSecondary   = Color(39, 39, 42)
    static Color borderCard      = Color(39, 39, 42)
    static Color borderChrome    = Color(39, 39, 42)

    // Base (Dark Mode — nomes de token do spec; mesmos valores de
    // background/card/borderCard acima)
    static Color bgPrimary       = Color(18, 18, 20)
    static Color bgCard          = Color(24, 24, 27)
    static Color bgBorder        = Color(39, 39, 42)

    // Accent
    static Color accent          = Color(6, 182, 212)
    static Color accentBlue      = Color(6, 182, 212)
    static Color accentContrast  = Color(250, 250, 250)

    // Texto
    static Color textPrimary     = Color(250, 250, 250)
    static Color textSecondary   = Color(161, 161, 170)
    static Color textMuted       = Color(113, 113, 122)

    // Tamanhos de fonte
    static Int titleSize         = 24
    static Int subtitleSize      = 16
    static Int bodySize          = 14

    // Estado
    static Color success         = Color(0, 229, 160)
    static Color warning         = Color(255, 184, 0)
    static Color danger          = Color(255, 74, 110)

    // Categoria (ícones de caixinhas)
    static Color catMoradia      = Color(124, 140, 255)
    static Color catMercado      = Color(45, 212, 191)
    static Color catTransporte   = Color(56, 189, 248)
    static Color catDelivery     = Color(167, 139, 250)
    static Color catLazer        = Color(244, 114, 182)
    static Color catReserva      = Color(163, 230, 53)
}

// =============================================================================
// Estilos pré-definidos (funções top-level — sem estado, sem cerimônia)
// =============================================================================

Style screenStyle() = Style(AppTheme.background, AppTheme.textPrimary, 16, 0)
Style cardStyle()   = Style(AppTheme.card, AppTheme.textPrimary, 16, 12)
Style inputStyle()  = Style(AppTheme.card, AppTheme.textPrimary, 16, 8)

// Botão padrão: fundo accent (cyan), radius 8, sem borda (View/Style não tem
// propriedade de borda), texto textPrimary. Usar: View(buttonStyle()).bind(button)
Style buttonStyle() = Style(AppTheme.accent, AppTheme.textPrimary, 16, 8)
