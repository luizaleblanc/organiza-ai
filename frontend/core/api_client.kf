package core

import kof.http
import core.app_state

// =============================================================================
// Cliente HTTP do frontend (Batch 2, design §2.3 e §4.2)
// =============================================================================
// Same-origin: o backend serve o bundle (KOF_WEB_OUT), então os caminhos são
// relativos, sem host nem configuração por ambiente.
// No navegador, http.get/post devolvem Promise: toda chamada é spawn + await
// (spec B2-08 item 4). O corpo chega como String, sem status: 4xx devolve o
// JSON de erro; rede, CORS e 5xx lançam String. Estas funções NÃO capturam a
// exceção: quem chama trata catch (String e) como falha de rede ou servidor
// (core/auth_api.kf).
// =============================================================================

String apiHeaders() {
    var headers = "Content-Type: application/json"
    if (SessionState.token != "") {
        headers = "Authorization: Bearer " + SessionState.token + "\n" + headers
    }
    return headers
}

String apiGet(String path) {
    val h = spawn http.get(path, apiHeaders())
    return await h
}

String apiPost(String path, String payload) {
    val h = spawn http.post(path, payload, apiHeaders())
    return await h
}

// Erro de API = corpo {"error": ...} (4xx). O texto nunca vai para a tela.
Bool isApiError(String body) = body.startsWith("{\"error\"")
