package core

import kof.http
import core.app_state

// =============================================================================
// Cliente HTTP do frontend (Batch 2, design §2.3 e §4.2)
// =============================================================================
// Same-origin: o backend serve o bundle (KOF_WEB_OUT), então os caminhos são
// relativos, sem host nem configuração por ambiente.
// No navegador, http.get/post/put/delete devolvem Promise: toda chamada é spawn + await
// (spec B2-08 item 4). O corpo chega como String, sem status: 4xx devolve o
// JSON de erro; rede, CORS e 5xx lançam String. Estas funções NÃO capturam a
// exceção: quem chama trata catch (String e) como falha de rede ou servidor
// (core/auth_api.kf).
// =============================================================================

String apiHeaders() {
    var headers = "Content-Type: application/json"
    if (SessionState.token != "") {
        headers = "Authorization: Bearer " + SessionState.token + "\n" + headers
    }
    return headers
}

String apiGet(String path) {
    val h = spawn http.get(path, apiHeaders())
    return await h
}

String apiPost(String path, String payload) {
    val h = spawn http.post(path, payload, apiHeaders())
    return await h
}

// PUT/DELETE (Batch 3, F0): mesmo transporte de apiGet/apiPost. No alvo js
// http.put/http.delete viram kofHttpPutHeaders/kofHttpDeleteHeaders, que chamam
// fetch com method "PUT"/"DELETE" e devolvem Promise (medido no kof 0.6.6 e
// 0.6.7, Edge headless contra o backend H2: PUT /api/users/me/preferences e
// DELETE /api/envelopes/:id).
String apiPut(String path, String payload) {
    val h = spawn http.put(path, payload, apiHeaders())
    return await h
}

// PATCH (Batch 3, Z): mesmo padrão de apiPut. http.patch está na tabela do
// KofHttp.staticCall (KOF_WEB_REFERENCE.md) e o runtime js traz
// kofHttpPatchHeaders (JsRuntimeOps no 0.6.6 e 0.6.7); medido no Edge headless
// com PATCH /api/users/me/salary.
String apiPatch(String path, String payload) {
    val h = spawn http.patch(path, payload, apiHeaders())
    return await h
}

String apiDelete(String path) {
    val h = spawn http.delete(path, apiHeaders())
    return await h
}

// Erro de API = corpo {"error": ...} (4xx). O texto nunca vai para a tela.
Bool isApiError(String body) = body.startsWith("{\"error\"")
