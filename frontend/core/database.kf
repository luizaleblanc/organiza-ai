package core

// =============================================================================
// Organiza IA - Entidades do Banco de Dados Nativas (kof.orm)
// =============================================================================

entity User {
    id: String 
    email: String
    salary: Float
    tier: String
    hasVariableIncome: Bool
    emergencyFundGoal: Float
    budgetModel: String 
    incomeType: String 
    hasDebt: Bool
    debtAmount: Float
}

entity Transaction {
    id: String
    userId: String
    description: String
    amount: Float
    category: String
    currency: String
    createdAt: String
}

entity Envelope {
    id: String
    userId: String
    categoryName: String
    limitAmount: Float
    currentSpent: Float
}

entity ChatMessage {
    id: String
    userId: String
    role: String
    content: String
    createdAt: String
}

// =============================================================================
// Database Initialization (In-Memory Mock fallback for Kof JS target)
// =============================================================================

class AppDatabase {
    static List<User> users = listOf()
    static List<Transaction> transactions = listOf()
    static List<Envelope> envelopes = listOf()
    static List<ChatMessage> messages = listOf()
    
    static void init() {
        // Seed default user for testing
        users.add(User(
            "u-1",
            "luiza@example.com",
            0.0,
            "FREE",
            false,
            0.0,
            "STANDARD_503020",
            "FIXED",
            false,
            0.0
        ))
    }
}
