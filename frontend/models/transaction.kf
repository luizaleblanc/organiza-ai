package models

// =============================================================================
// Models de Transação e Pulso Diário — DTOs compartilhados
// =============================================================================

record DailyPulse(String availableToday, String daysRemaining, String? tip)

record Transaction(String id, String name, String category, String formattedAmount, String time)

record TransactionList(List<Transaction> transactions)

record BucketSummary(String name, Int percentage, String spent, String limit, String status)

