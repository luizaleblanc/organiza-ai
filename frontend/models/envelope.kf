package models

// =============================================================================
// Models de Envelope (Caixinha) — DTOs compartilhados
// =============================================================================

record Envelope(
    String id,
    String name,
    String category,
    Int percentage,
    String spent,
    String limit,
    String status,
    String bucketName
)

record EnvelopeGroup(String bucketName, List<Envelope> envelopes)

